<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-update: installs APKs published by companion/bin/release-app (user confirms each). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: updates to an app we installed ourselves need no confirmation. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Speaking exercises: the speech recognizer hears the learner (asked for at first use). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pairing with the tutor: the camera reads the QR code from lani-pair (asked for when scanning). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- "🚗 Za pot · For the road" (road/RoadService): audio in the car, playing on with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Getting the road ready (road/RoadPrepService): the clips and prompts, on with the screen off or the app in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Package visibility for the text-to-speech engine (API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Speech recognition: the service, the system dialog, and its language list. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lani">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <!-- Compose handles rotation and resizing itself: recreating the activity would drop a running
                 exercise's remembered answers (index, outcomes, typed text) and restart it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android Auto: Lani is a media app there ("🚗 Za pot · For the road"), companion/README.md "Im Auto · In the car". -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- The car's audio session: Android Auto browses it, Bluetooth and the steering wheel control it. -->
        <service
            android:name=".road.RoadService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Getting the car's sessions ready in the background: "🚗 Pripravljam za pot … 40 %". -->
        <service
            android:name=".road.RoadPrepService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false" />

        <!-- Home-screen widget: the village, the streak, today's cards and the active event. -->
        <receiver
            android:name=".widget.VillageWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/village_widget_info" />
        </receiver>
    </application>
</manifest>
