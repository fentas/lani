    ["n't(?!\\p{L})", " not"],
    ["(?<!\\p{L})i'm(?!\\p{L})", "i am"],
    ["'re(?!\\p{L})", " are"],
    ["'ve(?!\\p{L})", " have"],
    ["'ll(?!\\p{L})", " will"],
    ["(?<!\\p{L})let's(?!\\p{L})", "let us"],
    ["(?<!\\p{L})(it|that|there|here|what|where|who|he|she)'s(?!\\p{L})", "$1 is"]
