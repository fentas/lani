<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- The phone bridge's probe (debug and qa builds only: phone/PhoneBridgeProbe): times and checks the bridge in the
             app on a throwaway data directory. adb shell am broadcast -n si.lanisce.lani/.phone.PhoneBridgeProbe -->
        <receiver
            android:name="si.lanisce.lani.phone.PhoneBridgeProbe"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
