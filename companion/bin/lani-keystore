#!/usr/bin/env bash
# Create the app's release key, outside the repository: ~/.config/lani/release.keystore (PKCS12, RSA 4096, valid 30
# years) and ~/.config/lani/signing.properties (mode 600) with its alias and passwords, which app/build.gradle.kts and
# companion/bin/lani-build-app read for a release build. Then it shows how to give GitHub Actions the same key (the
# release workflow's secrets) without printing a password.
#
# Every release is signed with this key from then on, and a phone takes an update only with the key its app was
# installed with: keep a backup of both files (a password manager, an encrypted disk), and never commit them. The
# script never overwrites a key.
#
# Usage: companion/bin/lani-keystore [--alias <alias>] [--dname <distinguished name>] [--repo <owner/name>]
#        companion/bin/lani-keystore --secrets [--repo <owner/name>]    show the GitHub commands again
#
#   --alias    the key's alias (lani)
#   --dname    the certificate's subject ("CN=Lani"); it is public, in every APK
#   --repo     the GitHub repository for the secrets (from the origin remote, else fentas/lani)
#
# keytool comes from JAVA_HOME, the PATH or mise; without a JDK, from the build image (companion/bin/lani-build-app).
# LANI_CONFIG_DIR replaces ~/.config/lani.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
umask 077

die() { echo "lani-keystore: $*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; }

alias=lani dname="CN=Lani" repo="" secrets_only=0
while (($#)); do
  case "$1" in
    --alias) [ $# -ge 2 ] || die "--alias needs a value"; alias="$2"; shift ;;
    --dname) [ $# -ge 2 ] || die "--dname needs a value"; dname="$2"; shift ;;
    --repo) [ $# -ge 2 ] || die "--repo needs a value"; repo="$2"; shift ;;
    --secrets) secrets_only=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
  shift
done
[[ "$alias" =~ ^[A-Za-z0-9._-]+$ ]] || die "the alias may hold letters, digits, '.', '_' and '-'"

config="${LANI_CONFIG_DIR:-$HOME/.config/lani}"
keystore="$config/release.keystore"
props="$config/signing.properties"

if [ -z "$repo" ]; then
  url="$(git -C "$root" remote get-url origin 2> /dev/null || true)"
  repo="$(sed -En 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p' <<< "${url%.git}")"
  repo="${repo:-fentas/lani}"
fi

secrets() {
  local p k
  p="$(printf %q "$props")" k="$(printf %q "$keystore")"
  cat << EOF

The release workflow (.github/workflows/android-release.yml) signs with the same key when the repository has these
secrets. Each command reads the value from the files; nothing is shown:

  base64 < $k | tr -d '\n' | gh secret set LANI_KEYSTORE_B64 --repo $repo
  sed -n 's/^storePassword=//p' $p | tr -d '\n' | gh secret set LANI_KEYSTORE_PASSWORD --repo $repo
  sed -n 's/^keyAlias=//p' $p | tr -d '\n' | gh secret set LANI_KEY_ALIAS --repo $repo
  sed -n 's/^keyPassword=//p' $p | tr -d '\n' | gh secret set LANI_KEY_PASSWORD --repo $repo

  gh secret list --repo $repo     # the four names, without their values
EOF
}

if ((secrets_only)); then
  [ -f "$keystore" ] && [ -f "$props" ] || die "no key in $config yet: run companion/bin/lani-keystore first"
  secrets
  exit 0
fi

for f in "$keystore" "$props"; do
  [ ! -e "$f" ] || die "$f exists already; a new key would leave the installed apps without updates. Move it away first if you really mean to replace it."
done

# 48 hex digits: no character that a properties file or a shell would read differently
password="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
[ ${#password} -eq 48 ] || die "could not read /dev/urandom"

keytool="${JAVA_HOME:+$JAVA_HOME/bin/keytool}"
[ -n "$keytool" ] && [ -x "$keytool" ] || keytool="$(command -v keytool || true)"
if [ -z "$keytool" ] && command -v mise > /dev/null; then
  java="$(mise where java 2> /dev/null || true)"
  [ -z "$java" ] || [ ! -x "$java/bin/keytool" ] || keytool="$java/bin/keytool"
fi

mkdir -p "$config"
tmp="$(mktemp "$config/.release.keystore.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
export LANI_NEW_STOREPASS="$password"
args=(-genkeypair -storetype PKCS12 -alias "$alias" -keyalg RSA -keysize 4096 -validity 10950 -dname "$dname"
  -storepass:env LANI_NEW_STOREPASS -keypass:env LANI_NEW_STOREPASS)
if [ -n "$keytool" ]; then
  rm -f "$tmp" # keytool refuses to write into an empty file
  "$keytool" "${args[@]}" -keystore "$tmp" > /dev/null
else
  # No JDK here: keytool in the build image writes the keystore into the container and hands it over on stdout.
  engine="${LANI_CONTAINER:-}"
  [ -n "$engine" ] || engine="$(command -v docker > /dev/null && echo docker || echo podman)"
  command -v "$engine" > /dev/null || die "no keytool and no docker or podman: install a JDK, or Docker"
  image="$("$root/companion/bin/lani-build-app" --image)"
  "$engine" run --rm -e LANI_NEW_STOREPASS "$image" \
    sh -c 'keytool "$@" -keystore /tmp/release.keystore > /dev/null && cat /tmp/release.keystore' keytool "${args[@]}" > "$tmp"
fi
[ -s "$tmp" ] || die "keytool made no keystore"
chmod 600 "$tmp"

cat > "$props.tmp" << EOF
# The Lani app's release key (companion/bin/lani-keystore, $(date +%F)). app/build.gradle.kts and
# companion/bin/lani-build-app sign release builds with it. Keep a backup of this file and of release.keystore, and
# never commit them: an app installed with this key updates only to an APK signed with it.
storeFile=release.keystore
storePassword=$password
keyAlias=$alias
keyPassword=$password
EOF
chmod 600 "$props.tmp"
mv "$tmp" "$keystore"
mv "$props.tmp" "$props"
trap - EXIT

echo "Created $keystore and $props (mode 600)."
echo "Release builds (companion/bin/release-app, companion/bin/lani-build-app --release) are signed with it from now on."
cat << EOF

A phone with the app installed from a debug-signed build (every build before this key) doesn't take the first
release-signed APK as an update ("App not installed", or INSTALL_FAILED_UPDATE_INCOMPATIBLE). Open the app once while
it reaches the bridge (its outbox empties), uninstall it, install the new APK and pair it again (companion/bin/lani-pair).
The village, the reviews and the stats come from the bridge; what only the phone kept (the chat archive, the app's
settings) starts anew, as in docs/migrate-from-fluent.md ("The app").
EOF
secrets
