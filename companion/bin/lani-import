#!/usr/bin/env python3
"""A learner's data from one file (lani export, or the app's export): it replaces the data here.

  lani import FILE [--profile ID | --data DIR] [--yes] [--dry-run]
  lani import --verify FILE     only check FILE and say what it holds

The whole file is checked first (the paths, the sizes and hashes, the JSON, the databases); nothing changes when it is
refused. Then what was there is kept (a commit in a data repository, else a copy beside the data directory), the files
are replaced and, in a data repository, committed. The node's own secrets, voice clips and runtime files stay. The
format and the rules: .claude/hooks/lani_export.py.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / ".claude" / "hooks"))
import lani_export  # noqa: E402

sys.exit(lani_export.import_main(sys.argv[1:], prog="lani import"))
