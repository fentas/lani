# --- visiting a linked town (the second dev town; companion/README.md, "Visiting") --------------------------------

def centre(b):
    return (b[0] + b[2]) // 2, (b[1] + b[3]) // 2


def on_visit() -> bool:
    """The visited town's own screen: its banner's "⌂ Casa · Home" (not one of its places, a card, a request)."""
    return find(f"⌂ {host('common.home')} · ") is not None


def no_town():
    """Why the visit steps can't run: no second town, or a problem with its fixture; None when they can."""
    if "error" in FACTS:
        return FACTS["error"]
    return None if TOWN.get("row") else f"no second town ({TOWN['why']})"


def friends():
    """The scroll's people page leads to "Prijatelji · Friends", where the linked second town is listed, with its visit."""
    if (why := no_town()) is not None:
        return why
    plain_village()
    assert tap("Zvitek · Scroll", 3) or tap("Knjiga · Book", 3), "scroll button"
    assert tap("Prebivalci · Villagers", 5), "people index"
    assert tap("Prijatelji · Friends", 5), "the Friends row on the people page"
    assert wait_for("🤝 Prijatelji · Friends", 8), "Friends screen"
    # the dev bridge asks each linked town for its state now (3 s each)
    assert wait_for(FACTS["name"], 15) and scroll_to(FACTS["name"], 3), f"the linked town {FACTS['name']!r} on Friends"
    assert find("Obišči · Visit"), "its visit button"
    time.sleep(1)


def visit_town():
    """"🚶 Obišči · Visit" on the town's card opens it: the banner "🧳 In visita · Visiting: <town> (<learner>)" and
    "⌂ Casa · Home", the bar of things to do, all in the town's language (the pair switched), the town answering."""
    if (why := no_town()) is not None:
        return why
    if find("🤝 Prijatelji · Friends") is None:
        return "not on Friends (the step before failed)"
    bs = list(boxes())
    title = next((b for t, b in bs if t.endswith(FACTS["name"])), None)
    assert title is not None, f"the card of {FACTS['name']!r}"
    below = [b for t, b in bs if "Obišči · Visit" in t and b[1] >= title[1]]  # this card's button, not the next card's
    assert below, "the card's visit button"
    tap_at(centre(min(below, key=lambda b: b[1])))
    banner = f"{host('visit.visiting')} · "
    assert wait_for(banner, 10), f"the visit's banner ({banner.strip()} …): the pair didn't switch to {FACTS['language']}?"
    # "On the way …" until its state, people and places came: then the town and the bar under it
    assert wait_for(f"📜 {host('visit.requests')} · ", 25), "the visited town (its bar of things to do)"
    line = next((t for t, _ in nodes() if banner in t), "")
    assert FACTS["name"] in line and FACTS["learner"] in line, f"the banner names the town and its learner: {line!r}"
    assert on_visit(), "the banner's home button"
    assert find("Na obisku") is None and find("Zvitek · Scroll") is None and find("Knjiga · Book") is None, "Slovene labels during the visit"
    if find(host("visit.asOf").split("{")[0].strip()) is not None:
        print("    (the town shows its last state: it isn't answering now)")
    time.sleep(2)  # the town settles, its people walk out


def visit_villager():
    """Someone of the town out on its map: a tap shows their card, in the town's language ("💬 Parla · Talk" for its
    cast, "Chiudi · Close"); back closes just the card. The talk itself is the tutor's (not played here)."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    people = [(t, b) for t, b in boxes() if t in FACTS["people"] and b[2] > b[0] and b[3] > b[1] and b[1] > 0]
    if not people:
        return "nobody of the town out on the map (all indoors at night?)"
    who = None
    for t, b in people:
        tap_at(centre(b))
        if wait_for(f"💬 {host('visit.talk')} · ", 5):
            who = t
            break
        if find(f"{host('common.close')} · "):  # a place's card opened instead (Back on the bare town would leave it)
            adb("shell", "input", "keyevent", "KEYCODE_BACK")
            time.sleep(1.2)
    assert who, f"no villager's card (tried {', '.join(t for t, _ in people)})"
    assert find(f"{host('common.close')} · "), "the card in the town's language"
    time.sleep(1)
    shot("visit-villager-card")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    time.sleep(1.2)
    assert on_visit() and find(f"💬 {host('visit.talk')} · ") is None, "back closed more than the card"


def visit_scene():
    """The land at the horizon (the host culture's sea) opens its place card, "🚪 Entra · Go in" walks into the scene:
    a guest there ("🧳 Qui sei ospite"), its words and who is there; someone with a dialog for guests talks (their lines
    are scripted: no tutor); "‹ <town>" leads back to the town."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    label, go = f"{FACTS['horizon']} · ", f"🚪 {host('placeCard.go')} · "
    for _ in range(3):
        bs = list(boxes())
        land = next((b for t, b in bs if t.startswith(label)), None)
        assert land is not None, f"the town's horizon ({label.strip()} …): no scene of its for guests?"
        # under the banner a tap goes to the banner: drag the town down a little until its horizon is clear of it
        banner = max((b[3] for t, b in bs if t.startswith(("🧳", "⌂"))), default=0)
        x, y = centre(land)
        if y > banner + 30:
            tap_at((x, y))
            if wait_for(go, 5):
                break
            if find(f"{host('common.close')} · "):  # something else opened (a villager's or a building's card)
                adb("shell", "input", "keyevent", "KEYCODE_BACK")
                time.sleep(1.2)
        adb("shell", "input", "swipe", "540", "900", "540", "1300", "400")
        time.sleep(1.5)
    else:
        raise AssertionError(f"the horizon's place card ({go.strip()} …)")
    shot("visit-place-card")
    assert tap(go, 3), "go in"
    assert wait_for(f"‹ {FACTS['name']}", 10), "the scene of the visited town (its way back to the town)"
    time.sleep(2)
    shot("visit-scene")
    # "Here today": someone with a dialog (one for guests among them)
    talk = find(f"💬 {host('visit.talk')} · ") or scroll_to(f"💬 {host('visit.talk')} · ", 3)
    if talk is not None:
        tap_at(talk)
        assert wait_for(f"{host('common.close')} · ", 8), "the guest's dialog"
        time.sleep(3)  # the first line types in
        shot("visit-dialog")
        assert tap(f"{host('common.close')} · ", 3), "close the dialog"
    else:
        print("    (nobody in the scene has a dialog now: it depends on the hour and the day)")
    guest = f"🧳 {host('visit.guestHere')} · "
    # the last line of the scene, at the screen's foot when several people talk there today: on screen is enough
    assert wait_for(guest, 6) or scroll_to(guest, 3) or wait_for(guest, 2), "a guest there (under the scene's words)"
    assert tap(f"‹ {FACTS['name']}", 5), "back to the town"
    assert wait_for(f"⌂ {host('common.home')} · ", 8), "back in the visited town"


def visit_requests():
    """"📜 Richieste · Requests": the town's open requests (the fixture's), each with "✋ Aiuta · Help", which opens the
    request's card (its story, what it takes, its words in the town's language); back to the town. Not played: the run
    and the help it sends are the unit and smoke tests'."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    assert tap(f"📜 {host('visit.requests')} · ", 5), "the requests button"
    help_ = wait_for(f"✋ {host('visit.help')} · ", 12)
    if help_ is None:
        assert find(host("visit.noRequests")) is None, f"no open request, though the town has {FACTS['requests']}"
        raise AssertionError("the town's requests")
    time.sleep(1)
    shot("visit-requests")
    tap_at(help_)
    assert wait_for(f"‹ {FACTS['name']}", 8), "the request's card"
    time.sleep(1)
    shot("visit-request-card")
    assert tap(f"‹ {FACTS['name']}", 3), "back from the request"
    assert wait_for(f"⌂ {host('common.home')} · ", 8), "back in the visited town"


def visit_market():
    """"⚖️ Mercato · Market": what the town's market can spare (the fixture's chest), what the learner offers of their
    own, and "🗣️ Contratta · Haggle" (not pressed: the haggle is a role-play with the tutor); back closes it."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    assert tap(f"⚖️ {host('visit.market')} · ", 5), "the market button"
    assert wait_for(f"{host('visit.marketSells')} · ", 12), "the market's wares"
    wares = [w for w in FACTS["wares"] if find(f"{w} · ")]
    assert wares, f"a good the market spares ({', '.join(FACTS['wares'])})"
    haggle = f"🗣️ {host('visit.haggle')} · "
    for _ in range(6):  # further down the market's panel, below everything the learner can offer
        if find(haggle) is not None:
            break
        adb("shell", "input", "swipe", "540", "2000", "540", "1200", "400")
        time.sleep(slow())
    assert find(haggle), "the haggle button"
    time.sleep(1)
    shot("visit-market")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the market
    time.sleep(1.2)
    assert on_visit() and find(f"{host('visit.marketSells')} · ") is None, "back closed more than the market"


def visit_gift():
    """"🎁 Regalo · Gift": the message field focused, the keyboard up, the field and "🎁 Invia · Send" above it (the
    visit's panel keeps above the keyboard); nothing is sent. Back hides the keyboard, back again closes the panel."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    assert tap(f"🎁 {host('visit.gift')} · ", 5), "the gift button"
    label = f"{host('visit.messageInLanguage')} · "
    field = wait_for(label, 8)
    assert field is not None, "the gift's message field"
    tap_at(field)
    top = keyboard_settled()
    assert top is not None, "the keyboard came up"
    bs = list(boxes())
    shot("visit-gift-keyboard")
    parts = {"the message field": box_of(bs, label), "Send": box_of(bs, f"🎁 {host('visit.send')} · ")}
    missing = [n for n, b in parts.items() if b is None]
    assert not missing, f"with the keyboard up, not on screen: {', '.join(missing)}"
    under = [f"{n} ({b[3]} > {top})" for n, b in parts.items() if b[3] > top]
    assert not under, f"under the keyboard (its top at {top}): {', '.join(under)}"
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the keyboard down
    time.sleep(1.2)
    assert ime_top() is None, "back hid the keyboard"
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel closed
    end = time.time() + 6 * slow()
    while find(label) is not None and time.time() < end:  # it slides away
        time.sleep(0.8)
    assert find(label) is None, "back closed the gift's panel"
    assert on_visit(), "back closed only the gift's panel (still on the visit)"


def visit_home():
    """"⌂ Casa · Home" leads back to the own village, in its own pair again."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    assert tap(f"⌂ {host('common.home')} · ", 3), "home"
    assert wait_for("Zvitek · Scroll", 10) or wait_for("Knjiga · Book", 3), "the own village"
    assert find(f"{host('visit.visiting')} · ") is None, "still visiting"


def leave_visit():
    """After a visit step failed: home from wherever in the visit it stopped (a place, a request, a card), then the
    plain village. Back from the town leads to Friends, from Friends to the village."""
    for _ in range(5):
        if (c := find(f"⌂ {host('common.home')} · ")) is not None:
            tap_at(c)
            break
        if any(t in VILLAGE_HUD for t, _ in nodes()):
            break
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.2)
    plain_village()


def in_front() -> bool:
    """The app is the resumed activity ("topResumedActivity=…" on newer Androids, "mResumedActivity: …" on older)."""
    dump = adb("shell", "dumpsys", "activity", "activities", check=False)
    return PKG in re.split(r"ResumedActivity", dump, maxsplit=1)[-1][:200]


def go_home():
    """Back out of sheets and screens until Home; relaunch if Back left the app."""
    for _ in range(6):
        if find("Danes · Today"):
            return
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        if not in_front():
            adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
            time.sleep(3)
    assert wait_for("Danes · Today", 8), "could not get back to Home"


FILL_FORM = "Vstavi pravo obliko"  # a form question's instruction (l10n wordForms.fillForm)


def deck_lemmas() -> list[str]:
    """The one-word vocabulary cards of the dev bridge's deck (its copy of the learner data), as GET /forms is asked."""
    items = api("/state").get("databases", {}).get("spaced_repetition", {}).get("items", {})
    words = [str(i.get("content", "")).strip() for i in items.values() if i.get("type", "vocabulary") == "vocabulary"]
    return sorted({w for w in words if re.fullmatch(r"[^\W\d_]{2,40}", w)})


def word_forms():
    """A word's forms in review (companion/GAME.md, "A word's forms"): the dev bridge's GET /forms for the deck's words,
    then QA's "forms" hook starts a review of the words with a form reached, each asking one in a sentence with a gap
    ("Vstavi pravo obliko · Fill in the right form"); one is answered, its feedback shows, the review is left."""
    go_home()
    lemmas = deck_lemmas()
    if not lemmas:
        return "no one-word cards in the deck"
    known = []
    for i in range(0, min(len(lemmas), 200), 40):
        q = "&".join("w=" + urllib.parse.quote(w) for w in lemmas[i:i + 40])
        known += [w["word"] for w in api(f"/forms?{q}")["words"] if any(e.get("slots") for e in w["entries"])]
    if not known:
        return "no word of the deck has forms"
    qa_hook("forms")
    try:
        c = wait_for(FILL_FORM, 25)
        if c is None:
            return f"no form question ({len(known)} words with forms: {', '.join(known[:5])} …)"
        time.sleep(1)
        shot("form-question")
        if find("Preveri · Check"):  # typed: anything, its feedback shows the right form
            field = find("Napiši odgovor") or find("Type your answer")
            if field:
                tap_at(field)
                type_text("x")
            tap("Preveri · Check", 3)
        else:  # chosen: the first option below the sentence with its gap
            gap = next((c for t, c in nodes() if "____" in t), None)
            assert gap is not None, "the sentence with its gap"
            options = [(t, c) for t, c in nodes() if t and c[1] > gap[1] + 30 and "____" not in t and FILL_FORM not in t
                       and not any(n in t for n in NOT_OPTIONS)]
            assert options, "the forms to choose from"
            tap_at(options[0][1])
        assert wait_for("Naprej · Next", 8), "the answer's feedback"
        shot("form-answered")
    finally:
        qa_hook("forms:off")
        go_home()


def packs():
    """The Nove besede tile opens the packs; an unfinished pack starts its words."""
    go_home()
    tile = scroll_to("Nove besede")
    assert tile, "new words tile"
    tap_at(tile)
    assert wait_for("Znaš ", 8), "packs screen"
    time.sleep(1)
    ring = next((c for t, c in nodes() if (m := re.fullmatch(r"(\d+)/(\d+)", t)) and m[1] != m[2]), None)
    if ring is None:
        return "no learnable pack"
    adb("shell", "input", "tap", str(ring[0]), str(ring[1]))
    assert wait_for("Pozneje · Later", 8), "the pack's intro"  # the pack's giver asks first
    shot("pack-intro")
    assert tap("Začni", 3), "start from the intro"
    assert wait_for("Naprej · Next", 8), "word card"


# --- the car ("🚗 Za pot"; companion/README.md, "Im Auto · In the car") --------------------------------------------

ROAD_SERVICE = f"{PKG}/.road.RoadService"
ROAD_TITLE = "🚗 Za pot · For the road"  # the sheet's title, and its first session's button
ROAD_PROBLEMS = ("Priprava ni uspela", "Za pripravo mora", "Telefon nima glasu")  # road.failed, road.needsNode, road.noVoice


def road_session() -> dict:
    """The app's media session as `dumpsys media_session` shows it (what a car sees): {"state": 3 playing, 2 paused …,
    "title": its item's title}; {} when the app has none."""
    out = adb("shell", "dumpsys", "media_session", check=False)
    for b in re.split(r"\n(?=  \S[^\n]* \(userId=\d+\)\n)", out):
        if f"package={PKG}" not in b:
            continue
        state = re.search(r"state=PlaybackState \{state=(?:\w+\()?(\d+)", b)
        title = re.search(r"metadata: size=\d+, description=([^\n]*)", b)
        return {"state": int(state[1]) if state else None, "title": title[1].split(", ")[0] if title else None}
    return {}


def road_now() -> dict:
    """What the road's service plays, from its dump (a debug build's, road/RoadService.dump): "session", "item", "piece"
    of "pieces", "sound" ("pause:SAY" the pause to say the Slovene, "clip", "prompt" …), "state"; "sessions": each
    session's items on the phone."""
    out = adb("shell", "dumpsys", "activity", "service", ROAD_SERVICE, check=False)
    now: dict = {}
    if m := re.search(r"road: session=(\S+) item=(\S+) piece=(-?\d+)/(\d+) sound=(\S+) state=(\d+) playing=(\w+)", out):
        now = {"session": m[1], "item": m[2], "piece": int(m[3]), "pieces": int(m[4]), "sound": m[5], "state": int(m[6]), "playing": m[7] == "true"}
    if m := re.search(r"road: sessions ([^\n]*)", out):
        now["sessions"] = {k: int(v) for k, v in (p.split("=") for p in m[1].split())}
    return now


def app_alive() -> bool:
    return bool(adb("shell", "pidof", PKG, check=False).strip())


def still_playing(when: str) -> dict:
    """The app runs and its session plays an item (what a car sees), [when]; the session, else an assertion."""
    assert app_alive(), f"the app closed {when}"
    s = {}
    for _ in range(6):  # a moment for the session to tell the system
        s = road_session()
        if s.get("state") == 3 and s.get("title"):
            return s
        time.sleep(0.5)
    raise AssertionError(f"the session isn't playing an item {when}: {s or 'no session'}")


def media_key(key: str):
    """[key] ("next", "pause") as a car's or a Bluetooth button sends it, to the session playing."""
    if "rror" in adb("shell", "cmd", "media_session", "dispatch", key, check=False):
        adb("shell", "input", "keyevent", f"KEYCODE_MEDIA_{key.upper()}")


def road_car_log() -> list[str]:
    """What QA's car ("road:car", road/RoadCarCheck) logged in its last check, a line each."""
    lines = [m[1] for l in adb("logcat", "-d", "-s", "RoadCar:I", check=False).splitlines() if (m := re.search(r"RoadCar\s*: (.*)", l))]
    start = max((i for i, l in enumerate(lines) if l.startswith("connected")), default=0)
    return lines[start:]


def road():
    """"🚗 Za pot" in the car: QA's small library ("road:mini": two items of each kind from the dev bridge, the files got in
    the background, "🚗 Pripravljam za pot … %" in a notification) until the sheet says "Končano"; "🚗 Za pot" started
    from the sheet plays (dumpsys media_session: PLAYING, an item); next in the pause to say the Slovene plays the answer
    (the same item, on past the pause), next after it the next item, the app still running and playing; paused. Then as
    Android Auto does ("road:car": the platform's media browser browses the tab and plays each session from its id): every
    session with items on the phone plays, none fails ("Failed to load selection" in a car), the app still runs."""
    go_home()
    tile = scroll_to("Za pot", 6, exact=True)
    assert tile, "the 🚗 Za pot tile"
    tap_at(tile)
    assert wait_for(ROAD_TITLE, 6), "the 🚗 sheet"
    qa_hook("road:mini")
    # getting ready: in the background (road/RoadPrepService), its notification while it works
    seen, end = "", time.time() + 240 * slow()
    while time.time() < end:
        if not seen and (m := re.search(r"Pripravljam za pot … \d+ %", adb("shell", "dumpsys", "notification", "--noredact", check=False))):
            seen = m[0]
            shot("road-preparing")
        labels = [t for t, _ in nodes()]
        if why := next((t for t in labels if t.startswith(ROAD_PROBLEMS)), None):
            raise AssertionError(f"getting ready fell short: {why}")
        if any(t.startswith("✅ Končano") for t in labels):
            break
        time.sleep(0.5)
    else:
        raise AssertionError(f"the sheet never said \"Končano\" (seen: {' | '.join(t for t, _ in nodes() if '/' in t or '%' in t)[:200]})")
    done = re.search(r"Končano: vse za pot je na telefonu[^)\n]*\)", adb("shell", "dumpsys", "notification", "--noredact", check=False))
    print(f"    got ready: {next((t for t, _ in nodes() if t.startswith('✅')), '?')}")
    print(f"    notification: {seen or 'the progress not caught (ready within seconds)'}; at the end: {done[0] if done else 'none (notifications not allowed?)'}")
    sessions = road_now().get("sessions", {})
    assert sessions.get("road:mix"), f"nothing in 🚗 Za pot on the phone: {sessions}"
    # the sheet's player: "🚗 Za pot" is its first session, below the title of the same name
    for _ in range(4):
        buttons = [b for t, b in boxes() if t == ROAD_TITLE]
        if len(buttons) > 1:
            tap_at(centre(max(buttons, key=lambda b: b[1])))
            break
        adb("shell", "input", "swipe", "540", "1800", "540", "1100", "400")
        time.sleep(1)
    else:
        raise AssertionError("the sheet's \"🚗 Za pot\" session button")
    s = still_playing("after 🚗 Za pot was started from the sheet")
    shot("road-playing")
    print(f"    playing: {s['title']!r}; sessions on the phone: {', '.join(f'{k.removeprefix('road:')} {v}' for k, v in sessions.items())}")
    # next in the pause to say the Slovene: the answer at once. Sent as a pause begins (it lasts 2.5 s or more).
    revealed, before, end = None, road_now(), time.time() + 60
    while revealed is None and time.time() < end:
        now = road_now()
        if now.get("sound") == "pause:SAY" and (before.get("sound") != "pause:SAY" or before.get("item") != now.get("item")):
            media_key("next")
            time.sleep(1)
            after = road_now()
            if after.get("item") == now["item"] and after.get("piece", -1) > now["piece"]:
                revealed = (now, after)
            else:
                print(f"    next in a pause to say it went elsewhere ({now} → {after}): again at the next one")
            now = after
        before = now
        time.sleep(0.2)
    assert revealed, "next in a pause to say the Slovene never played the answer (within a minute)"
    still_playing("after next in a pause to say it")
    print(f"    next in the pause to say it: {revealed[0]['item']} piece {revealed[0]['piece']} → {revealed[1]['piece']} ({revealed[1]['sound']})")
    item = road_now().get("item")
    media_key("next")
    time.sleep(1.5)
    now = road_now()
    assert now.get("item") not in (None, item), f"next after the answer didn't go on to the next item ({item} → {now.get('item')})"
    still_playing("after next once the answer played")
    media_key("pause")
    time.sleep(1.5)
    assert app_alive(), "the app closed on pause"
    assert road_session().get("state") == 2, f"not paused: {road_session()}"
    # as Android Auto: browse, then play each session from its id
    qa_hook("road:car")
    end = time.time() + 200 * slow()
    while time.time() < end and not any(l.startswith(("done", "FAILED")) for l in road_car_log()):
        assert app_alive(), f"the app closed while the car browsed and played ({' / '.join(road_car_log()[-2:])})"
        time.sleep(2)
    log = road_car_log()
    for l in log:
        print(f"    car: {l}")
    assert log and log[-1].startswith("done"), f"the car's check didn't finish: {' / '.join(log[-3:]) or 'nothing logged'}"
    failed = [l for l in log if "FAILED" in l]
    assert not failed, " / ".join(failed)
    assert any(l.startswith("session road:mix: playing") for l in log), "🚗 Za pot didn't play from its id"
    silent = [k for k, n in sessions.items() if n and not any(l.startswith(f"session {k}: playing") for l in log)]
    assert not silent, f"sessions with items on the phone that didn't play from their id: {', '.join(silent)}"
    assert app_alive(), "the app closed after the car's check"
    assert road_session().get("state") != 3, f"still playing after the car's check paused it: {road_session()}"
    shot("road-car")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the sheet
    time.sleep(1)


def optional_screen(label: str, marker: str, exact: bool = False):
    """A screen reached from Home by [label] ([exact]: a label that is exactly that), shown when [marker] appears."""
    def run():
        go_home()
        c = scroll_to(label, 6, exact=exact)
        if c is None:
            return f"no '{label}' entry"
        tap_at(c)
        return None if wait_for(marker, 8) else f"'{marker}' not shown"
    return run


# --- the bridges ----------------------------------------------------------------------------

def start_bridge():
    """The dev bridge on PORT, on a copy of the learner data (test/dev-bridge.ts); whatever listened there is stopped."""
    for pid in listeners(PORT):
        subprocess.run(["kill", pid])
    bridge = subprocess.Popen(["bun", "test/dev-bridge.ts"], cwd=BRIDGE, stdout=open(OUT / "bridge.log", "w"), stderr=subprocess.STDOUT,
                              env={**os.environ, "LANI_DEV_PORT": PORT})
    if "--keep-bridge" not in sys.argv:
        atexit.register(bridge.terminate)  # also when a step raises past the end, or QA is interrupted
    return bridge


def dev_town(pid: str) -> bool:
    """Whether [pid] is a second town's bridge (test/dev-town.ts marks its environment), not a learner's."""
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        return b"LANI_DEV_TOWN=1" in env or b"FLUENT_DEV_TOWN=1" in env  # the old name: one started before the rename
    except OSError:
        return False


def start_town():
    """The second town (test/dev-town.ts) on TOWN_PORT, which links itself with the dev bridge's town once both
    answer; None when it can't start (TOWN["why"] says why). A second town left on the port by an earlier run is
    stopped; anything else there (a learner's bridge) is left alone, and the visit steps skip."""
    if "--no-town" in sys.argv:
        TOWN["why"] = "--no-town"
        return None
    if "error" in FACTS:
        TOWN["why"] = FACTS["error"]
        return None
    if TOWN_PORT == PORT or TOWN_PORT in NEVER_PORTS:
        TOWN["why"] = f"LANI_DEV_TOWN_PORT={TOWN_PORT} is the dev bridge's or a service's port"
        return None
    for pid in listeners(TOWN_PORT):
        if dev_town(pid):
            subprocess.run(["kill", pid])
    for _ in range(10):
        if not listeners(TOWN_PORT):
            break
        time.sleep(0.5)
    if others := listeners(TOWN_PORT):
        TOWN["why"] = f"port {TOWN_PORT} is taken (pid {', '.join(others)}): LANI_DEV_TOWN_PORT picks another"
        return None
    town = subprocess.Popen(["bun", "test/dev-town.ts"], cwd=BRIDGE, stdout=open(OUT / "town.log", "w"), stderr=subprocess.STDOUT,
                            env={**os.environ, "LANI_DEV_TOWN_PORT": TOWN_PORT, "LANI_DEV_TOWN_LINK": f"http://127.0.0.1:{PORT}",
                                 "LANI_DEV_TOWN_LINK_TOKEN": TOKEN})
    if "--keep-bridge" not in sys.argv:
        atexit.register(town.terminate)
    TOWN["why"] = "not linked yet"
    return town


def visit_summary(tid: str) -> str:
    """What a visit asks of the second town, through the dev bridge as the app asks it, checked: a line for the report."""
    pub = api(f"/towns/{tid}/public")
    people = api(f"/towns/{tid}/villagers")["villagers"]
    scenes = api(f"/towns/{tid}/scenes")["scenes"]
    reqs = api(f"/towns/{tid}/requests")["requests"]
    wares = api(f"/towns/{tid}/market")["wares"]
    t = pub["town"]
    problems = [p for p, bad in (
        (f"its language is {t['language']}", t["language"] != FACTS["language"]),
        ("nobody lives there", not pub["residents"]),
        ("no people (villagers)", not people),
        ("no places (scenes)", not scenes),
        ("no open request", not reqs),
        ("nothing at its market", not wares),
    ) if bad]
    if problems:
        raise AssertionError("the second town answers, but " + ", ".join(problems))
    return (f"\"{t['name']}\" ({t['learner']}, {t['culture']}, {t['language']}): age {pub['age']}, {len(pub['residents'])} residents, "
            f"{len(people)} people, places {', '.join(s['id'] for s in scenes)}, {len(reqs)} requests, "
            f"market {', '.join(f'{k}×{n}' for k, n in wares.items())}")


def link_town(town, timeout=90) -> str:
    """Waits until the dev bridge lists the second town, linked and answering, and checks what a visit asks of it.
    Sets TOWN (its row, or why there is none); the report's line for it."""
    if town is None:
        return f"skipped: {TOWN['why']}"
    end, why, row = time.time() + timeout, "the dev bridge doesn't list it", None
    while time.time() < end:
        if town.poll() is not None:
            why = f"test/dev-town.ts stopped ({town.returncode}): {tail(OUT / 'town.log')}"
            break
        if (bad := next((l for l in tail(OUT / "town.log", 20).split(" / ") if "dev town: not linked" in l), None)) is not None:
            why = bad
            break
        try:
            row = next((t for t in api("/towns", timeout=15)["towns"] if t.get("name") == FACTS["name"]), None)
            if row is not None and row.get("status") == "ok":
                break
            why = f"the dev bridge lists it as {row.get('status')}" if row else "the dev bridge doesn't list it"
        except (OSError, RuntimeError, ValueError) as e:
            why = str(e)
        row = None
        time.sleep(2)
    if row is None:
        TOWN["why"] = why
        return f"FAILED: {why}"
    try:
        TOWN["summary"] = visit_summary(row["id"])
    except (OSError, RuntimeError, ValueError, KeyError, AssertionError) as e:
        TOWN["why"] = str(e)
        return f"FAILED: {e}"
    TOWN["row"] = row
    print(f"    second town: {TOWN['summary']}")
    return "ok"


# --- main -----------------------------------------------------------------------------------

def plan():
    """Every step in order: (name, flow, cleanup, keep, group)."""
    # In the village every step ends on the plain village (camera at home), failed or not; a step whose next one
    # goes on from where it left off (the fire's card into its scene, a run's result, the build sheet) only when failed.
    # The visit goes on from step to step (Friends, the visited town); a failure goes home from it, and the rest skip.
    v, h = plain_village, leave_visit
    return [
        ("setup", setup, None, False, ""),
        ("home", home, None, False, ""),
        ("challenges", challenges, None, False, ""),
        ("village", village, v, False, ""),
        ("scroll", scroll, v, False, ""),
        ("villagers", villagers, v, False, ""),
        ("place-card", place_card, v, True, ""),
        ("scene", scene, v, False, ""),
        ("dialog-words", dialog_words, v, False, ""),
        ("typed-turn", typed_turn, v, False, ""),
        ("ispy", ispy, v, False, ""),
        ("your-words", your_words, v, False, ""),
        ("word-missed", word_missed, v, False, ""),
        ("story-in-scene", story_in_scene, v, False, ""),
        ("counting", counting, v, False, ""),
        ("forest", forest, v, False, ""),
        ("zoom", zoom, v, False, ""),
        ("spot-card", spot_card, v, False, ""),
        ("villager", villager, v, False, ""),
        ("bubble", bubble, v, False, ""),
        ("camera", camera, v, False, ""),
        ("gather", gather, v, True, ""),
        ("back-to-village", back_to_village, v, False, ""),
        ("intro-stage", intro_stage, v, True, ""),
        ("back-to-village-2", back_to_village, v, False, ""),
        ("chest", chest, v, False, ""),
        ("projects", projects, v, False, ""),
        ("build-sheet", build_sheet, v, True, ""),
        ("ages", ages, v, False, ""),
        ("friends", friends, h, True, "visit"),
        ("visit", visit_town, h, True, "visit"),
        ("visit-villager", visit_villager, h, True, "visit"),
        ("visit-scene", visit_scene, h, True, "visit"),
        ("visit-requests", visit_requests, h, True, "visit"),
        ("visit-market", visit_market, h, True, "visit"),
        ("visit-gift", visit_gift, h, True, "visit"),
        ("visit-home", visit_home, h, False, "visit"),
        ("packs", packs, None, False, ""),
        ("word-forms", word_forms, go_home, False, ""),
        ("progress", optional_screen("Napredek · Progress", "📊 Napredek · Progress"), None, False, ""),
        ("talk", optional_screen("Pogovor", "Učitelj igra drugo osebo", exact=True), None, False, ""),
        ("road", road, go_home, False, ""),
    ]


def selected(steps):
    """The steps --steps names (a step, or the group "visit"), and setup; all without it."""
    want = arg("--steps")
    if not want:
        return steps
    names = {w.strip() for w in want.split(",") if w.strip()}
    if unknown := names - {s[0] for s in steps} - {s[4] for s in steps if s[4]}:
        sys.exit(f"unknown steps: {', '.join(sorted(unknown))} (companion/bin/qa --dry lists them)")
    return [s for s in steps if s[0] == "setup" or s[0] in names or s[4] in names]


def dry(steps, visiting: bool):
    """--dry: what a run would do, with the ports as they are now; nothing is built, started or tapped."""
    def port(p):
        pids = listeners(p)
        return "free" if not pids else f"in use now (pid {', '.join(pids)})"
    print("QA plan (--dry: nothing is built, started or tapped)\n")
    print(f"app          {'' if '--no-build' in sys.argv else 'build, '}install and start {PKG} on {SERIAL or f'the emulator (AVD {avd()})'}")
    print(f"dev bridge   127.0.0.1:{PORT} (the app: {BRIDGE_URL}, token {TOKEN}): test/dev-bridge.ts on a copy of "
          f"{os.environ.get('LANI_DEV_DATA') or dev_data()}, its town links left out; port {port(PORT)} (stopped first)")
    why = "--no-town" if "--no-town" in sys.argv else FACTS.get("error") or (None if visiting else "no visit step chosen")
    if why:
        print(f"second town  none: {why}")
    else:
        f = FACTS
        print(f"second town  127.0.0.1:{TOWN_PORT} (token {TOWN_TOKEN}): test/dev-town.ts, \"{f['name']}\" ({f['learner']}, {f['culture']}, "
              f"{f['language']}), a temp data dir; linked with the dev bridge's town; port {port(TOWN_PORT)} "
              "(a second town left there is stopped, anything else skips the visit)")
        print(f"             its people {', '.join(f['people'])}; {f['requests']} requests; market {', '.join(f['wares'])}; "
              f"its horizon {f['horizon']}; the visit's labels read \"{host('visit.visiting')} · …\"")
    print(f"\nsteps ({len(steps)}):")
    for i, (name, fn, _, _, group) in enumerate(steps, 1):
        doc = " ".join((fn.__doc__ or "").split())
        print(f"  {i:2d}  {name:<18} {doc[:110] + ('…' if len(doc) > 110 else '')}")


def bridges_only() -> int:
    """--bridges-only: no app. The dev bridge and the second town, linked; what a visit asks of the town, through the
    dev bridge; both stopped again."""
    OUT.mkdir(parents=True, exist_ok=True)
    bridge = start_bridge()
    town = start_town()
    line = link_town(town)
    print(f"second town: {line}")
    for p in (town, bridge):
        if p is not None:
            p.terminate()
            try:
                p.wait(10)
            except subprocess.TimeoutExpired:
                p.kill()
    print(f"logs: {OUT}")
    return 0 if line == "ok" else 1


def main():
    steps = selected(plan())
    visiting = any(s[4] == "visit" for s in steps)
    if "--dry" in sys.argv:
        return dry(steps, visiting)
    if "--bridges-only" in sys.argv:
        sys.exit(bridges_only())
    OUT.mkdir(parents=True, exist_ok=True)
    env = {**os.environ, "JAVA_HOME": sh("mise", "where", "java").strip()}
    if "--no-build" not in sys.argv:
        print("building …")
        subprocess.run(["./gradlew", "-q", ":app:assembleDebug"], cwd=ANDROID, env=env, check=True)
    ensure_emulator()

    bridge = start_bridge()
    town = start_town() if visiting else None
    time.sleep(4)

    adb("uninstall", PKG, check=False)
    adb("install", "-r", str(APK))
    adb("logcat", "-c")
    adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")

    linked = False
    for name, fn, cleanup, keep, group in steps:
        if group == "visit" and not linked:  # linked by now, while the other steps ran
            results.append(("second-town", link_town(town)))
            linked = True
        step(name, fn, cleanup, keep)

    # Only the app's own crashes: a uiautomator dump that collides with another one also logs a FATAL EXCEPTION.
    log = adb("logcat", "-d", check=False).splitlines()
    crashes = [l for i, l in enumerate(log) if "FATAL EXCEPTION" in l and any(f"Process: {PKG}" in n for n in log[i + 1:i + 3])]
    if crashes:
        results.append(("crash check", "FAILED: " + " / ".join(crashes[:3])))
    else:
        results.append(("crash check", "ok"))

    if "--keep-bridge" not in sys.argv:
        bridge.terminate()
        if town is not None:
            town.terminate()

    if shutil.which("magick"):
        subprocess.run(["magick", "montage", *map(str, shots), "-resize", "270x", "-geometry", "+6+6",
                        "-tile", "6x", str(OUT / "contact-sheet.png")], check=False)
    report = "\n".join(f"{'✅' if r == 'ok' else '⏭️' if r.startswith('skipped') else '❌'} {n}: {r}" for n, r in results)
    (OUT / "report.txt").write_text(report + "\n")
    print(report)
    print(f"\nscreenshots: {OUT}")
    sys.exit(1 if any(r.startswith("FAILED") for _, r in results) else 0)


if __name__ == "__main__":
    main()
