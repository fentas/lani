#!/usr/bin/env python3
"""End-to-end QA of the Lani app on an Android emulator.

Starts the emulator (AVD "lani-qa", or "fluent-qa" made before the rename; $LANI_QA_AVD) if needed, builds and installs a fresh debug APK, runs the
dev bridge on a COPY of the learner data, drives the main flows by visible text, takes a screenshot
per step and fails on crashes. Real learner data is never touched.

A second town to visit: a fixture Italian town (companion/bridge/test/fixtures/dev-town.json, the Friuli
culture pack) on its own dev bridge (test/dev-town.ts, a temp data dir), linked with the dev bridge's town;
the visit steps go to it from Friends and back home.

Usage: companion/bin/qa [--no-build] [--keep-bridge] [--no-town] [--steps <names>] [--happening <scene>/<id>] [--dry] [--bridges-only]
  --steps visit,packs  only these steps (and setup); "visit" is Friends and every visit step; "road" the car's
                       "🚗 Za pot" (a small library got ready, played, next, paused, browsed as Android Auto does);
                       "typed-turn" a dialog's turn typed with the keyboard up (QA's hook "turns:type"), the
                       keyboard the answer's (its language, no suggestion strip); "ispy" a game of «Vidim, vidim» by
                       the fire (QA's hook "ispy:ob-ognju/stump"): a wrong thing tapped, the right one;
                       "your-words" a dialog that tests the learner's own words answered right, its end listing them;
                       "word-missed" one got wrong first, its card after the turn
  --dry                print the plan (bridges, ports, the fixture town, the steps) and stop
  --bridges-only       no app: start both bridges, link them, check what a visit asks through the dev bridge, stop
  --no-town            no second town (the visit steps are skipped)
  --happening ob-ognju/roke  that happening counts as on from the village on (QA's hook), so its person stands at its
                       place for the village's steps (Luka warming his hands at the fire: the fire's card and zoom with
                       someone beside it); a dialog step lets it go again
Output: companion/qa-shots/<timestamp>/  (NN-step.png, contact-sheet.png, report.txt, bridge.log, town.log)
Env: ANDROID_SERIAL picks the device when several run; LANI_DEV_PORT the dev bridge's port (default 8791);
LANI_DEV_TOWN_PORT the second town's (default 8797); LANI_DEV_DATA the data the dev bridge copies (default: the default
learner's, LANI_DATA_DIR in lani.env, else data/).
"""
import atexit
import html
import json
import os
import re
import resource
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def dev_data():
    """The data the dev bridge copies by default: the default learner's (LANI_DATA_DIR in lani.env), else data/."""
    sys.path.insert(0, str(ROOT / ".claude" / "hooks"))
    from lani_paths import learner_setting  # noqa: E402
    return learner_setting("LANI_DATA_DIR") or ROOT / "data"
# LANI_X from FLUENT_X, its name before the project was renamed from Fluent, when LANI_X isn't set.
for _k, _v in list(os.environ.items()):
    if _k.startswith("FLUENT_"):
        os.environ.setdefault("LANI_" + _k[len("FLUENT_"):], _v)
ANDROID = ROOT / "companion/android"
BRIDGE = ROOT / "companion/bridge"
SDK = Path.home() / "Android/Sdk"
APK = ANDROID / "app/build/outputs/apk/debug/app-debug.apk"
PKG = "si.lanisce.lani"
OUT = ROOT / "companion/qa-shots" / time.strftime("%Y%m%d-%H%M%S")
PORT = os.environ.get("LANI_DEV_PORT", "8791")
BRIDGE_URL, TOKEN = f"http://10.0.2.2:{PORT}", "dev-token"
SERIAL = os.environ.get("ANDROID_SERIAL")
# The second town (test/dev-town.ts): its own port (reserved for it in src/learners.ts) and app token.
TOWN_PORT = os.environ.get("LANI_DEV_TOWN_PORT", "8797")
TOWN_TOKEN = "dev-town-token"
NEVER_PORTS = {"8790", "8795", "8796"}  # the real bridge, the voice and speech workers: QA never binds or stops them
OPEN = "si.lanisce.lani.open"  # a deep link in the launch intent (data/DeepLink.kt)
QA_HOOK = "si.lanisce.lani.qa"  # what QA asks of a debug build (app/QaHooks.kt); a release build ignores it

results: list[tuple[str, str]] = []  # (step, "ok" | "skipped: …" | "FAILED: …")


def sh(*args, check=True, **kw) -> str:
    return subprocess.run(args, check=check, capture_output=True, text=True, **kw).stdout


def arg(name: str):
    """The value of option [name] ("--steps visit" or "--steps=visit"), or None."""
    for i, a in enumerate(sys.argv):
        if a == name and i + 1 < len(sys.argv):
            return sys.argv[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


def api(path: str, port=PORT, token=TOKEN, timeout=10):
    """GET [path] from the bridge on 127.0.0.1:[port] with its app token; the answer's JSON (raises with its status)."""
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", headers={"authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"GET {path} answered {e.code}: {e.read()[:200].decode(errors='replace')}") from None


def listeners(port: str) -> list[str]:
    """The pids that listen on tcp [port]."""
    return sh("lsof", "-ti", f"tcp:{port}", "-sTCP:LISTEN", check=False).split()


def tail(path: Path, n=4) -> str:
    try:
        return " / ".join(l.strip() for l in path.read_text(errors="replace").splitlines()[-n:] if l.strip())
    except OSError:
        return "(no log)"


# --- the town visited (the fixture of test/dev-town.ts, its culture pack, the app's texts) -----------------------

def l10n(lang: str) -> dict:
    """The app's texts in [lang] by key ("visit.visiting" → "In visita"), from its resources."""
    def flat(o, p=""):
        for k, v in o.items():
            key = f"{p}.{k}" if p else k
            if isinstance(v, dict):
                yield from flat(v, key)
            else:
                yield key, str(v)
    try:
        return dict(flat(json.loads((ANDROID / f"app/src/main/resources/l10n/{lang}.json").read_text())))
    except (OSError, ValueError):
        return {}


def town_facts() -> dict:
    """What the visit steps look for in the fixture town: its name, its people's names (its residents and today's
    visitor, from its culture pack's cast), the label of its horizon (the host culture's backdrop, "Il mare"), the goods
    its market can spare, and the app's texts in its language. During a visit every label reads "<host> · <base>"
    ("In visita · Visiting" for Jan, Slovene from English, in an Italian town): the steps look for the host's part."""
    try:
        f = json.loads((BRIDGE / "test/fixtures/dev-town.json").read_text())
        host, culture = f["learner"]["target"], ROOT / "companion/cultures" / f["learner"]["culture"]
        cast = {}
        for p in (culture / "villagers").glob("*.json"):
            v = json.loads(p.read_text())
            cast[v.get("id", p.stem)] = v.get("name", p.stem)
        s = f["state"]
        ids = [r["id"] for r in s.get("residents", [])] + ([s["visitor"]["id"]] if s.get("visitor") else [])
        goods = {g["id"]: g.get("name", {}) for g in json.loads((culture / "chest.json").read_text()).get("goods", [])}
        spare = [i for i, n in s.get("chest", {}).get("goods", {}).items() if min(3, n - 1) > 0]
        backdrop = json.loads((culture / "world.json").read_text()).get("backdrop", {}).get("name", {})
        return {
            "name": f["town_name"], "learner": f["learner"]["name"], "culture": f["learner"]["culture"], "language": host,
            "people": [cast[i] for i in ids if i in cast], "requests": len(s.get("quests", [])),
            "horizon": backdrop.get(host, ""), "wares": [goods[i].get(host, i) for i in spare if i in goods],
            "t": l10n(host),
        }
    except (OSError, ValueError, KeyError) as e:
        return {"error": f"the fixture town can't be read: {e}"}


FACTS = town_facts()
TOWN: dict = {"why": "not started"}  # the second town as the dev bridge lists it ("row"), or why there is none ("why")


def host(key: str) -> str:
    """[key] in the visited town's language ("Casa"): the first half of a label during the visit."""
    return FACTS.get("t", {}).get(key, key)


def adb(*args, check=True) -> str:
    return sh("adb", *(("-s", SERIAL) if SERIAL else ()), *args, check=check)


# --- device ---------------------------------------------------------------------------------

def avd() -> str:
    """The QA emulator: $LANI_QA_AVD, else lani-qa, else fluent-qa (the AVD made before the rename) when only that exists."""
    if os.environ.get("LANI_QA_AVD"):
        return os.environ["LANI_QA_AVD"]
    known = sh(str(SDK / "emulator/emulator"), "-list-avds", check=False).split()
    return "fluent-qa" if "lani-qa" not in known and "fluent-qa" in known else "lani-qa"


def ensure_emulator():
    if (SERIAL or "emulator-") in sh("adb", "devices"):
        return
    print("starting emulator …")
    subprocess.Popen(
        [str(SDK / "emulator/emulator"), "-avd", avd(), "-no-window", "-no-audio", "-no-boot-anim",
         "-gpu", "swangle_indirect", "-no-snapshot-save", "-memory", "4096"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
        # A crashing emulator would otherwise leave a core dump of ~10 GB in the working directory.
        preexec_fn=lambda: resource.setrlimit(resource.RLIMIT_CORE, (0, 0)),
    )
    adb("wait-for-device")
    for _ in range(90):
        if adb("shell", "getprop", "sys.boot_completed", check=False).strip() == "1":
            return
        time.sleep(2)
    sys.exit("emulator did not boot")


def nodes():
    adb("shell", "uiautomator", "dump", "/sdcard/ui.xml", check=False)
    xml = adb("shell", "cat", "/sdcard/ui.xml", check=False)
    for n in re.findall(r"<node [^>]*?>", xml):
        def attr(k):
            m = re.search(k + r'="([^"]*)"', n)
            return html.unescape(m.group(1)) if m else ""
        b = list(map(int, re.findall(r"\d+", attr("bounds")))) or [0, 0, 0, 0]
        yield attr(" text") or attr("content-desc"), ((b[0] + b[2]) // 2, (b[1] + b[3]) // 2)


def boxes():
    """Every labelled node's bounds: (text, (x0, y0, x1, y1))."""
    adb("shell", "uiautomator", "dump", "/sdcard/ui.xml", check=False)
    xml = adb("shell", "cat", "/sdcard/ui.xml", check=False)
    for n in re.findall(r"<node [^>]*?>", xml):
        def attr(k):
            m = re.search(k + r'="([^"]*)"', n)
            return html.unescape(m.group(1)) if m else ""
        b = list(map(int, re.findall(r"\d+", attr("bounds")))) or [0, 0, 0, 0]
        if t := attr(" text") or attr("content-desc"):
            yield t, tuple(b)


def clear_of_others(text: str, reach=0, beside=False):
    """A point on [text]'s target (up to [reach] px outside it) that no other target covers (a villager, a bubble
    bobbing over it), nearest its centre; its centre when nothing is clear. None when there is no such target.
    [beside]: off the target itself too (near it, on nothing)."""
    bs = list(boxes())
    me = next((b for t, b in bs if t == text), None) or next((b for t, b in bs if text in t), None)
    if me is None:
        return None
    x0, y0, x1, y1 = me
    cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
    others = [b for t, b in bs if (beside or b != me) and (b[2] - b[0]) * (b[3] - b[1]) < 400 * 400]  # not the whole village
    pad = 12  # a bubble bobs: keep off its edge
    def free(x, y):
        return all(not (b[0] - pad <= x <= b[2] + pad and b[1] - pad <= y <= b[3] + pad) for b in others)
    pts = [(x, y) for x in range(x0 - reach, x1 + reach + 1, 6) for y in range(y0 - reach, y1 + reach + 1, 6)
           if free(x, y)]
    return min(pts, key=lambda p: (p[0] - cx) ** 2 + (p[1] - cy) ** 2) if pts else (cx, cy)


def open_spot(text: str, reach: int, room=30, bs=None):
    """A point near [text]'s target (up to [reach] px outside it) clear of every target, the target itself included,
    by [room] px where it can be: a bubble bobs by ±8 px and takes a tap before the village sees it. Nearest the
    target's centre of those clear enough (not off by the palisade or the water, whose stakes and stones have no
    target of their own), else the most open. None when there is no such target. [bs]: the screen's [boxes], if at hand."""
    bs = list(boxes()) if bs is None else bs
    me = next((b for t, b in bs if t == text), None) or next((b for t, b in bs if text in t), None)
    if me is None:
        return None
    x0, y0, x1, y1 = me
    cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
    others = [b for t, b in bs if (b[2] - b[0]) * (b[3] - b[1]) < 400 * 400]  # not the whole village
    def clearance(x, y):  # to the nearest target's edge (0 on one)
        return min((max(b[0] - x, 0, x - b[2]) ** 2 + max(b[1] - y, 0, y - b[3]) ** 2) ** 0.5 for b in others)
    pts = [(x, y) for x in range(x0 - reach, x1 + reach + 1, 6) for y in range(y0 - reach, y1 + reach + 1, 6)]
    return max(pts, key=lambda p: (min(clearance(*p), room), -((p[0] - cx) ** 2 + (p[1] - cy) ** 2)))


def tap_clear(text: str, timeout=10.0) -> bool:
    """[tap], on a part of the target nothing else covers."""
    if wait_for(text, timeout) is None:
        return False
    c = clear_of_others(text)
    if c is None:
        return False
    adb("shell", "input", "tap", str(c[0]), str(c[1]))
    time.sleep(1.2)
    return True


def find(text: str):
    """Exact text first ("Allow" the button, not "Allow Lani to …" the title), then substring."""
    ns = list(nodes())
    return next((c for t, c in ns if t == text), None) or next((c for t, c in ns if text in t), None)


def slow() -> float:
    """How much longer to wait on a busy machine (many builds at once slow the emulator): 1 when idle, up to 3.
    QA_SLOW overrides it."""
    if os.environ.get("QA_SLOW"):
        return float(os.environ["QA_SLOW"])
    return min(3.0, 1.0 + max(0.0, os.getloadavg()[0] - 4.0) / 4.0)


def wait_for(text: str, timeout=15.0):
    end = time.time() + timeout * slow()
    while time.time() < end:
        if (c := find(text)) is not None:
            return c
        time.sleep(1)
    return None


def tap(text: str, timeout=10.0) -> bool:
    c = wait_for(text, timeout)
    if c is None:
        return False
    adb("shell", "input", "tap", str(c[0]), str(c[1]))
    time.sleep(1.2)
    return True


def type_text(s: str):
    adb("shell", "input", "text", s.replace(" ", "%s"))
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # hide the keyboard so bounds are stable
    time.sleep(0.6)


shots: list[Path] = []


def shot(name: str):
    path = OUT / f"{len(shots) + 1:02d}-{name}.png"
    with open(path, "wb") as f:
        f.write(subprocess.run(["adb", *(("-s", SERIAL) if SERIAL else ()), "exec-out", "screencap", "-p"], capture_output=True).stdout)
    shots.append(path)


def step(name: str, fn, cleanup=None, keep=False):
    """Runs a flow and screenshots where it ended. [cleanup] then tidies up (e.g. back to the plain village), so one
    failure doesn't cascade; with [keep] only after a failure: the next step goes on from where this one left off."""
    failed = False
    try:
        outcome = fn()
        results.append((name, "ok" if outcome in (None, True) else f"skipped: {outcome}"))
    except Exception as e:  # keep going: one broken flow shouldn't hide the others
        failed = True
        results.append((name, f"FAILED: {e}"))
    shot(name)
    if cleanup is not None and (failed or not keep):
        try:
            cleanup()
        except Exception as e:
            print(f"    cleanup after {name} failed: {e}")


# --- flows ----------------------------------------------------------------------------------

def setup():
    if wait_for("Poveži", 12) is None:
        return "already connected"
    for _ in range(3):  # a busy emulator's keyboard can come up only after the text went nowhere: type it again
        c = find("http") or find("Bridge URL")  # the field itself: a tap on its label puts the cursor inside the text
        assert c is not None, "the URL field"
        adb("shell", "input", "tap", str(c[0]), str(c[1]))
        time.sleep(1.5 * slow())
        # empty it wherever the cursor is, then the URL; it must be all the field has
        adb("shell", "input", "keyevent", *["KEYCODE_DEL"] * 40 + ["KEYCODE_FORWARD_DEL"] * 40)
        adb("shell", "input", "text", BRIDGE_URL)
        time.sleep(slow())
        if any(t == BRIDGE_URL for t, _ in nodes()):
            break
    else:
        raise AssertionError("the URL field took no text")
    tap("Token")
    time.sleep(slow())
    type_text(TOKEN)
    assert tap("Poveži"), "connect button"
    end = time.time() + 30
    while time.time() < end:  # Home, and the notification permission whenever it comes
        ns = list(nodes())
        c = next((c for t, c in ns if t == "Allow"), None)
        if c is not None:
            adb("shell", "input", "tap", str(c[0]), str(c[1]))
        elif any("Danes · Today" in t for t, _ in ns):
            break
        time.sleep(1)
    assert wait_for("Danes · Today", 5), "home did not load"


def scroll_to(text: str, swipes=5, exact=False):
    """Scrolls down until [text] is on screen clear of the header and the tutor bar; its centre, or None. [exact]: only a
    label that is exactly [text] (Home's "Pogovor" tile, not a row that says "Pogovori se")."""
    for _ in range(swipes + 1):
        c = next((c for t, c in nodes() if t == text), None) if exact else find(text)
        if c is not None and 300 < c[1] < 1850:
            return c
        adb("shell", "input", "swipe", "540", "1600", "540", "1000", "400")
        time.sleep(1)
    return None


def tap_at(c):
    adb("shell", "input", "tap", str(c[0]), str(c[1]))
    time.sleep(1.2)


def qa_hook(command: str, link=None):
    """Asks the debug build [command] (app/QaHooks.kt): "zoom" zooms the camera on screen in, as its "Približaj · Zoom
    in" action does; "happening:<scene>/<happening>" counts that happening as on ("happening:" lets it go); for recordings,
    "bubbles:<n>" shows only the n bubbles nearest the fire and "clock:<f>" slows the towns' time ("bubbles:", "clock:"
    undo them). Then opens
    [link] ("scene:<id>@<focus>"), if given. One intent to the running app (singleTop: nothing else changes)."""
    adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity", "--es", QA_HOOK, command, *(("--es", OPEN, link) if link else ()))
    time.sleep(1.5)


def double_tap_zoom(x: int, y: int, tries=2) -> str:
    """Zooms in by a double tap at ([x], [y]) (both taps in one shell call, so they land within the double-tap window),
    up to [tries] times; when a busy machine sends them too far apart, by QA's zoom hook instead (the camera's own
    "Približaj · Zoom in"). How it zoomed ("double tap", "zoom hook"), or "" when neither did (the Recenter button
    shows once the camera moved)."""
    for _ in range(tries):
        adb("shell", f"input tap {x} {y} && input tap {x} {y}")
        time.sleep(2.5)  # the flight settles, the closer look renders and fades in
        if wait_for("Na sredino · Recenter", 3):
            return "double tap"
        if find("Na sredino · Recenter") is None and any(t in OVER_VILLAGE for t, _ in nodes()):
            adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the first tap alone opened something: close it
            time.sleep(1)
    qa_hook("zoom")
    time.sleep(1)
    return "zoom hook" if wait_for("Na sredino · Recenter", 5) else ""


def to_top():
    for _ in range(4):
        adb("shell", "input", "swipe", "540", "700", "540", "1900", "200")
    time.sleep(1)


def home():
    """Home: the village header, "Danes · Today" with one thing to do, the villagers, the learning tiles."""
    assert wait_for("Danes · Today", 10), "today card"
    assert find("Moja vas"), "the header's way into the village"
    assert find("Igraj · Play") or find("Ponovi · Review") or find("Uči se · Learn") or find("Govori · Talk") or find("Odgovori · Answer"), "today's one action"
    assert scroll_to("Učenje · Learning"), "learning section"
    shot("home-learning")
    for tile in ("Nove besede", "Izzivi", "Pogovor", "Družina"):
        assert scroll_to(tile, 2), f"{tile} tile"
    assert scroll_to("Napredek · Progress", 3), "progress line"
    to_top()


def challenges():
    """The Izzivi tile opens the tutor's modules in a sheet; back closes it."""
    go_home()
    tile = scroll_to("Izzivi")
    assert tile, "challenges tile"
    tap_at(tile)
    assert wait_for("✨ Izzivi · Challenges", 6), "challenges sheet"
    time.sleep(1)
    shot("challenges-sheet")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    time.sleep(1)
    assert find("✨ Izzivi · Challenges") is None, "sheet still open"
    to_top()


def village():
    to_top()
    assert tap("Moja vas"), "open village"
    # The first-time intro, and the news of who moved in while the app was closed, may come in any order.
    end, calm = time.time() + 25, 0
    while time.time() < end and calm < 3:  # the village three times in a row, with nothing over it
        ns = list(nodes())
        c = next((c for t, c in ns if t.startswith("Preskoči") or t == "Naprej · Continue"), None)
        if c is not None:
            adb("shell", "input", "tap", str(c[0]), str(c[1]))
            calm = 0
            time.sleep(1.5)  # a fading intro still lists its Skip: a second tap would land on the HUD under it
        elif any(t in ("Zvitek · Scroll", "Knjiga · Book") for t, _ in ns):
            calm += 1
        elif any("Nabiraj · Gather" in t for t, _ in ns):  # a resource chip's sheet opened after all ("📜 Nabiraj · Gather"): close it
            adb("shell", "input", "keyevent", "KEYCODE_BACK")
            calm = 0
        time.sleep(1)
    assert wait_for("Zvitek · Scroll", 5) or wait_for("Knjiga · Book", 3), "village screen"
    if (h := arg("--happening")) is not None:
        qa_hook(f"happening:{h}")  # its person comes to its place (see the usage)
    time.sleep(1.5)  # let the camera settle on the village


VILLAGE_HUD = ("Zvitek · Scroll", "Knjiga · Book")  # the bottom bar's first button: hidden under a sheet or the scroll
OVER_VILLAGE = ("Zapri · Close", "Close sheet")  # a card's ✕ or the scroll's, a bottom sheet's scrim
MOVE_ON = ("Naprej · Continue", "V vas · To the village")  # news over the village, a run's result


def plain_village():
    """Back to the plain village, camera at home, whatever a step left open: a card, a sheet, the scroll, a screen
    in front of it; into the village again when Back went on to Home."""
    for _ in range(8):
        ns = list(nodes())
        labels = [t for t, _ in ns]
        if any(t in VILLAGE_HUD for t in labels) and not any(t in OVER_VILLAGE for t in labels):
            if (c := next((c for t, c in ns if t == "Na sredino · Recenter"), None)) is not None:
                tap_at(c)
                time.sleep(1.5)
            return
        if any("Danes · Today" in t for t in labels):
            village()
            continue
        if not in_front():  # Back left the app
            adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
            time.sleep(3)
            continue
        c = next((c for t, c in ns if t in MOVE_ON or t.startswith("Preskoči")), None)
        if c is not None:
            tap_at(c)
        else:
            adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.5)
    raise AssertionError("could not get back to the plain village")


def scroll():
    """The scroll (the book from Vas on): the community overview, and a jump to the next goal."""
    assert tap("Zvitek · Scroll", 3) or tap("Knjiga · Book", 3), "scroll button"
    assert wait_for("Danes v vasi", 8), "today section"
    time.sleep(1)
    shot("scroll-today")
    assert tap("Naslednji cilj · Next goal", 5), "goal index"
    assert wait_for("Naslednji cilj", 5), "next goal section"
    time.sleep(1)
    shot("scroll-goal")
    assert tap("Kraji · Places", 5), "places index"
    assert wait_for("Ogenj · The fire", 5), "places section"
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # rolls the scroll up
    time.sleep(1.5)
    assert wait_for("Zvitek · Scroll", 5) or wait_for("Knjiga · Book", 3), "back to the village"


def villagers():
    """The register (the scroll's people section links to it), a villager's card and page, their greeting."""
    assert tap("Zvitek · Scroll", 3) or tap("Knjiga · Book", 3), "scroll button"
    assert tap("Prebivalci · Villagers", 5), "people index"
    assert tap("Vsi prebivalci", 5), "link to the register"
    assert wait_for("Prebivalci · Villagers", 8), "register"
    time.sleep(1)
    shot("villagers-register")
    talk = next((c for t, c in nodes() if t.startswith("Pogovori se · Talk: ")), None)
    if talk is None:
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        return "no villagers on this node"
    adb("shell", "input", "tap", str(talk[0]), str(talk[1]))
    assert wait_for("Več · More", 5), "villager card"
    shot("villager-card")
    assert tap("Več · More", 3), "more"
    assert wait_for("‹ Prebivalci · Villagers", 8), "villager page"
    assert tap("💬 Pogovori se · Talk", 5), "talk"
    assert wait_for("Pogovor s tutorjem", 12), "greeting, then the free talk"
    time.sleep(1)
    shot("villager-page")
    # A word of their greeting opens its card (always here, unlike a scene's dialog, which depends on the hour),
    # and "Add to my words" goes through the outbox to the dev bridge's copy of the data.
    bs = list(boxes())
    listen = min((b for t, b in bs if t == "Poslušaj · Listen"), key=lambda b: b[1], default=None)
    assert listen is not None, "the greeting's 🔊"
    cy = (listen[1] + listen[3]) // 2
    line = next((b for t, b in bs if " · " in t and b[2] <= listen[0] + 4 and b[1] <= cy <= b[3]), None)
    assert line is not None, "the greeting's line"
    # Its second word: greetings often open with a name (Jan!), and a name has no "Add to my words".
    tap_at((line[0] + int((line[2] - line[0]) * 0.33), line[1] + 24))
    assert word_card(), "the word's card"
    shot("villager-word-card")
    if tap("Dodaj med moje besede", 2):
        assert wait_for("Dodano", 10), "the word added to Jan's words"
        shot("villager-word-added")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the card
    time.sleep(1.2)
    assert not any(w in t for t, _ in nodes() for w in WORD_CARD), "the card is still open"
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the page → the register
    time.sleep(1)
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the register → the village
    assert wait_for("Zvitek · Scroll", 10) or wait_for("Knjiga · Book", 3), "back in the village"


def place_card():
    """Tapping the fire in the village (its screen-reader target shows where it is) opens its card."""
    # the camera flies to the fire before its card comes up, and right after the village opens a busy emulator can let
    # the first tap go: tap again when nothing came
    # At night the fire is crowded (the hut, Stari Janez and his story's bubble over it): after a tap that opened
    # nothing, zoom in on the fire (a bigger target), and tap again.
    for attempt in range(3):
        if find("Ogenj · The fire") is None:
            plain_village()
        assert tap_clear("Ogenj · The fire", 5), "the fire in the village"
        if wait_for("Nahrani ogenj", 10):
            break
        if find("Nahrani ogenj") is None and attempt == 0 and (c := find("Ogenj · The fire")) is not None:
            double_tap_zoom(c[0], c[1])
    else:
        raise AssertionError("the fire's place card")
    time.sleep(1)


def scene():
    """The fire's card leads into its scene (the close-up), and back to the village."""
    if find("Vstopi · Go in") is None:
        return "no scene opens at the fire (no scenes on this node)"
    assert tap("Vstopi · Go in", 3), "go in"
    assert wait_for("‹ Vas · Village", 10), "scene screen"
    time.sleep(2)
    shot("scene-open")
    time.sleep(2)  # the debug build logs the scene's frame time every 24 frames
    # a double tap on the picture zooms in, and closer up the scene is drawn finer (it fades in)
    pic = next((b for t, b in boxes() if t.startswith("Prizor · Scene")), None)
    assert pic is not None, "the scene's picture"
    # a corner of the picture, where nothing is to tap: if the two taps come too far apart (a busy machine), the
    # single tap lands on nothing and the next try goes again; after two, the camera's own zoom (QA's hook)
    x, y = pic[0] + 70, pic[3] - 70
    how = double_tap_zoom(x, y)
    assert how, "recenter button after zooming into the scene (a double tap twice, then the zoom hook)"
    if how != "double tap":
        print(f"    zoomed by the {how}: the double taps came too far apart")
    shot("scene-closer")
    time.sleep(2)  # the debug build logs the closer look's frame time every 24 frames
    for line in adb("logcat", "-d", "-s", "SceneView:D", check=False).splitlines()[-4:]:
        print("   ", line.split("SceneView: ")[-1])
    assert tap("Na sredino · Recenter", 3), "recenter in the scene"
    time.sleep(1.5)
    assert tap("‹ Vas · Village", 3), "back from the scene"
    assert wait_for("Zvitek · Scroll", 10) or wait_for("Knjiga · Book", 3), "back in the village"


WORD_CARD = ("Vprašaj učitelja", "Dodaj med moje besede", "Med tvojimi besedami", "Poskusi znova", "Iščem")


def word_card(timeout=10.0):
    """The word card (its meanings with "Add to my words", or asking the tutor, or offline), or None."""
    end = time.time() + timeout
    while time.time() < end:
        labels = [t for t, _ in nodes()]
        if any(w in t for t in labels for w in WORD_CARD):
            return True
        time.sleep(1)
    return None


def dialog_happenings() -> list:
    """The happenings with a dialog of the scenes the dev bridge serves, as (scene, happening), the fire's first; the
    repo's scenes when the bridge can't be asked. A storyteller's evening (its story is tonight's) is left out."""
    try:
        scenes = api("/scenes")
    except (OSError, RuntimeError, ValueError):
        scenes = [json.loads(p.read_text()) for p in sorted((ROOT / "companion/scenes").glob("*.json"))]
    out = [(s["id"], h["id"]) for s in scenes if isinstance(s, dict) for h in s.get("happenings", [])
           if h.get("dialog") and not h.get("stories") and not h.get("guests")]
    return sorted(out, key=lambda k: k[0] != "ob-ognju")


def open_dialog() -> str:
    """Opens a scene's dialog: "" once it shows, else why not. First a happening QA counts as on (the debug build's hook,
    on the dev bridge's copy of the data), opened through its deep link: its dialog comes up whatever the hour, the day's
    dice or who has been met. Without the hook (a build from before it): as before, someone "Here today" with a dialog
    at the fire, else in the other scenes through their links."""
    for sid, hid in dialog_happenings()[:3]:
        qa_hook(f"happening:{sid}/{hid}", f"scene:{sid}@{sid}/{hid}")
        if wait_for("‹ Vas · Village", 8) is None:
            continue  # that scene didn't open (not built yet): the next
        if wait_for("Zapri · Close", 6):
            print(f"    the dialog of {sid}/{hid} (counted as on by QA's hook)")
            # let it go now: the dialog plays on, and the village comes back without its bubble
            qa_hook("happening:")
            return ""
        print("    the scene opened without its dialog: no QA hook in this build")
        break
    # no hook: the fire's card (a happening's bubble over the fire goes straight into the scene), and in
    if find("‹ Vas · Village") is None:
        plain_village()
        assert tap_clear("Ogenj · The fire", 5), "the fire in the village"
        if find("‹ Vas · Village") is None:
            if wait_for("Vstopi · Go in", 8) is None:
                if find("‹ Vas · Village") is None:
                    plain_village()
                    return "the fire's card didn't open (a tap beside it?), and no QA hook in this build"
            else:
                assert tap("Vstopi · Go in", 3), "go in"
    assert wait_for("‹ Vas · Village", 10), "scene screen"
    talk = scroll_to("💬 Pogovori se · Talk", 4)  # "Here today": someone with a dialog
    if talk is None:
        # Who is in a scene depends on the hour and who lives here: try the other scenes through their links.
        for sid in sorted({s for s, _ in dialog_happenings()} - {"ob-ognju"}):
            adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity", "--es", OPEN, f"scene:{sid}")
            if wait_for("‹ Vas · Village", 8) and (talk := scroll_to("💬 Pogovori se · Talk", 3)) is not None:
                break
    if talk is None:
        tap("‹ Vas · Village", 3)
        return "nobody in any scene has something to say now, and no QA hook in this build"
    tap_at(talk)
    assert wait_for("Zapri · Close", 8), "the dialog"
    return ""


def story_in_scene():
    """The storyteller's evening story opens from inside the fire's scene too, not only through the village's bubble
    (Stari Janez's had no dialog, so the scene offered nothing): with his evening on (QA's hook), the scene opened without
    a focus has "📖 Poslušaj · Listen" by him under "Here today", which opens the story, and so does his marker over the
    picture."""
    try:
        qa_hook("happening:ob-ognju/zgodba", "scene:ob-ognju")
        if wait_for("‹ Vas · Village", 10) is None:
            return "the fire's scene didn't open (no scenes on this node)"
        # the list's last row: it can't scroll clear of the bottom edge, so where it is will do
        listen = scroll_to("📖 Poslušaj · Listen", 4) or find("📖 Poslušaj · Listen")
        if listen is None and find("Stari Janez") is None:
            return "Stari Janez isn't by the fire (no storyteller in this village)"
        assert listen is not None, "📖 Poslušaj · Listen by Stari Janez in the fire's scene"
        tap_at(listen)
        assert wait_for("Zapri · Close", 8), "the story from the scene's list"
        shot("story-from-list")
        assert tap("Zapri · Close", 3), "close the story"
        time.sleep(1.5)
        # his marker over the picture ("Stari Janez: <tonight's story>. Pogovori se · Talk")
        marker = next((c for t, c in nodes() if t.startswith("Stari Janez:")), None)
        assert marker is not None, "Stari Janez's marker over the fire's scene"
        tap_at(marker)
        assert wait_for("Zapri · Close", 8), "the story from his marker"
        shot("story-from-marker")
        tap("Zapri · Close", 3)
        time.sleep(1)
    finally:
        qa_hook("happening:")
    return None


def ispy_positions(timeout=10.0):
    """The latest round QA's I spy logged (app/ISpyController.log, a debug build): (round, target, {slot: (x, y)}, word), the
    things' centres on the screen and the word of the thing spied; None when none came."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        lines = [l for l in adb("logcat", "-d", "-s", "ISpy:D", check=False).splitlines() if " round " in l]
        if lines:
            m = re.search(r"round (\d+) target (\S+) things (.*?) word (.*)$", lines[-1])
            if m:
                at = {}
                for part in m.group(3).split():
                    slot, _, xy = part.partition("@")
                    x, _, y = xy.partition(",")
                    if x.lstrip("-").isdigit() and y.lstrip("-").isdigit():
                        at[slot] = (int(x), int(y))
                return int(m.group(1)), m.group(2), at, m.group(4).strip()
        time.sleep(1)
    return None


def ispy():
    """«Vidim, vidim» (companion/SCENES.md, "I spy") by the fire: QA's hook ("ispy:ob-ognju/stump") offers it whatever the
    day, with a child who comes by, its first round spying the stump. "🔍 Igrajva · Let's play" starts it; the round's first
    clue shows; a wrong thing tapped in the picture (the woodpile) is the learner's guess, marked wrong, with the child's
    kind reaction and the next clue; the stump tapped is found ("Ja, to je štor!"); then each round's thing (the debug
    build logs where it is on the screen) to the end card."""
    try:
        adb("logcat", "-c")
        qa_hook("ispy:ob-ognju/stump", "scene:ob-ognju")
        if wait_for("‹ Vas · Village", 10) is None:
            return "the fire's scene didn't open (no scenes on this node)"
        # the child who offers it has a 🔍 over them in the picture ("<name>: Vidim, vidim · I spy. Igrajva · Let's play"),
        # once the village's people are loaded; the panel's card says it too
        marker = wait_for("Vidim, vidim · I spy. Igrajva", 20)
        card = scroll_to("🔍 Igrajva · Let's play", 5)
        assert marker is not None or card is not None, "the offer «Vidim, vidim»: the 🔍 over the child, the card on the panel"
        shot("ispy-offer")
        tap_at(card if card is not None else marker)
        assert wait_for("Vidim, vidim nekaj", 8), "the child's opening line"
        assert wait_for("Poišči v prizoru · Find it in the scene", 5), "the round: find it in the picture"
        got = ispy_positions()
        assert got is not None, "the debug build's ISpy log of where the things are"
        rnd, target, at, _ = got
        assert target == "stump" and "stump" in at, f"the first round spies the stump (QA's hook): {target}, {sorted(at)}"
        wrong = "logs" if "logs" in at else next(s for s in at if s != target)
        tap_at(at[wrong])
        time.sleep(1.5)
        reacted = any(r in t for t, _ in nodes() for r in ("Ne, to ni to", "Mrzlo", "Toplo", "Hi hi, ne", "Še en namig", "Skoraj"))
        assert reacted, f"the child's reaction to a wrong guess ({wrong})"
        shot("ispy-wrong")
        tap_at(at[target])
        assert wait_for("Ja, to je štor", 6), "the child's cheer: the stump found"
        shot("ispy-found")
        # the other rounds: the thing's word among the things listed ("✋ Izberi raje · Let me choose", as TalkBack has them),
        # then on to the end (a thing's area can lie under another's, the stars' under the smoke: its centre is no sure tap)
        for _ in range(4):
            if not tap("Naprej", 3):
                break
            time.sleep(1.5)
            got = ispy_positions(5)
            if got is None or got[0] == rnd:
                break
            rnd, target, at, word = got
            assert tap("Izberi raje", 3), "✋ Izberi raje · Let me choose: the things as chips"
            time.sleep(1)
            chip = next((c for t, c in nodes() if t == word), None)
            assert chip is not None, f"the chip of «{word}»"
            tap_at(chip)
            time.sleep(1.5)
            assert find(f"{word}! Bravo") is not None, f"the child's cheer for «{word}»"
        if find("Konec") is not None:
            tap("Konec", 3)
        assert wait_for("Hvala za igro! · Thanks for the game!", 8), "the end card"
        shot("ispy-end")
        assert tap("Nazaj v prizor · Back to the scene", 4), "back to the scene"
        time.sleep(1)
        assert tap("‹ Vas · Village", 3), "back from the scene"
    finally:
        qa_hook("ispy:")
    return None


def counting():
    """A counting dialog (companion/SCENES.md, "Numbers": Luka counts his cows on the pasture) opens with its number in
    words and no placeholder left. Through QA's hook, the happenings that have one; whichever of their variants plays
    today, none may crash the app (a pattern Android's regex engine rejects once did, and the JVM's unit tests passed)."""
    try:
        scenes = api("/scenes?arts=2")
    except (OSError, RuntimeError, ValueError) as e:
        return f"the dev bridge's scenes: {e}"
    counted = {(s["id"], d["id"]) for s in scenes if isinstance(s, dict) for d in s.get("dialogs", []) if d.get("count")}
    hs = [(s["id"], h["id"]) for s in scenes if isinstance(s, dict) for h in s.get("happenings", [])
          if not h.get("guests") and any((s["id"], d) in counted for d in h.get("dialogs", []))]
    # first those whose first variant counts: the first not heard yet is the one that plays
    first = {(s["id"], h["id"]) for s in scenes if isinstance(s, dict) for h in s.get("happenings", [])
             if h.get("dialogs") and (s["id"], h["dialogs"][0]) in counted}
    hs.sort(key=lambda k: k not in first)
    if not hs:
        return "no happening with a counting dialog"
    shown = []
    try:
        for sid, hid in hs[:3]:
            qa_hook(f"happening:{sid}/{hid}", f"scene:{sid}@{sid}/{hid}")
            opened = wait_for("‹ Vas · Village", 8) is not None and wait_for("Zapri · Close", 6) is not None
            assert adb("shell", "pidof", PKG, check=False).strip(), f"the app crashed opening {sid}/{hid}"
            if opened:
                texts = [t for t, _ in nodes()]
                left = [t for t in texts if re.search(r"\{[^}]*\}", t)]
                assert not left, f"{sid}/{hid}: a placeholder left: {left[:2]}"
                shown.append(f"{sid}/{hid}")
            plain_village()
    finally:
        qa_hook("happening:")
    print(f"    dialogs opened: {', '.join(shown) or 'none'} (their variant today may or may not count)")
    return None if shown else "no counting happening's dialog opened"


def dialog_words():
    """In a scene's dialog, a tap on a word of the person's line opens the word's card; back closes just the card.
    A long press on a word of an answer opens its card too, and doesn't pick the answer."""
    try:
        return words_in_dialog()
    finally:
        qa_hook("happening:")  # whatever happened: the next steps see the village as it is


def words_in_dialog():
    """[dialog_words], once QA's happening is counted as on."""
    if why := open_dialog():
        return why
    time.sleep(3)  # the first line types in (only typed words can be tapped)
    if find("Tapni besedo") is None:
        print("    (no word hint: seen before?)")
    shot("dialog-open")
    # The person's line is left of its 🔊, the topmost one in the dialog; its screen-reader label is "<Slovene> · <English>".
    bs = list(boxes())
    listen = min((b for t, b in bs if t == "Poslušaj · Listen"), key=lambda b: b[1], default=None)
    assert listen is not None, "the person's line (its 🔊)"
    cy = (listen[1] + listen[3]) // 2
    line = next((b for t, b in bs if " · " in t and b[2] <= listen[0] + 4 and b[1] <= cy <= b[3]), None)
    assert line is not None, "the person's line"
    tap_at((line[0] + 24, line[1] + 24))  # the line's first word
    assert word_card(), "the word's card"
    shot("dialog-word-card")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the card
    time.sleep(1.2)
    assert not any(w in t for t, _ in nodes() for w in WORD_CARD), "the card is still open"
    assert find("Zapri · Close"), "back closed the dialog too"
    # On to the learner's turn, then a long press on the first answer's first word.
    for _ in range(4):
        if find("Tvoj odgovor") or not tap("Naprej · Next", 2):
            break
    label = next((b for t, b in boxes() if t.startswith("Tvoj odgovor")), None)
    if label is not None:
        row = min((b for t, b in boxes() if b[1] > label[3] and b[2] - b[0] > 400), key=lambda b: b[1], default=None)
        assert row is not None, "an answer"
        x, y = row[0] + 50, row[1] + 45  # past the row's padding, on its first word
        adb("shell", "input", "swipe", str(x), str(y), str(x), str(y), "900")  # a long press
        assert word_card(), "the card of an answer's word"
        shot("dialog-answer-word")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.2)
        assert find("Tvoj odgovor"), "the long press picked the answer"
    assert tap("Zapri · Close", 3), "close the dialog"
    assert tap("‹ Vas · Village", 5), "back from the scene"
    assert wait_for("Zvitek · Scroll", 10) or wait_for("Knjiga · Book", 3), "back in the village"


YOUR_WORDS = "Tvoje besede · Your words"  # a dialog's end, the learner's words it tested (dialogWords.yours)
QA_WORD = re.compile(r"[^\W_]+(?:['’][^\W_]+)*")


def _lcs(a: list, b: list) -> set:
    """The positions in [a] of a longest common subsequence of [a] and [b] (game/DialogWords.kt's alignment)."""
    n = [[0] * (len(b) + 1) for _ in range(len(a) + 1)]
    for i in range(len(a) - 1, -1, -1):
        for j in range(len(b) - 1, -1, -1):
            n[i][j] = n[i + 1][j + 1] + 1 if a[i] == b[j] else max(n[i + 1][j], n[i][j + 1])
    out, i, j = set(), 0, 0
    while i < len(a) and j < len(b):
        if a[i] == b[j]:
            out.add(i)
            i, j = i + 1, j + 1
        elif n[i + 1][j] >= n[i][j + 1]:
            i += 1
        else:
            j += 1
    return out


def tested_words(right: str, wrong: str) -> list:
    """The words of [right] a wrong choice [wrong] tests (companion/SCENES.md, "Your words in the dialogs"): where they
    differ, one or two words, the rest shared (a one-word answer always)."""
    r = [w.lower() for w in QA_WORD.findall(right)]
    w = [x.lower() for x in QA_WORD.findall(wrong)]
    off = [i for i in range(len(r)) if i not in _lcs(r, w)]
    if not off or len(off) > 2 or (len(r) > 1 and len(r) - len(off) < len(off)):
        return []
    return [r[i] for i in off]


def dialogs_with_words() -> list:
    """The happenings whose dialogs test one of the dev deck's words as written (no form needed to find it), as
    (scene, happening, the words), those whose every dialog does first."""
    try:
        scenes, cards = api("/scenes?arts=2"), set(deck_lemmas())
    except (OSError, RuntimeError, ValueError) as e:
        print(f"    the dev bridge's scenes or deck: {e}")
        return []
    out = []
    for s in scenes:
        if not isinstance(s, dict):
            continue
        dialogs = {d["id"]: d for d in s.get("dialogs", [])}
        for h in s.get("happenings", []):
            if h.get("stories") or h.get("guests"):
                continue
            each = []
            for did in h.get("dialogs") or ([h["dialog"]] if h.get("dialog") else []):
                found = set()
                for line in dialogs.get(did, {}).get("lines", []):
                    ch = [c for c in line.get("choices", []) if not c.get("tap")]
                    for r in (c for c in ch if c.get("ok")):
                        for w in (c for c in ch if not c.get("ok")):
                            found |= {x for x in tested_words(r.get("sl", ""), w.get("sl", "")) if x in cards}
                each.append(found)
            if any(each):
                out.append((s["id"], h["id"], sorted(set().union(*each)), all(each)))
    out.sort(key=lambda k: (not k[3], k[0] != "ob-ognju"))
    return [(sid, hid, words) for sid, hid, words, _ in out]


def your_words():
    """A dialog whose turns test the learner's own words (the dev bridge's copy of the deck), answered right all through:
    its end lists them ("📇 Tvoje besede · Your words: kruh ✓"; companion/SCENES.md "Your words in the dialogs"), and the
    review it sent reaches the dev bridge. Its turns are answered by the right choice the scene has (a typed, said or tap
    turn by "✋ Izberi raje · Let me choose" first)."""
    try:
        return words_answered()
    finally:
        qa_hook("happening:")


def answer_right(ok_texts: set) -> bool:
    """At the learner's turn: picks the right choice on screen (one of [ok_texts]); False when none is there."""
    ns = list(nodes())
    labels = [t for t, _ in ns]
    if any("Izberi raje" in t for t in labels):
        tap("Izberi raje", 2)
        ns = list(nodes())
    if any("Poslušaj in ponovi" in t for t in labels):
        return tap("Naprej · Next", 2)
    # a choice's row reads its Slovene, then its translation ("Daj mi žlico, prosim., A spoon, please."): the exact text
    # first, then a row that begins with it
    c = next((c for t, c in ns if t in ok_texts), None) or next(
        (c for t, c in ns for ok in sorted(ok_texts, key=len, reverse=True) if t.startswith(ok + ",") or t.startswith(ok + " ")), None)
    if c is None:
        return False
    tap_at(c)
    return True


def words_answered():
    """[your_words], QA's happening counted as on."""
    tried = dialogs_with_words()
    if not tried:
        return "no happening's dialog tests a word of the dev deck"
    try:
        scenes = {s["id"]: s for s in api("/scenes?arts=2") if isinstance(s, dict)}
    except (OSError, RuntimeError, ValueError) as e:
        return f"the dev bridge's scenes: {e}"
    for sid, hid, words in tried[:4]:
        ok = {c["sl"] for d in scenes[sid].get("dialogs", []) for l in d.get("lines", []) for c in l.get("choices", []) if c.get("ok")}
        qa_hook(f"happening:{sid}/{hid}", f"scene:{sid}@{sid}/{hid}")
        if wait_for("‹ Vas · Village", 8) is None or wait_for("Zapri · Close", 6) is None:
            plain_village()
            continue
        print(f"    {sid}/{hid}: its dialogs test {', '.join(words)}")
        for _ in range(16):
            labels = [t for t, _ in nodes()]
            if any(YOUR_WORDS in t for t in labels) or any("Nazaj v prizor" in t for t in labels):
                break  # the end
            if any(t.startswith("Tvoj odgovor") or "Izberi raje" in t or "Poslušaj in ponovi" in t for t in labels):
                assert answer_right(ok), f"{sid}/{hid}: the right choice on screen"
                continue
            if not tap("Naprej · Next", 3):
                time.sleep(1)
        if scroll_to(YOUR_WORDS, 3) is not None or wait_for(YOUR_WORDS, 3):
            shot("your-words")
            marks = [t for t, _ in nodes() if "✓" in t or "prav · right" in t]
            assert marks, "a word of the learner's marked right"
            print(f"    the end lists: {', '.join(marks[:4])}")
            tap("Nazaj v prizor", 3)
            plain_village()
            return None
        print(f"    {sid}/{hid}: its end lists no word of the learner's (the variant played today tests none)")
        plain_village()
    raise AssertionError(f"no dialog's end listed the learner's words ({', '.join(f'{s}/{h}' for s, h, _ in tried[:4])} tried)")


YOUR_WORD = "Tvoja beseda · Your word"  # a word got wrong, its card after the turn (dialogWords.yourWord)


def word_missed():
    """A word of the learner's got wrong in a dialog: the first pick at a turn that tests it is a wrong choice that
    differs from the right one in that word; once the turn is passed, its card shows in the conversation ("📇 Tvoja beseda ·
    Your word: … — …"), the dialog goes on, and its end marks the word ✗."""
    try:
        return missed_in_dialog()
    finally:
        qa_hook("happening:")


def missed_in_dialog():
    """[word_missed], QA's happening counted as on."""
    tried = dialogs_with_words()
    if not tried:
        return "no happening's dialog tests a word of the dev deck"
    try:
        scenes = {s["id"]: s for s in api("/scenes?arts=2") if isinstance(s, dict)}
        cards = set(deck_lemmas())
    except (OSError, RuntimeError, ValueError) as e:
        return f"the dev bridge's scenes: {e}"
    for sid, hid, words in tried[:4]:
        turns = [l.get("choices", []) for d in scenes[sid].get("dialogs", []) for l in d.get("lines", []) if len(l.get("choices", [])) >= 2]
        ok = {c["sl"] for ch in turns for c in ch if c.get("ok")}
        # each right choice → a wrong choice of its turn that tests one of the learner's words in it
        traps = {}
        for ch in turns:
            for r in (c for c in ch if c.get("ok") and not c.get("tap")):
                for w in (c for c in ch if not c.get("ok")):
                    if any(x in cards for x in tested_words(r["sl"], w.get("sl", ""))):
                        traps.setdefault(r["sl"], w["sl"])
        qa_hook(f"happening:{sid}/{hid}", f"scene:{sid}@{sid}/{hid}")
        if wait_for("‹ Vas · Village", 8) is None or wait_for("Zapri · Close", 6) is None:
            plain_village()
            continue
        missed, seen = None, False
        for _ in range(18):
            labels = [t for t, _ in nodes()]
            if any(YOUR_WORD in t for t in labels) and missed and not seen:
                seen = True
                shot("word-missed-card")
            if any(YOUR_WORDS in t for t in labels) or any("Nazaj v prizor" in t for t in labels):
                break
            if any(t.startswith("Tvoj odgovor") or "Izberi raje" in t for t in labels):
                if any("Izberi raje" in t for t in labels):
                    tap("Izberi raje", 2)
                    labels = [t for t, _ in nodes()]
                here = next((r for r in traps if any(t == r or t.startswith(r + ",") or t.startswith(r + " ") for t in labels)), None)
                wrong = traps.get(here) if here and not missed else None
                c = next((c for t, c in nodes() if wrong and (t == wrong or t.startswith(wrong + ",") or t.startswith(wrong + " "))), None)
                if c is not None:
                    tap_at(c)  # the wrong one first: the person reacts, the learner picks again
                    missed = wrong
                    print(f"    picked «{wrong}» first")
                assert answer_right(ok), f"{sid}/{hid}: the right choice on screen"
                continue
            if any("Poslušaj in ponovi" in t for t in labels):
                tap("Naprej · Next", 2)
                continue
            if not tap("Naprej · Next", 3):
                time.sleep(1)
        if missed is None:
            print(f"    {sid}/{hid}: no turn played tested a word of the learner's")
            plain_village()
            continue
        if not seen:
            seen = scroll_to(YOUR_WORD, 2) is not None
        assert seen, f"{sid}/{hid}: the word's card after the turn got wrong"
        if scroll_to(YOUR_WORDS, 3) is not None or wait_for(YOUR_WORDS, 3):
            shot("word-missed-end")
            assert any("✗" in t for t, _ in nodes()), "the word marked wrong at the end"
        tap("Nazaj v prizor", 3)
        plain_village()
        return None
    return "no dialog played a turn that tests the learner's words"


TYPED_TURN = "Napiši manjkajočo besedo"  # a dialog's typed turn's title (adaptive.typeMissingWord)
ANSWER_FIELD = "Napiši odgovor"  # the answer field's placeholder (playerScreen.typeAnswer)
CHECK = "Preveri · Check"
TARGET = "sl"  # the language the dev data's learner learns: an answer's (QA's labels are Slovene too)
GBOARD = "com.google.android.inputmethod.latin"
NO_DECODING = f"{GBOARD}.noDecoding"  # app/ui/AnswerKeyboard.kt, GBOARD_NO_DECODING


def answer_keyboard(lang=TARGET) -> str:
    """What the focused answer field asks of the keyboard and what the keyboard does with it, from `dumpsys
    input_method` (app/ui/AnswerKeyboard.kt): plain text with no suggestions and no auto-correct (not a password's type,
    where Gboard can lose its language switch), Gboard's "no decoding", the answer's language as the keyboard's hint.
    With Gboard as the keyboard, its language is the hinted one (the learner's layout for it, or for this field alone
    when it isn't installed) and, "hisa" typed (its Slovene would offer "hiša"), no suggestion strip shows (its toolbar
    does). Types into the field; a line of what it found."""
    adb("shell", "input", "text", "hisa")
    time.sleep(1.2)
    d = adb("shell", "dumpsys", "input_method", check=False)
    at = d.find("curEditorInfo:")
    assert at >= 0, "the focused field's EditorInfo (dumpsys input_method)"
    info = d[at:at + 1500]
    m = re.search(r"inputType=0x([0-9a-f]+) imeOptions=0x[0-9a-f]+ privateImeOptions=(\S*)", info)
    assert m, f"the field's input type in: {info[:200]!r}"
    t, private = int(m.group(1), 16), m.group(2).split(",")
    hint = (re.search(r"hintLocales=(\S+)", info) or [None, "?"])[1]
    assert t & 0xf == 0x1 and t & 0xff0 == 0, f"plain text, not a password's or another variation: inputType 0x{t:x}"
    assert t & 0x80000, f"no suggestions asked (TYPE_TEXT_FLAG_NO_SUGGESTIONS): inputType 0x{t:x}"
    assert not t & 0x8000, f"no auto-correct asked: inputType 0x{t:x}"
    assert NO_DECODING in private, f"Gboard's no decoding asked: privateImeOptions {','.join(private)}"
    assert hint == f"[{lang}]", f"the keyboard's hint is the answer's language ({lang}): hintLocales {hint}"
    said = f"inputType 0x{t:x}, hintLocales {hint}, noDecoding"
    ime = adb("shell", "settings", "get", "secure", "default_input_method", check=False).strip()
    if not ime.startswith(GBOARD + "/"):
        return f"{said}; the keyboard is {ime or '?'}, not Gboard: its language and strip not checked"
    version = (re.search(r"versionName=(\S+)", adb("shell", "dumpsys", "package", GBOARD, check=False)) or [None, "?"])[1]

    def block(name):
        i = d.find(f"[{name} ")
        return d[i:d.find(f"[/{name} ", i)] if i >= 0 else ""
    now = (re.search(r"languageTag = (\S+)", block("CurrentInputMethodSubtypeNotification")) or [None, "?"])[1]
    layout = (re.search(r"variant = (\S+)", block("CurrentInputMethodEntryNotification")) or [None, "?"])[1]
    installed = re.findall(r"languageTag = (\S+)", block("EnabledInputMethodEntriesNotification"))
    assert now.split("-")[0] == lang, f"Gboard opened in the answer's language ({lang}), not {now} (its languages: {installed})"
    strip = re.findall(r'<LatinFixedCountCandidatesHolderView[^>]*visibility="(\d)"', d)
    assert "0" not in strip, "no suggestion strip with the keyboard up and a word typed (Gboard's candidates shown)"
    has = "installed" if any(l.split("-")[0] == lang for l in installed) else "for this field: not among " + ", ".join(installed)
    return f"{said}; Gboard {version} in {now} ({layout}, {has}), no suggestion strip"


def ime_top():
    """The keyboard's top on screen (px), from the window manager's insets (the IME's frame, as the app is told it);
    None while it is down."""
    for m in re.finditer(r"InsetsSource id=\S+ type=ime frame=\[(\d+),(\d+)\]\[(\d+),(\d+)\][^\n]*?visible=true",
                         adb("shell", "dumpsys", "window", check=False)):
        x0, y0, x1, y1 = map(int, m.groups())
        if y1 > y0 and x1 > x0:
            return y0
    return None


def keyboard_settled(timeout=8.0):
    """Waits for the keyboard to be up and still (its top the same twice, the panel risen); its top, or None."""
    end, last = time.time() + timeout * slow(), None
    while time.time() < end:
        top = ime_top()
        if top is not None and top == last:
            time.sleep(0.8)  # the panel's lift (a fifth of a second) and the bringing into view after it
            return top
        last = top
        time.sleep(0.6)
    return None


def typed_turn():
    """A dialog's typed turn (QA's hook asks every turn that tests a form typed into its gap) with the keyboard up: the
    field, the letter chips and "Preveri · Check" above the keyboard's top (its frame from `dumpsys window`), the sentence
    with the gap on screen too; the panel has risen over the picture (its header higher, the top bar gone) and comes back
    down once the keyboard is. The keyboard is an answer's ([answer_keyboard]): in the answer's language, without a
    suggestion strip."""
    try:
        return typed_in_dialog()
    finally:
        qa_hook("turns:")  # the learner's own masteries decide again
        qa_hook("happening:")


def open_typed_turn() -> str:
    """Opens a dialog whose first turn is typed (QA's hooks: the happening on, its form turns typed) and goes on to that
    turn: "" once it shows, else why not. A dialog whose turn is chosen (no form in it) is closed for the next one."""
    qa_hook("turns:type")
    for sid, hid in dialog_happenings()[:10]:
        qa_hook(f"happening:{sid}/{hid}", f"scene:{sid}@{sid}/{hid}")
        if wait_for("‹ Vas · Village", 8) is None:
            continue
        if wait_for("Zapri · Close", 6) is None:
            tap("‹ Vas · Village", 3)
            continue
        for _ in range(8):
            labels = [t for t, _ in nodes()]
            if any(TYPED_TURN in t for t in labels):
                print(f"    the typed turn of {sid}/{hid}")
                return ""
            if any(t.startswith("Tvoj odgovor") or "Poišči v prizoru" in t or "Poslušaj in ponovi" in t for t in labels):
                break  # the learner's turn, but chosen, tapped or echoed: the next dialog
            if not tap("Naprej · Next", 3):
                time.sleep(1)
        tap("Zapri · Close", 3)
        tap("‹ Vas · Village", 5)
        plain_village()
    return "no dialog with a typed turn opened (no form turn first in the dialogs tried)"


def box_of(bs, text, exact=False):
    """The bounds of the first node labelled [text] (exactly, or containing it) in [bs], or None."""
    return next((b for t, b in bs if (t == text if exact else text in t)), None)


def typed_in_dialog():
    """[typed_turn], its hooks asked."""
    if why := open_typed_turn():
        return why
    time.sleep(1.5)  # the person's line types in
    bs = list(boxes())
    header = box_of(bs, "Zapri · Close")
    assert header is not None, "the dialog's header (✕)"
    field = box_of(bs, ANSWER_FIELD)
    assert field is not None, "the answer field"
    shot("typed-turn")
    tap_at(((field[0] + field[2]) // 2, (field[1] + field[3]) // 2))
    top = keyboard_settled()
    assert top is not None, "the keyboard came up"
    bs = list(boxes())
    shot("typed-turn-keyboard")
    parts = {
        "the field": box_of(bs, ANSWER_FIELD),
        "the letter chips": box_of(bs, "č", exact=True),
        "Check": box_of(bs, CHECK),
        "the sentence with the gap": box_of(bs, "____"),
    }
    missing = [n for n, b in parts.items() if b is None]
    assert not missing, f"with the keyboard up, not on screen: {', '.join(missing)}"
    under = [f"{n} ({b[3]} > {top})" for n, b in parts.items() if b[3] > top]
    assert not under, f"under the keyboard (its top at {top}): {', '.join(under)}"
    risen = box_of(bs, "Zapri · Close")
    assert risen is not None and risen[1] < header[1], f"the panel rose over the picture (its ✕ at {risen} from {header})"
    assert box_of(bs, "‹ Vas · Village") is None, "the scene's top bar out of the way while the panel is up"
    print(f"    keyboard's top {top}px; Check {parts['Check'][1]}–{parts['Check'][3]}, field {parts['the field'][1]}–"
          f"{parts['the field'][3]}, gap's sentence from {parts['the sentence with the gap'][1]}; ✕ {header[1]} → {risen[1]}")
    print(f"    the answer's keyboard: {answer_keyboard()}")
    shot("typed-turn-answer-keyboard")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the keyboard down: the picture comes back
    time.sleep(1.5)
    assert ime_top() is None, "the keyboard went down"
    bs = list(boxes())
    back = box_of(bs, "Zapri · Close")
    assert back is not None and abs(back[1] - header[1]) < 12, f"the panel back under the picture (its ✕ at {back}, was {header})"
    assert box_of(bs, "‹ Vas · Village") is not None, "the scene's top bar back"
    assert tap("Zapri · Close", 3), "close the dialog"
    assert tap("‹ Vas · Village", 5), "back from the scene"
    plain_village()  # the village (its first-time intro skipped, when this step runs alone on a fresh install)


def forest():
    """A tap on the forest (through the camera's inverse) opens the forest's card."""
    if find("Nahrani ogenj"):  # a place card still open from the step before
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
    adb("shell", "input", "tap", "300", "2050")  # deep in the woods left of the path (nobody lives there), above the bottom bar
    assert wait_for("Gozd · The forest", 6), "forest card"
    assert wait_for("Nabiraj les", 3), "gather wood in the forest"
    time.sleep(1)
    shot("forest-card")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the card, not the village
    time.sleep(1)
    assert find("Zvitek · Scroll") or find("Knjiga · Book"), "back closed more than the card"


def zoom():
    """A double tap zooms in twice as close: the village switches to its finer level of detail (roof tiles, window frames)."""
    if tap("Na sredino · Recenter", 2):  # a card's reveal may have left the camera closer in
        time.sleep(1.5)
    # Near the fire, on nothing: a bubble takes a tap before the village sees it, and when the two taps come too far
    # apart (a busy machine) the first is a tap of its own, which opens what's there. Then close it and go again; after
    # two, the camera's own zoom (QA's hook, as the "Približaj · Zoom in" action).
    for _ in range(2):
        bs = list(boxes())
        c = open_spot("Ogenj · The fire", reach=160, bs=bs)
        assert c is not None, "the fire's target"
        adb("shell", f"input tap {c[0]} {c[1]} && input tap {c[0]} {c[1]}")  # one shell call: the taps land within the double-tap window
        time.sleep(2)  # the flight settles, the closer look renders and fades in
        if wait_for("Na sredino · Recenter", 5):
            break
        before = {t for t, _ in bs}
        opened = [t for t, _ in nodes() if t not in before]
        print(f"    no zoom after a double tap at {c}; {'opened: ' + ' | '.join(opened[:4]) if opened else 'nothing opened'}")
        plain_village()
    else:
        qa_hook("zoom")
        assert wait_for("Na sredino · Recenter", 5), "recenter button after zooming in (two double taps, then the zoom hook)"
        print("    zoomed by the zoom hook: the double taps came too far apart")
    shot("zoomed-in")
    assert tap("Na sredino · Recenter", 3), "recenter"
    time.sleep(1.5)


def spot_card():
    """A spot of the landscape (its screen-reader target shows where it is) is a place: its card offers to gather
    there. Villagers live at spots, and a tap on someone standing there opens their card; a happening's bubble over the
    spot (at night Luka's owl by the forest) opens its close-up: then back to the village and the next spot."""
    for spot, action in (("Skladovnica · The woodpile", "Nabiraj les"), ("Skale · The rocks", "Nabiraj kamen")):
        assert tap_clear(spot, 5), f"{spot} in the village"
        if wait_for(action, 6):
            break
        plain_village()  # someone's card, or a close-up with its dialog
    else:
        raise AssertionError("no spot's card (villagers standing on both?)")
    time.sleep(1)
    shot("woodpile-card")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the card
    time.sleep(1)
    assert find("Zvitek · Scroll") or find("Knjiga · Book"), "back closed more than the card"


CAST = ["Babica Micka", "Pastir Luka", "Zala", "Stari Janez", "Mlinar France", "Tine", "Teta Ančka", "Čebelar Anton", "Kovač Tone", "Vinar Marko", "Gostilničarka Vida", "Nejc", "Učiteljica Mojca"]


def villager():
    """Someone who lives here stands about their home; a tap on them shows their card over the village."""
    people = [t for t, _ in nodes() if any(t == n or t.startswith(n) for n in CAST)]
    if not people:
        return "nobody out on the map (no residents yet, or all indoors at night)"
    # Someone may stand under a crowd of bubbles (a tap there opens the place's card), or have walked off or
    # indoors since the list was read: try the next one.
    who = None
    for name in people:
        if not tap(name, 3):
            continue
        if wait_for("Več · More", 5):
            who = name
            break
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # a place card opened instead
        time.sleep(1.2)
    assert who, f"no villager's card over the village (tried {', '.join(people)})"
    time.sleep(1)
    shot("villager-card-on-map")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the card
    time.sleep(1.2)
    assert find("Zvitek · Scroll") or find("Knjiga · Book"), "back closed more than the card"


REQUEST = ", prošnja · request"  # a request bubble's TalkBack label: "<what's asked>, prošnja · request"
PROJECT = re.compile(r" \d+/\d+" + re.escape(REQUEST) + "$")  # a village project's: "Mlaj · The maypole 0/5, prošnja · request"


def bubble():
    """A villager's request bubble in the village opens their request."""
    wait_for("prošnja · request", 8)
    # A villager's own request opens its challenge; not the tutor's ("prošnja od učitelja"), which opens a module
    # player, nor a village project's (the projects sheet), nor a place's bubble that stands for several ("odpri kraj").
    asks = [(t, c) for t, c in nodes() if t.endswith(REQUEST) and not PROJECT.search(t)]
    if not asks:
        return "no villager's request bubble on screen"
    for t, c in asks:
        tap_at(c)
        # a villager's bubble (one for all their requests, "⚒️ 2") opens their card: "🙋 Prosi te za pomoč" over a row per
        # request ("📋 <title>"), their own first; its row leads on to the quest
        if wait_for("Prosi te za pomoč", 5):
            assert tap("📋 ", 3), "the first request on the villager's card"
        if wait_for("Začni", 10) or wait_for("Na kocki", 3):
            break
        print(f"    the bubble {t!r} led elsewhere")
        plain_village()
    else:
        raise AssertionError(f"quest intro (tried {' / '.join(t for t, _ in asks)})")
    shot("bubble-quest")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    assert wait_for("Zvitek · Scroll", 10) or wait_for("Knjiga · Book", 3), "back in the village"


def camera():
    """Dragging the village moves the camera; the recenter button brings it home."""
    # a busy machine (many builds at once) can take a while to show the button: a second drag if not
    for _ in range(2):
        adb("shell", "input", "swipe", "300", "1500", "800", "1100", "400")
        time.sleep(1.5)
        if wait_for("Na sredino · Recenter", 8):
            break
    else:
        raise AssertionError("recenter button after a drag")
    shot("camera-moved")
    assert tap("Na sredino · Recenter", 3), "recenter"
    time.sleep(1.5)
    assert find("Na sredino · Recenter") is None, "still away from home after recentring"


NOT_OPTIONS = ("Poslušaj · Listen", "Počasi · Slowly", "Predvajaj", "Namig", "Vprašaj", "Končaj", "Zapri")


def answer_any():
    """Answers the exercise on screen, whatever it is: types, flips the card, or taps the first option."""
    if find("Preveri · Check"):
        # the answer field ("Napiši odgovor"), not a prompt that also starts with "Napiši" ("Napiši, kar slišiš")
        c = find("Napiši odgovor") or find("Type your answer")
        if c:
            adb("shell", "input", "tap", str(c[0]), str(c[1]))
            type_text("hvala")
        tap("Preveri · Check", 3)
    elif find("Pokaži · Show"):
        tap("Pokaži · Show", 3)
        tap("Vedel sem", 3)
    else:  # a choice: the first option below the prompt (the stage and the prompt fill the top)
        # not the question itself, which can sit below the stage too ("🎧 … Where did he sit?")
        below = [(t, c) for t, c in nodes() if t and c[1] > 1000 and not any(n in t for n in NOT_OPTIONS)]
        options = [(t, c) for t, c in below if not t.rstrip().endswith("?")]
        # every answer a question ("Kako ti je ime?"): the lowest, which is an answer, never the prompt above them
        options = options or sorted(below, key=lambda o: o[1][1])[-1:]
        assert options, "an option to pick"
        x, y = options[0][1]
        adb("shell", "input", "tap", str(x), str(y))
    time.sleep(1.5)


def gather():
    assert tap("Hrana · Food"), "food chip"  # the HUD chip's TalkBack label
    assert tap("Nabiraj · Gather"), "gather button"
    assert wait_for("Pozneje · Later", 8), "the intro"  # the villager asks first
    assert tap("Začni"), "start run"
    for _ in range(2):  # answer two exercises whatever they are
        answer_any()
        shot("gather-answer")
        tap("Naprej · Next", 4)
    assert tap("Končaj"), "stop early"
    # "Za tvojo vas" when something was earned; a full store earns nothing, but the result still leads home
    assert wait_for("Za tvojo vas", 10) or wait_for("V vas · To the village", 5), "result screen"


def back_to_village():
    """A run's result leads back to the village (whatever else is open, the step's cleanup closes)."""
    if not tap("V vas", 5):
        return "no run's result on screen"


def stage_bubble():
    """The training stage's speech bubble ("Pastir Luka: Poslušaj … · Listen …"), or None."""
    return next((t for t, _ in nodes() if ": " in t and " · " in t and t.split(": ")[0] in STAGE_PEOPLE), None)


STAGE_PEOPLE = {"Pastir Luka", "Mlinar France", "Kovač Tone", "Stari Janez", "Babica Micka"}


def intro_stage():
    """A gathering run: the villager's intro (request, practice, pay), then the run with them on the stage, reacting."""
    assert tap("Les · Wood", 5), "wood chip"
    assert tap("Nabiraj · Gather", 5), "gather button"
    assert wait_for("Kaj boš vadil", 10), "intro: what you'll practise"
    assert find("Pastir Luka"), "intro: Pastir Luka asks for wood"
    assert find("Pozneje · Later"), "intro: later"
    time.sleep(1)
    shot("intro")
    assert tap("Začni", 3), "start from the intro"
    assert wait_for("Glas spremljevalca", 8), "the stage above the exercise"
    before = stage_bubble()
    assert before, "the companion says something as the exercise comes up"
    shot("stage-prompt")
    answer_any()
    after = stage_bubble()
    assert after and after != before, f"the companion reacts to the answer ({before!r} → {after!r})"
    shot("stage-reaction")
    tap("Naprej · Next", 4)
    assert tap("Končaj"), "stop early"
    assert wait_for("V vas · To the village", 10), "result screen"
    assert wait_for("Pastir Luka", 5), "the companion says goodbye on the result"
    time.sleep(1)


