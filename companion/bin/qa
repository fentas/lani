        ("bubbles-follow", bubbles_follow, v, False, ""),
        ("gather", gather, v, True, ""),
        ("back-to-village", back_to_village, v, False, ""),
        ("intro-stage", intro_stage, v, True, ""),
        ("back-to-village-2", back_to_village, v, False, ""),
