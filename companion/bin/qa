HOSTED_TITLE = "Lani na tej napravi"  # l10n hosted.title: the onboarding, the splash, the connection sheet
HOSTED_NAME = "Ana"


def hosted_shot(name: str):
    """A screenshot of the hosted step, also as hosted-<name>.png in $LANI_QA_HOSTED_SHOTS when it's set."""
    shot(f"hosted-{name}")
    if d := os.environ.get("LANI_QA_HOSTED_SHOTS"):
        Path(d).mkdir(parents=True, exist_ok=True)
        shutil.copy(shots[-1], Path(d) / f"hosted-{name}.png")


def hosted_home(timeout=60, found=False):
    """Waits for Home on a hosted install: the notification permission allowed, the village founded where offered; with
    [found] (a new learner) until it was founded (the founding comes over Home once the village was asked for)."""
    end = time.time() + timeout * slow()
    founded = False
    while time.time() < end:
        ns = list(nodes())
        if (c := next((c for t, c in ns if t == "Allow"), None)) is not None:
            adb("shell", "input", "tap", str(c[0]), str(c[1]))
        elif (c := next((c for t, c in ns if "Tu bo moja vas" in t), None)) is not None:
            adb("shell", "input", "tap", str(c[0]), str(c[1]))
            founded = True
        elif any("Kje bo tvoja vas" in t for t, _ in ns):
            # the founding (ui/game/FoundingScreen): its button under the picture, below the screen's edge
            if not founded:
                hosted_shot("founding")
            adb("shell", "input", "swipe", "540", "1700", "540", "700", "300")
            time.sleep(1)
        elif any("Danes · Today" in t for t, _ in ns) and (founded or not found):
            return founded
        time.sleep(1)
    raise AssertionError("Home did not load on the phone's bridge" + ("" if founded or not found else " (no founding)"))


def hosted_log(pattern: str) -> list[str]:
    """The app's LaniHosted lines matching [pattern] (hosted/HostedRuntime)."""
    return [l for l in adb("logcat", "-d", "-s", "LaniHosted:I", check=False).splitlines() if re.search(pattern, l)]


def hosted_home_ms() -> str:
    """The last "home: N ms after the app started" of the log, and the bridge's boot, for the report."""
    lines = hosted_log(r"home: \d+ ms")
    return lines[-1].split("LaniHosted: ", 1)[-1] if lines else "(no timing line)"


def hosted():
    """"☁️ Lani na tej napravi · Lani on this device" (docs/plans/05-built/hosted-mode.md) with no node at all: nothing
    may listen on the dev bridge's port. A fresh install: the first launch's "📱 Samo ta telefon / tablica", the
    onboarding (a name, as a woman, Slovene from English, A1, 30 minutes; LANI_QA_HOSTED_CHILD=1: for a child), the
    tutor's step (a child's closed until a parent's hold), Home on the phone's own bridge and the village founded; a word looked
    up in a pack, the pack learned (its words saved by the phone's update-db), a review (QA's hook "review") saved; the
    app killed and started again: the splash, Home in N ms (the log's timing), the review still there (the phone's
    spaced-repetition.json, the streak); the packs screen; the export made (the connection sheet's 📤, the share sheet),
    pulled and checked by the node's `lani import --verify`. Screenshots also to $LANI_QA_HOSTED_SHOTS."""
    assert not listeners(PORT), f"something listens on {PORT}: the hosted step runs with no node"
    # the first launch: the welcome, Slovene from English, "📱 Samo ta telefon / tablica · Just this device"
    first_launch(way_key="setup.deviceTitle")
    hosted_shot("setup")
    # no learner on the phone yet: the questions at once (an export imported from there too)
    c = wait_for("Kako ti je ime?", 8)
    assert c, "the name field"
    adb("shell", "input", "tap", str(c[0]), str(c[1]))
    time.sleep(1.2 * slow())
    adb("shell", "input", "text", HOSTED_NAME)
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    time.sleep(1)
    assert tap("kot ženska", 4), "as a woman"
    child = os.environ.get("LANI_QA_HOSTED_CHILD") == "1"
    if child:  # a child's device: keys and accounts a parent's (app/ParentGate)
        assert tap("Za otroka", 4), "for a child"
    assert find("Učiš se: slovenščina"), "the setup's languages, not asked again"
    hosted_shot("onboarding")
    for _ in range(3):  # to the end of the questions: the button sits low, under the minutes a day
        adb("shell", "input", "swipe", "540", "1600", "540", "800", "300")
        time.sleep(0.8)
    assert tap("Ustanovi mojo vas", 5), "found my village"
    assert wait_for("Še učitelj", 40), "the tutor's step"
    if child:
        # "a parent sets this up": nothing to type for the child; a hold opens it
        assert wait_for("To nastavi starš", 4) and not find("Claude (svoj ključ)"), "the child's tutor step, closed"
        hosted_shot("tutor-child")
        c = find("Drži za starše")
        assert c, "the parent's hold"
        adb("shell", "input", "tap", str(c[0]), str(c[1]))  # a tap doesn't open it
        time.sleep(1)
        assert not find("Claude (svoj ključ)"), "a tap opened the parent's gate"
        adb("shell", "input", "swipe", str(c[0]), str(c[1]), str(c[0]), str(c[1]), "2800")  # held for 2.8 s
        assert wait_for("Claude (svoj ključ)", 6), "the hold opens it"
        hosted_shot("tutor-child-open")
    # the three ways: Claude with one's own key, ChatGPT (where the build has OpenAI), or later
    assert find("Claude (svoj ključ)"), "Claude (your own key)"
    hosted_shot("tutor")
    assert tap("Pozneje · Later", 5), "the tutor later: to the village"
    hosted_home(found=True)
    time.sleep(2 * slow())
    assert find(HOSTED_NAME), "Home greets the learner"
    hosted_shot("home")
    first = hosted_home_ms()
    print(f"    first start: {first}")
    assert not listeners(PORT), f"something listens on {PORT}"

    # the chat without a tutor yet: it says so, rather than waiting in silence
    assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
    assert wait_for("Na tem telefonu še ni učitelja", 10), "the chat's no-tutor line"
    hosted_shot("chat")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    time.sleep(1)
    go_home()

    # a word looked up: its card (as a tap on it in a dialog: QA's hook), the meaning from the phone's dictionary
    qa_hook("formscard:word:hiša")
    assert wait_for("house", 40), "hiša's card with its meaning (the phone's /lookup)"
    hosted_shot("lookup")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    time.sleep(1)
    go_home()

    # the packs: a pack learned to its end (its words saved by the phone's update-db)
    tile = scroll_to("Nove besede")
    assert tile, "new words tile"
    tap_at(tile)
    assert wait_for("Znaš ", 10), "packs screen"
    time.sleep(1)
    hosted_shot("packs")
    ring = next((c for t, c in nodes() if (m := re.fullmatch(r"(\d+)/(\d+)", t)) and m[1] != m[2]), None)
    assert ring, "a learnable pack"
    tap_at(ring)
    assert wait_for("Pozneje · Later", 8), "the pack's intro"
    assert tap("Začni", 3), "start from the intro"
    assert wait_for("Naprej · Next", 8), "word card"
    for _ in range(80):
        ns = [t for t, _ in nodes()]
        if any("Jutri jih ponovimo" in t for t in ns):
            break
        # Ana is a woman: the cards say "Vedela sem" (answer_any knows "Vedel sem")
        knew = next((t for t in ns if t.endswith("Vedela sem") or t.endswith("Vedel sem")), None)
        if any("Vadimo!" in t for t in ns):
            tap("Vadimo!", 3)
        elif knew is not None:
            tap(knew, 3)
        elif any("Pokaži · Show" in t for t in ns):
            tap("Pokaži · Show", 3)
        elif any("Naprej · Next" in t for t in ns) and not any("Preveri · Check" in t for t in ns):
            tap("Naprej · Next", 3)
        else:
            try:
                answer_any()
            except AssertionError:
                time.sleep(1)
    assert wait_for("Jutri jih ponovimo", 10), "the pack's end"
    hosted_shot("pack-learned")
    tap("Naprej", 4)
    go_home()

    # a review of the new words today (QA's hook: they are due tomorrow), to its end
    qa_hook("review")
    assert wait_for("Ponavljanje", 10) or wait_for(DONE, 10) or find("Preveri · Check"), "the review"
    for _ in range(30):
        ns = [t for t, _ in nodes()]
        if any("recalled" in t for t in ns):
            break
        knew = next((t for t in ns if t.endswith("Vedela sem") or t.endswith("Vedel sem")), None)
        if knew is not None:
            tap(knew, 3)
        elif any("Pokaži · Show" in t for t in ns):
            tap("Pokaži · Show", 3)
        elif any("Naprej · Next" in t for t in ns) and not any("Preveri · Check" in t for t in ns):
            tap("Naprej · Next", 3)
        else:
            try:
                answer_any()
            except AssertionError:
                time.sleep(1)
    assert wait_for("recalled", 15), "the review's end"
    hosted_shot("review-saved")
    time.sleep(3 * slow())  # the outbox delivers it (in-process)
    sr = json.loads(run_as("cat", "files/lani/data/spaced-repetition.json") or "{}")
    reviewed = [i for i in sr.get("items", {}).values() if i.get("total_reviews", 0) > 0]
    assert reviewed, "the phone's spaced-repetition.json has no reviewed card"
    print(f"    {len(sr.get('items', {}))} cards on the phone, {len(reviewed)} reviewed")
    go_home()

    # killed and started again: the splash, then Home with the review still there
    adb("shell", "am", "force-stop", PKG)
    adb("logcat", "-c")
    time.sleep(1)
    started = adb("shell", "am", "start", "-W", "-n", f"{PKG}/.MainActivity")
    launch = re.search(r"TotalTime: (\d+)", started)
    HOSTED["launch"] = f"{launch[1]} ms to the first frame (am start -W)" if launch else "?"
    for _ in range(10):
        if find(HOSTED_TITLE):
            hosted_shot("splash")
            break
        if find("Danes · Today"):
            break
        time.sleep(0.2)
    hosted_home(30)
    time.sleep(2 * slow())
    again = hosted_home_ms()
    print(f"    after a restart: {HOSTED['launch']}; {again}")
    sr2 = json.loads(run_as("cat", "files/lani/data/spaced-repetition.json") or "{}")
    assert [i for i in sr2.get("items", {}).values() if i.get("total_reviews", 0) > 0], "the review is gone after the restart"
    hosted_shot("home-again")

    # the packs screen again (on the restarted bridge)
    tile = scroll_to("Nove besede")
    assert tile, "new words tile"
    tap_at(tile)
    assert wait_for("Znaš ", 10), "packs screen after the restart"
    go_home()

    # the export: the connection sheet's 📤, the share sheet; the zip checked by the node's lani import --verify
    to_top()
    dot = find(f"☁️ {HOSTED_TITLE}")
    assert dot, "the status dot"
    tap_at(dot)
    assert wait_for("Izvozi moje podatke", 8) or scroll_to("Izvozi moje podatke", 3), "the export button"
    hosted_shot("settings")
    assert tap("Izvozi moje podatke", 4), "export"
    time.sleep(3 * slow())
    hosted_shot("export")
    listing = run_as("ls", "cache/shared")
    name = next((n for n in listing.split() if n.startswith("lani-export-")), None)
    assert name, f"no export in the cache ({listing.strip()})"
    zip_path = OUT / name
    assert pull(f"cache/shared/{name}", zip_path), "the export pulled"
    v = subprocess.run([sys.executable, str(ROOT / ".claude/hooks/lani_export.py"), "verify", str(zip_path)], capture_output=True, text=True)
    assert v.returncode == 0, f"lani import --verify: {v.stdout or v.stderr}"
    print(f"    {name}: {zip_path.stat().st_size} bytes; {v.stdout.strip().splitlines()[0] if v.stdout.strip() else 'verified'}")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the share sheet
    time.sleep(1)
    # the Tutor section on the phone: the tutor in the app only (no "Claude Code on my node"), its provider to choose
    for _ in range(8):
        if find("odgovarja učitelj v aplikaciji"):
            break
        gate = find("Drži za starše")
        if gate is not None and os.environ.get("LANI_QA_HOSTED_CHILD") == "1":
            # a child's device: the data and the tutor a parent's, behind the hold
            hosted_shot("settings-child")
            adb("shell", "input", "swipe", str(gate[0]), str(gate[1]), str(gate[0]), str(gate[1]), "2800")
            time.sleep(1.5)
            continue
        adb("shell", "input", "swipe", "540", "1800", "540", "900", "400")  # up only: a drag down closes the sheet
        time.sleep(1)
    assert find("odgovarja učitelj v aplikaciji"), "the Tutor section's line for the phone"
    assert not find("Claude Code"), "no node to choose on the phone"
    hosted_shot("tutor-section")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the connection sheet
    time.sleep(1)
    assert not listeners(PORT), f"something listened on {PORT} during the hosted step"
    HOSTED["first"], HOSTED["again"] = first, again


HOSTED: dict = {}


def hosted_only(steps) -> bool:
    """Whether the run is the hosted step alone: no node then (no dev bridge, no pairing)."""
    return bool(steps) and all(s[0] == "hosted" for s in steps)


def selected(steps):
    """The steps --steps names (a step, or the group "visit"), and setup; all without it. The hosted step comes alone,
    without setup's pairing (and without the dev bridge: main)."""
    want = arg("--steps")
    if not want:
        # the hosted step, the child's side and the visit's voices only when named (no node; their own second town)
        return [s for s in steps if s[0] not in ("hosted", "town-progress-child") and s[4] != VOICES_GROUP]
    names = {w.strip() for w in want.split(",") if w.strip()}
    if unknown := names - {s[0] for s in steps} - {s[4] for s in steps if s[4]}:
        sys.exit(f"unknown steps: {', '.join(sorted(unknown))} (companion/bin/qa --dry lists them)")
    if "hosted" in names:
        if names != {"hosted"}:
            sys.exit("the hosted step runs alone (no node): --steps hosted")
        return [s for s in steps if s[0] == "hosted"]
    return [s for s in steps if s[0] == "setup" or s[0] in names or s[4] in names]


def app_apk() -> Path:
    """The APK QA installs: --apk's, else the build's (debug, or qa with --minified)."""
    return Path(arg("--apk")).resolve() if arg("--apk") else APK


def building() -> bool:
    """Whether QA builds the APK first: not with --no-build or --apk."""
    return "--no-build" not in sys.argv and not arg("--apk")


def dry(steps, visiting: bool):
    """--dry: what a run would do, with the ports as they are now; nothing is built, started or tapped."""
    if VOICES:
        data = os.environ.get("LANI_DEV_DATA") or f"a synthetic Italian learner (Friuli, from German) made in {OUT / 'visitor-data'}"
        print(f"visit voices the dev bridge on {data}, a fake ElevenLabs (down while {ELEVEN_DOWN} is there), no local "
              f"voice worker; the second town {TOWN_FIXTURE} with its people's greetings voiced; the visit in {VOICES_PAIR}\n")
    def port(p):
        pids = listeners(p)
        return "free" if not pids else f"in use now (pid {', '.join(pids)})"
    print("QA plan (--dry: nothing is built, started or tapped)\n")
    built = "" if not building() else f"build ({BUILD_TASK}), "
    print(f"app          {built}install {app_apk()} and start {PKG} on {SERIAL or f'the emulator (AVD {avd()})'}")
    data = os.environ.get("LANI_DEV_DATA") or (OUT / "visitor-data" if VOICES else dev_data())
    print(f"dev bridge   127.0.0.1:{PORT} (the app: {BRIDGE_URL}, token {TOKEN}): test/dev-bridge.ts on a copy of "
          f"{data}, its town links left out; port {port(PORT)} (stopped first)")
    why = "--no-town" if "--no-town" in sys.argv else FACTS.get("error") or (None if visiting else "no visit step chosen")
    if why:
        print(f"second town  none: {why}")
    else:
        f = FACTS
        print(f"second town  127.0.0.1:{TOWN_PORT} (token {TOWN_TOKEN}): test/dev-town.ts {f['fixture']}, \"{f['name']}\" ({f['learner']}, {f['culture']}, "
              f"{f['language']}), a temp data dir; linked with the dev bridge's town; port {port(TOWN_PORT)} "
              "(a second town left there is stopped, anything else skips the visit)")
        print(f"             its people {', '.join(f['people'])}; {f['requests']} requests; market {', '.join(f['wares'])}; "
              f"its horizon {f['horizon']}; the visit's labels read \"{host('visit.visiting')} · …\"")
    print(f"\nsteps ({len(steps)}):")
    for i, (name, fn, _, _, group) in enumerate(steps, 1):
        doc = " ".join((fn.__doc__ or "").split())
        print(f"  {i:2d}  {name:<18} {doc[:110] + ('…' if len(doc) > 110 else '')}")


def bridges_only() -> int:
    """--bridges-only: no app. The dev bridge and the second town, linked; what a visit asks of the town, through the
    dev bridge; both stopped again."""
    OUT.mkdir(parents=True, exist_ok=True)
    bridge = start_bridge()
    town = start_town()
    line = link_town(town)
    print(f"second town: {line}")
    for p in (town, bridge):
        if p is not None:
            p.terminate()
            try:
                p.wait(10)
            except subprocess.TimeoutExpired:
                p.kill()
    print(f"logs: {OUT}")
    return 0 if line == "ok" else 1


def main():
    steps = selected(plan())
    visiting = any(s[4] in VISIT_GROUPS or s[0] == "town-progress-child" for s in steps)
    if "--dry" in sys.argv:
        return dry(steps, visiting)
    if "--bridges-only" in sys.argv:
        sys.exit(bridges_only())
    OUT.mkdir(parents=True, exist_ok=True)
    env = {**os.environ, "JAVA_HOME": sh("mise", "where", "java").strip()}
    if building():
        print(f"building ({BUILD_TASK}) …")
        subprocess.run(["./gradlew", "-q", BUILD_TASK], cwd=ANDROID, env=env, check=True)
    ensure_emulator()

    alone = hosted_only(steps)
    if alone:
        # "Lani on this phone": no node at all, and nothing listening on the dev bridge's port
        if pids := listeners(PORT):
            sys.exit(f"the hosted step runs with no node: {PORT} is in use (pid {', '.join(pids)})")
        bridge, town = None, None
    else:
        bridge = start_bridge()
        town = start_town() if visiting else None
        time.sleep(4)

    adb("uninstall", PKG, check=False)
    adb("install", "-r", str(app_apk()))
    # an earlier run's last screen: a dump that fails while the app starts would leave it to be read (nodes())
    adb("shell", "rm", "-f", "/sdcard/ui.xml", check=False)
    adb("logcat", "-c")
    adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")

    linked = False
    for name, fn, cleanup, keep, group in steps:
        if (group in VISIT_GROUPS or name == "town-progress-child") and not linked:  # linked by now, while the other steps ran
            results.append(("second-town", link_town(town)))
            linked = True
        step(name, fn, cleanup, keep)

    # Only the app's own crashes: a uiautomator dump that collides with another one also logs a FATAL EXCEPTION.
    log = adb("logcat", "-d", check=False).splitlines()
    crashes = [l for i, l in enumerate(log) if "FATAL EXCEPTION" in l and any(f"Process: {PKG}" in n for n in log[i + 1:i + 3])]
    if crashes:
        results.append(("crash check", "FAILED: " + " / ".join(crashes[:3])))
    else:
        results.append(("crash check", "ok"))

    if "--keep-bridge" not in sys.argv:
        if bridge is not None:
            bridge.terminate()
        if town is not None:
            town.terminate()

    if shutil.which("magick"):
        subprocess.run(["magick", "montage", *map(str, shots), "-resize", "270x", "-geometry", "+6+6",
                        "-tile", "6x", str(OUT / "contact-sheet.png")], check=False)
    report = "\n".join(f"{'✅' if r == 'ok' else '⏭️' if r.startswith('skipped') else '❌'} {n}: {r}" for n, r in results)
    (OUT / "report.txt").write_text(report + "\n")
    print(report)
    print(f"\nscreenshots: {OUT}")
    sys.exit(1 if any(r.startswith("FAILED") for _, r in results) else 0)


if __name__ == "__main__":
    main()
