def visit_gift():
    """"🎁 Regalo · Gift": the message field focused, the keyboard up, the field and "🎁 Invia · Send" above it (the
    visit's panel keeps above the keyboard); nothing is sent. Back hides the keyboard, back again closes the panel."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    assert tap(f"🎁 {host('visit.gift')} · ", 5), "the gift button"
    label = f"{host('visit.messageInLanguage')} · "
    field = wait_for(label, 8)
    assert field is not None, "the gift's message field"
    tap_at(field)
    top = keyboard_settled()
    assert top is not None, "the keyboard came up"
    bs = list(boxes())
    shot("visit-gift-keyboard")
    parts = {"the message field": box_of(bs, label), "Send": box_of(bs, f"🎁 {host('visit.send')} · ")}
    missing = [n for n, b in parts.items() if b is None]
    assert not missing, f"with the keyboard up, not on screen: {', '.join(missing)}"
    under = [f"{n} ({b[3]} > {top})" for n, b in parts.items() if b[3] > top]
    assert not under, f"under the keyboard (its top at {top}): {', '.join(under)}"
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the keyboard down
    time.sleep(1.2)
    assert ime_top() is None, "back hid the keyboard"
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel closed
    end = time.time() + 6 * slow()
    while find(label) is not None and time.time() < end:  # it slides away
        time.sleep(0.8)
    assert find(label) is None, "back closed the gift's panel"
    assert on_visit(), "back closed only the gift's panel (still on the visit)"


def visit_home():
    """"⌂ Casa · Home" leads back to the own village, in its own pair again."""
    if not on_visit():
        return "not on a visit (a step before failed)"
    assert tap(f"⌂ {host('common.home')} · ", 3), "home"
    assert wait_for("Zvitek · Scroll", 10) or wait_for("Knjiga · Book", 3), "the own village"
    assert find(f"{host('visit.visiting')} · ") is None, "still visiting"


def leave_visit():
    """After a visit step failed: home from wherever in the visit it stopped (a place, a request, a card), then the
    plain village. Back from the town leads to Friends, from Friends to the village."""
    for _ in range(5):
        if (c := find(f"⌂ {host('common.home')} · ")) is not None:
            tap_at(c)
            break
        if any(t in VILLAGE_HUD for t, _ in nodes()):
            break
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.2)
    plain_village()

# --- a visit's voices and its sky (companion/README.md, "Voices on a visit"; docs/plans/05-built/visit-voices.md) ------

VISIT_PAIR = os.environ.get("LANI_QA_VISIT_PAIR")  # the phone's pair while it visits (QA's hook "pair:<t>-<b>"); None: as it is
VOICES_PAIR = VISIT_PAIR or "it-de"  # the visit's voices: Teo's pair, Italian from German (the visit's labels: sl · de)
VOICES_LOG = "visit-voices.log"  # what each phase of the visit's voices said: the app's lines and the dev bridge's


def icu_branch(msg: str, key: str) -> str:
    """The [key] branch of a "{x, select, it {…} other {…}}" message ("other" when it has none for [key]); a plain message
    as it is. Its own {placeholders} stay."""
    m = re.fullmatch(r"\{\w+, select, (.*)\}", msg.strip(), re.S)
    if not m:
        return msg
    body, branches, i = m.group(1), {}, 0
    while (b := re.compile(r"\s*(\w+)\s*\{").match(body, i)) is not None:
        depth, j = 1, b.end()
        while j < len(body) and depth:
            depth += {"{": 1, "}": -1}.get(body[j], 0)
            j += 1
        branches[b.group(1)] = body[b.end():j - 1]
        i = j
    return branches.get(key, branches.get("other", msg))


def head(msg: str) -> str:
    """A label up to its first placeholder or bracket ("Prenesi ({mb} MB)" → "Prenesi"): what shows whatever fills it."""
    return re.split(r"\s*[({]", msg, maxsplit=1)[0].strip()


def town_label(key: str) -> str:
    """[key] in the visited town's language, its branch for that language: the first half of a visit's label."""
    return icu_branch(host(key), FACTS.get("language", "sl"))


def own_pair() -> str:
    """The pair the steps read the own village's labels in: setup's (LANI_QA_PAIR), else the profile's ("")."""
    return os.environ.get("LANI_QA_PAIR", "")


FRIENDS = "🤝 Prijatelji · Friends"  # the Friends screen's title (in the own pair the steps read)


def friends_from_visit() -> bool:
    """Back from the visited town to Friends (its Back leads there: a card or a panel over it closes first), the own pair
    asked first so Friends comes in the labels the steps read (the visit's own stay the town's). True once Friends shows
    with the second town on it."""
    qa_hook(f"pair:{own_pair()}")
    for _ in range(4):
        if find(FRIENDS) is not None or not on_visit():
            break
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.5 * slow())
    return wait_for(FRIENDS, 8) is not None and wait_for(FACTS["name"], 15) is not None and scroll_to(FACTS["name"], 3) is not None


def dump_says() -> str:
    """What a uiautomator dump answers now ("UI hierchary dumped to …", or why it couldn't): when a label isn't found."""
    out = subprocess.run(["adb", *(("-s", SERIAL) if SERIAL else ()), "shell", "uiautomator", "dump", "/sdcard/qa-probe.xml"],
                         capture_output=True, text=True, timeout=60)
    return " ".join((out.stdout + " " + out.stderr).split())[:200]


def visit_again(pair=None):
    """The second town visited from wherever the app is: from a visit going on, Back to Friends (the own pair asked first,
    so Friends comes in the labels the steps read); else Friends by QA's hook "friends" (a busy emulator's dump of the
    village fails: "null root node"), else the own village, its scroll's villagers and Friends (again a while later when
    the screen's dump failed); then the town's "🚶 Obišči · Visit"; with [pair] ("it-de":
    QA's hook "pair:<t>-<b>", asked on Friends) the visit's labels are the town's language explained in that pair's base.
    Ends on the visited town."""
    if on_visit():
        reached = friends_from_visit()
    else:  # Friends showing already (a step before came back to it), else opened by QA's hook "friends"
        if find(FRIENDS) is None:
            qa_hook(f"pair:{own_pair()}")
            qa_hook("friends")
        reached = wait_for(FRIENDS, 10) is not None and wait_for(FACTS["name"], 15) is not None and scroll_to(FACTS["name"], 3) is not None
    if not reached:
        for attempt in (1, 2, 3):
            try:
                if on_visit():
                    qa_hook(f"pair:{own_pair()}")
                    leave_visit()
                why = friends()
                break
            except AssertionError as e:  # a busy emulator (the screen's dump failing): a while later, again
                print(f"    Friends again ({e}; the screen's dump: {dump_says()})")
                if attempt == 3:
                    raise
                time.sleep(5 * attempt * slow())
        if why is not None:
            raise AssertionError(why)
    label = "Obišči · Visit"
    if pair:
        qa_hook(f"pair:{pair}")
        t, b = pair.split("-")
        label = f"{l10n(t, 'towns.visit')} · {l10n(b, 'towns.visit')}"
        assert wait_for(label, 10), f"the visit's button in {pair} ({label})"
    bs = list(boxes())
    title = next((bx for tx, bx in bs if tx.endswith(FACTS["name"])), None)
    assert title is not None, f"the card of {FACTS['name']!r}"
    below = [bx for tx, bx in bs if label in tx and bx[1] >= title[1]]
    assert below, f"the card's visit button ({label})"
    tap_at(centre(min(below, key=lambda bx: bx[1])))
    banner = f"{host('visit.visiting')} · "
    assert wait_for(banner, 10), f"the visit's banner ({banner.strip()} …)"
    assert wait_for(f"📜 {host('visit.requests')} · ", 25), "the visited town (its bar of things to do)"
    time.sleep(2)


def town_voices() -> list[dict]:
    """The second town's own clips of its people's greetings (test/dev-town.ts with LANI_DEV_TOWN_VOICES: its
    "dev town voice: {…}" lines): person, voice, text, the store's answer."""
    out = []
    for l in (OUT / "town.log").read_text(errors="replace").splitlines() if (OUT / "town.log").exists() else []:
        if l.startswith("dev town voice: "):
            try:
                out.append(json.loads(l.split(": ", 1)[1]))
            except ValueError:
                pass
    return out


def spare_lines(seeded: list[dict]) -> list[tuple[str, str, str]]:
    """Lines the town's people say that its store has no clip of: (person, voice, text), their idle, thanks and goodbye
    lines in the town's language that name nobody (no placeholder) and that the device's shell can quote."""
    have = {norm(g["text"]) for g in seeded}
    lang, out = FACTS["language"], []
    for kind in ("idle", "bye", "thanks", "cheer", "comfort"):
        for pid, v in FACTS.get("folk", {}).items():
            for line in v.get("lines", {}).get(kind, []):
                text = line.get(lang) if isinstance(line, dict) else None
                if not text or re.search(r"[{}'\"`$\\|]", text) or norm(text) in have or any(norm(text) == norm(t) for _, _, t in out):
                    continue
                out.append((pid, str(v.get("speaker") or v.get("voice") or "female"), text))
    return out


def app_lines() -> list[str]:
    """The app's lines of the visit's voices since the log was cleared (a debug build: tags Speaker, VisitVoice, Clips,
    Piper), with their times."""
    log = adb("logcat", "-d", "-v", "time", "-s", "Speaker:*", "VisitVoice:*", "Clips:*", "Piper:*", check=False)
    return [l for l in log.splitlines() if l.strip() and not l.startswith("-")]


def bridge_mark() -> int:
    """Where the dev bridge's log is now: [bridge_lines] reads on from it."""
    try:
        return (OUT / "bridge.log").stat().st_size
    except OSError:
        return 0


def bridge_lines(mark: int) -> list[str]:
    """The dev bridge's lines of a visit's voices since [mark]: what it kept and where from, the fake ElevenLabs' takes."""
    try:
        raw = (OUT / "bridge.log").read_bytes()[mark:].decode(errors="replace")
    except OSError:
        return []
    return [l for l in raw.splitlines() if "visit voice" in l or "fake ElevenLabs" in l or "elevenlabs:" in l]


def voices_log(title: str, lines: list[str]):
    """A phase of the visit's voices in the run's visit-voices.log."""
    with open(OUT / VOICES_LOG, "a") as f:
        f.write(f"## {title}\n" + "".join(f"  {l}\n" for l in lines) + "\n")


def said_how(text: str, wait=30.0) -> list[str]:
    """How the app said [text] since the log was cleared (tag Speaker: "node clip (grandma)", "offline voice", "nothing (no
    tts voice)" …), once it came to a last word (the offline voice may still fall back: a moment more for it)."""
    key = f"«{norm(text)}»: "
    end, hows = time.time() + wait * slow(), []
    while time.time() < end:
        hows = [l.split(key, 1)[1].strip() for l in adb("logcat", "-d", "-s", "Speaker:I", check=False).splitlines() if key in l]
        if hows and hows[-1] != "offline voice":
            break
        if hows and time.time() > end - wait * slow() / 2:
            break
        time.sleep(1)
    return hows


def say_as(person: str, voice: str, text: str, wait=30.0) -> list[str]:
    """[text] said as [person]'s 🔊 says it, in [voice] (QA's hook "audio:say:<text>|<voice>|<person>"): how it was said."""
    adb("logcat", "-c")
    qa_hook(f"'audio:say:{text}|{voice}|{person}'")  # quoted: the device's shell would split it
    return said_how(text, wait)


def voices_hooks():
    """The phone as Teo's tablet for the town's language: Android's voice as none ("audio:tts:off"), no offline voice of
    it ("audio:voice:remove:<lang>"), the offers declined before forgotten ("audio:visitvoice:reset")."""
    qa_hook("audio:tts:off")
    qa_hook(f"audio:voice:remove:{FACTS['language']}")
    qa_hook("audio:visitvoice:reset")
    time.sleep(1.5)


def visit_voices():
    """A visit sounds like the town (companion/README.md, "Voices on a visit"), as for Teo, a child learning Italian from
    German on a tablet without a Slovene voice, in Jan's Slovene village: the dev bridge an Italian learner's (LANI_DEV_DATA,
    else a synthetic one of the Friuli culture made in the run's folder) with a fake ElevenLabs, the second town the Slovene
    fixture (test/fixtures/dev-town-sl.json) whose own store has its people's greetings (LANI_DEV_TOWN_VOICES), the phone
    without a Slovene voice ([voices_hooks]); the town visited in it · de (LANI_QA_VISIT_PAIR, default it-de: its labels
    sl · de). (a) Someone of the town out on its map tapped and their greeting's 🔊 (nobody out, or a greeting the town has
    no clip of: a greeting it has, said as its 🔊 says it, QA's hook "audio:say:<text>|<voice>|<person>"): the town's own
    clip plays (tag Speaker "said «…»: node clip (<voice>)"; the dev bridge "visit voices: <town>: "…" (<voice>): the
    town's own clip"). (b) A line of theirs the town has no clip of: voiced on the dev bridge in the town's cast voice and
    language (the fake's take with language_code sl; "voiced here (elevenlabs)"), its clip played. The lines in
    visit-voices.log. The visit stays for visit-voices-silent."""
    if (why := no_town()) is not None:
        return why
    seeded = [g for g in town_voices() if g.get("status") == 200]
    if not seeded:
        return "the town has no clips of its own (town.log: no greeting voiced; LANI_DEV_TOWN_VOICES)"
    print(f"    the town's own clips: {len(seeded)} greetings of {len({g['person'] for g in seeded})} people")
    visit_again(VOICES_PAIR)
    voices_hooks()
    labels = " ".join(t for t, _ in nodes())
    want = f"⌂ {host('common.home')} · {l10n(VOICES_PAIR.split('-')[1], 'common.home')}"
    assert want in labels, f"the visit's labels in {FACTS['language']} · {VOICES_PAIR.split('-')[1]} ({want})"
    names = {v.get("name"): (pid, str(v.get("speaker") or v.get("voice") or "female")) for pid, v in FACTS["folk"].items()}
    have = {norm(g["text"]): g for g in seeded}

    # (a) the town's own clip of a greeting: someone out on the map tapped, their greeting's 🔊
    mark = bridge_mark()
    adb("logcat", "-c")
    who = how = None
    listen = f"{host('common.listen')} · "
    people = [(t, b) for t, b in boxes() if t in names and b[2] > b[0] and b[3] > b[1] and b[1] > 0]
    for t, b in people:
        tap_at(centre(b))
        if not wait_for(f"💬 {host('visit.talk')} · ", 5):
            if find(f"{host('common.close')} · "):  # a place's card opened instead
                adb("shell", "input", "keyevent", "KEYCODE_BACK")
                time.sleep(1.2)
            continue
        greeting = next((m.group(1) for tx, _ in nodes() if (m := re.match(r"[^:]{1,40}: (.+?) · ", tx))), None)
        if greeting and norm(greeting) in have and tap(listen, 3):
            who, text = t, greeting
            how = said_how(greeting)
            shot("visit-voices-greeting")
            break
        print(f"    {t}'s greeting «{greeting}»: {'the town has no clip of it' if greeting else 'not read'}")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.2)
    if who is None:
        g = seeded[0]
        who, text = f"{FACTS['folk'][g['person']]['name']} (QA's audio:say: nobody out with a greeting the town has)", g["text"]
        how = say_as(g["person"], g["voice"], g["text"])
        shot("visit-voices-greeting")
    time.sleep(2)
    a_app, a_bridge = app_lines(), bridge_lines(mark)
    voices_log(f"(a) the town's own clip: {who}: «{text}»", ["app:"] + a_app + ["dev bridge:"] + a_bridge)
    print(f"    (a) {who}: «{text}» said by {' → '.join(how) or 'nothing'}")
    for l in a_bridge:
        print(f"        bridge: {l.strip()}")
    assert how and how[-1].startswith("node clip ("), f"(a) the greeting «{text}» wasn't its clip: {how}"
    assert any("the town's own clip" in l and norm(text)[:20] in norm(l) for l in a_bridge), \
        f"(a) the dev bridge didn't get the town's own clip of «{text}»: {a_bridge}"
    if find(f"💬 {host('visit.talk')} · "):
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the card closed
        time.sleep(1.2)

    # (b) a line the town has no clip of: voiced on the dev bridge in the town's cast voice, in its language
    spare = spare_lines(seeded)
    assert spare, "a line of the town's people that its store has no clip of"
    pid, voice, line = spare[0]
    mark = bridge_mark()
    how = say_as(pid, voice, line)
    time.sleep(2)
    shot("visit-voices-node")
    b_app, b_bridge = app_lines(), bridge_lines(mark)
    voices_log(f"(b) voiced on the node: {FACTS['folk'][pid]['name']} ({voice}): «{line}»", ["app:"] + b_app + ["dev bridge:"] + b_bridge)
    print(f"    (b) {FACTS['folk'][pid]['name']} ({voice}): «{line}» said by {' → '.join(how) or 'nothing'}")
    for l in b_bridge:
        print(f"        bridge: {l.strip()}")
    assert how and how[-1] == f"node clip ({voice})", f"(b) «{line}» wasn't the node's clip in {voice}: {how}"
    assert any("voiced here (elevenlabs)" in l for l in b_bridge), f"(b) the dev bridge didn't voice «{line}»: {b_bridge}"
    take = next((l for l in b_bridge if l.startswith("fake ElevenLabs: ") and " chars " in l and norm(line)[:20] in norm(l)), None)
    assert take and f" {FACTS['language']} " in take, f"(b) the fake's take of «{line}» in {FACTS['language']}: {take}"


def visit_voices_silent():
    """(c) Nothing can say a line of the visit (companion/README.md, "Voices on a visit"): the dev bridge's ElevenLabs down
    (its fake answers every take with a 503, test/dev-bridge.ts LANI_DEV_FAKE_ELEVENLABS_DOWN; no local voice worker), a
    line the town has no clip of: nothing speaks (tag Speaker "nothing (no tts voice)"), and the visit's first such line
    offers the town language's offline voice ("🗣️ Prenesi slovenski glas za obiske (61 MB)? · …", a screenshot); "Ne zdaj";
    home and the town visited again: its first silent line brings "🔇 Ta naprava nima glasu za slovenščino · …" with
    "⬇️ Prenesi (61 MB)" (a screenshot). (d) ⬇️: the voice comes from the dev bridge (its Piper cache, LANI_PIPER_CACHE),
    "✅ Slovenski glas je na telefonu", and the next line is said by it (Speaker "offline voice", Piper's WAV). Then home, the
    phone's voice and the dev bridge's ElevenLabs back, the own pair again. The lines in visit-voices.log."""
    if (why := no_town()) is not None:
        return why
    seeded = [g for g in town_voices() if g.get("status") == 200]
    spare = spare_lines(seeded)[1:]
    if len(spare) < 3:
        return "fewer than three more lines its people say that the town has no clip of"
    lang = FACTS["language"]
    offer = f"🗣️ {head(town_label('visitVoice.offerTitle'))}"
    not_now = f"{host('offlineAudio.offerNo')} · "
    note = f"🔇 {town_label('visitVoice.none')}"
    download = f"⬇️ {head(town_label('visitVoice.download'))}"
    ready = f"✅ {town_label('visitVoice.ready')}"
    coming = head(town_label("visitVoice.downloading"))
    try:
        if not on_visit():
            visit_again(VOICES_PAIR)
        voices_hooks()
        ELEVEN_DOWN.touch()
        time.sleep(1.5)

        # (c) the visit's first silent line: the offer
        pid, voice, line = spare[0]
        mark = bridge_mark()
        how = say_as(pid, voice, line)
        dialog = wait_for(offer, 10)
        time.sleep(1)
        shot("visit-voices-offer")
        c_app, c_bridge = app_lines(), bridge_lines(mark)
        voices_log(f"(c) nothing can say it: {FACTS['folk'][pid]['name']} ({voice}): «{line}»", ["app:"] + c_app + ["dev bridge:"] + c_bridge)
        print(f"    (c) «{line}» said by {' → '.join(how) or 'nothing'}; the offer: {next((t for t, _ in nodes() if t.startswith(offer)), None)}")
        for l in c_bridge:
            print(f"        bridge: {l.strip()}")
        assert how and how[-1] == "nothing (no tts voice)", f"(c) «{line}» was said after all: {how}"
        assert dialog is not None, f"(c) the offer ({offer} …)"
        assert tap(not_now, 4), f"(c) the offer's {not_now.strip()}"
        end = time.time() + 8 * slow()
        while find(offer) is not None and time.time() < end:  # the dialog fades out
            time.sleep(1)
        assert find(offer) is None, "(c) the offer still open after Ne zdaj"

        # home, and the town again: the note with the download
        visit_again(VOICES_PAIR)
        pid, voice, line = spare[1]
        mark = bridge_mark()
        how = say_as(pid, voice, line)
        card = wait_for(note, 10)
        time.sleep(1)
        shot("visit-voices-note")
        n_app, n_bridge = app_lines(), bridge_lines(mark)
        voices_log(f"(c) the next visit, a silent line: {FACTS['folk'][pid]['name']} ({voice}): «{line}»", ["app:"] + n_app + ["dev bridge:"] + n_bridge)
        print(f"    (c) the next visit: «{line}» said by {' → '.join(how) or 'nothing'}; the note: "
              f"{next((t for t, _ in nodes() if t.startswith(note)), None)}; {next((t for t, _ in nodes() if t.startswith(download)), None)}")
        assert how and how[-1] == "nothing (no tts voice)", f"(c) «{line}» was said after all: {how}"
        assert card is not None, f"(c) the note ({note} …)"
        assert find(offer) is None, "(c) the offer again after Ne zdaj"
        assert find(download), f"(c) the note's {download} …"

        # (d) the download: the voice from the dev bridge, then a line said by it
        adb("logcat", "-c")
        assert tap(download, 3), f"(d) {download} …"
        started, seen_coming, came = time.time(), False, False
        while time.time() - started < 900 * slow():
            labels = [t for t, _ in nodes()]
            if not seen_coming and any(t.startswith(coming) for t in labels):
                seen_coming = True
                shot("visit-voices-downloading")
            if any(t.startswith(ready) for t in labels):
                came = True
                shot("visit-voices-ready")
                break
            if run_as("ls", f"files/piper/{lang}/voice.json").strip().endswith("voice.json"):
                time.sleep(1)
                came = any(t.startswith(ready) for t, _ in nodes())
                if came:
                    shot("visit-voices-ready")
                break
            time.sleep(2)
        on_phone = run_as("ls", f"files/piper/{lang}/voice.json").strip().endswith("voice.json")
        print(f"    (d) the voice on the phone after {round(time.time() - started)} s: {on_phone} "
              f"({run_as('du', '-sk', f'files/piper/{lang}').split()[0] if on_phone else '-'} kB); \"{ready}\" {'shown' if came else 'not seen'}")
        assert on_phone, f"(d) the offline voice of {lang} isn't on the phone after the download"
        time.sleep(5)  # its note goes; Piper loads it on its first line
        run_as("sh", "-c", "rm -f cache/piper-wav/*.wav")
        pid, voice, line = spare[2]
        mark = bridge_mark()
        how = say_as(pid, voice, line, wait=60)
        wavs = []
        end = time.time() + 60 * slow()
        while time.time() < end and not wavs:
            wavs = [w for w in run_as("ls", "cache/piper-wav").split() if w.endswith(".wav")]
            time.sleep(1)
        time.sleep(3)
        shot("visit-voices-offline")
        d_app, d_bridge = app_lines(), bridge_lines(mark)
        voices_log(f"(d) the offline voice: {FACTS['folk'][pid]['name']} ({voice}): «{line}»", ["app:"] + d_app + ["dev bridge:"] + d_bridge)
        if wavs:
            pull(f"cache/piper-wav/{wavs[0]}", OUT / "visit-voices-piper.wav")
        print(f"    (d) «{line}» said by {' → '.join(how) or 'nothing'}; Piper's WAV: {wavs[:1]}")
        assert how and how[-1] == "offline voice", f"(d) «{line}» wasn't said by the offline voice: {how}"
        assert wavs, "(d) Piper said nothing (no WAV in its cache)"

        # out of the visit by Back (to Friends) with the own pair as the visit found it, no QA hook: Friends in that pair
        t, b = VOICES_PAIR.split("-")
        mine = f"🤝 {l10n(t, 'towns.friends')} · {l10n(b, 'towns.friends')}"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        end, seen = time.time() + 20 * slow(), None
        while time.time() < end and seen is None:
            labels = [t for t, _ in nodes()]
            seen = next((x for x in (mine, FRIENDS) if any(l.startswith(x) for l in labels)), None)
            time.sleep(1)
        shot("visit-voices-friends")
        print(f"    out of the visit (no pair hook): Friends reads {seen or '(not read: the dump failed)'}")
        assert seen != FRIENDS or mine == FRIENDS, f"out of the visit: Friends in sl · en ({FRIENDS}), not in {VOICES_PAIR} ({mine})"
    finally:
        ELEVEN_DOWN.unlink(missing_ok=True)
        qa_hook("audio:tts:")
        qa_hook(f"pair:{own_pair()}")


def voices_done():
    """After the visit's voices (or a failure in them): the dev bridge's ElevenLabs up again, the phone's voice and the own
    pair back; on Friends (from a visit by Back), else the plain village."""
    ELEVEN_DOWN.unlink(missing_ok=True)
    qa_hook("audio:tts:")
    if on_visit() and friends_from_visit():
        return
    qa_hook(f"pair:{own_pair()}")
    time.sleep(1.5)
    if wait_for(FRIENDS, 5) is None:  # not on Friends (where the step leaves off): out of the visit, Friends by QA's hook
        if on_visit():
            leave_visit()
        qa_hook("friends")


def sky_titles() -> set[str]:
    """What a sky card of the visited town's culture is called in its language (its sky.json: the moon, the things and their
    folk names, a shooting star): a card's title is one of them."""
    try:
        sky = json.loads((ROOT / "companion/cultures" / FACTS["culture"] / "sky.json").read_text())
    except (OSError, ValueError, KeyError):
        return set()
    lang = FACTS["language"]
    names = [sky.get("moon", {}).get("name", {}), sky.get("meteors", {}).get("name", {})]
    names += [t.get(k, {}) for t in sky.get("things", []) for k in ("name", "folk")]
    return {n.get(lang) for n in names if isinstance(n, dict) and n.get(lang)}


def bright_spots(png: Path, top: int, bottom: int, threshold="35%") -> list[tuple[int, int, int]]:
    """The bright spots of the screenshot [png] between rows [top] and [bottom] (the sky): (x, y, area), the roundest and
    largest first (the moon, a planet, then the stars: a star is a dot of a few pixels, at 35 % of white in the night's
    sky)."""
    w = int(sh("magick", "identify", "-format", "%w", str(png), check=False).strip() or 1080)
    if bottom - top < 4:
        return []
    out = sh("magick", str(png), "-crop", f"{w}x{bottom - top}+0+{top}", "+repage", "-colorspace", "gray", "-threshold", threshold,
             "-define", "connected-components:verbose=true", "-define", "connected-components:area-threshold=4",
             "-connected-components", "8", "null:", check=False)
    spots = []
    for l in out.splitlines():
        m = re.match(r"\s*\d+: (\d+)x(\d+)\+\d+\+\d+ ([\d.]+),([\d.]+) ([\d.e+]+) (\S+)", l)
        if not m or not re.search(r"\(255|white|#FFFF", m.group(6), re.I):
            continue
        bw, bh, area = int(m.group(1)), int(m.group(2)), round(float(m.group(5)))
        if bw > w * 0.25 or bh > (bottom - top) * 0.5:  # not a band of light, a hillside, a text's line
            continue
        spots.append((round(float(m.group(3))), top + round(float(m.group(4))), area, min(bw, bh) / max(bw, bh)))
    spots.sort(key=lambda s: -(s[2] * (0.5 + s[3])))
    return [(x, y, a) for x, y, a, _ in spots]


def visit_sky():
    """The night sky over a visited town (docs/plans/05-built/visit-voices.md, "Look and learn on a visit"; ui/towns/VisitTaps.kt):
    by the clock's night (the real sky is drawn only by the clock, never under QA's hook "hour:<h>"), the town's map, dragged
    down so the top of its sky comes out from under the banner; what of the sky shows (the moon, a planet, the stars: the
    bright spots of a screenshot between the banner and the hills, never on a button or a label) tapped until one opens its
    card, else the sky in a grid: a sky card ("Luna", a constellation, a star …) in the town's language explained in the
    visitor's base, its lines and its words to tap, and neither "📚" nor "📖" (a guest's runs and readings stay in the
    visitor's own village); a screenshot, and where the moon was drawn. TalkBack's "🌌 Nebo nocoj" and "🌙 Luna" are
    custom actions adb can't reach: not tapped here. Visits the second town itself when the step before left none (in
    LANI_QA_VISIT_PAIR when set)."""
    if (why := no_town()) is not None:
        return why
    hour = time.localtime().tm_hour
    if 6 <= hour < 18:
        return f"by day ({hour} o'clock): the real night sky is drawn by the clock's night only (not under QA's hour hook)"
    qa_hook("hour:")
    switched, notes = False, []
    home_button = f"⌂ {host('common.home')} · "
    close, listen, talk = f"{host('common.close')} · ", f"{host('common.listen')} · ", f"💬 {host('visit.talk')} · "
    try:
        if not on_visit():
            visit_again(VISIT_PAIR)
            switched = bool(VISIT_PAIR)
        size = adb("shell", "wm", "size", check=False)
        height = int(m.group(1)) if (m := re.search(r"x(\d+)", size.split("Override")[-1])) else 2400
        # the map dragged down: the canvas's top (its sky) out from under the banner, as far as the camera lets it
        for _ in range(2):
            adb("shell", "input", "swipe", "540", str(height * 40 // 100), "540", str(height * 70 // 100), "500")
            time.sleep(1)
        time.sleep(3 * slow())  # the sky settles in the picture: what the hills hide isn't there to tap
        titles = sky_titles()
        bs = [b for t, b in boxes()]
        top = max((b[3] for b in bs if b[1] < height * 0.25 and b[3] < height * 0.3 and b[1] > 0), default=height // 8) + 12
        bottom = int(height * 0.34)  # above the hills' tops, the village's lights and fire below them
        shot("visit-sky-night")
        # the moon above the banner (under the status bar): seen, not to be tapped there
        above = min((b[1] for b in bs if b[1] < height * 0.25 and b[3] < height * 0.3), default=0)
        moon = next(((x, y) for x, y, a in bright_spots(shots[-1], 0, above, "60%") if a >= 200), None)
        # its lower edge in the strip of the map between the status bar and the banner, when there is one
        under_moon = [(moon[0], y, 0) for y in (moon[1] + 14, moon[1] + 22) if y < above - 4] if moon else []
        if moon:
            notes.append(f"the moon drawn at {moon}, above the banner (from row {above}): "
                         f"{'tapped on its lower edge ' + str([y for _, y, _ in under_moon]) if under_moon else 'not to be tapped there'}")
        # on a button or a label (not the map: its own node covers the screen)
        small = [b for b in bs if (b[2] - b[0]) * (b[3] - b[1]) < 1080 * height * 0.25]
        inside = lambda x, y: any(b[0] - 8 <= x <= b[2] + 8 and b[1] - 8 <= y <= b[3] + 8 for b in small)  # noqa: E731
        spots = [(x, y, a) for x, y, a in bright_spots(shots[-1], top, bottom) if not inside(x, y)]
        grid = [(x, y, 0) for y in range(top + 40, bottom, 110) for x in range(90, 1000, 150) if not inside(x, y)]
        print(f"    the sky between rows {top} and {bottom}: bright spots {spots[:8]}; {len(grid)} grid points after them")

        def opened() -> str | None:
            """What the tap opened: a sky card's title, "" for something else (closed again), None for nothing."""
            labels = [t for t, _ in nodes()]
            if card := next((t for t in labels if t in titles), None):
                return card
            if any(t.startswith(listen) for t in labels) and not any(t.startswith((talk, close)) for t in labels) and not any(t.startswith(home_button) for t in labels):
                # a sheet over the visit with its 🔊 by the title: a sky card its culture's sky.json doesn't name
                return next((t for t in labels if t and not t.startswith(listen) and len(t) < 40), "?")
            if any(t.startswith((talk, close)) for t in labels) or not any(t.startswith(home_button) for t in labels):
                return ""
            return None

        card, tried = None, 0
        for x, y, _ in under_moon + spots[:12] + grid:
            if not on_visit() and find(home_button) is None:
                raise AssertionError("the visit left while tapping the sky")
            tap_at((x, y))
            tried += 1
            time.sleep(0.8)
            what = opened()
            if what:
                card = what
                notes.append(f"a sky card from a tap at ({x}, {y}) (tap {tried})")
                break
            if what == "":  # a place's card, a person's: closed, the visit stays
                adb("shell", "input", "keyevent", "KEYCODE_BACK")
                time.sleep(1.2)
        if card is None:
            return f"no sky card from {tried} taps of the sky ({len(spots)} bright spots, the rest a grid); " + "; ".join(notes)
        time.sleep(1.5)
        shot("visit-sky-card")
        labels = [t for t, _ in nodes()]
        print(f"    the card: {card}; on it: {' | '.join(t for t in labels if len(t) < 90)[:500]}")
        for n in notes:
            print(f"    {n}")
        assert not any(t.startswith("📚 ") for t in labels), "a guest's sky card with 📚 (the sky's pack: the own village's)"
        assert not any(t.startswith("📖 ") for t in labels), "a guest's sky card with 📖 (the almanac: the own village's)"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the card closed
        time.sleep(1.5)
        assert on_visit(), "back closed more than the sky's card"
    finally:
        if switched:
            qa_hook(f"pair:{own_pair()}")  # the visit's labels stay the town's; home comes in the pair the steps read


def in_front() -> bool:
    """The app is the resumed activity ("topResumedActivity=…" on newer Androids, "mResumedActivity: …" on older)."""
    dump = adb("shell", "dumpsys", "activity", "activities", check=False)
    return PKG in re.split(r"ResumedActivity", dump, maxsplit=1)[-1][:200]


def go_home():
    """Back out of sheets and screens until Home; relaunch if Back left the app."""
    for _ in range(6):
        if find("Danes · Today"):
            return
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        if not in_front():
            adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
            time.sleep(3)
    assert wait_for("Danes · Today", 8), "could not get back to Home"


FILL_FORM = "Vstavi pravo obliko"  # a form question's instruction (l10n wordForms.fillForm)


def deck_lemmas() -> list[str]:
    """The one-word vocabulary cards of the dev bridge's deck (its copy of the learner data), as GET /forms is asked."""
    items = api("/state").get("databases", {}).get("spaced_repetition", {}).get("items", {})
    words = [str(i.get("content", "")).strip() for i in items.values() if i.get("type", "vocabulary") == "vocabulary"]
    return sorted({w for w in words if re.fullmatch(r"[^\W\d_]{2,40}", w)})


def word_forms():
    """A word's forms in review (companion/GAME.md, "A word's forms"): the dev bridge's GET /forms for the deck's words,
    then QA's "forms" hook starts a review of the words with a form reached, each asking one in a sentence with a gap
    ("Vstavi pravo obliko · Fill in the right form"); one is answered, its feedback shows, the review is left."""
    go_home()
    lemmas = deck_lemmas()
    if not lemmas:
        return "no one-word cards in the deck"
    known = []
    for i in range(0, min(len(lemmas), 200), 40):
        q = "&".join("w=" + urllib.parse.quote(w) for w in lemmas[i:i + 40])
        known += [w["word"] for w in api(f"/forms?{q}")["words"] if any(e.get("slots") for e in w["entries"])]
    if not known:
        return "no word of the deck has forms"
    qa_hook("forms")
    try:
        c = wait_for(FILL_FORM, 25)
        if c is None:
            return f"no form question ({len(known)} words with forms: {', '.join(known[:5])} …)"
        time.sleep(1)
        shot("form-question")
        if find("Preveri · Check"):  # typed: anything, its feedback shows the right form
            field = find("Napiši odgovor") or find("Type your answer")
            if field:
                tap_at(field)
                type_text("x")
            tap("Preveri · Check", 3)
        else:  # chosen: the first option below the sentence with its gap
            gap = next((c for t, c in nodes() if "____" in t), None)
            assert gap is not None, "the sentence with its gap"
            options = [(t, c) for t, c in nodes() if t and c[1] > gap[1] + 30 and "____" not in t and FILL_FORM not in t
                       and not any(n in t for n in NOT_OPTIONS)]
            assert options, "the forms to choose from"
            tap_at(options[0][1])
        assert wait_for("Naprej · Next", 8), "the answer's feedback"
        shot("form-answered")
    finally:
        qa_hook("forms:off")
        go_home()


COUNTING_TITLE = "🔢 Štetje · Counting"  # a counting card's label (l10n counting.title)
COUNTING_ON = "Kartice za štetje so odslej"  # the note when the unit stevila's intro ends (l10n counting.on)
ALL_FOUR = "Vse štiri skupaj · All four together"  # a counting card's end (l10n counting.allFour)
COUNTING_HELP = "Štetje in spol · Counting and gender"  # its cheat sheet link (l10n counting.help)
LET_ME_CHOOSE = "Izberi raje · Let me choose"  # a typed step's way back to the options (l10n adaptive.letMeChoose)
DONE = "Končaj · Done"  # an exercise run's top bar once something is answered (l10n playerScreen.done)
NUMERALS = {1: ("en", "ena", "eno"), 2: ("dva", "dve"), 3: ("trije", "tri"), 5: ("pet",)}


def dev_counting() -> dict:
    """The counting cards of the dev bridge's copy, by noun: their four lines (the item's counting, companion/README.md
    "Counting cards")."""
    items = api("/state").get("databases", {}).get("spaced_repetition", {}).get("items", {})
    return {str(i.get("content")): i["counting"]["lines"] for i in items.values()
            if i.get("type") == "counting" and isinstance(i.get("counting"), dict) and len(i["counting"].get("lines") or []) == 4}


def counting_on_screen(timeout=40.0):
    """The counting card on screen: its noun and four lines (the dev bridge's), or None within [timeout] s."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        texts = [t for t, _ in nodes()]
        if any(COUNTING_TITLE in t for t in texts):
            cards = dev_counting()
            noun = next((t for t in texts if t in cards), None)
            if noun is not None:
                return noun, cards[noun]
        time.sleep(1)
    return None


def step_options(n: int) -> list:
    """The options of step [n] on screen (1: en / ena / eno; 2, 3, 5: a numeral of the count and a word): [(text, xy)]."""
    if n == 1:
        return [(t, c) for t, c in nodes() if t in NUMERALS[1]]
    return [(t, c) for t, c in nodes() if len(t.split()) == 2 and t.split()[0] in NUMERALS[n]]


def wait_options(n: int, timeout=8.0) -> list:
    end = time.time() + timeout * slow()
    while time.time() < end:
        if opts := step_options(n):
            return opts
        time.sleep(0.6)
    return []


def ascii_of(s: str) -> str:
    """What adb types of [s]: no č, š, ž (the app grades a forgotten one almost)."""
    return s.translate(str.maketrans("čšžćđČŠŽĆĐ", "cszcdCSZCD"))


def counting_said(lines: list, timeout=10.0) -> str:
    """How the app said the card's four lines together (the debug build's log, tag Speaker: "said «…»: how"), or ""."""
    want = " ".join(lines).lower()
    end = time.time() + timeout * slow()
    while time.time() < end:
        hit = [l for l in adb("logcat", "-d", "-s", "Speaker:I", check=False).splitlines() if f"said «{want}»" in l]
        if hit:
            return hit[-1].split("»:", 1)[-1].strip()
        time.sleep(1)
    return ""


def counting_cards():
    """Counting cards ("🔢 Štetje · Counting", companion/README.md "Counting cards"): the unit stevila's intro skipped
    ("⏭ Poznam to", QA's hook "counting:intro": the unit as never begun) turns them on, a note says so once; QA's hook
    "counting" asks the dev bridge for the day's cards (its copy's learned nouns) and starts a review of them. A card
    played: step 1 right (the gender's why under it), 💬 attaching the card with its steps so far, step 2 wrong (its
    correction and "Naprej · Next"), 3 and 5 right, all four lines at the end, said by the narrator (the app's log), the
    cheat sheet's counting and gender pages from the card; the review's end, and the dev bridge keeping the wrong step as
    a mistake of its kind. Then typed ("counting:type"): a step typed with the keyboard up, one typed without č/š/ž,
    "✋ Izberi raje" back to the options."""
    go_home()
    if "counting" not in api("/state").get("features", []):
        return "the dev bridge makes no counting cards (an older bridge)"
    adb("logcat", "-c")
    try:
        # the unit stevila's intro, skipped: its end turns counting on, said once
        qa_hook("counting:intro")
        assert tap("Poznam to", 15), "the unit stevila's intro (⏭ Poznam to)"
        assert wait_for(COUNTING_ON, 15), "the note: counting cards in the reviews from now on"
        shot("counting-note")

        # a review of the counting cards the dev bridge makes now
        qa_hook("counting")
        got = counting_on_screen()
        if got is None:
            made = dev_counting()
            return f"no counting card came ({len(made)} on the dev bridge: {', '.join(made) or 'none'})"
        noun, lines = got
        print(f"    {noun}: {', '.join(lines)}")
        shot("counting-card")
        # the cheat sheet's counting and gender pages from the card
        assert tap(COUNTING_HELP, 4), "the card's cheat sheet link"
        assert wait_for("Plonk listek", 6), "the cheat sheet"
        time.sleep(1.5 * slow())
        shot("counting-cheat")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.5)
        # 1: right; its why stays under it
        assert wait_options(1), "step 1's en / ena / eno"
        assert tap(lines[0].split()[0], 3), f"step 1: {lines[0].split()[0]}"
        assert wait_for("💡", 5), "step 1's why (the noun's end, its gender)"
        two = wait_options(2)
        assert two and any(t == lines[1] for t, _ in two), f"step 2's options with {lines[1]}: {two}"
        # 💬 with the card on screen: attached, its steps so far
        assert tap(ASK_BUTTON, 5), "💬 in the review's top bar"
        assert wait_for(CHAT_TITLE, 6), "the chat over the card"
        time.sleep(1)
        chip = attach_chip()
        assert chip is not None and noun in chip, f"the card attached ({chip})"
        print(f"    attached: {chip}")
        shot("counting-chat")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.5)
        # 2: wrong; the right line and Next
        wrong = next((t, c) for t, c in step_options(2) if t != lines[1])
        tap_at(wrong[1])
        assert wait_for("❌", 5) and wait_for("Naprej · Next", 4), "step 2's correction"
        shot("counting-mistake")
        assert tap("Naprej · Next", 3), "on from step 2"
        for n, line in ((3, lines[2]), (5, lines[3])):
            opts = wait_options(n)
            hit = next((c for t, c in opts if t == line), None)
            assert hit, f"step {n}'s options with {line}: {opts}"
            tap_at(hit)
        assert wait_for(ALL_FOUR, 8), "all four lines together at the end"
        how = counting_said(lines, timeout=15.0)
        assert how, "the four lines said together (the app's log, tag Speaker)"
        print(f"    the four lines said: {how}")
        shot("counting-four")
        # the run's feedback, then the review's end (the other cards left: Done)
        assert tap("Naprej · Next", 6), "the card's feedback"
        if wait_for("recalled", 4) is None:
            assert tap(DONE, 6), "the review's Done"
        assert wait_for("recalled", 10), "the review's end"
        shot("counting-review-end")
        # the dev bridge keeps the wrong step as a mistake of its kind
        end = time.time() + 20 * slow()
        kept = []
        while time.time() < end and not kept:
            patterns = api("/state").get("databases", {}).get("mistakes_db", {}).get("error_patterns", {})
            kept = [k for k, p in patterns.items() if k.startswith("counting_") and any(e.get("incorrect") == wrong[0] for e in p.get("examples", []))]
            time.sleep(1)
        assert kept, f"the dev bridge's mistakes: «{wrong[0]}» kept as a counting mistake"
        print(f"    «{wrong[0]}» for «{lines[1]}» kept as {kept[0]}")
        go_home()

        # typed: as if every card were secure
        qa_hook("counting:type")
        qa_hook("counting")
        got = counting_on_screen()
        assert got, "a counting card, typed"
        noun, lines = got
        field = wait_for("en / ena / eno", 6)
        assert field, "step 1's field"
        tap_at(field)
        top = keyboard_settled()
        assert top is not None, "the keyboard up for the typed step"
        time.sleep(1)  # the typed step scrolled into view with the keyboard up
        check = find("Preveri · Check")
        assert check and check[1] < top, f"Check above the keyboard ({check}, its top {top})"
        shot("counting-typed")
        type_text(lines[0].split()[0])
        assert tap("Preveri · Check", 3), "check step 1"
        field = wait_for("Napiši odgovor", 8) or wait_for("Type your answer", 2)
        assert field, "step 2's field"
        tap_at(field)
        type_text(ascii_of(lines[1]))
        assert tap("Preveri · Check", 3), "check step 2"
        assert wait_for(LET_ME_CHOOSE, 8), "step 3, typed, and its way back to the options"
        shot("counting-typed-2")
        assert tap(LET_ME_CHOOSE, 3), "let me choose"
        opts = wait_options(3)
        assert any(t == lines[2] for t, _ in opts), f"step 3's options after Let me choose: {opts}"
        shot("counting-let-me-choose")
    except Exception:
        shot("counting-failed")  # where it stopped, before the way home
        raise
    finally:
        qa_hook("counting:off")
        go_home()


NUMBERS_OPEN_INTRO = "Odpri uvod · Open the intro"  # the closed module's way to the intro (l10n numbers.openIntro)
NUMBERS_LOCKED = "Odpre jih uvod enote"  # what opens it (l10n numbers.lockedIntro)
NUMBERS_ON = "Števila so odprta"  # the note when the unit stevila's intro ends (l10n numbers.on)
NUMBERS_START = "Začni · Start"  # the module's ▶️ (l10n numbers.start)
NUMBERS_ASK = {  # each way's instruction (l10n numbers.ask.<mode>)
    "hear": "Poslušaj in vtipkaj število", "read": "Preberi in vtipkaj število", "write": "Napiši z besedo",
    "date": "Dopolni datum", "time_hear": "Poslušaj in vtipkaj uro",
}
NUMBERS_OPENED = "Novo odprto"  # a run's end, a range opened (l10n numbers.opened)
NUMBERS_BACK = "Pridejo spet"  # a run's end, the numbers missed (l10n numbers.comingBack)
CONTINUE = "Naprej · Continue"  # a run's end (l10n common.continue)
NEXT = "Naprej · Next"  # an answer's feedback (l10n common.next)
SL_ONES = ["nič", "ena", "dva", "tri", "štiri", "pet", "šest", "sedem", "osem", "devet"]
SL_TEENS = ["deset", "enajst", "dvanajst", "trinajst", "štirinajst", "petnajst", "šestnajst", "sedemnajst", "osemnajst", "devetnajst"]
SL_TENS = ["", "", "dvajset", "trideset", "štirideset", "petdeset", "šestdeset", "sedemdeset", "osemdeset", "devetdeset"]
SL_ORD = ["", "prvi", "drugi", "tretji", "četrti", "peti", "šesti", "sedmi", "osmi", "deveti"]
HOURS_AT = ["enih", "dveh", "treh", "štirih", "petih", "šestih", "sedmih", "osmih", "devetih", "desetih", "enajstih", "dvanajstih"]


def sl_number(n: int) -> str:
    """[n] in Slovene words as the app counts it (data/SpokenNumbers.slovene): 27 sedemindvajset, 2026 dva tisoč šestindvajset."""
    if n < 10:
        return SL_ONES[n]
    if n < 20:
        return SL_TEENS[n - 10]
    if n < 100:
        return SL_TENS[n // 10] if n % 10 == 0 else SL_ONES[n % 10] + "in" + SL_TENS[n // 10]
    if n < 1000:
        head = {1: "sto", 2: "dvesto"}.get(n // 100, SL_ONES[n // 100] + "sto")
        return head if n % 100 == 0 else f"{head} {sl_number(n % 100)}"
    head = "tisoč" if n // 1000 == 1 else f"{sl_number(n // 1000)} tisoč"
    return head if n % 1000 == 0 else f"{head} {sl_number(n % 1000)}"


NUMBER_WORDS = {sl_number(n): n for n in range(10000)}
CLOCK_WORDS = {**{f"ob {HOURS_AT[h - 1]}": f"{h}:00" for h in range(1, 13)}, **{f"ob pol {HOURS_AT[h % 12]}": f"{h}:30" for h in range(1, 13)}}


def numbers_said(timeout=15.0) -> str:
    """What the app said last (the debug build's log, tag Speaker: "said «…»: how"), or ""; the log cleared before."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        hit = re.findall(r"said «(.*?)»", adb("logcat", "-d", "-s", "Speaker:I", check=False))
        if hit:
            return hit[-1]
        time.sleep(1)
    return ""


def pad_type(figures: str):
    """[figures] tapped on the number pad (its keys' labels: "1" … "9", "0", "Dvopičje · Colon"), below the prompt."""
    for ch in figures:
        label = "Dvopičje · Colon" if ch == ":" else ch
        keys = [c for t, c in nodes() if t == label and c[1] > 900]
        assert keys, f"the pad's key {label}"
        tap_at(max(keys, key=lambda c: c[1]))


def numbers_on_screen(timeout=10.0):
    """The task's figures shown (a node of figures alone, above the pad or the field), or None."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        figs = [t for t, c in nodes() if re.fullmatch(r"\d{1,4}", t) and c[1] < 900]
        if figs:
            return int(figs[0])
        time.sleep(1)
    return None


def word_on_screen(timeout=10.0):
    """The number word shown to read ("sedemindvajset"), or None."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        words = [t for t, _ in nodes() if t in NUMBER_WORDS]
        if words:
            return words[0]
        time.sleep(1)
    return None


def numbers_run_end():
    """Leaves the run on screen: its answer's feedback on (the run keeps an answer once on to the next), then its
    "Končaj · Done" (its end: how it went), and back to the module's screen."""
    assert tap(NEXT, 6), "on from the answer"
    assert tap(DONE, 6), "the run's Done"
    assert wait_for(CONTINUE, 10), "the run's end"
    assert tap(CONTINUE, 4), "back from the run's end"
    assert wait_for(NUMBERS_START, 8), "the module's screen again"


def numbers():
    """"🔢 Števila · Numbers" (companion/README.md "Numbers"): closed (QA's hook "numbers:locked": the unit stevila as never
    begun), what opens it and "📖 Odpri uvod" one tap to the unit's intro, skipped there ("⏭ Poznam to"): its note, the
    module open with 0–10 and 11–20; a number heard (the app's log says which) typed on the number pad, right; with the
    ranges up to 21–99 open ("numbers:ranges:21-99") a number's figures and its word typed with the tens first, the order's
    why; the unit kdaj-cas's intro done ("numbers:time"): a clock time heard and typed with the pad's colon; a date's
    ordinal; then a whole run read → figures with the newest range one right answer from the next ("numbers:near"), one
    figure swapped: its end says the range opened and the number that comes back, the dev bridge's village keeps both, and
    the run reached the dev tutor as a session_end."""
    go_home()
    try:
        # closed: what opens it, one tap to the unit's intro
        qa_hook("numbers:locked")
        assert wait_for(NUMBERS_OPEN_INTRO, 12), "the closed module's 📖 Odpri uvod"
        assert wait_for(NUMBERS_LOCKED, 3), "what opens it"
        shot("numbers-locked")
        assert tap(NUMBERS_OPEN_INTRO, 3), "📖 Odpri uvod"
        assert wait_for("Poznam to", 12), "the unit stevila's intro, one tap away"
        shot("numbers-intro")
        assert tap("Poznam to", 4), "⏭ Poznam to"
        assert wait_for(NUMBERS_ON, 45), "the note: the numbers are open"
        shot("numbers-note")

        # open: its first two ranges; 🎧 a number heard, typed on the pad
        qa_hook("numbers:only:hear")
        qa_hook("numbers")
        assert wait_for(NUMBERS_START, 10), "▶️ Začni"
        assert wait_for("11–20", 4), "the first two ranges open"
        shot("numbers-open")
        adb("logcat", "-c")
        assert tap(NUMBERS_START, 4), "start a run"
        assert wait_for(NUMBERS_ASK["hear"], 12), "a number to hear"
        said = numbers_said()
        assert said in NUMBER_WORDS, f"the number said ({said!r})"
        n = NUMBER_WORDS[said]
        print(f"    heard «{said}»: {n}")
        pad_type(str(n))
        assert wait_for(f"Vtipkano: {n}", 4), "the pad shows what was typed"
        shot("numbers-pad")
        assert tap("Preveri · Check", 3), "check the figures"
        assert wait_for("✅", 6), "right"
        shot("numbers-pad-right")
        numbers_run_end()

        # ✍️ figures → the word, with 21–99 open: the tens first, the order's why
        qa_hook("numbers:ranges:21-99")
        qa_hook("numbers:only:write")
        qa_hook("numbers")
        assert tap(NUMBERS_START, 8), "start a run"
        shown = None
        for _ in range(10):  # to a number of 21–99 (60 % of a run's new ones)
            assert wait_for(NUMBERS_ASK["write"], 10), "figures to write"
            shown = numbers_on_screen()
            assert shown is not None, "the figures shown"
            field = wait_for(ANSWER_FIELD, 6)
            assert field, "the answer field"
            if 21 <= shown <= 99 and shown % 10:
                break
            tap_at(field)
            type_text(ascii_of(sl_number(shown)))
            assert tap("Preveri · Check", 3), "check the word"
            assert tap(NEXT, 6), "on to the next"
        assert shown is not None and 21 <= shown <= 99 and shown % 10, f"a number of 21–99 to write ({shown})"
        tap_at(field)
        top = keyboard_settled()
        tens_first = f"{SL_TENS[shown // 10]} {SL_ONES[shown % 10]}"
        type_text(ascii_of(tens_first))
        shot("numbers-write")
        assert tap("Preveri · Check", 3), "check the word"
        assert wait_for("❌", 6), "wrong: the tens first"
        assert wait_for(sl_number(shown), 4), f"the right word ({sl_number(shown)})"
        assert wait_for("ones first", 4) or wait_for("najprej enice", 2), "the order's why"
        print(f"    {shown}: «{tens_first}» for «{sl_number(shown)}», the order's why shown")
        shot("numbers-write-order")
        numbers_run_end()

        # ⏰ a clock time by ear, once the unit kdaj-cas's intro is done: "ob pol šestih" → 5:30, the pad's colon
        qa_hook("numbers:time")
        qa_hook("numbers:only:time_hear")
        qa_hook("numbers")
        adb("logcat", "-c")
        assert tap(NUMBERS_START, 8), "start a run"
        assert wait_for(NUMBERS_ASK["time_hear"], 12), "a time to hear"
        said = numbers_said()
        assert said in CLOCK_WORDS, f"the time said ({said!r})"
        pad_type(CLOCK_WORDS[said])
        shot("numbers-time")
        assert tap("Preveri · Check", 3), "check the time"
        assert wait_for("✅", 6), f"right: «{said}» is {CLOCK_WORDS[said]}"
        print(f"    heard «{said}»: {CLOCK_WORDS[said]}")
        shot("numbers-time-right")
        numbers_run_end()

        # 📅 a date's day: its ordinal ("Danes je ___ maj. (15.)")
        qa_hook("numbers:only:date")
        qa_hook("numbers")
        assert tap(NUMBERS_START, 8), "start a run"
        assert wait_for(NUMBERS_ASK["date"], 10), "a date to fill in"
        frame = next((t for t, _ in nodes() if t.startswith("Danes je ___")), "")
        m = re.search(r"\((\d+)\.\)", frame)
        assert m, f"the date's frame ({frame!r})"
        day = int(m.group(1))
        ordinal = SL_ORD[day] if day < 10 else sl_number(day) + "i"
        field = wait_for(ANSWER_FIELD, 6)
        assert field, "the answer field"
        tap_at(field)
        type_text(ascii_of(ordinal))
        assert tap("Preveri · Check", 3), "check the date"
        assert wait_for("🟡", 6) or wait_for("✅", 2), f"«{ordinal}» typed without č, š, ž: almost, or right"
        shot("numbers-date")
        numbers_run_end()

        # a whole run, read → figures, the newest range (21–99) one right answer from the next; one figure swapped
        qa_hook("numbers:near")
        qa_hook("numbers:only:read")
        qa_hook("numbers")
        assert tap(NUMBERS_START, 8), "start a run"
        swapped = None
        for i in range(10):
            assert wait_for(NUMBERS_ASK["read"], 10), f"task {i + 1}: a word to read"
            w = word_on_screen()
            assert w, "the word shown"
            n = NUMBER_WORDS[w]
            typed = str(n)
            if swapped is None and 21 <= n % 100 <= 99 and n % 10 and (n // 10) % 10 != n % 10:
                typed = str(n - n % 100 + (n % 10) * 10 + (n // 10) % 10)
                swapped = (n, typed)
            pad_type(typed)
            assert tap("Preveri · Check", 3), "check"
            assert wait_for(NEXT, 6), "the answer's feedback"
            tap(NEXT, 3)
        assert wait_for(CONTINUE, 15), "the run's end"
        assert wait_for(NUMBERS_OPENED, 4), "the range it opened"
        if swapped:
            assert wait_for(NUMBERS_BACK, 3), "the number missed, coming back"
        shot("numbers-end")
        # the dev bridge's village keeps the ranges and the number missed; the dev tutor heard the run
        kept = api("/game").get("state", {}).get("numbers", {})
        assert "100-999" in kept.get("opened", {}), f"the dev bridge's village: 100–999 open ({kept.get('opened')})"
        if swapped:
            assert any(a.get("n") == swapped[0] and a.get("mode") == "read" for a in kept.get("again", [])), f"{swapped[0]} coming back ({kept.get('again')})"
        end = time.time() + 20 * slow()
        while time.time() < end and "Practised the numbers" not in (OUT / "bridge.log").read_text(errors="replace"):
            time.sleep(1)
        assert "Practised the numbers" in (OUT / "bridge.log").read_text(errors="replace"), "the run's session_end at the dev tutor"
        print(f"    the end: 100–999 opened{f', {swapped[0]} typed {swapped[1]}: coming back' if swapped else ''}; the dev tutor heard it")
        assert tap(CONTINUE, 4), "back to the module's screen"
        assert wait_for("100–999", 6), "the ladder with 100–999 open"
        shot("numbers-ladder")
    except Exception:
        shot("numbers-failed")
        raise
    finally:
        qa_hook("numbers:only:")
        go_home()


FORMS_ALL = "Vse oblike · All forms"  # a word card's button (l10n formsCard.allForms)
FORMS_PLAY = "Vadi zdaj · Practise now"  # once its card is made (l10n formsCard.playNow)
FORMS_WHOLE = "Vsa tabela · The whole table"  # a forms card's end (l10n formsCard.whole)
FORMS_HELP = "Pravila v knjigi · The rules in the book"  # its cheat sheet link (l10n formsCard.help)
FORMS_GREY = "še ni predstavljeno"  # a greyed cell's label for TalkBack (l10n formsCard.preview)
FORMS_BACK = "Nove oblike v tabelah"  # the note when a unit brings cards back (l10n formsCard.back)
FORMS_FRESH = "Novo v tabeli"  # a card's newly introduced part (l10n formsCard.fresh)
FORMS_PRACTISE = "Vadi oblike · Practise the forms"  # the overview's way to a card (l10n formsView.practise)
FORMS_SECTIONS = re.compile(r"FormsCard\s*:\s*sections (.*) hidden (.*)$")
FORMS_VIEW = re.compile(r"FormsView\s*:\s*(\S+) sections (.*) practised (\d+)/(\d+)$")
MY_WORDS = "Moje besede · My words"  # its title (l10n myWords.title)
MY_WORDS_LOG = re.compile(r"MyWords\s*:\s*«(.*)» (\d+) of (\d+); dictionary (\S+)$")
FORMS_GAP = re.compile(r"FormsCard\s*:\s*gap (\d+)/(\d+) (\S+) «(.*)» \[(.*)\] (typed|chosen)$")
def scroll_up(swipes=2):
    """Scrolls the run up [swipes] times (the card's head and the table's top, above the gap kept in view)."""
    for _ in range(swipes):
        adb("shell", "input", "swipe", "540", "1000", "540", "1900", "400")  # within the run's scroll, under its header
        time.sleep(0.8)


def forms_on(word: str, timeout=20.0):
    """A forms card of [word] on screen: its gap's line ("📋 miza · 1/5 · …", under the table, kept in view), or None."""
    return wait_for(f"📋 {word} · ", timeout)


FORMS_NOUN = "miza"  # a noun the dev bridge's copy has learned (Jan's: from the kitchen's pack)
FORMS_VERB = "delati"  # and a verb, its imperative not introduced (the unit velelnik not begun)


def dev_forms() -> dict:
    """The forms cards of the dev bridge's copy, by word: their items (type forms, companion/README.md "Forms cards")."""
    items = api("/state").get("databases", {}).get("spaced_repetition", {}).get("items", {})
    return {str(i.get("content")): {**i, "id": k} for k, i in items.items() if i.get("type") == "forms" and isinstance(i.get("forms"), dict)}


def forms_gap(after=0, timeout=12.0, typed=None):
    """The gap a forms card asks now, as the debug build logged it (tag FormsCard): (index, of, key, answer, options,
    typed), the latest with an index past [after] (and asked so: [typed]); None within [timeout] s."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        hits = [m for l in adb("logcat", "-d", "-s", "FormsCard:I", check=False).splitlines() if (m := FORMS_GAP.search(l.strip()))]
        if hits and int(hits[-1].group(1)) > after and (typed is None or (hits[-1].group(6) == "typed") == typed):
            m = hits[-1]
            return int(m.group(1)), int(m.group(2)), m.group(3), m.group(4), [o for o in m.group(5).split("|") if o], m.group(6) == "typed"
        time.sleep(0.8)
    return None


def gap_option(text: str, timeout=6.0):
    """Where option [text] of the gap on screen is (a card of its own, below the table; scrolled down to when the run was
    scrolled up): its centre, or None."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        ns = list(nodes())
        hits = [c for t, c in ns if t == text and c[1] < 2250]
        # the option: below the gap's line, and below the table's cell of the same form
        line = next((c for t, c in ns if t.startswith("📋 ") and " · " in t and "/" in t), None)
        hits = [c for c in hits if line is None or c[1] > line[1]]
        if hits:
            return max(hits, key=lambda c: c[1])
        adb("shell", "input", "swipe", "540", "1600", "540", "900", "300")
        time.sleep(0.6)
    return None


def play_forms(wrong_first=False) -> tuple:
    """Plays the forms card on screen to its end: each gap chosen right (the first wrong when [wrong_first]: its
    correction, a screenshot, "Naprej · Next"). (the first gap's key, what was answered wrong or "", its right form)."""
    g = forms_gap()
    assert g, "a gap asked (the app's log, tag FormsCard)"
    first, wrong = g, ""
    while True:
        i, n, key, answer, options, typed = g
        assert not typed, f"gap {i} chosen ({g})"
        assert answer in options and len(options) == 3, f"gap {i}: three options with {answer} ({options})"
        pick = next(o for o in options if o != answer) if wrong_first and i == 1 else answer
        c = gap_option(pick)
        assert c, f"gap {i}'s option {pick}"
        tap_at(c)
        if pick != answer:
            wrong = pick
            assert wait_for("❌", 5) and wait_for("Naprej · Next", 4), "the wrong gap's correction"
            shot("forms-mistake")
            assert tap("Naprej · Next", 3), "on from the wrong gap"
        if i == n:
            break
        g = forms_gap(after=i)
        assert g, f"gap {i + 1} after {i}"
    return first[2], wrong, first[3]


def forms_said(word: str, timeout=12.0) -> str:
    """How the app said a card's rows at its end (tag Speaker: "said «…»: how", with [word] in it), or ""."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        hit = [l for l in adb("logcat", "-d", "-s", "Speaker:I", check=False).splitlines() if "said «" in l and word.lower() in l.lower()]
        if hit:
            return hit[-1].split("»:", 1)[-1].strip()
        time.sleep(1)
    return ""


def review_end():
    """The run's feedback after the card, then the review's end (the other cards left: Done)."""
    assert tap("Naprej · Next", 8), "the card's feedback"
    if wait_for("recalled", 4) is None:
        assert tap(DONE, 6), "the review's Done"
    assert wait_for("recalled", 10), "the review's end"


def forms_note(timeout=30.0) -> str:
    """The note that a unit's intro brought forms cards back ("📋 Nove oblike v tabelah …", a snackbar of four seconds,
    after the book's own news): watched with screen dumps as fast as the emulator gives them; one that came and went
    between two dumps still shows in the app's log (tag FormsCard: "note …", a debug build). How it was seen, or ""."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        if any(FORMS_BACK in t for t, _ in nodes()):
            return "on screen"
        if any("FormsCard" in l and f"note 📋 {FORMS_BACK}" in l for l in adb("logcat", "-d", "-s", "FormsCard:I", check=False).splitlines()):
            return "shown (the app's log: between two screen dumps)"
        time.sleep(0.2)
    return ""


def forms_sections(word="", timeout=12.0):
    """The sections the forms card on screen shows and those it hides (no gap asked in them), as the debug build logged
    them (tag FormsCard): (shown, hidden), the latest; None within [timeout] s."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        hits = [m for l in adb("logcat", "-d", "-s", "FormsCard:I", check=False).splitlines() if (m := FORMS_SECTIONS.search(l))]
        if hits:
            m = hits[-1]
            return [x for x in m.group(1).split("|") if x], [x for x in m.group(2).split("|") if x]
        time.sleep(1)
    return None


def forms_view(word: str, timeout=15.0):
    """The overview of [word] on screen, as the debug build logged it (tag FormsView): (sections, practised, forms), or None."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        hits = [m for l in adb("logcat", "-d", "-s", "FormsView:I", check=False).splitlines() if (m := FORMS_VIEW.search(l)) and m.group(1) == word]
        if hits:
            m = hits[-1]
            return m.group(2).split("|"), int(m.group(3)), int(m.group(4))
        time.sleep(1)
    return None


def my_words_log(query: str, dictionary=None, timeout=12.0):
    """What "📚 Moje besede" shows for [query] (tag MyWords): (shown, of, the dictionary's state), the latest; with
    [dictionary], waits for that state ("Found", "NotFound" …). None within [timeout] s."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        hits = [m for l in adb("logcat", "-d", "-s", "MyWords:I", check=False).splitlines() if (m := MY_WORDS_LOG.search(l)) and m.group(1) == query]
        if hits and (dictionary is None or hits[-1].group(4) == dictionary):
            m = hits[-1]
            return int(m.group(2)), int(m.group(3)), m.group(4)
        time.sleep(1)
    return None


def forms_cards():
    """Forms cards ("📋 Oblike · Forms", companion/README.md "Forms cards"): "📋 Vse oblike · All forms" on a noun's word card
    (QA's hook "formscard:word:<word>") opens its overview, whose "🃏 Vadi oblike" makes its card at once on the dev
    bridge and offers "▶ Vadi zdaj"; its table: the forms the copy's pages introduced as gaps, the dative's row greyed
    (dajalnik not met); the rules' pages from the card,
    💬 attaching it, the first gap wrong (its correction), the rest right, the rows said together at the end (the narrator,
    a clip made on demand), the review's end, the mistake kept by the dev bridge by kind (forms_*). A verb's card (QA's
    hook "formscard:<word>"): its imperative hidden (no gap in it), played through. The day's cards in a review ("formscard"): the core
    verbs made, among the due cards. Typed ("formscard:type"): a gap typed with the keyboard up, Check above it, one typed
    without č/š/ž, "✋ Izberi raje" back to the options. The unit velelnik's intro done ("formscard:unit:velelnik"): the
    note, the verb's card due again within days, its repetitions back to 0, its imperative newly tested, then played
    first, chosen."""
    go_home()
    if "forms-cards" not in api("/state").get("features", []):
        return "the dev bridge makes no forms cards (an older bridge)"
    adb("logcat", "-c")
    try:
        # the first units' intros done, as a learner past them has them (a synthetic copy has nothing introduced: no card
        # to make, a noun's card one gap); the dative stays not met, the imperative's unit not begun
        for unit in ("biti", "sedanjik", "mnozina", "tozilnik"):
            qa_hook(f"formscard:unit:{unit}")
            time.sleep(3 * slow())
        go_home()
        # "📋 Vse oblike" on a noun's word card: its card at once
        qa_hook(f"formscard:word:{FORMS_NOUN}")
        assert wait_for(FORMS_NOUN, 15), "the word card"
        c = wait_for(FORMS_ALL, 10)  # under the word's entry, at the sheet's foot
        assert c, "📋 Vse oblike on the word card"
        shot("forms-word-card")
        tap_at(c)
        assert forms_view(FORMS_NOUN), "the word's overview"
        shot("forms-overview")
        practise = sheet_find(FORMS_PRACTISE, swipes=10)
        assert practise, "🃏 Vadi oblike in the overview"
        tap_at(practise)
        assert wait_for(FORMS_PLAY, 20), "▶ Vadi zdaj once the card is made"
        made = dev_forms()
        assert FORMS_NOUN in made, f"the dev bridge's forms cards: {', '.join(made) or 'none'}"
        noun = made[FORMS_NOUN]
        assert noun["due_date"] <= time.strftime("%Y-%m-%d"), f"due today ({noun['due_date']})"
        print(f"    {FORMS_NOUN}: {len(noun['forms']['slots'])} forms, {len(noun['forms']['tested'])} tested"
              f"{', made on demand' if noun['forms'].get('asked') else ', made by itself before'}")
        shot("forms-made")
        assert tap(FORMS_PLAY, 3), "▶ Vadi zdaj"
        assert forms_on(FORMS_NOUN), "the forms card"
        time.sleep(1.5)
        shot("forms-noun")
        scroll_up(3)
        time.sleep(0.5)
        shot("forms-noun-top")
        assert scroll_to(FORMS_GREY, swipes=3), "a greyed cell (the dative's row: not introduced)"
        shot("forms-noun-grey")
        # the rules' pages on the cheat sheet (under the word, at the card's top)
        scroll_up(4)
        assert tap(FORMS_HELP, 4), "the card's cheat sheet link"
        assert wait_for("Plonk listek", 6), "the cheat sheet"
        time.sleep(1.5 * slow())
        shot("forms-cheat")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.5)
        # 💬 with the card on screen: attached
        assert tap(ASK_BUTTON, 5), "💬 in the review's top bar"
        assert wait_for(CHAT_TITLE, 6), "the chat over the card"
        time.sleep(1)
        chip = attach_chip()
        assert chip is not None and FORMS_NOUN in chip, f"the card attached ({chip})"
        print(f"    attached: {chip}")
        shot("forms-chat")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.5)
        key, wrong, right = play_forms(wrong_first=True)
        assert wait_for(FORMS_WHOLE, 8), "the whole table at the end"
        how = forms_said(right, timeout=15.0)
        assert how, "the rows said together (the app's log, tag Speaker)"
        print(f"    the rows said: {how}")
        shot("forms-whole")
        review_end()
        shot("forms-review-end")
        # the dev bridge keeps the wrong gap as a mistake of its kind
        end = time.time() + 20 * slow()
        kept = []
        while time.time() < end and not kept:
            patterns = api("/state").get("databases", {}).get("mistakes_db", {}).get("error_patterns", {})
            kept = [k for k, p in patterns.items() if k.startswith("forms_") and any(e.get("incorrect") == wrong for e in p.get("examples", []))]
            time.sleep(1)
        assert kept, f"the dev bridge's mistakes: «{wrong}» for {key} kept as a forms mistake"
        print(f"    «{wrong}» for «{right}» ({key}) kept as {kept[0]}")
        go_home()

        # a verb's card: its imperative greyed (the unit velelnik not begun)
        adb("logcat", "-c")
        qa_hook(f"formscard:{FORMS_VERB}")
        assert forms_on(FORMS_VERB), "the verb's forms card"
        time.sleep(1.5)
        shot("forms-verb")
        verb = dev_forms().get(FORMS_VERB)
        assert verb, "the verb's card on the dev bridge"
        imperative = [s["key"] for s in verb["forms"]["slots"] if s["key"].startswith("imp.")]
        assert imperative and not any(k in verb["forms"]["tested"] for k in imperative), f"its imperative not tested yet ({verb['forms']['tested']})"
        sections = forms_sections()
        assert sections and any("velelnik" in t for t in sections[1]) and not any("velelnik" in t for t in sections[0]), f"its imperative hidden ({sections})"
        print(f"    {FORMS_VERB}: shows {', '.join(sections[0])}; hidden {', '.join(sections[1])}")
        play_forms()
        assert wait_for(FORMS_WHOLE, 8), "the verb's whole table"
        shot("forms-verb-whole")
        review_end()
        go_home()

        # the day's cards of their own accord, in a review
        adb("logcat", "-c")
        qa_hook("formscard")
        assert forms_gap(timeout=25) and wait_for("📋 ", 5), "a review of the day's forms cards"
        shot("forms-review")
        cards = dev_forms()
        due = set(api("/state").get("computed", {}).get("due_review_items", []))
        auto = [w for w, i in cards.items() if not i["forms"].get("asked")]
        print(f"    forms cards: {', '.join(f'{w}{'' if i['forms'].get('asked') else ' (by itself)'}' for w, i in cards.items())}; due: {sum(i['id'] in due for i in cards.values())}")
        assert 1 <= len(auto) <= 2, f"one or two made by themselves today ({auto})"
        assert any(w in ("biti", "imeti", "iti") for w in auto), f"the core verbs first ({auto})"
        go_home()

        # typed: as if every card were secure
        adb("logcat", "-c")
        qa_hook("formscard:type")
        qa_hook(f"formscard:{FORMS_NOUN}")
        g = forms_gap(timeout=20)
        assert g and g[5], f"a typed gap ({g})"
        field = wait_for("Napiši odgovor", 8) or wait_for("Type your answer", 2)
        assert field, "the gap's field"
        tap_at(field)
        top = keyboard_settled()
        assert top is not None, "the keyboard up for the typed gap"
        time.sleep(1)
        check = find("Preveri · Check")
        assert check and check[1] < top, f"Check above the keyboard ({check}, its top {top})"
        shot("forms-typed")
        type_text(ascii_of(g[3]))
        assert tap("Preveri · Check", 3), "check the first gap"
        g2 = forms_gap(after=g[0])
        assert g2, "the next gap"
        assert wait_for(LET_ME_CHOOSE, 8), "the next gap, typed, and its way back to the options"
        shot("forms-typed-2")
        assert tap(LET_ME_CHOOSE, 3), "let me choose"
        g3 = forms_gap(after=g2[0] - 1, timeout=6, typed=False)
        assert g3 and not g3[5] and gap_option(g3[3]), f"the gap's options after Let me choose ({g3})"
        shot("forms-let-me-choose")
        qa_hook("formscard:off")
        go_home()

        # a unit's intro done: the verb's imperative rows become gaps, its card back within days, its new part first
        before = dev_forms()[FORMS_VERB]
        adb("logcat", "-c")
        qa_hook("formscard:unit:velelnik")
        how = forms_note(30)
        assert how, "the note: new forms in the tables (on screen, or the app's log, tag FormsCard)"
        print(f"    the note: {how}")
        shot("forms-unit-note")
        end = time.time() + 20 * slow()
        after = before
        while time.time() < end and not after["forms"].get("fresh"):
            after = dev_forms()[FORMS_VERB]
            time.sleep(1)
        fresh = after["forms"].get("fresh") or []
        assert fresh and all(k.startswith("imp.") for k in fresh), f"the verb's imperative newly tested ({fresh})"
        soon = time.strftime("%Y-%m-%d", time.localtime(time.time() + 3 * 86400))
        assert after["due_date"] <= soon and after["repetitions"] == 0 and after["interval_days"] == 1, \
            f"due within days as new learning ({after['due_date']}, repetitions {after['repetitions']}, interval {after['interval_days']})"
        assert after.get("total_reviews", 0) >= before.get("total_reviews", 0) and after.get("review_history") == before.get("review_history"), "its history kept"
        print(f"    {FORMS_VERB}: back {after['due_date']}, new: {', '.join(fresh)}")
        go_home()
        adb("logcat", "-c")
        qa_hook(f"formscard:{FORMS_VERB}")
        g = forms_gap(timeout=20)
        assert g and g[2].startswith("imp.") and not g[5], f"the imperative asked first, chosen ({g})"
        time.sleep(1)
        shot("forms-fresh")
        scroll_up(3)
        assert wait_for(FORMS_FRESH, 5), "🆕 its new part, above the table"
        shot("forms-fresh-top")
        for _ in range(4):  # back down to the gap
            adb("shell", "input", "swipe", "540", "1600", "540", "600", "400")
            time.sleep(0.8)
        play_forms()
        assert wait_for(FORMS_WHOLE, 8), "the whole table"
        shot("forms-fresh-whole")
    except Exception:
        shot("forms-failed")  # where it stopped, before the way home
        raise
    finally:
        qa_hook("formscard:off")
        go_home()


def found_village():
    """A dev bridge's copy without a village (a synthetic learner, LANI_DEV_DATA): founded here, as the learner would
    ("✓ Tu bo moja vas · My village will be here"); nothing when there is one. With LANI_QA_FOUND_SEED the place is that
    seed's (QA's hook "seed:<n>"; 551323397: Teo's coast), its preview shot first (founding-preview; also as
    coast-preview.png in $LANI_QA_COAST_SHOTS)."""
    c = wait_for("Kje bo tvoja vas", 4)
    if c is None:
        return
    if seed := os.environ.get("LANI_QA_FOUND_SEED"):
        qa_hook(f"seed:{seed}")
        time.sleep(2 * slow())
        # the picture whole under the landscapes' chips
        for _ in range(2):
            adb("shell", "input", "swipe", "540", "1500", "540", "1000", "300")
            time.sleep(0.6)
        time.sleep(1.5)
        shot("founding-preview")
        if d := os.environ.get("LANI_QA_COAST_SHOTS"):
            Path(d).mkdir(parents=True, exist_ok=True)
            shutil.copy(shots[-1], Path(d) / "coast-preview.png")
    for _ in range(3):  # its foot: the button under the picture (the screen scrolls only so far)
        adb("shell", "input", "swipe", "540", "1600", "540", "900", "300")
        time.sleep(0.6)
    here = find("Tu bo moja vas")
    assert here, "the founding screen's ✓ Tu bo moja vas"
    tap_at(here)
    time.sleep(3 * slow())


FORMS_TEST_WORD = "biti"  # a core verb: its card made on demand, its present asked first


def sheet_find(text: str, swipes=6):
    """[text] in a sheet, scrolling it down: a button at a sheet's foot rests below scroll_to's band. Its centre, or None."""
    for k in range(swipes + 1):
        c = next((c for t, c in nodes() if text in t and 250 < c[1] < 2250), None)
        if c is not None:
            return c
        adb("shell", "input", "swipe", "540", "1600", "540", "900", "400")
        time.sleep(1)
    return None


def forms_view_step():
    """The forms cards' view (Jan after the first test, with biti: "all is there … for tests it makes sense only to show
    the table which is tested"; "I like it as a general overview … a word list, quick lookup"): the unit biti's intro done
    ("formscard:unit:biti": biti, zanikanje and dvojina introduced), biti's card in a test (QA's hook "formscard:biti",
    made on demand): only its present shown (the first part: the present's first two rows), the negative, future, past and
    imperative hidden; played through, "📋 Vse oblike" at its end opens the overview over the run: every section, the
    present and the negative marked as practised. "📋 Vse oblike" on a word's card opens the overview at once ("🃏 Vadi
    oblike" there for a word without a card). "📚 Moje besede" from Napredek's words line: the list; a search filtering
    it, its field above the keyboard; a word not the learner's looked up in the dictionary; a word opened from the list,
    its card with "📋 Vse oblike"."""
    go_home()
    found_village()
    go_home()
    if "forms-cards" not in api("/state").get("features", []):
        return "the dev bridge makes no forms cards (an older bridge)"
    notes = []
    adb("logcat", "-c")
    try:
        # the unit biti's intro done: biti's present and negative (and the dual) introduced
        qa_hook("formscard:unit:biti")
        time.sleep(3 * slow())
        go_home()
        adb("logcat", "-c")
        fresh = FORMS_TEST_WORD not in dev_forms()
        qa_hook(f"formscard:{FORMS_TEST_WORD}")
        assert forms_on(FORMS_TEST_WORD), "biti's forms card"
        sections = forms_sections()
        assert sections, "the sections shown (the app's log, tag FormsCard)"
        shown, hidden = sections
        card = dev_forms().get(FORMS_TEST_WORD)
        assert card, "biti's card on the dev bridge"
        assert hidden and len(shown) + len(hidden) == 5, f"some of biti's five tables hidden ({sections})"
        new_part = card["forms"].get("fresh") or []
        if new_part:
            # a part newly introduced (the imperative after the unit velelnik, in the step forms-card): its tables first
            if all(k.startswith("imp.") for k in new_part):
                assert shown == [t for t in shown if "velelnik" in t], f"the new imperative's table alone ({sections})"
        elif fresh or card.get("total_reviews", 0) == 0:
            assert len(shown) == 1 and "sedanjik" in shown[0], f"the present alone in its first test ({sections})"
            assert all(any(t in h for h in hidden) for t in ("prihodnjik", "preteklik", "velelnik")), f"the future, the past, the imperative hidden ({sections})"
        notes.append(f"test: {' + '.join(shown)}; hidden {len(hidden)}")
        time.sleep(1.5)
        scroll_up(4)
        time.sleep(0.8)
        shot("forms-view-test")
        for _ in range(4):  # back down to the gap
            adb("shell", "input", "swipe", "540", "1600", "540", "600", "400")
            time.sleep(0.8)
        play_forms()
        assert wait_for(FORMS_WHOLE, 8), "the card's end"
        link = scroll_to(FORMS_ALL, swipes=4)
        assert link, "📋 Vse oblike at the card's end"
        tap_at(link)
        view = forms_view(FORMS_TEST_WORD)
        assert view and len(view[0]) == 5, f"the overview over the run: every section ({view})"
        assert 9 <= view[1] < view[2], f"the present and the negative marked as practised, the rest not ({view})"
        assert find(FORMS_PRACTISE) is None, "no 🃏 Vadi oblike in a run"
        time.sleep(1)
        shot("forms-view-overview-run")
        notes.append(f"overview: {len(view[0])} sections, {view[1]}/{view[2]} practised")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1.2)
        review_end()
        go_home()

        # the overview from the word's card, at once
        adb("logcat", "-c")
        qa_hook(f"formscard:word:{FORMS_TEST_WORD}")
        assert wait_for(FORMS_TEST_WORD, 15), "biti's word card"
        c = sheet_find(FORMS_ALL)
        assert c, "📋 Vse oblike on biti's card"
        tap_at(c)
        view = forms_view(FORMS_TEST_WORD)
        assert view and len(view[0]) == 5, f"biti's overview: every section ({view})"
        time.sleep(1.5)
        shot("forms-view-overview")
        assert sheet_find(FORMS_PLAY, swipes=10), "▶ Vadi zdaj under it (biti has its card)"
        shot("forms-view-overview-end")
        go_home()
        # a word without a card: its overview offers 🃏 Vadi oblike
        other = next((w for w in ("kruh", "hiša", "voda", "mleko") if w not in dev_forms()), None)
        if other:
            adb("logcat", "-c")
            qa_hook(f"formscard:word:{other}")
            c = wait_for(other, 15) and sheet_find(FORMS_ALL)
            if c:
                tap_at(c)
                assert forms_view(other), f"{other}'s overview"
                assert sheet_find(FORMS_PRACTISE, swipes=10), f"🃏 Vadi oblike for {other}"
                shot("forms-view-practise")
                notes.append(f"{other}: 🃏 Vadi oblike")
            go_home()

        # 📚 Moje besede from Napredek's words line
        adb("logcat", "-c")
        open_progress()
        line = drag_to_top("Words: ") or scroll_to("Besede · Words", 8)
        assert line, "Napredek's words line"
        tap_at(line)
        assert wait_for(MY_WORDS, 8), "📚 Moje besede"
        listed = my_words_log("")
        assert listed and listed[0] == listed[1] > 0, f"the learner's words listed ({listed})"
        time.sleep(1)
        shot("forms-view-words")
        field = wait_for("Išči med besedami", 5)
        assert field, "the search field"
        tap_at(field)
        top = keyboard_settled()
        assert top is not None, "the keyboard up for the search"
        adb("shell", "input", "text", "ma")
        time.sleep(1.5 * slow())
        f = find("ma")
        assert f and f[1] < top, f"the search field above the keyboard ({f}, its top {top})"
        mine = my_words_log("ma")
        assert mine and 0 < mine[0] < mine[1], f"the list filtered as typed ({mine})"
        shot("forms-view-words-typing")
        adb("shell", "input", "keyevent", "KEYCODE_DEL", "KEYCODE_DEL")
        adb("shell", "input", "text", "pes")
        looked = my_words_log("pes", dictionary="Found", timeout=15)
        assert looked, "pes looked up in the dictionary"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the keyboard down
        time.sleep(1)
        assert wait_for("V slovarju · In the dictionary", 5), "the dictionary's part"
        shot("forms-view-words-search")
        notes.append(f"Moje besede: {listed[1]} words; «ma» {mine[0]}; «pes» from the dictionary")
        # a word opened from the list: its card, with its forms' overview a tap away
        clear = find("✕")
        if clear:
            tap_at(clear)
        if ime_top() is not None:
            adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the keyboard down, the screen stays
            time.sleep(1)
        row = scroll_to("hiša", swipes=6, exact=True)
        assert row, "hiša in the list"
        tap_at(row)
        assert wait_for("hiša", 15) and sheet_find(FORMS_ALL), "hiša's card with 📋 Vse oblike"
        time.sleep(1)
        shot("forms-view-word")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        assert wait_for("Napredek · Progress", 8), "back to Napredek"
    except Exception:
        shot("forms-view-failed")
        raise
    finally:
        go_home()
    print("    " + "; ".join(notes))


# A word the dictionary doesn't know, added from its card (companion/README.md "Word lookup", "A word the dictionary
# doesn't know"), by the village's language: the word, the line it is in and its translation (no apostrophe: the device's
# shell quotes the hook), the word asked for offline, and a word "Did you mean" finds (None: no dictionary to suggest
# from). The dev tutor glosses them (test/dev-bridge.ts DEV_GLOSSES), the first by its lemma.
MISSING_WORDS = {
    "sl": {"word": "vretenom", "lemma": "vreteno", "line": "Babica prede z vretenom.", "en": "Grandma spins with a spindle.",
           "offline": "motovilo", "offline_line": "Na podstrešju je staro motovilo.", "typo": ("zlica", "Daj mi zlico.", "žlica")},
    "it": {"word": "arcolaio", "lemma": "arcolaio", "line": "La nonna ha un arcolaio.", "en": "Die Oma hat eine Garnwinde.",
           "offline": "aspo", "offline_line": "La nonna usa un vecchio aspo.", "typo": None},
}


def pair_now() -> tuple:
    """The pair the phone shows its labels in, as QA set it (LANI_QA_PAIR, else Jan's sl · en)."""
    t, _, b = os.environ.get("LANI_QA_PAIR", "sl-en").partition("-")
    return t, b or "en"


APP_TEXTS: dict = {}


def app_texts(lang: str) -> dict:
    """The app's string table of [lang] (app/src/main/resources/l10n/<lang>.json), read once."""
    if lang not in APP_TEXTS:
        try:
            APP_TEXTS[lang] = json.loads((ANDROID / f"app/src/main/resources/l10n/{lang}.json").read_text())
        except (OSError, ValueError):
            APP_TEXTS[lang] = {}
    return APP_TEXTS[lang]


def label(key: str, pair=None, half=False) -> str:
    """[key] as the app's bi() shows it in [pair] ("Dodano · Added"); [half]: the target's part alone, without a trailing
    ellipsis (for a label with an emoji or more around it)."""
    t, b = pair or pair_now()
    target = app_texts(t).get(key, key)
    if half:
        return target.rstrip(" …").rstrip("…")
    return f"{target} · {app_texts(b).get(key, key)}"


def missing_shot(name: str):
    """A screenshot of the missing-word step, also as missing-<name>.png in $LANI_QA_MISSING_SHOTS when it's set."""
    shot(f"missing-{name}")
    if d := os.environ.get("LANI_QA_MISSING_SHOTS"):
        Path(d).mkdir(parents=True, exist_ok=True)
        shutil.copy(shots[-1], Path(d) / f"missing-{name}.png")


def dev_item(item_id: str, language=None):
    """The dev bridge's review item [item_id] (its copy of the learner data; [language]: another language's deck), or None."""
    path = f"/state?language={language}" if language else "/state"
    return api(path).get("databases", {}).get("spaced_repetition", {}).get("items", {}).get(item_id)


def word_slug(lemma: str) -> str:
    """The id part of a word's review item (src/lexicon.ts wordSlug): vreteno → vreteno, žlica → zlica."""
    s = re.sub(r"[^a-z0-9]+", "-", unicodedata.normalize("NFD", lemma.lower()).encode("ascii", "ignore").decode()).strip("-")
    return s[:60].rstrip("-") or "word"


def open_my_words():
    """"📚 Moje besede" from Napredek's words line."""
    open_progress()
    line = drag_to_top("Words: ") or scroll_to("Besede · Words", 8)
    assert line, "Napredek's words line"
    tap_at(line)
    assert wait_for(MY_WORDS, 8), "📚 Moje besede"
    time.sleep(1.5)


def search_my_words(text: str):
    """Types [text] into Moje besede's search, the keyboard down after it."""
    field = wait_for("Išči med besedami", 5)
    assert field, "the search field"
    tap_at(field)
    keyboard_settled()
    adb("shell", "input", "text", text)
    time.sleep(1.5 * slow())
    if ime_top() is not None:
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)


def missing_word():
    """A word the dictionary doesn't know, added from its card (Jan: "if a definition is missing I can't add it but have to
    go to tutor -> ask to add"). In a Slovene village "Did you mean" first: «zlica» (QA's hook "word:…": the card as a tap
    in a line opens it) offers žlica, whose card a tap opens. Then «vretenom» in "Babica prede z vretenom.": "🤷 Te besede ni
    v slovarju", "➕ Dodaj med moje besede" tapped, the card waits ("✍️ Tvoj učitelj piše pomen …") until the dev tutor's
    gloss (gloss_request → publish_gloss, 4 s) fills it: vreteno, "Dodano", machine-written; the dev bridge's copy has
    vocab_word_vreteno with its meaning and the line; "📚 Moje besede" lists it. Offline: the card of «motovilo», airplane
    mode on, Add: "📶 … ko boš spet povezan"; the card closed, Moje besede lists it waiting (📶); airplane mode off: the
    outbox sends it, the dev tutor glosses it, the quiet notice ("Zdaj med tvojimi besedami") and the word in Moje besede.
    The village's language picks the words (MISSING_WORDS: an Italian village's for Teo); $LANI_QA_MISSING_PAIR ("it-de")
    shows the cards in the learner's own pair (QA's hook "pair:"), the base their meaning is asked in, the rest in QA's.
    Screenshots also to $LANI_QA_MISSING_SHOTS."""
    go_home()
    found_village()
    go_home()
    lang = api("/culture").get("language") or "sl"
    w = MISSING_WORDS.get(lang)
    if w is None:
        return f"no missing word for a village in {lang}"
    if api(f"/lookup?w={urllib.parse.quote(w['word'])}").get("entries"):
        return f"the dev bridge's dictionary knows {w['word']} (glossed in an earlier run?): nothing missing to add"
    own = os.environ.get("LANI_QA_MISSING_PAIR")
    cards = tuple(own.split("-", 1)) if own else pair_now()

    def in_cards():
        if own:
            qa_hook(f"pair:{own}")
            time.sleep(1.5)

    def in_qa():
        if own:
            qa_hook(f"pair:{os.environ.get('LANI_QA_PAIR', '')}")
            time.sleep(1.5)

    missing, add = label("words.notInDictionary", cards, half=True), label("words.addToMyWords", cards, half=True)
    notes = [f"cards in {'·'.join(cards)}"]
    airplane = False
    try:
        # did you mean …
        in_cards()
        if w["typo"]:
            typo, typo_line, meant = w["typo"]
            qa_hook(f"'word:{typo}|{typo_line}'")
            assert wait_for(label("words.didYouMean", cards, half=True), 15), f"«{typo}»: Did you mean"
            time.sleep(1)
            missing_shot("did-you-mean")
            c = find(meant)
            assert c, f"{meant} suggested"
            tap_at(c)
            assert wait_for(add, 15) or wait_for(label("words.inYourWords", cards, half=True), 3), f"{meant}'s card from the suggestion"
            assert find(missing) is None, f"{meant}'s card says it's in the dictionary"
            missing_shot("suggestion-card")
            notes.append(f"«{typo}» → {meant}")
            adb("shell", "input", "keyevent", "KEYCODE_BACK")
            time.sleep(1)

        # added from its card: the card waits for the tutor's meaning, then fills in
        qa_hook(f"'word:{w['word']}|{w['line']}|{w['en']}'")
        assert wait_for(missing, 15), f"«{w['word']}»'s card: not in the dictionary"
        time.sleep(1)
        missing_shot("card")
        assert tap(add, 5), "➕ Add to my words"
        assert wait_for(label("words.tutorWriting", cards, half=True), 8), "the card waits: ✍️ the tutor is writing its meaning"
        missing_shot("writing")
        started = time.time()
        item = f"vocab_word_{word_slug(w['lemma'])}"
        added = label("words.added", cards)
        end = time.time() + 40 * slow()
        # its entry, added (not the card's "✓ Dodano" while it looks again: the missing word's line still there)
        filled = lambda: find(added) is not None and find(missing) is None
        while time.time() < end and not filled():
            time.sleep(1)
        assert filled(), f"the card filled in: {w['lemma']}, added"
        notes.append(f"«{w['word']}» filled in {round(time.time() - started)} s after Add")
        time.sleep(1)
        missing_shot("filled")
        assert find(label("words.machineWritten", cards, half=True)), "the tutor's meaning flagged machine-written"
        got = dev_item(item)
        assert got and got.get("content") == w["lemma"] and got.get("example") == w["line"] and got.get("source") == "lookup", f"the dev bridge's {item}: {got}"
        notes.append(f"{item}: {got.get('answer')}")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        in_qa()
        go_home()
        open_my_words()
        search_my_words(w["lemma"])
        assert find(w["lemma"]) and find(got.get("answer", "")[:12]), f"{w['lemma']} in Moje besede with its meaning"
        missing_shot("my-words")
        go_home()

        # offline: it waits in the outbox, goes once online, a quiet notice when it is in
        in_cards()
        qa_hook(f"'word:{w['offline']}|{w['offline_line']}'")
        assert wait_for(missing, 15), f"«{w['offline']}»'s card: not in the dictionary"
        adb("shell", "cmd", "connectivity", "airplane-mode", "enable")
        airplane = True
        time.sleep(4)
        assert tap(add, 5), "➕ Add to my words, offline"
        assert wait_for(label("words.reachesTutorOnline", cards, half=True), 10), "the card: it reaches the tutor once online"
        missing_shot("offline-card")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        in_qa()
        open_my_words()
        assert wait_for(label("myWords.waiting", half=True), 8) and find(w["offline"]), "Moje besede: the word waiting, offline"
        missing_shot("offline-waiting")
        go_home()
        adb("logcat", "-c")
        adb("shell", "cmd", "connectivity", "airplane-mode", "disable")
        airplane = False
        offline_item = f"vocab_word_{word_slug(w['offline'])}"
        back = time.time()
        added_at = noticed = None
        now_in = label("words.nowInYourWords", half=True)
        end = time.time() + 120 * slow()
        # the item on the dev bridge, and the app's notice (the snackbar on screen, and the debug build's log line, tag
        # WordRequest: it may come and go between two dumps)
        while time.time() < end and not (added_at and noticed):
            if added_at is None and dev_item(offline_item):
                added_at = time.time()
            if noticed is None and find(now_in):
                noticed = "on screen"
                missing_shot("online-notice")
            if noticed is None and f"done «{w['offline']}» notice" in adb("logcat", "-d", "-s", "WordRequest:I", check=False):
                noticed = "logged"
            if added_at and time.time() - added_at > 20 * slow():
                break
            time.sleep(1)
        assert added_at, f"{offline_item} on the dev bridge once online"
        assert noticed, "the app's notice: «… zdaj med tvojimi besedami»"
        notes.append(f"«{w['offline']}» added {round(added_at - back)} s after the network came back, the notice {noticed}")
        open_my_words()
        search_my_words(w["offline"])
        assert find(w["offline"]), f"{w['offline']} in Moje besede"
        missing_shot("online-my-words")
    except Exception:
        shot("missing-failed")
        raise
    finally:
        if airplane:
            adb("shell", "cmd", "connectivity", "airplane-mode", "disable")
            time.sleep(3)
        in_qa()
        go_home()
    print("    " + "; ".join(notes))


EX_WORDS = re.compile(r"ExWords\s*:\s*(\S+) (none|tap|hold) «(.*)»(?: (.*))?$")
EX_TIP = "Tapni besedo in poglej, kaj pomeni (pikice"  # the exercises' tip about their words (l10n words.tapInExercise)


def ex_words(timeout=8.0) -> list:
    """The exercise's texts as the debug build logged them (tag ExWords, ui/ExerciseLook.kt), the latest of each: [(what:
    "prompt", "option", "tile", "sentence" …, how: "none" | "tap" | "hold", text, [(word, (x, y), new, can)])], each word's
    centre on the screen, whether it's dotted as new to the learner and whether it can be looked up."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        latest = {}
        for l in adb("logcat", "-d", "-s", "ExWords:D", check=False).splitlines():
            m = EX_WORDS.search(l)
            if not m:
                continue
            words = []
            for w in (m[4] or "").split():
                word, _, xy = w.partition("@")
                x, _, y = xy.rstrip("*!").partition(",")
                if x.lstrip("-").isdigit() and y.lstrip("-").isdigit():
                    words.append((word, (int(x), int(y)), "*" in xy, "!" not in xy))
            latest[(m[1], m[3])] = (m[1], m[2], m[3], words)
        if latest:
            return list(latest.values())
        time.sleep(1)
    return []


# The word card's own labels: not "Vprašaj učitelja", which an exercise's 💬 says too (Labels.ASK).
EX_CARD = ("Dodaj med moje besede", "Med tvojimi besedami", "Poskusi znova", "Iščem", "Te besede ni v slovarju",
           "Za iskanje besed potrebuješ", "Učitelj zdaj ni dosegljiv")


def ex_card(timeout=10.0) -> bool:
    """A word card over an exercise, within [timeout] s."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        if any(w in t for t, _ in nodes() for w in EX_CARD):
            return True
        time.sleep(0.8)
    return False


def card_gone(timeout=6.0) -> bool:
    """The word card over an exercise closed (its sheet slides away), within [timeout] s."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        if not any(w in t for t, _ in nodes() for w in EX_CARD):
            return True
        time.sleep(0.8)
    return False


def long_press(c, ms=900):
    adb("shell", "input", "swipe", str(c[0]), str(c[1]), str(c[0]), str(c[1]), str(ms))
    time.sleep(1.2)


def exercise_words():
    """An exercise's words looked up (companion/README.md, "Exercises"): QA's "forms" hook starts a review whose cards ask
    a form in a sentence with a gap. A tap on a word of the sentence opens its card (the first time a tip says so under
    the prompt); the forms to choose are what's tested: none can be looked up before the answer, and a long press on one
    opens nothing and picks nothing; once answered, every word can (the options' too), and a tap on the form in the
    feedback opens its card."""
    go_home()
    if not deck_lemmas():
        return "no one-word cards in the deck"
    adb("logcat", "-c")
    qa_hook("forms")
    try:
        if wait_for(FILL_FORM, 25) is None:
            return "no form question (no word of the deck has a form reached)"
        time.sleep(1.5)
        if find(EX_TIP) is None:
            print("    (no tip about the words: seen before?)")
        shot("exercise-words")
        texts = ex_words()
        prompt = next((t for t in texts if t[0] == "prompt" and t[1] == "tap"), None)
        assert prompt is not None, f"the sentence with the gap has words to tap ({texts})"
        word, at, new, _ = next(w for w in prompt[3] if w[3])
        print(f"    tap «{word}» in «{prompt[2]}»{' (dotted: new)' if new else ''}; new: {[w[0] for w in prompt[3] if w[2]]}; "
              f"not to look up: {[w[0] for w in prompt[3] if not w[3]]}")
        tap_at(at)
        assert ex_card(), f"the card of «{word}»"
        shot("exercise-word-card")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the card
        assert card_gone(), "the card is still open"
        assert find(FILL_FORM), "back closed the review too"
        options = [t for t in texts if t[0] == "option"]
        if not options:  # typed: the gap's word is typed, there are no options to hold
            return "a typed form: its sentence's word looked up, no options"
        assert all(t[1] == "none" and not any(w[3] for w in t[3]) for t in options), f"a form to choose (what's tested) can be looked up before the answer: {options}"
        held = options[0][3][0]  # the option's word itself, where a long press looks one up
        long_press(held[1])
        assert not ex_card(3), f"a long press on «{held[0]}» (what's tested) opened its card"
        assert find("Naprej · Next") is None, "the long press picked the option"
        shot("exercise-option-held")
        tap_at(held[1])  # the answer
        assert wait_for("Naprej · Next", 8), "the answer's feedback"
        time.sleep(1.5)
        texts = ex_words()
        answered = [t for t in texts if t[0] == "option"]
        assert answered and all(t[1] == "tap" and all(w[3] for w in t[3]) for t in answered), f"once answered, the options' words can be looked up: {answered}"
        # the feedback over the options: its right answer, or the sentence with the gap filled, has the tested word
        before = {w[0] for w in prompt[3]}
        shown = [w for t in texts if t[0] in ("correct", "sentence") for w in t[3] if w[3]]
        word, at, _, _ = next((w for w in shown if w[0] not in before), None) or shown[0]
        shot("exercise-answered")
        tap_at(at)
        assert ex_card(), f"the card of «{word}», the word the question tested, once answered"
        shot("exercise-answer-card")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        assert card_gone(), "the answer's card is still open"
    finally:
        qa_hook("forms:off")
        go_home()


EXPLAIN_MODULE = "kdo-govori"  # the learner's module whose third choice explains "dela: no -m and no -š, … I work = delam, …"


def exercise_explain():
    """An exercise's explanation in shape (ui/ExplainFormat.kt): the learner's module "Kdo govori?" (in the dev bridge's
    copy) opened by its link, its first two choices answered, the third's feedback: "dela: no -m and no -š, so he or
    she." on its line with dela and the endings in bold, "I work = delam, you work = delaš" a small table whose Slovene
    can be looked up; a tap on «delam» opens its card. The run is left with what it answered."""
    go_home()
    if not any(m.get("id") == EXPLAIN_MODULE for m in api("/modules")):
        return f"no module {EXPLAIN_MODULE} in the dev bridge's copy"
    adb("logcat", "-c")
    adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity", "--es", OPEN, f"module:{EXPLAIN_MODULE}")
    try:
        assert tap("Začni", 15), "start the module from its intro"
        for n in range(3):
            assert wait_for("on, ona · he, she", 15), f"choice {n + 1}"
            time.sleep(1)
            tap("on, ona · he, she", 3)  # the third's right answer; any answer shows the explanation
            assert wait_for("Naprej · Next", 8), f"the feedback of choice {n + 1}"
            if n < 2:
                tap("Naprej · Next", 3)
        time.sleep(1.5)
        shot("exercise-explain")
        lines = [t for t in ex_words() if t[0] == "explain"]
        texts = [t[2] for t in lines]
        assert any(t.startswith("dela: no -m and no -š") for t in texts), f"the rule on its own line: {texts}"
        assert "I work" in texts and "delam" in texts, f"the pairs as a table, a cell each: {texts}"
        delam = next(w for t in lines if t[2] == "delam" for w in t[3] if w[3])
        tap_at(delam[1])
        assert ex_card(), "the card of «delam» in the explanation"
        shot("exercise-explain-card")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        assert card_gone(), "the card is still open"
    finally:
        go_home()


def packs():
    """The Nove besede tile opens the packs; an unfinished pack starts its words."""
    go_home()
    tile = scroll_to("Nove besede")
    assert tile, "new words tile"
    tap_at(tile)
    assert wait_for("Znaš ", 8), "packs screen"
    time.sleep(1)
    ring = next((c for t, c in nodes() if (m := re.fullmatch(r"(\d+)/(\d+)", t)) and m[1] != m[2]), None)
    if ring is None:
        return "no learnable pack"
    adb("shell", "input", "tap", str(ring[0]), str(ring[1]))
    assert wait_for("Pozneje · Later", 8), "the pack's intro"  # the pack's giver asks first
    shot("pack-intro")
    assert tap("Začni", 3), "start from the intro"
    assert wait_for("Naprej · Next", 8), "word card"


# --- the car ("🚗 Za pot"; companion/README.md, "Im Auto · In the car") --------------------------------------------

ROAD_SERVICE = f"{PKG}/.road.RoadService"
ROAD_TITLE = "🚗 Za pot · For the road"  # the sheet's title
ROAD_CONTINUE = "▶ Nadaljuj · Continue"  # the sheet's (and the car's) first big button: "🚗 Za pot" where it left off
ROAD_QUIZ = "❓ Kviz · Quiz"
ROAD_PROBLEMS = ("Priprava ni uspela", "Za pripravo mora", "Telefon nima glasu")  # road.failed, road.needsNode, road.noVoice


def road_session() -> dict:
    """The app's media session as `dumpsys media_session` shows it (what a car sees): {"state": 3 playing, 2 paused …,
    "title": its item's title}; {} when the app has none."""
    out = adb("shell", "dumpsys", "media_session", check=False)
    for b in re.split(r"\n(?=  \S[^\n]* \(userId=\d+\)\n)", out):
        if f"package={PKG}" not in b:
            continue
        state = re.search(r"state=PlaybackState \{state=(?:\w+\()?(\d+)", b)
        title = re.search(r"metadata: size=\d+, description=([^\n]*)", b)
        return {"state": int(state[1]) if state else None, "title": title[1].split(", ")[0] if title else None}
    return {}


def road_now() -> dict:
    """What the road's service plays, from its dump (a debug build's, road/RoadService.dump): "session", "item", "piece"
    of "pieces", "sound" ("pause:SAY" the pause to say the Slovene, "clip", "prompt" …), "state"; in a quiz's question
    "quiz", what plays of it ("TEXT:1": the second option heard, being read; "ASK:-1" the question), and "last", the last
    pick ("<question>:<place heard>:right|wrong"); "sessions": each session's items on the phone."""
    out = adb("shell", "dumpsys", "activity", "service", ROAD_SERVICE, check=False)
    now: dict = {}
    if m := re.search(r"road: session=(\S+) item=(\S+) piece=(-?\d+)/(\d+) sound=(\S+) state=(\d+) playing=(\w+)", out):
        now = {"session": m[1], "item": m[2], "piece": int(m[3]), "pieces": int(m[4]), "sound": m[5], "state": int(m[6]), "playing": m[7] == "true"}
    if m := re.search(r"road: session=.* quiz=(\S+)", out):
        now["quiz"] = m[1]
    if m := re.search(r"road: quiz answered=(\d+) right=(\d+) last=(\S+)", out):
        now["last"] = m[3]
    if m := re.search(r"road: sessions ([^\n]*)", out):
        now["sessions"] = {k: int(v) for k, v in (p.split("=") for p in m[1].split())}
    return now


def app_alive() -> bool:
    return bool(adb("shell", "pidof", PKG, check=False).strip())


def still_playing(when: str) -> dict:
    """The app runs and its session plays an item (what a car sees), [when]; the session, else an assertion."""
    assert app_alive(), f"the app closed {when}"
    s = {}
    for _ in range(6):  # a moment for the session to tell the system
        s = road_session()
        if s.get("state") == 3 and s.get("title"):
            return s
        time.sleep(0.5)
    raise AssertionError(f"the session isn't playing an item {when}: {s or 'no session'}")


def media_key(key: str):
    """[key] ("next", "pause") as a car's or a Bluetooth button sends it, to the session playing."""
    if "rror" in adb("shell", "cmd", "media_session", "dispatch", key, check=False):
        adb("shell", "input", "keyevent", f"KEYCODE_MEDIA_{key.upper()}")


def sheet_button(label: str) -> bool:
    """Taps the road sheet's button [label], scrolling the sheet down to it; False when it isn't there."""
    for _ in range(5):
        found = [b for t, b in boxes() if t == label]
        if found:
            tap_at(centre(found[-1]))
            return True
        adb("shell", "input", "swipe", "540", "1800", "540", "1100", "400")
        time.sleep(1)
    return False


def road_car_log() -> list[str]:
    """What QA's car ("road:car", road/RoadCarCheck) logged in its last check, a line each."""
    lines = [m[1] for l in adb("logcat", "-d", "-s", "RoadCar:I", check=False).splitlines() if (m := re.search(r"RoadCar\s*: (.*)", l))]
    start = max((i for i, l in enumerate(lines) if l.startswith("connected")), default=0)
    return lines[start:]


# --- the offline audio (companion/README.md, "Offline on the phone") -----------------------------------------------

_debuggable: dict[str, bool] = {}


def in_app(*args, quote=True) -> list[str]:
    """[args] as a command in the app's own folder: run-as in a debuggable build (debug), else (the qa build, not
    debuggable: --minified) the emulator's su, a command at a time (adb stays as it is, not restarted as root). [quote]:
    for adb shell, which joins its arguments as they are for the device's shell; adb exec-out quotes each one itself."""
    if "app" not in _debuggable:
        _debuggable["app"] = "DEBUGGABLE" in adb("shell", "dumpsys", "package", PKG, check=False).partition("pkgFlags=")[2].split("\n")[0]
    if _debuggable["app"]:
        return ["run-as", PKG, *args]
    command = f"cd /data/data/{PKG} && " + " ".join(map(shlex.quote, args))
    return ["su", "0", "sh", "-c", shlex.quote(command) if quote else command]


def run_as(*args) -> str:
    """A shell command in the app's own folder (in_app)."""
    return adb("shell", *in_app(*args), check=False)


def pull(path: str, to: Path) -> bool:
    """The app's file [path] (relative to its folder) copied to [to]."""
    out = subprocess.run(["adb", *(("-s", SERIAL) if SERIAL else ()), "exec-out", *in_app("cat", path, quote=False)], capture_output=True).stdout
    if not out:
        return False
    to.write_bytes(out)
    return True


def open_connection_sheet():
    """Home's tutor status dot opens the connection sheet (the phone's settings)."""
    go_home()
    to_top()
    for label in ("Tutor online", "Offline", "Connecting"):
        if tap(label, 3):
            break
    else:
        raise AssertionError("the tutor's status dot")
    assert wait_for("Povezava · Connection", 8), "the connection sheet"


def offline_audio():
    """The connection sheet's "🔊 Zvok brez povezave · Offline audio": the cap's chips (Off, 100, 250, 500 MB, Unlimited),
    "only while charging", what's on the phone, "⬇️ Prenesi zdaj · Download now", and the offline voice the node offers."""
