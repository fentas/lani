def build_sheet():
    # The bottom bar's Build opens the sheet; the next-goal card may have its own Build that builds
    # straight away (when affordable), so take the lowest match on screen.
    matches = [c for t, c in nodes() if "Gradi · Build" in t]
    assert matches, "build button"
