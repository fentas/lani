    assert scroll_to("Zvok brez povezave · Offline audio", 10), "the offline audio section"
    for chip in ("Izklopljeno · Off", "100 MB", "250 MB", "500 MB", "Brez omejitve · Unlimited"):
        assert scroll_to(chip, 2), f"the cap's chip {chip}"
    assert scroll_to("Le med polnjenjem", 2) or scroll_to("Prenašaj le med polnjenjem", 2), "only while charging"
    shot("offline-audio-cap")
    assert scroll_to("Prenesi zdaj · Download now", 3) or find("Prenašam"), "download now"
    assert scroll_to("Glas brez povezave · Offline voice", 4), "the offline voice"
    assert find("Prenesi glas") or find("je na telefonu") or find("Prenašam glas"), "the offline voice offered (or on the phone)"
    shot("offline-audio-voice")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")


def prefetch():
    """QA's "audio:prefetch": the day's plan made and its clips got at once from the dev bridge (its voice worker pointed
    nowhere: what it lacks it can't voice, unless ElevenLabs is set). The status must say the day's lines are on the phone;
    the plan, the status and the clip folder's size go to prefetch.json."""
    go_home()

    def status_now():
        raw = run_as("cat", "files/audio/status.json")
        return json.loads(raw) if raw.strip().startswith("{") else None

    def told(s: dict, seconds=None) -> str:
        g = lambda k: s.get(k, 0)  # noqa: E731 (a field at its default isn't written)
        took = f" in {seconds} s" if seconds is not None else ""
        return (f"{g('wants')} lines today, {g('wanted')} in their voice, {g('other')} in another, {g('missing')} missing; "
                f"{g('downloaded')} files, {g('bytes') / 1048576:.1f} MB{took}; tomorrow {'too' if s.get('tomorrow') else 'not'}"
                + (f"; {s['problem']}" if s.get("problem") else ""))

    # the run the app asked for when it opened (on Wi-Fi), if it ran already: the day's clips from nothing
    first = status_now()
    if first:
        print(f"    prefetch when the app opened: {told(first)}")
    run_as("rm", "-f", "files/audio/status.json")
    started = time.time()
    qa_hook("audio:prefetch")
    status = None
    while time.time() - started < 600 * slow() and status is None:
        time.sleep(3)
        status = status_now()
    assert status, "no prefetch status after 10 minutes"
    seconds = round(time.time() - started)
    for name in ("files/audio/day.json", "files/voice-clips/index.json"):
        pull(name, OUT / Path(name).name)
    plan = json.loads((OUT / "day.json").read_text() if (OUT / "day.json").exists() else "{}")
    kb = run_as("du", "-sk", "files/voice-clips").split()
    days = [{"day": d["day"], "lines": len(d["wants"]),
             "by": {k: sum(1 for w in d["wants"] if w["why"].split(":")[0] == k) for k in sorted({w["why"].split(":")[0] for w in d["wants"]})}}
            for d in plan.get("days", [])]
    facts = {"first": first, "status": status, "seconds": seconds, "days": days, "clips_kb": int(kb[0]) if kb and kb[0].isdigit() else None}
    (OUT / "prefetch.json").write_text(json.dumps(facts, indent=2, ensure_ascii=False) + "\n")
    print(f"    prefetch asked now: {told(status, seconds)}; the clip cache {facts['clips_kb']} kB")
    assert not status.get("problem"), f"the prefetch failed: {status.get('problem')}"
    assert status.get("wants", 0) > 0, "the day's plan has no lines"
    assert status.get("wanted", 0) + status.get("other", 0) > 0, "none of the day's lines is on the phone"
    open_connection_sheet()
    assert scroll_to("Na telefonu", 10), "what's on the phone"
    shot("offline-audio-on-phone")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")


PIPER_LINE = "Ko povezave ni, govori glas na telefonu."  # a sentence no clip has


def offline_voice():
    """The offline voice: downloaded through the dev bridge (QA's "audio:voice"; the bridge fetches it from LANI_PIPER_URL
    once into its cache), then with airplane mode on a line without a clip said ("audio:say:…"), and slowly
    ("audio:slow:…"): Piper speaks it (the log's "Piper … loaded", WAVs in its cache, pulled into the run's folder).
    Airplane mode goes off again whatever happens."""
    go_home()
    qa_hook("audio:voice")
    started = time.time()
    while time.time() - started < 900 * slow():
        if run_as("ls", "files/piper/sl/voice.json").strip().endswith("voice.json"):
            break
        time.sleep(5)
    else:
        raise AssertionError("the offline voice isn't on the phone after 15 minutes")
    print(f"    offline voice on the phone after {round(time.time() - started)} s ({run_as('du', '-sk', 'files/piper/sl').split()[0]} kB)")
    run_as("sh", "-c", "rm -f cache/piper-wav/*.wav")
    adb("logcat", "-c")
    adb("shell", "cmd", "connectivity", "airplane-mode", "enable")
    try:
        time.sleep(3)
        qa_hook(f"'audio:say:{PIPER_LINE}'")  # quoted: the device's shell would split it
        wavs = []
        end = time.time() + 60 * slow()
        while time.time() < end and not wavs:
            wavs = [w for w in run_as("ls", "cache/piper-wav").split() if w.endswith(".wav")]
            time.sleep(1)
        assert wavs, "Piper said nothing (no WAV in its cache)"
        time.sleep(4)
        qa_hook(f"'audio:slow:{PIPER_LINE}'")
        end = time.time() + 60 * slow()
        while time.time() < end and len(wavs) < 2:
            wavs = [w for w in run_as("ls", "cache/piper-wav").split() if w.endswith(".wav")]
            time.sleep(1)
        assert len(wavs) >= 2, "Piper didn't say it slowly"
        time.sleep(5)
        log = [l for l in adb("logcat", "-d", "-s", "Piper:*", check=False).splitlines() if "Piper" in l]
        print("    " + " / ".join(l.split(": ", 1)[-1] for l in log[-3:]))
        assert any(f"said {len(PIPER_LINE)} characters" in l for l in log), "Piper didn't say the whole line"
        for i, w in enumerate(sorted(wavs, key=lambda w: int(run_as("stat", "-c", "%s", f"cache/piper-wav/{w}").strip() or 0))):
            pull(f"cache/piper-wav/{w}", OUT / f"piper-{'normal' if i == 0 else 'slow'}.wav")
        shot("offline-voice")
    finally:
        adb("shell", "cmd", "connectivity", "airplane-mode", "disable")
        time.sleep(3)


def previous_clip():
    """A re-voiced line keeps its old clip until the new one is here (companion/README.md, "Offline on the phone"): a line
    with both narrators' clips on the dev bridge is said once (its female clip downloaded), then re-voiced on the phone's
    side to a URL the bridge hasn't got (QA's "audio:revoice:…", the swap the app's refresh does): previous.json keeps
    the old clip, and with airplane mode on the line plays it (the log's "earlier clip stands in"), not the phone's voice;
    online too, as the new one can't be had. Then re-voiced to the male clip of the same line, which the bridge has: said
    online the old clip plays, the new one downloads for the next play, and a minute later the old file is gone.
    "audio:refresh" takes the bridge's index again."""
    go_home()
    on_phone = lambda: set(run_as("ls", "files/voice-clips").split())  # noqa: E731
    name = lambda url: url.rsplit("/", 1)[-1]  # noqa: E731

    def serves(url: str) -> bool:
        req = urllib.request.Request(f"http://127.0.0.1:{PORT}{url}", headers={"authorization": f"Bearer {TOKEN}"})
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                return r.status == 200 and len(r.read()) > 0
        except Exception:
            return False

    have = on_phone()
    line = next((k for k, v in sorted(api("/voice/index").items(), key=lambda kv: len(kv[0]))
                 if re.fullmatch(r"[a-zčšž ]{4,24}", k) and "female" in v and "male" in v and name(v["female"]) not in have
                 and name(v["male"]) not in have and v["female"] != v["male"] and serves(v["female"]) and serves(v["male"])), None)
    if line is None:
        return "no line with both narrators' clips on the dev bridge that the phone hasn't got"
    clips = api("/voice/index")[line]
    old, new = name(clips["female"]), clips["male"]
    print(f"    the line «{line}»: {old}, re-voiced to a URL the bridge hasn't got, then to {name(new)}")

    def earlier() -> dict:
        raw = run_as("cat", "files/voice-clips/previous.json")
        return json.loads(raw).get(line, {}) if raw.strip().startswith("{") else {}

    def said(times=1) -> list:
        adb("logcat", "-c")
        for _ in range(times):
            qa_hook(f"'audio:say:{line}'")
            time.sleep(3 * slow())
        return [l.split(": ", 1)[-1] for l in adb("logcat", "-d", "-s", "Clips:*", check=False).splitlines() if "earlier clip stands in" in l]

    qa_hook(f"'audio:say:{line}'")
    end = time.time() + 30 * slow()
    while time.time() < end and old not in on_phone():
        time.sleep(1)
    assert old in on_phone(), f"the line's clip {old} wasn't downloaded"
    qa_hook(f"'audio:revoice:{line}'")
    time.sleep(2 * slow())
    assert name(earlier().get("female", "")) == old, f"previous.json doesn't keep {old}: {earlier()}"
    adb("shell", "cmd", "connectivity", "airplane-mode", "enable")
    try:
        time.sleep(3)
        stood = said()
        assert any(line in l and old in l for l in stood), f"offline the old clip didn't play: {stood}"
        print(f"    offline: {stood[-1]}")
    finally:
        adb("shell", "cmd", "connectivity", "airplane-mode", "disable")
        time.sleep(6)
    stood = said()
    assert any(old in l for l in stood), f"online, the new clip not to be had, the old one didn't play: {stood}"
    assert old in on_phone() and name(earlier().get("female", "")) == old, "the old clip went before a new one came"
    # a new take the bridge has: the old one plays once more, the new one comes for the next play, then the old one goes
    qa_hook(f"'audio:revoice:{line}|{new}'")
    time.sleep(2 * slow())
    assert name(earlier().get("female", "")) == old, f"the chain lost the old clip: {earlier()}"
    stood = said()
    assert any(old in l for l in stood), f"the old clip didn't play while the new one came: {stood}"
    end = time.time() + 30 * slow()
    while time.time() < end and name(new) not in on_phone():
        time.sleep(1)
    assert name(new) in on_phone(), "the new clip wasn't downloaded in the background"
    stood = said()
    assert not stood, f"the new clip is here, yet the old one played: {stood}"
    end = time.time() + 90 * slow()
    while time.time() < end and (old in on_phone() or earlier()):
        time.sleep(3)
    assert old not in on_phone() and not earlier(), f"the old clip stayed after the new one came: {earlier()}"
    print(f"    the new clip came and played; the old one went {round(90 * slow() - (end - time.time()))} s later")
    qa_hook("audio:refresh")


def voice_node_clip():
    """A new line a villager says plays the node's clip, not the phone's voice: a line the dev bridge has no clip of, said
    by a villager with a shared voice (QA's "audio:say:<text>|<voice>|<person>", as a 🔊 or a dialog says it), is voiced
    by the bridge (POST /voice/say), downloaded and played: the app's last word on it (tag Speaker, a debug or qa build)
    is "node clip", never "offline voice" or "tts", and its file is on the phone; said again, its clip on the phone plays.
    Then with Lani's audio at its cap as on Jan's phone on 2026-10-15: the car's library taking the cap (a sparse
    qa-car.mp3 in road/clips) and the day's clips over the 20 MB the clips played keep (a sparse qa-day.mp3 the day's
    keep.txt names): a new line still plays its clip (the cap's trim right after the download dropped it before it
    played: every new line fell to the phone's voice). The two files go again after. A dev bridge with no voice engine
    (no LANI_DEV_FAKE_ELEVENLABS, the local worker down) skips it."""
    go_home()
    index = api("/voice/index")
    people = api("/voice/profiles").get("people", {})
    shared = lambda p: not str(p.get("speaker", "@")).startswith("@") and p.get("speaker") not in ("female", "male")  # noqa: E731
    who = next((pid for pid in ("n-tjasa-mozetic", "tjasa", *sorted(people)) if pid in people and shared(people[pid])), None)
    voice = people[who]["speaker"] if who else "young-woman"
    lines = [f"{a} {b} je tukaj" for a in ("zelena", "modra", "rdeča", "rumena", "siva", "rjava")
             for b in ("žaba", "torba", "ladja", "skodelica", "knjiga", "omara") if f"{a} {b} je tukaj" not in index]
    if len(lines) < 4:
        return "the QA lines have clips on the dev bridge already"
    print(f"    new lines said by {who or '(no villager with a shared voice)'} in {voice}")
    on_phone = lambda: set(run_as("ls", "files/voice-clips").split())  # noqa: E731

    def app_sh(cmd: str) -> str:
        """[cmd] by the device's shell in the app's folder (run-as in a debug build, else su: in_app)."""
        if in_app("true")[0] == "run-as":
            return adb("shell", f"run-as {PKG} sh -c {shlex.quote(cmd)}", check=False)
        return adb("shell", *in_app("sh", "-c", cmd), check=False)

    def restart():
        """The app started again (it lists the car's library anew), at Home."""
        adb("shell", "am", "force-stop", PKG)
        adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
        assert wait_for("Danes · Today", 30), "Home after the app started again"
        time.sleep(3 * slow())

    def say(line: str, wait: float = 30) -> tuple[list[str], list[str], dict, set]:
        """[line] said: how the app said it (tag Speaker; the last line is what played), what Clips logged, the
        bridge's clips of it and the files new on the phone."""
        before = on_phone()
        adb("logcat", "-c")
        qa_hook(f"'audio:say:{line}|{voice}|{who or ''}'")  # quoted: the device's shell would split it
        end, hows = time.time() + wait * slow(), []
        while time.time() < end:
            log = adb("logcat", "-d", "-s", "Speaker:I", check=False).splitlines()
            hows = [l.split(f"«{line}»: ", 1)[1].strip() for l in log if f"«{line}»: " in l]
            # the offline voice falls back to TTS when it fails: a moment more for the last word
            if hows and (hows[-1].startswith(("node clip", "clip on the phone", "tts", "nothing")) or time.time() > end - 5):
                break
            time.sleep(1)
        time.sleep(1)
        hows = [l.split(f"«{line}»: ", 1)[1].strip() for l in adb("logcat", "-d", "-s", "Speaker:I", check=False).splitlines() if f"«{line}»: " in l]
        clips = [l.split(": ", 1)[-1] for l in adb("logcat", "-d", "-s", "Clips:*", check=False).splitlines()]
        return hows, clips, api("/voice/index").get(line, {}), on_phone() - before

    def played_node_clip(line: str, hows: list[str], clips: list[str], made: dict, new: set, when: str):
        print(f"    {when}: «{line}» said by {' → '.join(hows) or 'nothing'}; the bridge's clip: {made}; new on the phone: {sorted(new)}")
        assert hows, f"{when}: the app didn't say «{line}» (no Speaker line); Clips: {clips[-3:]}"
        assert hows[-1] == f"node clip ({voice})", (
            f"{when}: a new line the bridge voiced ({made}) was said by {hows[-1]} ({' → '.join(hows)}), not its clip; "
            f"Clips: {clips[-3:]}; new on the phone: {sorted(new)}")
        assert made.get(voice, "").rsplit("/", 1)[-1] in on_phone(), f"{when}: the clip {made.get(voice)} isn't on the phone: {sorted(new)}"

    hows, clips, made, new = say(lines[0])
    if hows and not made:
        return f"the dev bridge made no clip of «{lines[0]}» (no voice engine?): the app said it by {hows[-1]}"
    played_node_clip(lines[0], hows, clips, made, new, "on a fresh phone")
    time.sleep(3 * slow())
    hows, clips, _, _ = say(lines[0], 15)
    assert hows and hows[-1] == "clip on the phone", f"said again, it wasn't its clip on the phone: {hows}; Clips: {clips[-3:]}"

    # the cap full: the car's library takes it (beyond 500 MB, the largest cap but unlimited), the day's clips are over
    # the clips played's 20 MB (AudioBudget.MIN_CACHE); both sparse files (nothing on the disk)
    owner = "$(stat -c %u:%g files)"
    try:
        app_sh(f"mkdir -p files/road/clips && truncate -s 600M files/road/clips/qa-car.mp3 && truncate -s 25M files/voice-clips/qa-day.mp3 && chown -R {owner} files/road files/voice-clips/qa-day.mp3")
        restart()
        for line in lines[1:4]:
            # the day's prefetch may write keep.txt anew meanwhile (started again, the plan made again): then once more
            app_sh(f"mkdir -p files/audio && printf '\\nqa-day.mp3\\n' >> files/audio/keep.txt && chown {owner} files/audio files/audio/keep.txt")
            hows, clips, made, new = say(line)
            if "qa-day.mp3" not in app_sh("cat files/audio/keep.txt").split():
                print(f"    the day's keep.txt was written anew while «{line}» was said: again")
                continue
            played_node_clip(line, hows, clips, made, new, "the cap full")
            break
        else:
            raise AssertionError("the day's keep.txt was written anew each time a line was said")
    finally:
        app_sh("rm -f files/road/clips/qa-car.mp3 files/voice-clips/qa-day.mp3")
        restart()


def road():
    """"🚗 Za pot" in the car: QA's small library ("road:mini": two items of each kind and eight quiz questions from the dev
    bridge, the files got in the background, "🚗 Pripravljam za pot … %" in a notification) until the sheet says
    "Končano"; "▶ Nadaljuj" started from the sheet plays (dumpsys media_session: PLAYING, an item); next in the pause to say
    the Slovene plays the answer (the same item, on past the pause), next after it the next item, the app still running
    and playing; paused. "❓ Kviz" from the sheet: next while the second option is read picks it (its feedback plays,
    "✓ …" or "✗ …"), previous during the next question's options asks it again, paused. Then as Android Auto does
    ("road:car": the platform's media browser browses the root's two tabs, "🚗 Za pot" a grid of four and "Več" a list,
    and plays each session from its id): every session with items on the phone plays, none fails ("Failed to load
    selection" in a car), the app still runs."""
    go_home()
    tile = scroll_to("Za pot", 6, exact=True)
    assert tile, "the 🚗 Za pot tile"
    tap_at(tile)
    assert wait_for(ROAD_TITLE, 6), "the 🚗 sheet"
    qa_hook("road:mini")
    # getting ready: in the background (road/RoadPrepService), its notification while it works
    seen, end = "", time.time() + 240 * slow()
    while time.time() < end:
        if not seen and (m := re.search(r"Pripravljam za pot … \d+ %", adb("shell", "dumpsys", "notification", "--noredact", check=False))):
            seen = m[0]
            shot("road-preparing")
        labels = [t for t, _ in nodes()]
        if why := next((t for t in labels if t.startswith(ROAD_PROBLEMS)), None):
            raise AssertionError(f"getting ready fell short: {why}")
        if any(t.startswith("✅ Končano") for t in labels):
            break
        time.sleep(0.5)
    else:
        raise AssertionError(f"the sheet never said \"Končano\" (seen: {' | '.join(t for t, _ in nodes() if '/' in t or '%' in t)[:200]})")
    done = re.search(r"Končano: vse za pot je na telefonu[^)\n]*\)", adb("shell", "dumpsys", "notification", "--noredact", check=False))
    print(f"    got ready: {next((t for t, _ in nodes() if t.startswith('✅')), '?')}")
    print(f"    notification: {seen or 'the progress not caught (ready within seconds)'}; at the end: {done[0] if done else 'none (notifications not allowed?)'}")
    sessions = road_now().get("sessions", {})
    assert sessions.get("road:mix"), f"nothing in 🚗 Za pot on the phone: {sessions}"
    assert sessions.get("road:quiz"), f"no quiz question on the phone: {sessions}"
    # the sheet's menu: four big buttons, "▶ Nadaljuj" the first
    assert sheet_button(ROAD_CONTINUE), f"the sheet's \"{ROAD_CONTINUE}\" button"
    s = still_playing("after ▶ Nadaljuj was started from the sheet")
    shot("road-playing")
    print(f"    playing: {s['title']!r}; sessions on the phone: {', '.join(f'{k.removeprefix('road:')} {v}' for k, v in sessions.items())}")
    # next in the pause to say the Slovene: the answer at once. Sent as a pause begins (it lasts 2.5 s or more).
    revealed, before, end = None, road_now(), time.time() + 60
    while revealed is None and time.time() < end:
        now = road_now()
        if now.get("sound") == "pause:SAY" and (before.get("sound") != "pause:SAY" or before.get("item") != now.get("item")):
            media_key("next")
            time.sleep(1)
            after = road_now()
            if after.get("item") == now["item"] and after.get("piece", -1) > now["piece"]:
                revealed = (now, after)
            else:
                print(f"    next in a pause to say it went elsewhere ({now} → {after}): again at the next one")
            now = after
        before = now
        time.sleep(0.2)
    assert revealed, "next in a pause to say the Slovene never played the answer (within a minute)"
    still_playing("after next in a pause to say it")
    print(f"    next in the pause to say it: {revealed[0]['item']} piece {revealed[0]['piece']} → {revealed[1]['piece']} ({revealed[1]['sound']})")
    item = road_now().get("item")
    media_key("next")
    time.sleep(1.5)
    now = road_now()
    assert now.get("item") not in (None, item), f"next after the answer didn't go on to the next item ({item} → {now.get('item')})"
    still_playing("after next once the answer played")
    media_key("pause")
    time.sleep(1.5)
    assert app_alive(), "the app closed on pause"
    assert road_session().get("state") == 2, f"not paused: {road_session()}"
    road_quiz()
    # as Android Auto: browse, then play each session from its id
    qa_hook("road:car")
    end = time.time() + 240 * slow()
    while time.time() < end and not any(l.startswith(("done", "FAILED")) for l in road_car_log()):
        assert app_alive(), f"the app closed while the car browsed and played ({' / '.join(road_car_log()[-2:])})"
        time.sleep(2)
    log = road_car_log()
    for l in log:
        print(f"    car: {l}")
    assert log and log[-1].startswith("done"), f"the car's check didn't finish: {' / '.join(log[-3:]) or 'nothing logged'}"
    failed = [l for l in log if "FAILED" in l]
    assert not failed, " / ".join(failed)
    assert any(l.startswith("tabs: 2 (road:tab ") and " road:more " in l for l in log), "the root's two tabs (🚗 Za pot, Več)"
    assert any(l.startswith("tab road:tab: 4 (road:mix road:quiz road:easy road:story) grid") for l in log), "🚗 Za pot: a grid of four"
    assert any(l.startswith("tab road:more: 9 ") and " list" in l for l in log), "Več: a list of nine"
    assert any(l.startswith("session road:mix: playing") for l in log), "🚗 Za pot (▶ Nadaljuj) didn't play from its id"
    assert any(l.startswith("session road:quiz: playing") for l in log), "❓ Kviz didn't play from its id"
    silent = [k for k, n in sessions.items() if n and not any(l.startswith(f"session {k}: playing") for l in log)]
    assert not silent, f"sessions with items on the phone that didn't play from their id: {', '.join(silent)}"
    assert app_alive(), "the app closed after the car's check"
    assert road_session().get("state") != 3, f"still playing after the car's check paused it: {road_session()}"
    shot("road-car")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # closes the sheet
    time.sleep(1)


def road_quiz():
    """"❓ Kviz" from the sheet: next while the second option of a question is read picks it (the feedback plays: "✓ …"
    or "✗ …", the pick in the dump), previous during the next question's options asks it again (back to the question,
    the same item), and it pauses."""
    assert sheet_button(ROAD_QUIZ), f"the sheet's \"{ROAD_QUIZ}\" button"
    s = still_playing("after ❓ Kviz was started from the sheet")
    first = road_now()
    print(f"    quiz: {s['title']!r} ({first.get('item')}, {first.get('quiz')})")
    assert (first.get("item") or "").startswith("quiz:"), f"❓ Kviz plays no question: {first}"
    # next while the second option is read ("Dve: …"): it is picked
    picked, end = None, time.time() + 120 * slow()
    while picked is None and time.time() < end:
        now = road_now()
        if now.get("quiz") == "TEXT:1" and "#" not in now.get("item", "#"):
            media_key("next")
            time.sleep(1.2)
            picked = (now, road_now())
        time.sleep(0.15)
    assert picked, "the quiz never read a second option (within two minutes)"
    asked, after = picked
    assert after.get("item", "").startswith(asked["item"] + "#"), f"next while the second option was read played no feedback ({asked} → {after})"
    assert after.get("last", "").startswith(asked["item"].removeprefix("quiz:") + ":1:"), f"the pick isn't the second option: {after.get('last')}"
    s = still_playing("after a pick in the quiz")
    assert (s.get("title") or " ")[0] in "✓✗", f"the car doesn't show the feedback: {s}"
    shot("road-quiz-feedback")
    print(f"    quiz: next while \"Dve\" was read picked it: {after['last']} ({s['title']!r})")
    # the next question; previous during its options asks it again
    repeated, end = None, time.time() + 90 * slow()
    while repeated is None and time.time() < end:
        now = road_now()
        if (now.get("quiz") or "").startswith(("NUMBER:", "TEXT:", "GAP:")) and "#" not in now.get("item", "#") and now.get("item") != asked["item"]:
            media_key("previous")
            time.sleep(1)
            repeated = (now, road_now())
        time.sleep(0.15)
    assert repeated, "no next question's options heard (within 90 s)"
    during, again = repeated
    assert again.get("item") == during["item"], f"previous during the options left the question: {during} → {again}"
    assert (again.get("quiz") or "").startswith("ASK") or again.get("piece", 99) < during.get("piece", 0), f"previous didn't ask the question again: {during} → {again}"
    still_playing("after previous in the quiz")
    print(f"    quiz: previous during {during['quiz']} of {during['item']} asked it again ({again['quiz']}, piece {during['piece']} → {again['piece']})")
    # paused: during the question play/pause pauses (during the options it would pick: then once more, in the feedback)
    for _ in range(3):
        media_key("pause")
        time.sleep(1.2)
        if road_session().get("state") == 2:
            break
    assert app_alive(), "the app closed in the quiz"
    assert road_session().get("state") == 2, f"the quiz didn't pause: {road_session()}"


PROGRESS = "📊 Napredek · Progress"


def open_progress():
    """Home's "📊 Napredek · Progress" line to the progress screen, the node's stats on it."""
    go_home()
    c = scroll_to("Napredek · Progress", 6)
    assert c is not None, "Home's progress line"
    tap_at(c)
    assert wait_for(PROGRESS, 8), "the progress screen"
    time.sleep(2 * slow())  # the node's stats after the cached ones


def drag_to_top(text: str, swipes=8):
    """Scrolls down to [text], then drags it slowly (no fling) to near the top: the card under it on screen. Its centre, or None."""
    c = scroll_to(text, swipes)
    if c is None:
        return None
    if c[1] > 420:
        adb("shell", "input", "swipe", "540", str(c[1]), "540", "380", "900")
        time.sleep(1.5)
    return find(text)


def on_treasure_map(timeout=6.0) -> bool:
    """The treasure map is on screen: its header ("🗺️ Zemljevid zaklada · The treasure map", the level under it), not
    the progress screen's way to it ("… ›", under "🧭 Do …")."""
    end = time.time() + timeout * slow()
    while time.time() < end:
        ts = [t for t, _ in nodes()]
        if any("Zemljevid zaklada · The treasure map" in t and "›" not in t for t in ts) and not any(t.startswith("🧭 ") for t in ts):
            return True
        time.sleep(1)
    return False


def progress_cards(suffix: str, way: str, grammar: str):
    """The progress screen's top (the words bar), its way to the next level ([way]: its title) and its grammar section
    ([grammar]), a screenshot each, named with [suffix]."""
    to_top()
    time.sleep(1)
    shot(f"progress-top{suffix}")
    assert card_at_top(way), f"the way to the next level ({way})"
    shot(f"progress-path{suffix}")
    assert card_at_top(grammar), f"the grammar section ({grammar})"
    shot(f"progress-grammar{suffix}")
    to_top()


def card_at_top(title: str):
    """From the screen's top down to the card [title], dragged to near the top. Its title's centre, or None."""
    to_top()
    return drag_to_top(title)


def on_screen(*labels, swipes=2):
    """The first node whose text has one of [labels], on screen (scrolling down up to [swipes] times): (text, centre), or None."""
    for k in range(swipes + 1):
        if k:
            adb("shell", "input", "swipe", "540", "1600", "540", "1000", "600")
            time.sleep(1.2)
        hit = next(((t, c) for t, c in nodes() if any(l in t for l in labels) and 250 < c[1] < 2150), None)
        if hit is not None:
            return hit
    return None


def progress():
    """The progress screen ("📊 Napredek · Progress"; Jan: "x/300 words: we reached this now and the progress bar stays
    full", "also progress for grammar?"): the words bar past A1's 300 aims at B1's 1000 with "✅ 300 besed za A2"; "🧭 Do
    A2 · To A2" with the words and the treasure map's three signs (the grammar, the reviews, the practice), each ✅ or ⏳
    and its numbers, the map a tap away and back; "📝 Slovnica · Grammar": the school's units of A1 (done of 18, a bar),
    the next unit a tap away (its page, back through the school to the progress screen), the book's pages of A1, the
    weakest page a tap away (its sheet over the screen). Then the three parts in the dark theme and with the base in
    German (QA's hook "pair:sl-de"), the light theme and the profile's pair again after."""
    open_progress()
    notes = []
    to_top()
    shot("progress-top")
    # the words bar: before A1's goal "x / 300 besed do A2"; past it on to B1's, the goal passed marked
    if find("besed za B1"):
        assert find("✅ 300 besed za A2 · 300 words for A2"), "the words goal passed, marked"
        notes.append("words past 300: the bar aims at B1's 1000")
    else:
        assert find("besed do A2"), "the words bar: x / 300 besed do A2"
        notes.append("words before 300")
    way = "🧭 Do A2 · To A2"
    assert card_at_top(way), "the way to A2"
    # each line is one node, read by TalkBack in the base language ("Words: 312 / 300. met")
    for sign in ("Words: ", "Rules of A1 secure: ", "Reviews, last 14 days: ", "Days of practice at A1: "):
        assert on_screen(sign), f"the way's sign {sign}"
    card_at_top(way)
    shot("progress-path")
    # the map from the way (before the offer: its signs and "🗺️ Sem pripravljen"; offered or on: the map), and back
    hit = on_screen("Zemljevid zaklada te čaka", "Zemljevid zaklada · The treasure map ›", "Zemljevid zaklada: postaje")
    assert hit is not None, "no way to the treasure map on the progress screen"
    tap_at(hit[1])
    assert on_treasure_map(), "the treasure map from the progress screen"
    time.sleep(1)
    shot("progress-map")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    assert wait_for(PROGRESS, 8), "back from the map: the progress screen"
    notes.append(f"map: {hit[0]}")
    grammar = "📝 Slovnica · Grammar"
    assert card_at_top(grammar), "the grammar section"
    assert on_screen("Šola: enote A1"), "the school's units of A1"
    assert on_screen("A1 pages in the book: "), "the book's pages of A1 (its TalkBack label)"
    card_at_top(grammar)
    shot("progress-grammar")
    # the unit suggested next ("★ Naslednja · Next", or "▶ V teku · In progress" when begun): its page; back to the school
    # ("← Napredek · Progress"), back to the progress screen
    labels = ("Naslednja · Next", "V teku · In progress")
    ns = list(nodes())
    hit = next(((i, c) for i, (t, c) in enumerate(ns) if t in labels and 250 < c[1] < 2150), None)
    if hit is not None:
        title = ns[hit[0] + 1][0] if hit[0] + 1 < len(ns) else ""  # the unit's title, the node after its label
        tap_at(hit[1])
        assert wait_for("← ", 6) and find(grammar) is None and not any(t in labels for t, _ in nodes()), "the next unit's page"
        assert len(title) < 4 or find(title), f"the next unit's page: {title}"
        shot("progress-unit")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        assert wait_for("← Napredek · Progress", 6), "the school, its way back to the progress screen"
        shot("progress-school")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        assert wait_for(PROGRESS, 8), "back from the school: the progress screen"
        notes.append(f"next unit: {title}")
    # the weakest page: its sheet over the progress screen
    card_at_top(grammar)
    if on_screen("Najšibkejše strani · Weakest pages") is not None:
        page = next((c for t, c in nodes() if re.search(r"[★☆]{5}|še nevadeno", t) and 250 < c[1] < 2150), None)
        assert page is not None, "a weakest page's row"
        tap_at(page)
        assert wait_for("Zapri · Close", 6), "the grammar page over the progress screen"
        time.sleep(1)
        shot("progress-page")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        assert wait_for("Najšibkejše strani · Weakest pages", 6) and find("Zapri · Close") is None, "the page closed: the progress screen"
    else:
        notes.append("no weakest page")
    # the dark theme, then the light one again (or whatever the emulator had)
    to_top()
    night = adb("shell", "cmd", "uimode", "night", check=False)
    try:
        adb("shell", "cmd", "uimode", "night", "yes")
        time.sleep(3 * slow())
        assert wait_for(PROGRESS, 8), "the progress screen in the dark theme"
        progress_cards("-dark", way, grammar)
    finally:
        adb("shell", "cmd", "uimode", "night", "yes" if "yes" in night else "auto" if "auto" in night else "no")
        time.sleep(2 * slow())
    # the base in German
    try:
        qa_hook("pair:sl-de")
        assert wait_for("Napredek · Fortschritt", 10), "the progress screen in sl · de"
        progress_cards("-de", "🧭 Do A2 · Bis A2", "📝 Slovnica · Grammatik")
    finally:
        qa_hook("pair:")
        wait_for(PROGRESS, 10)
    print(f"    {'; '.join(notes)}")
    go_home()


def optional_screen(label: str, marker: str, exact: bool = False):
    """A screen reached from Home by [label] ([exact]: a label that is exactly that), shown when [marker] appears."""
    def run():
        go_home()
        c = scroll_to(label, 6, exact=exact)
        if c is None:
            return f"no '{label}' entry"
        tap_at(c)
        return None if wait_for(marker, 8) else f"'{marker}' not shown"
    return run


# --- the bridges ----------------------------------------------------------------------------

# The visit's voices (VOICES): what the dev bridge voices, until QA takes its ElevenLabs down (this file there: every take a
# 503, test/dev-bridge.ts LANI_DEV_FAKE_ELEVENLABS_DOWN)
ELEVEN_DOWN = OUT / "eleven-down"


def synthetic_visitor() -> Path:
    """A synthetic learner for the visit's voices when LANI_DEV_DATA names none: Italian from German, of the Friuli culture,
    without a village (as Teo: setup founds it), made in the run's folder as `lani-profile add` makes one
    (src/learners.ts initLearnerData). Never the real learner's data."""
    d = OUT / "visitor-data"
    if not (d / "learner-profile.json").exists():
        code = ("import { initLearnerData } from './src/learners'; "
                "initLearnerData(process.env.QA_PROJECT, process.env.QA_VISITOR, { name: 'Leo', target: 'it', base: 'de', culture: 'friuli', child: false })")
        subprocess.run(["bun", "-e", code], cwd=BRIDGE, check=True, env={**os.environ, "QA_PROJECT": str(ROOT), "QA_VISITOR": str(d)})
    return d


def start_bridge():
    """The dev bridge on PORT, on a copy of the learner data (test/dev-bridge.ts); whatever listened there is stopped. Its
    offline voices in QA's own cache (never the machine's), kept between runs. For the visit's voices (VOICES): a fake
    ElevenLabs that QA can take down (ELEVEN_DOWN), no local voice worker (so what ElevenLabs can't voice nobody voices),
    and a synthetic Italian learner (Friuli) when LANI_DEV_DATA names no data."""
    for pid in listeners(PORT):
        subprocess.run(["kill", pid])
    piper = os.environ.get("LANI_PIPER_CACHE") or str(Path.home() / ".cache/lani-qa/piper")
    extra = {}
    if VOICES:
        extra = {"LANI_DEV_FAKE_ELEVENLABS": "1", "LANI_DEV_FAKE_ELEVENLABS_DOWN": str(ELEVEN_DOWN), "LANI_GEPARD_URL": "http://127.0.0.1:9"}
        if not os.environ.get("LANI_DEV_DATA"):
            extra |= {"LANI_DEV_DATA": str(synthetic_visitor()), "LANI_CULTURE": os.environ.get("LANI_CULTURE") or "friuli"}
            os.environ.setdefault("LANI_QA_PAIR", "sl-en")  # setup reads the labels in sl · en (as coast does)
    ELEVEN_DOWN.unlink(missing_ok=True)
    bridge = subprocess.Popen(["bun", "test/dev-bridge.ts"], cwd=BRIDGE, stdout=open(OUT / "bridge.log", "w"), stderr=subprocess.STDOUT,
                              env={**os.environ, "LANI_DEV_PORT": PORT, "LANI_PIPER_CACHE": piper, **extra})
    if "--keep-bridge" not in sys.argv:
        atexit.register(bridge.terminate)  # also when a step raises past the end, or QA is interrupted
    return bridge


def dev_town(pid: str) -> bool:
    """Whether [pid] is a second town's bridge (test/dev-town.ts marks its environment), not a learner's."""
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        return b"LANI_DEV_TOWN=1" in env or b"FLUENT_DEV_TOWN=1" in env  # the old name: one started before the rename
    except OSError:
        return False


def start_town():
    """The second town (test/dev-town.ts) on TOWN_PORT, which links itself with the dev bridge's town once both
    answer; None when it can't start (TOWN["why"] says why). A second town left on the port by an earlier run is
    stopped; anything else there (a learner's bridge) is left alone, and the visit steps skip."""
    if "--no-town" in sys.argv:
        TOWN["why"] = "--no-town"
        return None
    if "error" in FACTS:
        TOWN["why"] = FACTS["error"]
        return None
    if TOWN_PORT == PORT or TOWN_PORT in NEVER_PORTS:
        TOWN["why"] = f"LANI_DEV_TOWN_PORT={TOWN_PORT} is the dev bridge's or a service's port"
        return None
    for pid in listeners(TOWN_PORT):
        if dev_town(pid):
            subprocess.run(["kill", pid])
    for _ in range(10):
        if not listeners(TOWN_PORT):
            break
        time.sleep(0.5)
    if others := listeners(TOWN_PORT):
        TOWN["why"] = f"port {TOWN_PORT} is taken (pid {', '.join(others)}): LANI_DEV_TOWN_PORT picks another"
        return None
    town = subprocess.Popen(["bun", "test/dev-town.ts"], cwd=BRIDGE, stdout=open(OUT / "town.log", "w"), stderr=subprocess.STDOUT,
                            env={**os.environ, "LANI_DEV_TOWN_PORT": TOWN_PORT, "LANI_DEV_TOWN_LINK": f"http://127.0.0.1:{PORT}",
                                 "LANI_DEV_TOWN_LINK_TOKEN": TOKEN, "LANI_DEV_TOWN_FIXTURE": TOWN_FIXTURE,
                                 **({"LANI_DEV_TOWN_VOICES": "1"} if VOICES else {})})
    if "--keep-bridge" not in sys.argv:
        atexit.register(town.terminate)
    TOWN["why"] = "not linked yet"
    return town


def visit_summary(tid: str) -> str:
    """What a visit asks of the second town, through the dev bridge as the app asks it, checked: a line for the report."""
    pub = api(f"/towns/{tid}/public")
    people = api(f"/towns/{tid}/villagers")["villagers"]
    scenes = api(f"/towns/{tid}/scenes")["scenes"]
    reqs = api(f"/towns/{tid}/requests")["requests"]
    wares = api(f"/towns/{tid}/market")["wares"]
    t = pub["town"]
    problems = [p for p, bad in (
        (f"its language is {t['language']}", t["language"] != FACTS["language"]),
        ("nobody lives there", not pub["residents"]),
        ("no people (villagers)", not people),
        ("no places (scenes)", not scenes),
        ("no open request", not reqs),
        ("nothing at its market", not wares),
    ) if bad]
    if problems:
        raise AssertionError("the second town answers, but " + ", ".join(problems))
    return (f"\"{t['name']}\" ({t['learner']}, {t['culture']}, {t['language']}): age {pub['age']}, {len(pub['residents'])} residents, "
            f"{len(people)} people, places {', '.join(s['id'] for s in scenes)}, {len(reqs)} requests, "
            f"market {', '.join(f'{k}×{n}' for k, n in wares.items())}")


def link_town(town, timeout=90) -> str:
    """Waits until the dev bridge lists the second town, linked and answering, and checks what a visit asks of it.
    Sets TOWN (its row, or why there is none); the report's line for it."""
    if town is None:
        return f"skipped: {TOWN['why']}"
    end, why, row = time.time() + timeout, "the dev bridge doesn't list it", None
    while time.time() < end:
        if town.poll() is not None:
            why = f"test/dev-town.ts stopped ({town.returncode}): {tail(OUT / 'town.log')}"
            break
        if (bad := next((l for l in tail(OUT / "town.log", 20).split(" / ") if "dev town: not linked" in l), None)) is not None:
            why = bad
            break
        try:
            row = next((t for t in api("/towns", timeout=15)["towns"] if t.get("name") == FACTS["name"]), None)
            if row is not None and row.get("status") == "ok":
                break
            why = f"the dev bridge lists it as {row.get('status')}" if row else "the dev bridge doesn't list it"
        except (OSError, RuntimeError, ValueError) as e:
            why = str(e)
        row = None
        time.sleep(2)
    if row is None:
        TOWN["why"] = why
        return f"FAILED: {why}"
    try:
        TOWN["summary"] = visit_summary(row["id"])
    except (OSError, RuntimeError, ValueError, KeyError, AssertionError) as e:
        TOWN["why"] = str(e)
        return f"FAILED: {e}"
    TOWN["row"] = row
    print(f"    second town: {TOWN['summary']}")
    return "ok"


SHADOW_MOCK_PORT = os.environ.get("LANI_TUTOR_MOCK_PORT", "8771")
EFFORT_BETA = "mid-conversation-output-config-2026-07-01"  # the per-message effort's (tutor/Effort.kt)
RECOMMENDED = "⭐ priporočeno · recommended"  # our recommendation in the shadow panel's pickers (ui/tutor/ShadowPanel.kt)
MORE_LEVELS = "more… (xhigh, max)"  # the effort picker's toggle
FROM_TEXT = "✍️ as text, no reply tool"  # a reply the shadow took from the text of a turn that never called reply
SHADOW_KEY = "sk-ant-qa-fake-0000000000000000"  # QA's mock takes any key; never a real one (none exists yet)
SHADOW_MOCK = f"http://10.0.2.2:{SHADOW_MOCK_PORT}"
DEVELOPER = "🛠️ Razvijalec · Developer"  # the connection sheet's developer section (l10n developer.title)
SHADOW = "🕵️ Učitelj v senci · Shadow tutor"  # its row (developer.shadowTutor)
OPEN_PANEL = "🔍 Odpri pregled · Open the panel"  # (developer.openPanel)
MOCK_TUTOR = "Mock tutor"  # in each of the mock's replies: only ever in the shadow's panel
DEV_TUTOR = "(dev tutor) Prejel sem"  # the dev bridge's canned tutor's reply to a chat: the real tutor here


def mock_api(path: str, method="GET"):
    """QA's mock of the Messages API (companion/bridge/test/tutor-mock.ts): its own routes, no key."""
    req = urllib.request.Request(f"http://127.0.0.1:{SHADOW_MOCK_PORT}{path}", method=method)
    with urllib.request.urlopen(req, timeout=5) as r:
        return json.loads(r.read() or b"null")


def answer_form_card() -> bool:
    """Answers the review card on screen as word-forms does (a form typed wrong, "x"; else the first form offered; a
    flashcard known), then goes on ("Naprej · Next"); False when there is no card to answer."""
    if find("Preveri · Check"):
        field = find("Napiši odgovor") or find("Type your answer")
        if field:
            tap_at(field)
            type_text("x")
        tap("Preveri · Check", 3)
    elif find("Pokaži · Show"):
        tap("Pokaži · Show", 3)
        return tap("Vedel sem", 3)
    else:
        gap = next((c for t, c in nodes() if "____" in t), None)
        if gap is None:
            return False
        # a form to choose: a short label (not the tip about tapping words, which can sit between)
        options = [(t, c) for t, c in nodes() if t and c[1] > gap[1] + 30 and "____" not in t and FILL_FORM not in t
                   and not any(n in t for n in NOT_OPTIONS) and len(t) <= 40 and "Tapni" not in t]
        if not options:
            return False
        tap_at(options[0][1])
    return tap("Naprej · Next", 8)


def start_tutor_mock():
    """QA's mock of the Messages API (test/tutor-mock.ts on SHADOW_MOCK_PORT), started afresh and reset; stopped at exit."""
    for pid in listeners(SHADOW_MOCK_PORT):
        subprocess.run(["kill", pid])
    mock = subprocess.Popen(["bun", "test/tutor-mock.ts"], cwd=BRIDGE, stdout=open(OUT / "tutor-mock.log", "w"), stderr=subprocess.STDOUT,
                            env={**os.environ, "LANI_TUTOR_MOCK_PORT": SHADOW_MOCK_PORT})
    atexit.register(mock.terminate)
    end = time.time() + 15
    while time.time() < end:
        try:
            mock_api("/mock/reset", "POST")
            return mock
        except Exception:
            time.sleep(0.5)
    mock.terminate()
    raise AssertionError("the mock didn't start (tutor-mock.log)")


def shadow_tutor():
    """The in-app tutor in shadow mode (companion/README.md "The in-app tutor in shadow mode"), against QA's mock of the
    Messages API on 127.0.0.1:8771 (started here): the developer section shown by tapping the connection sheet's version
    line seven times, the shadow tutor turned on, which opens its panel for a key; the mock's base URL (a QA build's), a
    fake key checked (GET /v1/models) and kept; a chat sent from the tutor chat (the real tutor, the dev bridge's canned
    one, answers it there; the shadow's reply only in the panel), a review finished (its digest runs when the chat
    opens: Haiku at xhigh, the recommended routine level); the panel's events, "Also run on" Haiku at low (the mock answers
    as text without reply, as Haiku at low did in Jan's shadow: the panel's "✍️ as text, no reply tool"), its numbers,
    the export through the share sheet (no key in it, the replies from text and the numbers by model × effort in it);
    the effort: the settings' model and effort per task with our recommendation (⭐: the matrix's, chat and routine at
    xhigh, grading at high), a picker below xhigh (grading's: xhigh and max behind "more"), the chat's effort set to high
    (its picker opens with xhigh and max: its level is xhigh), a second chat on the day's thread at high by an effort
    message (its beta,
    the thread's top-level effort and history as they were), "Also run on" Haiku at high, the numbers by model × effort,
    the chat's effort back to the preset's; the mock's log: the key only in x-api-key, the 1-hour breakpoint, the tool
    order, the per-message effort's beta only with an effort message; the chat never shows the shadow's reply."""
    mock = start_tutor_mock()
    try:
        # the developer section: hidden until the version line is tapped seven times
        open_connection_sheet()
        for _ in range(12):  # to the sheet's end: the version line is its last (below scroll_to's band)
            adb("shell", "input", "swipe", "540", "1600", "540", "900", "300")
        time.sleep(1)
        version = find("Lani 0.")
        assert version, "the version line at the bottom of the connection sheet"
        assert find(DEVELOPER) is None or find(SHADOW), "the developer section shown before the taps"
        if find(SHADOW) is None:
            for _ in range(7):
                adb("shell", "input", "tap", str(version[0]), str(version[1]))
                time.sleep(0.25)
            time.sleep(1.5)
        assert scroll_to(SHADOW, 3), "the developer section after seven taps"
        shot("shadow-developer")
        scroll_to(OPEN_PANEL, 3)  # below the section's lines; at the sheet's end it may stay low on the screen
        assert tap(OPEN_PANEL, 4), "the panel's button"
        assert wait_for("Shadow mode", 8), "the panel's settings"

        # the mock's address (a QA build's setting), the key, shadow mode on
        assert scroll_to("The mock (10.0.2.2:8771)", 4) and tap("The mock (10.0.2.2:8771)", 3), "the mock's base URL"
        to_top()
        field = find("sk-ant-…")
        assert field, "the key's field"
        tap_at(field)
        time.sleep(slow())
        adb("shell", "input", "text", SHADOW_KEY)
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        assert tap("Check (GET /v1/models) and keep", 4), "the key's check"
        assert wait_for("the key works", 10 * slow()), "the mock took the key"
        shot("shadow-key")
        if find("Shadow mode: off"):
            assert tap("Shadow mode: off", 3), "the switch"
        assert wait_for("Shadow mode: on", 6), "shadow mode on"
        assert wait_for("idle", 6) or find("waiting"), "the shadow's status"
        shot("shadow-on")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel
        time.sleep(1)
        if find("Povezava · Connection"):
            adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the connection sheet under it
            time.sleep(1)
        go_home()

        # a chat: the real tutor (the dev bridge's) answers it in the chat; the shadow's answer is the panel's
        assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
        assert wait_for("💬 Tvoj učitelj", 6), "the tutor chat"
        assert tap("Napiši…", 4), "the chat's field"
        time.sleep(slow())
        adb("shell", "input", "text", "Kako%sse%srece%sstove")  # adb types ASCII only
        time.sleep(0.5)
        assert tap("Pošlji · Send", 4), "send"
        assert wait_for(DEV_TUTOR, 20), "the real tutor's reply in the chat"
        time.sleep(4 * slow())  # the shadow's turn: three calls to the mock
        assert not any(MOCK_TUTOR in t for t, _ in nodes()), "the shadow's reply in the real chat"
        shot("shadow-chat")
        go_home()

        # a review (today's, else the forms' review QA's hook starts): its review_done waits for the digest, which the
        # chat opened runs; "hvala" typed where a form is asked makes an answer wrong, so the digest has something to say
        qa_hook("forms")  # a short review (five word cards with a form reached), as word-forms has it
        started = wait_for(FILL_FORM, 25) is not None
        if started:
            for _ in range(12):
                if find("recalled") or find("priklicanih") or not answer_form_card():
                    break
            assert wait_for("recalled", 6) or find("priklicanih"), "the review's end"
            shot("shadow-review")
            qa_hook("forms:off")
            go_home()
            assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
            time.sleep(8 * slow())  # the digest's turn: Haiku, stateless
            assert not any(MOCK_TUTOR in t for t, _ in nodes()), "the shadow's reply in the real chat"
            go_home()
        else:
            print("    no review to finish: the digest isn't shown")

        # the panel: the events with the shadow's replies and tool calls, the real tutor's; the numbers; the export
        qa_hook("shadow")
        assert wait_for("Events", 8), "the panel"
        assert tap("Events", 3), "the events tab"
        assert wait_for(MOCK_TUTOR, 10), "the shadow's reply in the panel"
        assert wait_for(DEV_TUTOR, 4), "the real tutor's reply beside it"
        shot("shadow-events")
        # the newest event on Haiku at low too: its own stateless call, metered, beside the first; the mock answers as
        # Haiku at low did in Jan's shadow (text, end_turn, no reply call): the text becomes the reply, marked
        assert tap("Also run on", 3), "also run on"
        assert tap("claude-haiku-5-5 · low", 3), "Haiku at low in the menu"
        assert wait_for("also · ", 15) and any("also · " in t and "claude-haiku-5-5 · low" in t for t, _ in nodes()), "the event's turn on Haiku at low"
        assert wait_for(FROM_TEXT, 15), "the reply taken from the text (no reply tool)"
        assert wait_for("reply ✍️ as text", 4), "the run's line: how it replied"
        time.sleep(slow())
        shot("shadow-also-haiku-low")
        assert tap("tool call(s)", 3), "a turn's tool calls"
        time.sleep(1)
        shot("shadow-tools")
        assert tap("Numbers", 3), "the numbers tab"
        assert wait_for("calls ", 4), "the day's numbers"
        shot("shadow-numbers")
        for _ in range(8):  # to the list's end: the export is its last
            adb("shell", "input", "swipe", "540", "1600", "540", "700", "300")
        time.sleep(1)
        assert tap("Export everything", 3), "the export"
        time.sleep(3 * slow())
        shot("shadow-share")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the share sheet
        time.sleep(1)
        listed = run_as("ls", "cache/shared").split()
        export = next((f for f in listed if f.startswith("lani-shadow-")), None)
        assert export, f"the export in cache/shared: {listed}"
        assert pull(f"cache/shared/{export}", OUT / "shadow-export.json"), "the export pulled"
        text = (OUT / "shadow-export.json").read_text()
        assert "lani.shadow-export/v0" in text and MOCK_TUTOR in text, "the export's content"
        assert SHADOW_KEY not in text and "qa-fake" not in text, "the key in the export"
        exported = json.loads(text)
        today_stats = exported["days"][-1]["stats"]
        assert today_stats.get("repliesFromText", 0) >= 1 and '"replyFromText":true' in text, "the reply from text in the export"
        assert any(k.startswith("claude-haiku-5-5 · low") for k in today_stats.get("byModelEffort", {})), f"the numbers by model × effort in the export: {list(today_stats.get('byModelEffort', {}))}"
        assert tap("Notebook", 3), "the notebook tab"
        time.sleep(1)
        shot("shadow-notebook")

        # the effort: the model and the effort per task, our recommendation marked; the chat's set to high
        assert tap("Settings", 3), "the settings tab"
        assert scroll_to("chat effort:", 6), "the effort per task"
        # the matrix's recommendation (2026-10): chat and routine at xhigh, grading at high, content on Opus at medium
        assert find("routine effort: xhigh ⭐") and find("chat effort: xhigh ⭐") and find("grading effort: high ⭐"), "the recommended efforts (routine xhigh, chat xhigh, grading high)"
        assert find("content: claude-opus-5-5 ⭐") and find("content effort: medium ⭐"), "content on Opus at medium"
        shot("shadow-effort-settings")
        # a picker at a level below xhigh (grading's): xhigh and max behind "more"
        assert tap("grading effort: high", 3), "the grading's effort picker"
        assert wait_for("high " + RECOMMENDED, 4) and find(MORE_LEVELS), "the levels, the recommended one marked, more behind a toggle"
        assert not any(t in ("xhigh", "max") for t, _ in nodes()), "xhigh and max behind more"
        assert tap(MORE_LEVELS, 3), "more levels"
        time.sleep(1)
        shown = {t for t, _ in nodes()}
        assert {"xhigh", "max"} <= shown, f"xhigh and max after more: {sorted(t for t in shown if len(t) < 40)}"
        shot("shadow-effort-picker")
        assert tap("as the preset (high)", 3), "grading's as the preset"
        # the chat's picker opens with xhigh and max (its level is xhigh); the chat's effort set to high
        assert tap("chat effort: xhigh", 3), "the chat's effort picker"
        assert wait_for("xhigh " + RECOMMENDED, 4) and find("max"), "the chat's levels, xhigh recommended, the more levels shown"
        assert tap("high", 3), "high"
        assert wait_for("chat effort: high ✎", 4), "the chat's effort set to high"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel
        time.sleep(1)

        # a second chat on the day's thread (Sonnet), now at high: an effort message, the thread's top-level effort kept
        before = len([r for r in mock_api("/mock/requests") if r.get("path") == "/v1/messages"])
        assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
        assert wait_for("💬 Tvoj učitelj", 6), "the tutor chat"
        assert tap("Napiši…", 4), "the chat's field"
        time.sleep(slow())
        adb("shell", "input", "text", "Kaj%sje%spec")  # adb types ASCII only
        time.sleep(0.5)
        assert tap("Pošlji · Send", 4), "send"
        end = time.time() + 30 * slow()
        while time.time() < end and len([r for r in mock_api("/mock/requests") if r.get("path") == "/v1/messages"]) < before + 3:
            time.sleep(1)
        time.sleep(2 * slow())
        assert not any(MOCK_TUTOR in t for t, _ in nodes()), "the shadow's reply in the real chat"
        go_home()
        qa_hook("shadow")
        assert tap("Events", 6), "the events tab"
        assert wait_for("day · chat · claude-sonnet-5-5 · high", 10), "the second chat's turn on the thread at high"
        shot("shadow-effort-thread")
        # the same event on Haiku at high: a reply through the tool
        assert tap("Also run on", 3), "also run on"
        assert tap("claude-haiku-5-5 · high", 3), "Haiku at high in the menu"
        assert wait_for("also · chat · claude-haiku-5-5 · high", 15), "the chat's turn on Haiku at high"
        time.sleep(2 * slow())
        shot("shadow-also-haiku-high")
        assert tap("Numbers", 3), "the numbers tab"
        assert wait_for("By model × effort", 4), "the numbers by model × effort"
        assert find("claude-sonnet-5-5 · high:") and find("claude-haiku-5-5 · low:"), "the runs by model and effort"
        shot("shadow-effort-numbers")
        # the chat's effort back to the preset's
        assert tap("Settings", 3), "the settings tab"
        assert scroll_to("chat effort:", 6), "the effort per task"
        assert tap("chat effort: high", 3), "the chat's effort picker"
        assert tap("as the preset (xhigh)", 3), "as the preset"
        assert wait_for("chat effort: xhigh ⭐", 4), "the chat's effort as the preset's"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel
        time.sleep(1)

        # the mock saw the requests: the key only in x-api-key (never in a body), the prefix's 1-hour breakpoint, the tools
        reqs = [r for r in mock_api("/mock/requests") if r.get("path") == "/v1/messages"]
        assert reqs, "no request reached the mock"
        assert all(r.get("has_key") for r in reqs), "a request without the key"
        assert all(SHADOW_KEY not in json.dumps(r.get("body")) for r in reqs), "the key in a request's body"
        first = reqs[0]["body"]
        assert first["system"][-1].get("cache_control", {}).get("ttl") == "1h", "the 1-hour breakpoint at the prefix's end"
        assert [t["name"] for t in first["tools"]][:3] == ["reply", "guide", "learner_state"], "phase A's tool order"
        assert first.get("tool_choice", {}).get("type") == "auto", "tool_choice auto"
        # the effort: the per-message effort's beta only with an effort message, the thinking-binding beta always
        for r in reqs:
            betas = (r.get("anthropic_beta") or "").split(",")
            assert "thinking-binding-controls-2026-08-01" in betas, "the thinking-binding beta"
            assert (EFFORT_BETA in betas) == bool(r.get("effort_messages")), f"the per-message effort's beta with an effort message only: {betas} {r.get('effort_messages')}"
        digest = [r for r in reqs if r.get("model") == "claude-haiku-5-5" and "<digest" in json.dumps(r["body"]["messages"])]  # the core prompt names it too
        assert not digest or all(r["effort"] == "xhigh" and r["body"]["max_tokens"] == 32000 for r in digest), "the digest on Haiku at xhigh, 32,000 tokens of room"
        sonnet = [r for r in reqs if r.get("model") == "claude-sonnet-5-5"]
        at_high = [r for r in sonnet if r.get("effort") == "high"]
        assert at_high, "the second chat's calls at high"
        assert all(r["effort_top"] == "xhigh" and r.get("effort_messages") for r in at_high), "the thread's top-level effort (the chat's: xhigh) kept, the level by an effort message"
        earlier = [r for r in sonnet if not r.get("effort_messages")]
        msgs, prev = at_high[0]["body"]["messages"], earlier[-1]["body"]["messages"]
        assert msgs[:len(prev)] == prev, "the thread's history before the effort message: as sent before (the cache's prefix)"
        e = next(i for i, m in enumerate(msgs) if m.get("role") == "system")
        assert msgs[e] == {"role": "system", "content": [], "output_config": {"effort": "high"}} and msgs[e + 1]["role"] == "user" and e >= len(prev), "the effort message after the last answer, before the chat's user message"
        assert any(r.get("call") == "no_reply" and r.get("effort") == "low" for r in reqs), "Haiku at low answered without reply"
        (OUT / "shadow-mock-requests.json").write_text(json.dumps(reqs, indent=1, ensure_ascii=False))
        log = adb("logcat", "-d", "-s", "ShadowTutor:*", check=False)
        (OUT / "shadow-logcat.txt").write_text(log)
        assert SHADOW_KEY not in log and "qa-fake" not in log, "the key in a log line"
        print(f"    {len(reqs)} calls to the mock; the export {export}, {len(text) // 1024} KB")
    finally:
        mock.terminate()


MATRIX_LANES = ["claude-haiku-5-5@medium", "claude-haiku-5-5@high", "claude-haiku-5-5@xhigh", "claude-haiku-5-5@max",
                "claude-sonnet-5-5@low", "claude-sonnet-5-5@medium", "claude-sonnet-5-5@high", "claude-opus-5-5@low",
                "claude-opus-5-5@medium"]  # the matrix's default lanes (tutor/Matrix.kt MatrixSettings.DEFAULT_LANES)


def dev_bridge(path: str, body=None, method=None):
    """The dev bridge's API from this machine (127.0.0.1:PORT, the app's token): its JSON answer."""
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(f"http://127.0.0.1:{PORT}{path}", data=data, method=method or ("POST" if body is not None else "GET"),
                                 headers={"authorization": f"Bearer {TOKEN}", "content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read() or b"null")


LIVE_KEY = "sk-ant-qa-live-fake-000000000000"  # QA's mock takes any key; never a real one
TUTOR_SECTION = "Kdo odgovarja · Who answers"  # the Tutor section's first line (l10n tutorLive.who; its title "Učitelj · Tutor" is also the info line's)
IN_THE_APP = "V aplikaciji · In the app"  # who answers (tutorLive.app)
ON_THE_NODE = "Claude Code na mojem vozlišču · Claude Code on my node"  # (tutorLive.node)
LIVE_READY = "The tutor in the app answers"  # its state line (tutorLive.state.IDLE, RUNNING …)
AI_HERE = "Odgovarja umetna inteligenca"  # the chat's disclosure line (tutorLive.chatDisclosure)
SLOW_REPLY_END = "Kako si danes?"  # the end of the mock's slow reply ([mock:slow])
SCRATCH_SHOTS = os.environ.get("LANI_QA_TUTOR_SHOTS")  # also copied there as tutor-live-<name>.png


def tutor_live():
    """The tutor in the app answering for real (docs/plans/05-built/tutor-live.md), against QA's mock of the Messages API
    (test/tutor-mock.ts, its slow reply: LANI_TUTOR_MOCK_SLOW_MS 300) and the dev bridge's tutor session: the connection
    sheet's "🧑‍🏫 Učitelj · Tutor" section (Claude Code on the node at first), "In the app", a fake key checked and kept,
    the app attached to the dev bridge's channel, "react at once" on; a chat sent ("[mock:slow]"): the dev bridge's canned
    tutor (Claude Code here) never hears it, the mock's reply streams into the chat's bubble (a screenshot mid-way) and
    stays as the final message, the chat says an AI answers; a session's end (as the app posts it) gets the mock's
    reaction, and its record_session is in the dev data (the session log, the mistake); then "Claude Code on my node"
    again: detached, a chat answered by the dev bridge's tutor once more."""
    os.environ["LANI_TUTOR_MOCK_SLOW_MS"] = os.environ.get("LANI_TUTOR_MOCK_SLOW_MS", "300")
    mock = start_tutor_mock()
    def keep(name):
        shot(f"tutor-live-{name}")
        if SCRATCH_SHOTS:
            Path(SCRATCH_SHOTS).mkdir(parents=True, exist_ok=True)
            shutil.copy(shots[-1], Path(SCRATCH_SHOTS) / f"tutor-live-{name}.png")
    try:
        qa_hook(f"tutorlive:{SHADOW_MOCK}")
        session = dev_bridge("/tutor/session")
        assert session.get("protocol") == 1 and session.get("attached") is None, f"the dev bridge's tutor session: {session.get('protocol')}"
        open_connection_sheet()
        assert scroll_to(TUTOR_SECTION, 12), "the Tutor section"
        assert find(ON_THE_NODE), "who answers: Claude Code on the node at first"
        keep("settings-node")
        assert tap(IN_THE_APP, 4), "In the app"
        assert scroll_to("sk-ant-…", 4), "the key's field"
        field = find("sk-ant-…")
        tap_at(field)
        time.sleep(slow())
        adb("shell", "input", "text", LIVE_KEY)
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        assert tap("Preveri in shrani · Check and keep", 4), "the key's check"
        assert wait_for(LIVE_READY, 20), "attached: the tutor in the app answers"
        attached = dev_bridge("/tutor/session").get("attached") or {}
        assert attached.get("who") == "app", f"the dev bridge's channel is the app's: {attached}"
        assert (scroll_to("React at once: off", 6) or find("React at once: off")) and tap("React at once: off", 3), "react at once"  # at the sheet's end it stays low
        assert wait_for("React at once: on", 5), "react at once on"
        scroll_to(TUTOR_SECTION, 0)
        to_top()
        assert scroll_to(TUTOR_SECTION, 12), "the Tutor section again"
        adb("shell", "input", "swipe", "540", "1500", "540", "900", "300")  # its chips and the key's line in view
        time.sleep(1)
        keep("settings")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        go_home()

        # a chat: the mock answers through the app, streamed; the dev bridge's tutor (Claude Code here) hears nothing
        assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
        assert wait_for("💬 Tvoj učitelj", 6), "the tutor chat"
        assert wait_for(AI_HERE, 5), "the chat says an AI answers"
        assert tap("Napiši…", 4), "the chat's field"
        time.sleep(slow())
        adb("shell", "input", "text", "Zivjo%s[mock:slow]")
        time.sleep(0.5)
        assert tap("Pošlji · Send", 4), "send"
        midway = False
        end = time.time() + 40 * slow()
        while time.time() < end:
            texts = [t for t, _ in nodes()]
            if any(MOCK_TUTOR in t for t in texts) and not any(SLOW_REPLY_END in t for t in texts):
                keep("streaming")
                midway = True
                break
            if any(SLOW_REPLY_END in t for t in texts):
                break
            time.sleep(0.3)
        assert midway, "the reply seen while it was written"
        assert wait_for(SLOW_REPLY_END, 40), "the final reply in the chat"
        time.sleep(1)
        keep("reply")
        assert not any(DEV_TUTOR in t for t, _ in nodes()), "Claude Code's (the dev tutor's) reply while the app's tutor answers"
        reqs = mock_api("/mock/requests")
        posts = [r for r in reqs if r.get("path") == "/v1/messages"]
        assert posts and all(r.get("has_key") for r in posts), "the mock's calls, each with the key"
        tools = [t.get("name") for t in (posts[0].get("body") or {}).get("tools", [])]
        assert tools[:3] == ["reply", "guide", "learner_state"], f"phase A's tools in order: {tools[:5]}"

        # a session's end, as the app posts it: the reaction at once, and record_session in the dev data
        before = dev_bridge("/state")
        sessions = len(((before.get("databases") or {}).get("session_log") or {}).get("sessions") or [])
        dev_bridge("/message", {"kind": "session_end", "conversation_id": "main", "text": "Vaja končana · Practice finished",
                                "data": {"module_id": "qa-live", "results": [{"exercise_index": 0, "correct": False, "answer": "Jaz je Jan."}]}})
        assert wait_for("videl sem dogodek session_end", 40), "the reaction to the session's end in the chat"
        keep("session-end")
        after = dev_bridge("/state")
        dbs = after.get("databases") or {}
        log = (dbs.get("session_log") or {}).get("sessions") or []
        assert len(log) > sessions and any(s.get("notes") == "A mock session." for s in log[-2:]), f"record_session in the dev data's session log ({len(log)} sessions)"
        assert "mock_pattern" in ((dbs.get("mistakes_db") or {}).get("error_patterns") or {}), "the mistake in the dev data"
        go_home()

        # off: Claude Code on the node answers again
        open_connection_sheet()
        assert scroll_to(TUTOR_SECTION, 12), "the Tutor section"
        assert tap(ON_THE_NODE, 4), "Claude Code on my node"
        assert wait_for("Odgovarja Claude Code na vozlišču", 15), "detached"
        assert dev_bridge("/tutor/session").get("attached") is None, "the dev bridge's channel is Claude Code's again"
        keep("settings-off")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        go_home()
        assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
        assert tap("Napiši…", 4), "the chat's field"
        time.sleep(slow())
        adb("shell", "input", "text", "Spet%sClaude")
        time.sleep(0.5)
        assert tap("Pošlji · Send", 4), "send"
        assert wait_for(DEV_TUTOR, 20), "the dev bridge's tutor (Claude Code here) answers again"
        assert find(AI_HERE) is None, "no AI line while Claude Code answers"
        keep("claude-code-again")
        (OUT / "tutor-live-mock-requests.json").write_text(json.dumps(mock_api("/mock/requests"), indent=1, ensure_ascii=False))
        log = adb("logcat", "-d", "-s", "LiveTutor", check=False)
        (OUT / "tutor-live-logcat.txt").write_text(log)
        assert LIVE_KEY not in log, "the key in the log"
    finally:
        mock.terminate()
        os.environ.pop("LANI_TUTOR_MOCK_SLOW_MS", None)


STUDIO_SHOTS = os.environ.get("LANI_QA_STUDIO_SHOTS")  # also copied there as studio-<name>.png
WRITING = "Pišem …"  # a studio job's card in the chat (l10n studio.writing)
STUDIO_PUBLISHED = "vaje so objavljene"  # the mock studio's reply after its module ([mock:studio-module])
STUDIO_STORY = "the story is written"  # its reply after the story the text editor wrote ([mock:studio-file])
ON_ITS_WAY = "vaje so na poti"  # the mock tutor's reply in the chat to [mock:request]


def live_tutor_on():
    """The tutor in the app on against QA's mock (as the tutor-live step turns it on); the key entered when none is kept."""
    qa_hook(f"tutorlive:{SHADOW_MOCK}")
    open_connection_sheet()
    assert scroll_to(TUTOR_SECTION, 12), "the Tutor section"
    assert tap(IN_THE_APP, 4), "In the app"
    if not wait_for(LIVE_READY, 6):
        assert scroll_to("sk-ant-…", 4), "the key's field"
        tap_at(find("sk-ant-…"))
        time.sleep(slow())
        adb("shell", "input", "text", LIVE_KEY)
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        assert tap("Preveri in shrani · Check and keep", 4), "the key's check"
        assert wait_for(LIVE_READY, 20), "attached: the tutor in the app answers"
    assert (dev_bridge("/tutor/session").get("attached") or {}).get("who") == "app", "the dev bridge's channel is the app's"
    adb("shell", "input", "keyevent", "KEYCODE_BACK")
    time.sleep(1)
    go_home()


def chat_send(text: str):
    """[text] sent from the tutor chat (Home's tutor bar)."""
    go_home()
    assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
    assert wait_for("💬 Tvoj učitelj", 6), "the tutor chat"
    assert tap("Napiši…", 4), "the chat's field"
    time.sleep(slow())
    # in pieces: a long text typed at once loses its end on the emulator's keyboard ("[mock:" and nothing after)
    for piece in re.split(r"([ :])", text):
        if piece:
            adb("shell", "input", "text", "%s" if piece == " " else piece)
            time.sleep(0.25)
    assert wait_for(text[-12:], 10), f"the text typed: {text}"
    time.sleep(0.5)
    assert tap("Pošlji · Send", 4), "send"


def studio_jobs() -> list:
    """The studio's jobs as the dev bridge keeps them (GET /tutor/jobs), newest first."""
    return dev_bridge("/tutor/jobs").get("jobs") or []


def studio():
    """The studio (docs/plans/05-built/studio.md): the tutor in the app against QA's mock (its studio calls slow:
    LANI_TUTOR_MOCK_STUDIO_MS 2500) and the dev bridge's tutor session. A chat asks for exercises ("[mock:request]"):
    the chat's tutor hands the studio a brief (request_content), says it's on its way, and the studio's job runs on Opus:
    a module the bridge's validator refuses, then a valid one; its reply in the chat, the "🎉" banner, the module on
    the dev bridge (GET /modules) and the job done there (GET /tutor/jobs). A story through the text editor
    ("[mock:request:file]"): refused by the story validator, then written; on the dev bridge (GET /stories). A slow job
    ("[mock:request:slow]"): its "✍️ Pišem …" card in the chat, the app killed mid-job (am force-stop) once the job saved
    two calls on the bridge, started again: the job goes on from the bridge's copy and finishes (two attempts, the module
    published once more). The Tutor section's studio list; then Claude Code on the node again. LANI_QA_STUDIO_SHOTS:
    the screenshots also there as studio-*.png."""
    os.environ["LANI_TUTOR_MOCK_STUDIO_MS"] = os.environ.get("LANI_TUTOR_MOCK_STUDIO_MS", "2500")
    mock = start_tutor_mock()

    def keep(name):
        shot(f"studio-{name}")
        if STUDIO_SHOTS:
            Path(STUDIO_SHOTS).mkdir(parents=True, exist_ok=True)
            shutil.copy(shots[-1], Path(STUDIO_SHOTS) / f"studio-{name}.png")

    try:
        live_tutor_on()
        session = dev_bridge("/tutor/session")
        app_tools = [t.get("name") for t in session.get("app_tools") or []]
        assert "str_replace_based_edit_tool" in app_tools and "search" in app_tools, f"the dev bridge's file tools: {app_tools}"
        before = {j.get("id") for j in studio_jobs()}

        # 1. a chat asks for exercises: the studio writes a module, its first try refused by the validator
        chat_send("Vaje za rodilnik prosim [mock:request]")
        assert wait_for(ON_ITS_WAY, 40), "the chat's tutor says it's on its way"
        # the mock's module job is quick: its card may be gone already (the slow job's is checked below)
        if find(WRITING):
            keep("writing")
        assert wait_for(STUDIO_PUBLISHED, 90), "the studio's reply in the chat"
        time.sleep(1)
        keep("module")
        jobs = [j for j in studio_jobs() if j.get("id") not in before]
        assert jobs and jobs[0].get("status") == "done", f"the job on the dev bridge: {[(j.get('id'), j.get('status')) for j in jobs]}"
        job = jobs[0]
        assert job.get("model") == "claude-opus-5-5", f"the studio on the content model: {job.get('model')}"
        assert any(p.get("item", "").endswith("mock-studio-drill") for p in job.get("published") or []), f"published: {job.get('published')}"
        modules = dev_bridge("/modules")
        ids = [m.get("id") for m in (modules.get("modules") if isinstance(modules, dict) else modules) or []]
        assert "mock-studio-drill" in ids, "the module on the dev bridge"
        reqs = mock_api("/mock/requests")
        studio_calls = [r for r in reqs if r.get("path") == "/v1/messages" and "studio of Lani" in json.dumps((r.get("body") or {}).get("system"))]
        refused = [r for r in studio_calls if "out of range" in json.dumps((r.get("body") or {}).get("messages", [])[-1:])]
        assert refused, "the validator's refusal went back to the model"
        tools = [t.get("type") or t.get("name") for t in (studio_calls[0].get("body") or {}).get("tools", [])]
        assert "text_editor_20250728" in tools, f"the text editor by its type: {tools[-6:]}"
        go_home()
        # the app has it: Home offers the new module (its title machine-written, test/tutor-mock.ts)
        assert wait_for("Pozdravi in vljudnost", 15), "the studio's module on Home"
        keep("home")

        # 2. a story through the text editor: refused by the story validator, then written
        before = {j.get("id") for j in studio_jobs()}
        chat_send("Zgodbo prosim [mock:request:file]")
        assert wait_for(STUDIO_STORY, 90), "the studio's reply after the story"
        time.sleep(1)
        keep("file")
        stories = dev_bridge("/stories")
        ids = [s.get("id") for s in (stories.get("stories") if isinstance(stories, dict) else stories) or []]
        assert "mock-studio-story" in ids, f"the story on the dev bridge ({len(ids)} stories)"
        reqs = mock_api("/mock/requests")
        assert any("doesn't validate as a story" in json.dumps((r.get("body") or {}).get("messages", [])[-1:]) for r in reqs), "the story validator's refusal"

        # 3. a slow job, the app killed in the middle, started again: the job goes on from the bridge's copy
        before = {j.get("id") for j in studio_jobs()}
        chat_send("Vaje znova prosim [mock:request:slow]")
        assert wait_for(WRITING, 40), "the slow job's card"
        keep("slow-writing")
        end = time.time() + 90 * slow()
        job = None
        while time.time() < end:
            job = next((j for j in studio_jobs() if j.get("id") not in before), None)
            if job and int(job.get("calls") or 0) >= 2:
                break
            time.sleep(1)
        assert job and int(job.get("calls") or 0) >= 2 and job.get("status") != "done", f"the job mid-way: {job and (job.get('status'), job.get('calls'))}"
        adb("shell", "am", "force-stop", PKG)
        time.sleep(3)
        killed = next(j for j in studio_jobs() if j.get("id") == job.get("id"))
        assert killed.get("status") != "done", "killed before it was done"
        adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
        assert wait_for("Danes · Today", 30), "Home after the app started again"
        assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
        resumed = wait_for(WRITING, 30)
        if resumed:
            keep("resumed")
        end = time.time() + 120 * slow()
        while time.time() < end:
            done = next(j for j in studio_jobs() if j.get("id") == job.get("id"))
            if done.get("status") == "done":
                break
            time.sleep(2)
        assert done.get("status") == "done", f"the resumed job: {done.get('status')}"
        assert int(done.get("attempts") or 0) >= 2, f"run twice (killed, resumed): {done.get('attempts')}"
        assert wait_for(STUDIO_PUBLISHED, 20), "the resumed job's reply in the chat"
        keep("done")
        print(f"    jobs: {len(studio_jobs())}; the killed one {done.get('id')} resumed ({done.get('attempts')} attempts, {done.get('calls')} calls)")

        # the Tutor section's studio list
        go_home()
        open_connection_sheet()
        # at the sheet's end it stays low, below scroll_to's band: found as it is then
        assert scroll_to("Studio: kar napiše učitelj", 14) or find("Studio: kar napiše učitelj"), "the studio's list in the Tutor section"
        keep("settings")
        (OUT / "studio-mock-requests.json").write_text(json.dumps(mock_api("/mock/requests"), indent=1, ensure_ascii=False))
        log = adb("logcat", "-d", "-s", "LiveTutor", check=False)
        (OUT / "studio-logcat.txt").write_text(log)
        assert LIVE_KEY not in log, "the key in the log"

        # Claude Code on the node again (the sheet opened afresh: the Tutor section is above where the list was)
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
        open_connection_sheet()
        assert scroll_to(TUTOR_SECTION, 12), "the Tutor section"
        assert tap(ON_THE_NODE, 4), "Claude Code on my node"
        assert wait_for("Odgovarja Claude Code na vozlišču", 15), "detached"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        time.sleep(1)
    finally:
        try:
            (OUT / "studio-mock-requests.json").write_text(json.dumps(mock_api("/mock/requests"), indent=1, ensure_ascii=False))
            (OUT / "studio-logcat.txt").write_text(adb("logcat", "-d", "-s", "LiveTutor", check=False))
        except Exception:
            pass
        mock.terminate()
        os.environ.pop("LANI_TUTOR_MOCK_STUDIO_MS", None)


def shadow_matrix():
    """The shadow's matrix (docs/plans/05-phase-0.md, "The matrix") against QA's mock: the panel's Matrix tab (the
    switch, the lanes' grid), turned on with the nine default lanes; a chat answered by the primary and by every lane at
    its own model and effort (the mock's log: the lanes' calls with their effort as the top-level one, no effort
    message, max_tokens by the level), the event's "🧪 Matrix: 9 lane(s)" in Events with each lane's run, today's spend
    per lane; the matrix off again. Sets the mock's base URL and a fake key itself when the shadow-tutor step didn't."""
    mock = start_tutor_mock()
    try:
        qa_hook(f"shadow:{SHADOW_MOCK}")
        assert wait_for("Settings", 8), "the panel"
        assert tap("Settings", 3), "the settings tab"
        time.sleep(1)
        if find("sk-ant-…"):
            field = find("sk-ant-…")
            tap_at(field)
            time.sleep(slow())
            adb("shell", "input", "text", SHADOW_KEY)
            adb("shell", "input", "keyevent", "KEYCODE_BACK")
            time.sleep(1)
            assert tap("Check (GET /v1/models) and keep", 4), "the key's check"
            assert wait_for("the key works", 10 * slow()), "the mock took the key"
        to_top()
        if find("Shadow mode: off"):
            assert tap("Shadow mode: off", 3), "the switch"
        assert wait_for("Shadow mode: on", 6), "shadow mode on"
        assert tap("Matrix", 3), "the matrix tab"
        assert wait_for("🧪 The matrix", 4), "the matrix's section"
        if find("The matrix: on"):
            assert tap("The matrix: on", 3)  # from an earlier run: off first, so its lanes start afresh
        assert wait_for("The matrix: off", 4), "the matrix off by default"
        assert find("Haiku · claude-haiku-5-5") and find("Sonnet · claude-sonnet-5-5") and find("Opus · claude-opus-5-5"), "the grid: each family's model"
        shot("matrix-off")
        assert tap("The matrix: off", 3), "the matrix's switch"
        assert wait_for("The matrix: on", 4) and wait_for("on: 9 lane(s)", 6), "the matrix on, nine lanes"
        shot("matrix-on")
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel
        time.sleep(1)
        mock_api("/mock/reset", "POST")

        # a chat: the primary's turn and one in each lane, each on its own thread
        go_home()
        assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
        assert wait_for("💬 Tvoj učitelj", 6), "the tutor chat"
        assert tap("Napiši…", 4), "the chat's field"
        time.sleep(slow())
        adb("shell", "input", "text", "Kaj%sje%sizvir")  # adb types ASCII only
        time.sleep(0.5)
        assert tap("Pošlji · Send", 4), "send"
        end = time.time() + 90 * slow()
        reqs = []
        while time.time() < end:
            reqs = [r for r in mock_api("/mock/requests") if r.get("path") == "/v1/messages"]
            if len({(r.get("model"), r.get("effort_top")) for r in reqs}) >= 10 and len(reqs) >= 30:
                break
            time.sleep(1)
        time.sleep(2 * slow())
        assert not any(MOCK_TUTOR in t for t, _ in nodes()), "a shadow's reply in the real chat"
        go_home()
        pairs = {f"{r.get('model')}@{r.get('effort_top')}" for r in reqs}
        assert set(MATRIX_LANES) <= pairs, f"every lane's calls at its model and effort: {sorted(pairs)}"
        lanes = [r for r in reqs if f"{r.get('model')}@{r.get('effort_top')}" in MATRIX_LANES and not r.get("effort_messages")]
        assert all(r["body"]["max_tokens"] == {"max": 64000, "xhigh": 32000}.get(r["effort_top"], 16000) for r in lanes), "max_tokens by the lane's level"
        assert all(r.get("has_key") and SHADOW_KEY not in json.dumps(r.get("body")) for r in reqs), "the key only in x-api-key"
        (OUT / "matrix-mock-requests.json").write_text(json.dumps(reqs, indent=1, ensure_ascii=False))

        # the panel: the event's lane runs, today's spend per lane
        qa_hook("shadow")
        assert tap("Events", 6), "the events tab"
        assert tap("🧪 Matrix: 9 lane(s)", 10), "the event's lane runs"
        assert wait_for("🧪 claude-haiku-5-5@medium · chat", 6), "a lane's run of the chat (the grid's order: Haiku medium first)"
        shot("matrix-event-lanes")
        assert tap("Matrix", 3), "the matrix tab"
        for _ in range(3):
            adb("shell", "input", "swipe", "540", "1500", "540", "900", "300")
        time.sleep(1)
        assert wait_for("the lanes' spend", 4) and find("claude-haiku-5-5@max: $"), "today's spend per lane"
        shot("matrix-spend")
        to_top()
        assert tap("The matrix: on", 3), "the matrix's switch"
        assert wait_for("The matrix: off", 4), "the matrix off again"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel
        time.sleep(1)
        print(f"    {len(reqs)} calls to the mock (the primary's and the nine lanes'), {len(pairs)} model × effort pairs")
    finally:
        mock.terminate()


def dev_copy() -> Path:
    """The dev bridge's copy of the learner data (its log's "data copy: <dir>", test/dev-bridge.ts)."""
    m = re.search(r"data copy: (\S+)", (OUT / "bridge.log").read_text(errors="replace"))
    assert m, "the dev bridge's data copy (bridge.log)"
    return Path(m.group(1))


def dev_saved() -> int:
    """How many uploads the dev bridge saved so far (its log's "dev: …" lines, src/features/dev.ts)."""
    text = (OUT / "bridge.log").read_text(errors="replace")
    return text.count("dev: the shadow's export saved") + text.count("dev: the app's log appended")


SEND_TO_NODE = "📤 Pošlji vozlišču · Send to the node"  # the shadow panel's button (ui/tutor/ShadowPanel.kt)
SECRET_LIKE = re.compile(r"sk-ant-(?!‹)[A-Za-z0-9_-]{6,}|Bearer (?!‹)[A-Za-z0-9._~+/=-]{6,}|token=(?!‹)[^&\s\"']+")


def data_sheet():
    """"💾 Podatki · Data" (ui/data/DataSheet, docs/plans/05-built/git-sync.md), opened by QA's hook "data": git not
    connected, who writes the data, this phone's id, the backup without a relay (the debug build has none), a screenshot
    each; then "🔗 Poveži git · Connect git": without a GitHub client id (the debug build's) the dialog says so and offers
    the token field. Nothing is connected or sent."""
    qa_hook("data")
    assert wait_for("Podatki · Data", 8), "the data sheet"
    assert wait_for("Poveži git · Connect git", 4), "connect git"
    time.sleep(slow())
    shot("data-sheet")
    assert tap("Poveži git · Connect git", 4), "connect git"
    assert wait_for("prilepi žeton", 6), "the token field"
    shot("data-connect")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the dialog
    time.sleep(1)
    # up to the backup (a drag down would close the sheet: only up)
    adb("shell", "input", "swipe", "540", "1800", "540", "900", "500")
    time.sleep(1.2)
    assert wait_for("Varnostna kopija · Backup", 4), "the backup section"
    assert find("Ta telefon:") is not None, "this phone's id"
    shot("data-sheet-backup")
    adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the sheet
    time.sleep(1)


def dev_upload():
    """The developer's data on the node (companion/README.md "Developer data on the node"): the developer setting on and
    the shadow tutor on QA's mock (QA's hook "shadow:<mock>", a fake key), a chat, the app to the background: the shadow's
    export and the app's log land in the dev bridge's copy of the data under app/dev/ (shadow-<day>.json,
    app-log-<day>.txt, mode 0600), the export with the thread's first call's raw usage, the log with the shadow's lines
    from logcat, neither with the key or the device token; the copy's .gitignore keeps /app/dev/ out; the panel's "📤
    Pošlji vozlišču" sends again; with the developer setting off ("dev:off") the background sends nothing."""
    for pid in listeners(SHADOW_MOCK_PORT):
        subprocess.run(["kill", pid])
    mock = subprocess.Popen(["bun", "test/tutor-mock.ts"], cwd=BRIDGE, stdout=open(OUT / "dev-upload-mock.log", "w"), stderr=subprocess.STDOUT,
                            env={**os.environ, "LANI_TUTOR_MOCK_PORT": SHADOW_MOCK_PORT})
    atexit.register(mock.terminate)
    try:
        end = time.time() + 15
        while time.time() < end:
            try:
                mock_api("/mock/reset", "POST")
                break
            except Exception:
                time.sleep(0.5)
        else:
            raise AssertionError("the mock didn't start (dev-upload-mock.log)")
        copy = dev_copy()
        dev = copy / "app" / "dev"
        day = time.strftime("%Y-%m-%d")
        shadow_file, log_file = dev / f"shadow-{day}.json", dev / f"app-log-{day}.txt"

        # the developer setting on, the shadow on the mock with a fake key (the panel opens for it)
        qa_hook(f"shadow:{SHADOW_MOCK}")
        assert wait_for("Shadow tutor", 8), "the shadow's panel"
        if find("Shadow mode") is None:
            assert tap("Settings", 3), "the panel's settings"
        to_top()
        if (field := find("sk-ant-…")) is not None:
            tap_at(field)
            time.sleep(slow())
            adb("shell", "input", "text", SHADOW_KEY)
            adb("shell", "input", "keyevent", "KEYCODE_BACK")
            time.sleep(1)
            assert tap("Check (GET /v1/models) and keep", 4), "the key's check"
            assert wait_for("the key works", 10 * slow()), "the mock took the key"
        if find("Shadow mode: off"):
            assert tap("Shadow mode: off", 3), "the switch"
        assert wait_for("Shadow mode: on", 6), "shadow mode on"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel
        time.sleep(1)
        go_home()

        # a chat: the shadow's turn on the mock (its calls, the first with its raw usage)
        assert tap("Tvoj učitelj · Your tutor", 6), "the tutor bar"
        assert wait_for("💬 Tvoj učitelj", 6), "the tutor chat"
        assert tap("Napiši…", 4), "the chat's field"
        time.sleep(slow())
        adb("shell", "input", "text", "Kako%sse%srece%sdev%supload")  # adb types ASCII only
        time.sleep(0.5)
        assert tap("Pošlji · Send", 4), "send"
        assert wait_for(DEV_TUTOR, 20), "the real tutor's reply in the chat"
        time.sleep(5 * slow())  # the shadow's turn: three calls to the mock
        go_home()

        # the app to the background: both land in the copy's app/dev/
        qa_hook("dev:again")  # an earlier step may have sent within the 30 minutes
        before = dev_saved()
        adb("shell", "input", "keyevent", "KEYCODE_HOME")
        end = time.time() + 30 * slow()
        while time.time() < end and dev_saved() < before + 2:
            time.sleep(1)
        assert shadow_file.is_file(), f"the shadow's export in {dev}: {sorted(p.name for p in dev.glob('*')) if dev.exists() else 'no app/dev'}"
        assert log_file.is_file(), "the app's log in app/dev"
        assert (dev.stat().st_mode & 0o777) == 0o700 and (shadow_file.stat().st_mode & 0o777) == 0o600 and (log_file.stat().st_mode & 0o777) == 0o600, "app/dev 0700, its files 0600"
        export = json.loads(shadow_file.read_text())
        assert export.get("schema") == "lani.shadow-export/v0", "the export's schema"
        text = shadow_file.read_text()
        assert MOCK_TUTOR in text and "dev upload" in text, "the shadow's turn and the chat in the export"
        calls = [c for d in export["days"] for c in d["log"]["calls"]]
        raw = [c for c in calls if c.get("usageRaw")]
        assert raw and "cache_creation" in raw[0]["usageRaw"].get("start", {}), f"the raw usage of the thread's first call: {len(calls)} calls, {len(raw)} with it"
        breakdown = sum(d["stats"].get("cacheBreakdown", 0) for d in export["days"])
        assert breakdown >= 1, "the day's count of calls with the breakdown"
        assert all("byModelEffort" in d["stats"] and "repliesFromText" in d["stats"] for d in export["days"]), "the numbers by model × effort and the replies from text"
        assert any(c.get("effort") for c in calls) and any(" · " in k for d in export["days"] for k in d["stats"]["byModelEffort"]), "the calls' effort and the numbers by it"
        log = log_file.read_text(errors="replace")
        assert log.startswith("=== ") and " ShadowTutor: " in log, "the app's log: its header and the shadow's lines from logcat"
        for name, body in (("the export", text), ("the log", log)):
            assert SHADOW_KEY not in body and "qa-fake" not in body, f"the key in {name}"
            assert TOKEN not in body, f"the device token in {name}"
            assert not SECRET_LIKE.search(body), f"something shaped like a secret in {name}: {SECRET_LIKE.search(body).group(0)[:40]}"
        (OUT / "dev-shadow.json").write_text(text)
        (OUT / "dev-app-log.txt").write_text(log)
        ignore = copy / ".gitignore"
        if ignore.is_file():
            assert "/app/dev/" in ignore.read_text().splitlines(), "the copy's .gitignore keeps /app/dev/ out"
        print(f"    app/dev: the export {len(text) // 1024} KB ({len(calls)} calls, {len(raw)} with raw usage), the log {len(log.splitlines())} lines")

        # the panel's button sends again
        adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
        time.sleep(2)
        qa_hook("shadow")
        assert tap("Numbers", 6), "the numbers tab"
        for _ in range(20):  # to the list's end: the export and the button are its last (a day of many calls is long)
            c = find(SEND_TO_NODE)
            if c is not None and c[1] < 2100:
                break
            adb("shell", "input", "swipe", "540", "1600", "540", "700", "300")
        time.sleep(1)
        mtime = shadow_file.stat().st_mtime_ns
        before = dev_saved()
        assert tap(SEND_TO_NODE, 4), "the panel's button"
        end = time.time() + 15 * slow()
        while time.time() < end and dev_saved() <= before:
            time.sleep(1)
        for _ in range(3):  # its outcome under the button, at the list's end
            adb("shell", "input", "swipe", "540", "1600", "540", "700", "300")
        assert wait_for("asked in the panel", 10), "its outcome in the panel"
        shot("dev-upload-panel")
        assert dev_saved() > before and shadow_file.stat().st_mtime_ns != mtime, "the button's upload on the node"
        adb("shell", "input", "keyevent", "KEYCODE_BACK")  # the panel
        time.sleep(1)

        # the developer setting off: the background sends nothing
        qa_hook("dev:off")
        qa_hook("dev:again")
        mtime, size, before = shadow_file.stat().st_mtime_ns, log_file.stat().st_size, dev_saved()
        adb("logcat", "-c")
        adb("shell", "input", "keyevent", "KEYCODE_HOME")
        time.sleep(8 * slow())
        adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
        time.sleep(2)
        assert dev_saved() == before and shadow_file.stat().st_mtime_ns == mtime and log_file.stat().st_size == size, "an upload with the developer setting off"
        said = adb("logcat", "-d", "-s", "DevUpload:*", check=False)
        assert "developer setting is off" in said, "the background's upload didn't run (DevUpload's QA line)"
        go_home()
    finally:
        mock.terminate()


WISH_MODULE = {
    # a tutor's module as the dev bridge keeps it (app/modules/<id>/v1.json): a select-all, then two near misses (almost)
    "schema": "lani.module/v0", "id": "wish-qa", "version": 1, "title": "Pozdravi · Greetings (QA)", "level": "A1",
    "targets": [], "tags": [],
    "exercises": [
        {"type": "multi", "prompt": "Which greetings are polite (vi)?", "options": ["Dober dan", "Živjo", "Dobro jutro", "Oj"],
         "answers": [0, 2], "say_options": True, "explain": "**dober dan**, **dobro jutro** → *vi*\n- živjo, oj · for friends"},
        {"type": "choice", "prompt": "Micka's new neighbour greets you: »Dober dan!« You say…", "options": ["Dober dan!", "Živjo!", "Lahko noč!"],
         "answer": 0, "almost": [1], "say_options": False,
         "explain": "**Dober dan** to someone you meet for the first time → *vi*\n- živjo · hi, for friends: almost"},
        {"type": "scenario", "scene": "🏡 Ob ograji, 9:00", "speaker": "Soseda", "line": "Dober dan!", "prompt": "Greet her back.",
         "options": ["Živjo!", "Dober dan!", "Hvala!"], "answer": 1, "almost": [0],
         "explain": "**Dober dan** back to a neighbour you don't know yet\n- živjo · for friends: almost"},
    ],
}
# the cards of the request QA makes: a word, and a grammar card of three forms joined by " · " (vocab_biti_dual's, as it was)
WISH_CARDS = {
    "vocab_hvala": {"type": "vocabulary", "content": "hvala", "answer": "thank you", "category": "politeness"},
    "vocab_biti_dual": {"type": "grammar", "content": "midva sva · vidva sta · onadva sta",
                        "answer": "we two are · you two are · they two are", "category": "grammar_dual"},
}


def wish_snap(name: str):
    """A screenshot of the wishlist step, also as wish-<name>.png in $LANI_QA_WISH_SHOTS when it's set."""
    shot(f"wish-{name}")
    if d := os.environ.get("LANI_QA_WISH_SHOTS"):
        Path(d).mkdir(parents=True, exist_ok=True)
        shutil.copy(shots[-1], Path(d) / f"wish-{name}.png")


def wishlist():
    """The tutor's wishlist of 2026-10-25 in the app: a select-all exercise looks like one (a checkbox on each option, the
    count on its Check button: "0 izbranih · 0 selected", "Preveri · Check (2)"); a picked near miss is almost (a choice's
    and a picked scenario's `almost`: "Živjo!" to a first "Dober dan", the feedback "Skoraj!"); a request's grammar card is
    a flashcard in its challenge, never typed (QA's hook "request:<ids>"; companion/GAME.md, "Cards in a challenge"). The
    module and the cards go into the dev bridge's copy first (the copy's own deck may have neither); the app is started
    again to read the cards. Each screenshot also as wish-<name>.png in $LANI_QA_WISH_SHOTS when it's set."""
    copy = dev_copy()
    mod = copy / "app/modules/wish-qa"
    mod.mkdir(parents=True, exist_ok=True)
    (mod / "v1.json").write_text(json.dumps(WISH_MODULE, ensure_ascii=False, indent=2))
    (mod / "current.json").write_text(json.dumps({"version": 1}))
    sr_file = copy / "spaced-repetition.json"
    sr = json.loads(sr_file.read_text())
    today = time.strftime("%Y-%m-%d")
    for cid, c in WISH_CARDS.items():
        sr.setdefault("items", {}).setdefault(cid, {
            **c, "id": cid, "difficulty": "A1", "created_date": today, "due_date": today, "interval_days": 1, "repetitions": 0,
            "easiness_factor": 2.5, "consecutive_correct": 0, "consecutive_incorrect": 0, "last_quality": 0, "mastery_level": 0,
            "total_reviews": 0, "priority": "medium"})
    sr_file.write_text(json.dumps(sr, ensure_ascii=False, indent=2))

    # 1 · the select-all
    adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity", "--es", OPEN, "module:wish-qa")
    assert tap("Začni", 15), "wish-qa's intro"
    assert wait_for("0 izbranih", 10), "the select-all's Check button before anything is ticked (0 izbranih · 0 selected)"
    wish_snap("multi-none")
    assert tap("Dober dan", 4) and tap("Dobro jutro", 4), "two options ticked"
    assert wait_for("Preveri · Check (2)", 4), "the count on the Check button"
    wish_snap("multi-two")
    assert tap("Preveri · Check (2)", 3), "check"
    assert wait_for("Pravilno!", 6), "both polite greetings: right"
    assert tap("Naprej · Next", 4), "next"

    # 2 · a choice's near miss
    assert tap("Živjo!", 8), "the choice's near miss"
    assert wait_for("Skoraj!", 6), "a near miss picked: almost (Skoraj!), not wrong"
    wish_snap("almost")
    assert tap("Naprej · Next", 4), "next"

    # 3 · a picked scenario's near miss
    assert wait_for("Greet her back", 8), "the scenario"
    assert tap("Živjo!", 4), "the scenario's near miss"
    assert wait_for("Skoraj!", 6), "the scenario's near miss: almost"
    wish_snap("almost-scenario")
    assert tap("Naprej · Next", 4), "next"
    time.sleep(2)
    go_home()

    # 4 · a request with a grammar card: the app again, so its deck has the copy's new cards
    adb("shell", "am", "force-stop", PKG)
    adb("shell", "am", "start", "-n", f"{PKG}/.MainActivity")
    assert wait_for("Danes · Today", 40), "Home after the restart"
    time.sleep(3 * slow())  # the deck (read-db) loads after Home
    qa_hook("request:vocab_hvala,vocab_biti_dual")
    assert wait_for("Napake na tabli", 10), "the request's challenge"
    wish_snap("challenge-intro")
    assert tap("Začni", 6), "start the challenge"
    seen = False
    for _ in range(3):
        time.sleep(1.5)
        if find("midva sva · vidva sta · onadva sta"):
            # the grammar card: a flashcard (turned over, self-rated), no answer field
            assert not find("Napiši odgovor"), "the grammar card asked typed"
            wish_snap("challenge-grammar")
            assert tap("Pokaži · Show", 4), "the flashcard's Show"
            wish_snap("challenge-grammar-back")
            assert tap("Vedel sem", 4), "knew it"
            seen = True
        elif find("Napiši odgovor") or find("Preveri · Check"):
            answer_any()  # the word: typed (hvala)
        else:
            break
        if not tap("Naprej · Next", 4):
            break
    assert seen, "the grammar card in the request's challenge"
    time.sleep(2)
    wish_snap("challenge-result")
    go_home()


# a wild animal's word on the map of a Friuli village (the string tables' "wild.*" in Italian; GAME.md "The land")
WILD_IT = ("scoiattolo", "lepre", "uccello", "capriolo", "volpe", "riccio", "pipistrello", "cinghiale", "tasso", "gufo", "orso", "orma")
WILD_SL = ("veverica", "zajec", "ptica", "srna", "lisica", "jež", "netopir", "divji prašič", "jazbec", "sova", "medved", "sled")


def coast():
    """Teo's coast (2026-10-25, on the tablet: "He chose the beach location. I hear the beach, but can't move to it / can't
    see it. Also the location does not look like what we saw in the preview. It looks like my location."; "If I tap the
    animals, it shows me the Slovene words, not Italian."; "the aims are in English, not German"; GAME.md "The land",
    VILLAGERS.md "Talking to a villager"). On a synthetic learner of the Friuli culture without a village (LANI_DEV_DATA,
    the dev bridge's LANI_CULTURE=friuli and LANI_LANDSCAPE=coast, the phone's labels in sl · en: LANI_QA_PAIR=sl-en),
    founded at LANI_QA_FOUND_SEED (551323397: Teo's land) where setup's founding shot its preview. The village after
    founding: the sea and the beach on its left from the town view's first look; dragged to the beach (the canvas's left
    edge, where the camera stops); closer at the sea's horizon by night, at dusk and by day (the far sea joining the land's,
    no strip of the hills between: horizon-night, horizon-dusk, horizon-day); on a tablet held upright (the emulator's display at 1600 × 2560 px for a moment: the
    town's narrowest canvas, 320 nominal px wide). A wild animal on the map (QA's hook "hour:<h>" until one is out) tapped:
    its card with its Italian word. A villager's free talk (the register, their page, the greeting, then "Pogovor s
    tutorjem") in Teo's pair, Italian from German (QA's hook "pair:it-de"): its goals in Italian and German, not the
    node's English. The same land as a village and as a town (QA's hook "hearths:vas", "hearths:mesto"). Each also as
    coast-<name>.png in $LANI_QA_COAST_SHOTS. The dev village's copy grows: the run's last step."""
    notes = []

    def snap(name: str):
        shot(f"coast-{name}")
        if d := os.environ.get("LANI_QA_COAST_SHOTS"):
            Path(d).mkdir(parents=True, exist_ok=True)
            shutil.copy(shots[-1], Path(d) / f"coast-{name}.png")

    go_home()
    found_village()
    go_home()
    land = (api("/game").get("state") or {}).get("land") or {}
    culture = api("/culture").get("id")
    if land.get("kind") != "coast":
        return (f"the dev village stands on {land or 'no land'} ({culture}): a learner without a village (LANI_DEV_DATA), "
                "LANI_CULTURE=friuli, LANI_LANDSCAPE=coast")
    notes.append(f"{culture}, land {land.get('kind')}:{land.get('seed')}")
    try:
        qa_hook("hour:11")
        village()
        plain_village()
        time.sleep(2 * slow())
        snap("village")
        # dragged right: the land to the left comes into view, as far as the canvas goes (the sea's edge)
        for _ in range(3):
            adb("shell", "input", "swipe", "200", "1300", "1000", "1300", "400")
            time.sleep(1)
        time.sleep(1.5 * slow())
        snap("beach")
        plain_village()
        # the sea at the horizon, closer (2026-10-26, Jan on a visit at night: "this strip looks weird - kind of a cut-off
        # moving sea behind the scene?"): the far sea comes down to the land's, one water, no strip of the hills between
        # them, by night, at dusk and by day (GAME.md "The land"; the camera at the canvas's left edge, the horizon brought
        # down into the screen's middle)
        for name, h in (("night", 22), ("dusk", 19.6), ("day", 11)):
            qa_hook(f"hour:{h}")
            plain_village()
            qa_hook("zoom")
            time.sleep(1.5)
            for _ in range(3):
                adb("shell", "input", "swipe", "200", "1300", "1000", "1300", "400")
                time.sleep(1)
            adb("shell", "input", "swipe", "540", "700", "540", "1500", "400")
            time.sleep(2 * slow())
            snap(f"horizon-{name}")
        qa_hook("hour:11")
        plain_village()
        # a tablet held upright (1600 × 2560 px at 320 dpi): the town's narrowest canvas, 320 nominal px wide, as on Teo's
        # tablet; the emulator's own size again after
        try:
            adb("shell", "wm", "size", "1600x2560")
            adb("shell", "wm", "density", "320")
            time.sleep(6 * slow())
            plain_village()
            time.sleep(2 * slow())
            snap("tablet")
        finally:
            adb("shell", "wm", "size", "reset")
            adb("shell", "wm", "density", "reset")
            time.sleep(6 * slow())
        plain_village()

        # a wild animal: the windows of the day one after another until one is out on the map (the day's dice)
        word = None
        for h in (12, 7, 19.6, 23, 9, 16, 6.5, 21.5):
            qa_hook(f"hour:{h}")
            time.sleep(2 * slow())
            for _ in range(2):
                # the animal's TalkBack node: a box round it, its feet three quarters down (TownView's AnimalTargets)
                on = [(t, ((b[0] + b[2]) // 2, b[1] + (b[3] - b[1]) * 7 // 10)) for t, b in boxes()
                      if (t in WILD_IT or t in WILD_SL) and 0 < (b[0] + b[2]) // 2 < 1080 and 400 < (b[1] + b[3]) // 2 < 2000]
                if on:
                    break
                time.sleep(1.5)
            if on:
                word, at = on[0]
                break
        if word is None:
            notes.append("no animal out at 6:30, 7, 9, 12, 16, 19:36, 21:30 or 23 today")
        else:
            assert word in WILD_IT, f"the animal's TalkBack node in Slovene: {word}"
            snap("animal")
            # it moves a little (a hare hops, birds fly): a tap right on it, again where it is now if the first missed
            for _ in range(3):
                tap_at(at)
                if word_card(6):
                    break
                plain_village()
                again = [((b[0] + b[2]) // 2, b[1] + (b[3] - b[1]) * 7 // 10) for t, b in boxes() if t == word]
                if not again:
                    break
                at = again[0]
            assert word_card(2), f"the word card of {word}"
            time.sleep(1.5)
            snap("animal-word")
            labels = [t for t, _ in nodes()]
            assert any(word in t for t in labels), f"{word} on its card"
            assert not any(t in WILD_SL for t in labels), f"a Slovene animal's word on the card: {[t for t in labels if t in WILD_SL]}"
            notes.append(f"animal: {word}")
            adb("shell", "input", "keyevent", "KEYCODE_BACK")
            time.sleep(1.2)
        qa_hook("hour:11")
        plain_village()

        # a villager's free talk in Teo's pair: its goals in Italian and German. A new village's people are met first (their
        # introduction): the cast counts as met on the dev bridge's copy, which the app adopts
        try:
            snap_state = dev_bridge("/game")
            st = snap_state["state"]
            for v in api("/villagers"):
                bond = st.setdefault("bonds", {}).setdefault(v["id"], {})
                bond["met"] = bond.get("met") or time.strftime("%Y-%m-%d")
            dev_bridge("/game", {"rev": snap_state["rev"], "state": st}, method="PUT")
            go_home()  # the village again: the app syncs and adopts the node's copy
            village()
            open_scroll()
            scroll_card("Prebivalci · Villagers: ")
            assert tap("Vsi prebivalci", 5), "link to the register"
            assert wait_for("Prebivalci · Villagers", 8), "register"
            talk = next((c for t, c in nodes() if t.startswith("Pogovori se · Talk: ")), None)
            if talk is None:
                notes.append("talk: nobody in the register")
            else:
                tap_at(talk)
                assert wait_for("Več · More", 5), "villager card"
                assert tap("Več · More", 3), "more"
                assert wait_for("‹ Prebivalci · Villagers", 8), "villager page"
                qa_hook("pair:it-de")
                time.sleep(2 * slow())
                speak = f"💬 {l10n('it', 'common.talkVerb')} · "
                assert tap(speak, 8), f"{speak}… on the villager's page in it · de"
                free = f"{l10n('it', 'villagerScreens.talkFreely')} · {l10n('de', 'villagerScreens.talkFreely')}"
                assert tap(free, 15), f"{free}: the free talk after the greeting"
                # the talk starts at once: its goals under the 🎯 chip of its top bar
                chip = f"{l10n('it', 'talkScreen.goals')} · {l10n('de', 'talkScreen.goals')}: "
                assert tap(chip, 20), f"the talk's goals chip ({chip}0 / 4)"
                time.sleep(1.5)
                greet = l10n("de", "villagerLogic.greetThem")
                bye = l10n("de", "villagerLogic.sayGoodbye")
                labels = " ".join(t for t, _ in nodes())
                snap("talk-goals")
                assert greet in labels and bye in labels, f"the talk's goals in German ({greet}, {bye})"
                assert "Say goodbye" not in labels and "Ask how they are" not in labels, "the node's English goals"
                notes.append("talk: goals in it · de")
                # left before a line is said: nothing to debrief
                adb("shell", "input", "keyevent", "KEYCODE_BACK")
                time.sleep(1.5)
        except Exception as e:  # noqa: BLE001 — the talk is one look of several: the land's steps go on
            snap("talk-failed")
            notes.append(f"talk: {e}")
        finally:
            qa_hook("pair:sl-en")
            time.sleep(2 * slow())
            plain_village()

        # the same land later: a village and a town, built as the hearths' step builds them
        for age in ("vas", "mesto"):
            qa_hook(f"hearths:{age}")
            time.sleep(3 * slow())
            plain_village()
            time.sleep(2 * slow())
            snap(age)
            for _ in range(3):
                adb("shell", "input", "swipe", "200", "1300", "1000", "1300", "400")
                time.sleep(1)
            time.sleep(1.5 * slow())
            snap(f"{age}-beach")
            plain_village()
        land = (api("/game").get("state") or {}).get("land") or {}
        assert land.get("kind") == "coast", f"the land after growing: {land}"
    finally:
        qa_hook("hour:")
    for n in notes:
        print(f"    {n}")
    # what it couldn't look at is a skip; the rest is said above
    return "; ".join(n for n in notes if n.startswith(("no animal", "talk: ")) and "goals in it · de" not in n) or None


def sea_frames():
    """What a frame of the village costs on the coast, against the same village on dry land, by a lake and on the classic
    valley (2026-10-26, Jan: Teo's tablet lags in his coast village, less on a visit to Jan's classic one; GAME.md "The
    land", docs/plans/05-built/coast-horizon.md). On the dev village of a synthetic learner of the Friuli culture
    (LANI_DEV_DATA, LANI_CULTURE=friuli, LANI_LANDSCAPE=coast; founded here when it has none, at LANI_QA_FOUND_SEED), the
    emulator's display as Teo's tablet on its side (2560 × 1600 px at 320 dpi: the town's 320 × 200 canvas): its land and
    then each of the others (the dev bridge's copy's land changed, the app adopting it), at night (QA's hook "hour:22"),
    the village at rest, closer (QA's hook "zoom", twice: the details 2 and 3) and panned there; each with the ground's
    still picture kept and drawn whole every frame (QA's hook "render:full"). For each: the map's own render time (the
    debug build's log, tag TownScene) and the frames' (dumpsys gfxinfo: the 50th and 90th percentile, the janky share).
    Printed as a table, also as frames.tsv in $LANI_QA_COAST_SHOTS. The dev village keeps its own land after."""
    go_home()
    found_village()
    go_home()
    snap0 = dev_bridge("/game")
    own = (snap0.get("state") or {}).get("land") or {"kind": "classic"}
    seed = own.get("seed", 551323397)
    lands = [own] + [l for l in ({"kind": "valley", "seed": seed}, {"kind": "lake", "seed": seed}, {"kind": "classic"}) if l != own]
    rows = []

    def put_land(land):
        snap = dev_bridge("/game")
        st = snap["state"]
        st["land"] = land
        dev_bridge("/game", {"rev": snap["rev"], "state": st}, method="PUT")
        go_home()  # the village again: the app syncs and adopts the node's copy
        village()

    def gfx() -> dict:
        out = adb("shell", "dumpsys", "gfxinfo", PKG, check=False)
        got = {}
        for key, pat in (("frames", r"Total frames rendered: (\d+)"), ("janky", r"Janky frames: \d+ \(([\d.]+)%\)"),
                         ("p50", r"50th percentile: (\d+)ms"), ("p90", r"90th percentile: (\d+)ms")):
            m = re.search(pat, out)
            got[key] = m.group(1) if m else "?"
        return got

    def renders(key: str) -> str:
        """The map's render times logged since the log was cleared, of [key]'s land: their middle (ms) and the detail."""
        times = []
        for line in adb("logcat", "-d", "-s", "TownScene:D", check=False).splitlines():
            m = re.search(r"TownScene: (\S+) at detail (\d): ([\d.]+) ms per frame", line)
            if m and m.group(1) == key:
                times.append((float(m.group(3)), m.group(2)))
        if not times:
            return "?\t?"
        times.sort()
        return f"{times[len(times) // 2][0]:.1f}\t{times[len(times) // 2][1]}"

    def look(land, mode: str, name: str, pan=False):
        key = land["kind"] if land["kind"] == "classic" else f"{land['kind']}:{land.get('seed', 0)}"
        adb("logcat", "-c")
        adb("shell", "dumpsys", "gfxinfo", PKG, "reset", check=False)
        end = time.time() + 8
        while time.time() < end:
            if pan:  # back and forth over the sea's side and the village
                adb("shell", "input", "swipe", "700", "800", "1700", "850", "700")
                adb("shell", "input", "swipe", "1700", "850", "700", "800", "700")
            else:
                time.sleep(0.5)
        g = gfx()
        row = f"{key}\t{mode}\t{name}\t{renders(key)}\t{g['frames']}\t{g['p50']}\t{g['p90']}\t{g['janky']}"
        rows.append(row)
        print(f"    {row}")

    try:
        adb("shell", "wm", "size", "2560x1600")
        adb("shell", "wm", "density", "320")
        time.sleep(6 * slow())
        qa_hook("hour:22")
        for land in lands:
            if land != lands[0] or rows:
                put_land(land)
            for mode in ("kept", "whole"):
                qa_hook("render:" if mode == "kept" else "render:full")
                plain_village()
                time.sleep(2 * slow())
                look(land, mode, "rest")
                qa_hook("zoom")
                time.sleep(2 * slow())
                look(land, mode, "closer")
                qa_hook("zoom")
                time.sleep(2 * slow())
                look(land, mode, "closest")
                look(land, mode, "panned", pan=True)
                if land == lands[0] and mode == "kept":
                    shot("sea-frames-closest")
    finally:
        qa_hook("render:")
        qa_hook("hour:")
        if lands[1:] and rows:
            put_land(own)
        adb("shell", "wm", "size", "reset")
        adb("shell", "wm", "density", "reset")
        time.sleep(6 * slow())
    head = "land\tground\tlook\trender ms\tdetail\tframes\tp50 ms\tp90 ms\tjanky %"
    print(f"    {head}")
    if d := os.environ.get("LANI_QA_COAST_SHOTS"):
        Path(d).mkdir(parents=True, exist_ok=True)
        (Path(d) / "frames.tsv").write_text("\n".join([head] + rows) + "\n")
    return None


