#!/usr/bin/env bash
# Build a release APK and publish it to the Lani app (self-update).
# The bridge notices the new latest.json and sends the app an app_update event.
# Usage: companion/bin/release-app [--docker] ["short release notes"]
#        companion/bin/release-app --github [<tag>] ["short release notes"]
#
#   --docker   build in a container (companion/bin/lani-build-app): no JDK or Android SDK needed. A machine without a
#              JDK or an SDK (JAVA_HOME, mise, java; local.properties, ANDROID_HOME) builds there anyway.
#   --github   build nothing: take the APK of a GitHub release (the latest, or <tag> such as v0.2.40) of the
#              repository (LANI_GITHUB_REPO, else the origin remote, else fentas/lani), check its SHA-256 and publish
#              it. The notes are the release's name unless given. The phone takes it only if its app was installed
#              with the same key (an APK from the GitHub releases, signed with the project's release key).
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"

docker=0 github=0 tag=""
case "${1:-}" in
  --docker) docker=1; shift ;;
  --github) github=1; shift; if [[ "${1:-}" == v[0-9]* ]]; then tag="$1"; shift; fi ;;
esac
notes="${1:-}"

data="$(python3 "$root/.claude/hooks/ensure_data_dir.py")"
rel="$data/app/release"
mkdir -p "$rel"

publish() { # versionCode versionName notes: latest.json, which the bridge watches
  python3 - "$rel" "$1" "$2" "$3" << 'PY'
import json, os, sys
rel, code, name, notes = sys.argv[1:]
tmp = os.path.join(rel, "latest.json.tmp")
with open(tmp, "w") as f:
    json.dump({"versionCode": int(code), "versionName": name, "file": f"lani-{code}.apk", "notes": notes}, f)
os.replace(tmp, os.path.join(rel, "latest.json"))
PY
  # Keep the last 5 builds (the app's from before the rename were fluent-<code>.apk).
  shopt -s nullglob
  local apks=("$rel"/lani-*.apk "$rel"/fluent-*.apk)
  if ((${#apks[@]} > 5)); then ls -1t -- "${apks[@]}" | tail -n +6 | xargs -r -d '\n' rm --; fi
  echo "released $2 ($1)"
}

if ((github)); then
  repo="${LANI_GITHUB_REPO:-}"
  if [ -z "$repo" ]; then
    url="$(git -C "$root" remote get-url origin 2> /dev/null || true)"
    repo="$(sed -En 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p' <<< "${url%.git}")"
    repo="${repo:-fentas/lani}"
  fi
  # The release workflow (.github/workflows/android-release.yml) attaches lani-<versionName>.apk, its .sha256 and
  # lani-<versionName>.json (versionCode, versionName, file, sha256). Public: no token needed. Prints
  # "<versionCode> <versionName> <release name>", or nothing when the bridge has that version or a later one.
  got="$(python3 - "$repo" "$tag" "$rel" "${LANI_GITHUB_API:-https://api.github.com}" << 'PY'
import hashlib, json, os, sys, urllib.error, urllib.request
repo, tag, rel, api = sys.argv[1:]
def get(url):
    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "lani-release-app"})
    return urllib.request.urlopen(req, timeout=60)
try:
    release = json.load(get(f"{api}/repos/{repo}/releases/" + (f"tags/{tag}" if tag else "latest")))
except urllib.error.HTTPError as e:
    sys.exit(f"no release {tag or '(latest)'} in {repo}: {e}")
where = f"{release.get('tag_name')} of {repo}"
assets = {a["name"]: a["browser_download_url"] for a in release.get("assets", [])}
meta = [n for n in assets if n.startswith("lani-") and n.endswith(".json")]
if not meta:
    sys.exit(f"{where} has no lani-<version>.json (an APK from the release workflow)")
info = json.load(get(assets[meta[0]]))
code, name, file, sha = int(info["versionCode"]), info["versionName"], info["file"], info["sha256"].lower()
if file not in assets:
    sys.exit(f"{where} has no {file}")
try:
    with open(os.path.join(rel, "latest.json")) as f:
        current = json.load(f)
except (OSError, ValueError):
    current = {}
if int(current.get("versionCode", 0)) >= code:
    print(f"the bridge has {current.get('versionName')} ({current.get('versionCode')}) already, {where} is {name} ({code})", file=sys.stderr)
    sys.exit(0)
side = assets.get(file + ".sha256")
if side and get(side).read().decode().split()[0].lower() != sha:
    sys.exit(f"{file}.sha256 and {meta[0]} disagree")
tmp = os.path.join(rel, f"lani-{code}.apk.tmp")
digest = hashlib.sha256()
with get(assets[file]) as r, open(tmp, "wb") as f:
    while chunk := r.read(1 << 20):
        digest.update(chunk)
        f.write(chunk)
if digest.hexdigest() != sha:
    os.remove(tmp)
    sys.exit(f"{file}: SHA-256 {digest.hexdigest()}, the release says {sha}")
os.replace(tmp, os.path.join(rel, f"lani-{code}.apk"))
print(code, name, (release.get("name") or release.get("tag_name") or "").replace("\n", " "))
PY
  )"
  [ -n "$got" ] || exit 0
  read -r code name title <<< "$got"
  publish "$code" "$name" "${notes:-$title}"
  exit 0
fi

# The version follows the commit count (versionCode 1000 + count, versionName 0.2.<count>: app/build.gradle.kts),
# so an uncommitted build would reuse the last code.
if [[ -n "$(git -C "$root" status --porcelain -- companion/android)" ]]; then
  echo "companion/android has uncommitted changes; commit them first." >&2
  exit 1
fi

cd "$root/companion/android"
if ((!docker)); then
  export JAVA_HOME="${JAVA_HOME:-$(mise where java 2> /dev/null || true)}"
  [ -n "$JAVA_HOME" ] || unset JAVA_HOME
  if { [ -z "${JAVA_HOME:-}" ] && ! command -v java > /dev/null; } \
    || { [ ! -f local.properties ] && [ -z "${ANDROID_HOME:-}${ANDROID_SDK_ROOT:-}" ]; }; then
    echo "no JDK or Android SDK here: building in a container (companion/bin/lani-build-app)" >&2
    docker=1
  fi
fi
if ((docker)); then
  "$root/companion/bin/lani-build-app" --release > /dev/null
else
  ./gradlew -q :app:assembleRelease
fi

# what the build made of it (AGP's output-metadata.json), so this script and the app can't disagree
read -r code name < <(python3 -c 'import json,sys; e=json.load(open(sys.argv[1]))["elements"][0]; print(e["versionCode"], e["versionName"])' app/build/outputs/apk/release/output-metadata.json)
cp app/build/outputs/apk/release/app-release.apk "$rel/lani-$code.apk"
publish "$code" "$name" "$notes"
