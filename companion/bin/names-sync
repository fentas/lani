#!/usr/bin/env bun
// The name check's lists for the bridge (docs/plans/05-built/names-guard.md), rebuilt from a checkout of the voice service (glas):
// its library/names/ as it was built, nothing fetched. Writes
//   companion/bridge/name-lists/blocklist.json    every list's entries as the source wrote them (glas's blocklist.json.gz, unzipped)
//   companion/bridge/name-lists/given-listed.txt  the given names a list's word is in: the only ones the bridge's verdict needs
//   companion/bridge/name-lists/keep.txt          the keep list, as glas has it
//   companion/bridge/name-lists/sources.json      the sources' pins, and the glas commit they came from
//   companion/bridge/name-lists/NOTICE            the sources' licences
//   companion/bridge/test/fixtures/name-check-verdicts.json   glas's own verdicts (its NameCheck.classify) over a probe set, which
//                                                            test/name-check.ts holds the bridge's check to
// and reads nothing of the checkout but those and src/name-check.ts (whose dependencies it needs: `bun install` there once).
//
// Usage: companion/bin/names-sync <glas checkout> [--check]
//   --check   write nothing: exit 1 when the bridge's copy is not what the checkout gives (a list or a rule moved on in glas)
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { join, resolve } from 'node:path'
import { parseArgs } from 'node:util'
import { NameLists, readKeep, type BlocklistData } from '../bridge/src/name-check'

const { values, positionals } = parseArgs({ allowPositionals: true, options: { check: { type: 'boolean' } } })
const glas = positionals[0] ? resolve(positionals[0]) : ''
const lib = join(glas, 'library/names')
if (!glas || !existsSync(join(glas, 'src/name-check.ts')) || !existsSync(join(lib, 'blocklist.json.gz'))) {
  console.error('usage: companion/bin/names-sync <glas checkout> [--check]   (a checkout with src/name-check.ts and library/names/)')
  process.exit(2)
}
const bridge = resolve(import.meta.dir, '../bridge')
const OUT = join(bridge, 'name-lists')
const FIXTURE = join(bridge, 'test/fixtures/name-check-verdicts.json')

const gunzip = (p: string) => new TextDecoder().decode(Bun.gunzipSync(readFileSync(p)))
const git = (...args: string[]) => {
  const r = Bun.spawnSync(['git', '-C', glas, ...args])
  return r.exitCode === 0 ? r.stdout.toString().trim() : null
}

const data = JSON.parse(gunzip(join(lib, 'blocklist.json.gz'))) as BlocklistData
if (data.v !== 1 || !Array.isArray(data.lists)) throw new Error(`${join(lib, 'blocklist.json.gz')} is not a blocklist`)
const given = gunzip(join(lib, 'given-names.txt.gz')).split('\n').filter(Boolean)
const keepText = readFileSync(join(lib, 'keep.txt'), 'utf8')
const sources = JSON.parse(readFileSync(join(lib, 'sources.json'), 'utf8')) as Record<string, unknown>
const notice = readFileSync(join(lib, 'NOTICE'), 'utf8')

// the given names whose verdict being a given name can change: one of their lookups is a list's entry. For any other the lists
// find nothing, given name or not, so the bridge needs only these (a name of them folded, as the check compares them)
const bare = new NameLists(data, [], readKeep(keepText))
const touched = [...new Set(given.filter(g => bare.touches(g)))].sort()

// --- the files ------------------------------------------------------------------------------------------------------------

/** blocklist.json: a list a block, an entry a line, so a change of a list reads as its lines. */
const blocklist = `{\n  "v": 1,\n  "lists": [\n${data.lists
  .map(l => `    {\n      "id": ${JSON.stringify(l.id)},\n      "source": ${JSON.stringify(l.source)},\n      "lang": ${JSON.stringify(l.lang)},\n      "entries": [\n${l.entries.map(e => `        ${JSON.stringify(e)}`).join(',\n')}\n      ]\n    }`)
  .join(',\n')}\n  ]\n}\n`

const commit = git('rev-parse', 'HEAD')
const date = git('log', '-1', '--format=%cs')
const givenListed = `# The given names a word of the blocklists is in (by a word, a part of a word, or the whole): ${touched.length} of glas's
# ${given.length.toLocaleString('en-US')} (Wikidata's male, female and unisex given names, CC0 1.0). For any other given name the lists find
# nothing, given name or not, so the bridge's check needs only these to give glas's verdict: a given name is looked up whole and by
# its words, and a list's word only with the marks off doesn't count against it (Peter, Mosè, Beom-sik).
# Generated by companion/bin/names-sync; don't edit.
${touched.join('\n')}
`
const keep = `# Copied from glas's library/names/keep.txt by companion/bin/names-sync; don't edit here.\n${keepText}`
const sourcesOut = `${JSON.stringify({ glas: { commit, date, given_listed: touched.length, given_names: given.length }, ...sources }, null, 2)}\n`
const noticeOut = `The name check's lists (companion/bridge/name-lists/) are copied from the voice service's (glas: library/names/) by
companion/bin/names-sync. Its notice, as glas has it:

${notice}`

// --- glas's own verdicts over a probe set --------------------------------------------------------------------------------

/** Names the rules were written for: glas's README and tests, the shape rules' edges, NFKC and the folding. */
const CURATED = [
  'Jan', 'Teo', 'Ana', 'Ana Marija', 'ana marija', 'Matej', 'Mojca', 'Ｍojca', 'Žiga', 'Gergő', 'Niccolò', 'Bjørn', 'Søren', 'Zoë', 'Đorđe', 'Łukasz',
  'Şükrü', 'Ülkü', 'Siobhán', 'Joaquín', 'Jiří', 'Zdeněk', "O'Brien", 'D’Arcy', 'Jean-Luc', 'Maximilian Hohenberg', 'maximilian  HOHENBERG',
  'Adəm', 'Adɔŋɔ', 'Abɛrempika', 'Kalani', 'Ngozi', 'Aroha', 'Hiroshi', 'Aiko', 'Fatima', 'Ahmed', 'Tinkara', 'Qwertina', 'Zzqbor', 'Zzqfoo',
  'Peter', 'Péter', 'Pál Péter', 'Mosè', 'Möse', 'Moese', 'Beom-sik', 'Beom-dong', 'Bong-sik', 'Ami', 'Anita', 'Regina', 'Mona', 'Pippa',
  'Guido', 'Guido Rossi', 'Gian Guido', 'Jerry', 'Jerry Lee', 'Mick', 'Marica', 'Marica Novak', 'Marica Kurba', 'Franc', 'Thông', 'Thong',
  'Thong Novak', 'Osama', 'Usāma', 'Isis', 'Ísis', 'Isis Daesh', 'Adolf', 'Aryan', 'Jihad', 'Cassandra', 'Dickson', 'Cumming', 'Semen',
  'Dick', 'Dĭck', 'Dick Long', 'Willy', 'Willie', 'Wíllý', 'Lolita', 'Bimbo', 'Bastard', 'Bastärd', 'Hooker', 'Tit', 'Monkey', 'Porch Monkey',
  'Kurba', 'kurba', 'ｋurba', 'ᴋurba', 'Kûrba', 'kurbɑ', 'Kurbica', 'Kurbin Sin', 'kurbe', 'Kurba-Svinja', 'Kurbasvinja', 'Zuzq Kurba',
  'Jan Kurba', 'Niggerboy', 'Shitpig', 'Fuck-Face', 'Mother Fucker', 'motherfucker', 'ﬁck', 'Fick', 'Scheiße', 'scheisse', 'SCHEISSE',
  'Schlampe', 'Missgeburt', 'Hurensohn', 'Arschloch', 'Wichser', 'Fotze', 'Picka', 'pička', 'pičko', 'Jebac', 'jebač', 'Jebo Te', 'Jebi',
  'Jebem', 'Jebemti', 'Kurac', 'Kurca', 'Pizda', 'Peder', 'Cefur', 'čefur', 'Prasec', 'Svinja', 'Kreten', 'Kretena', 'Idiot', 'Idiota',
  'Cazzo', 'Stronzo', 'Vaffanculo', 'Puttana', 'Troia', 'Frocio', 'Coglione', 'Merda', 'Dio Cane', 'Cane', 'Kike', 'Kíke', 'Paki',
  'Camel Jockey', 'Retard', 'Spast', 'Slut', 'Whore', 'Jizz', 'Hitler', 'Hitlerjugend', 'Osama Hitler', 'Heil Hitler', 'Hëil', 'Nazi',
  'Sieg Heil', 'White Power', 'Zadomspremni', 'Kill Yourself', 'kill yourself', 'Die Now', 'Die-Well', 'Ubij Se', 'Umri', 'Crkni', 'Stirb',
  'Muori', 'Majku Ti', 'Leck Mich', 'Screw You', 'Shut Up', 'Ugly', 'Stupid', 'Fat',
  '', 'x', 'Jan!', 'R2D2', 'Юлия', 'Prrrt', 'Brrr', 'Annnna', 'Admin', 'Test', 'abcdefghijklmnopq', 'Ana Marija Novak', 'Kurba Kurba Kurba',
  'Read this now for me', 'Dick͏', 'Di̶ck', 'ʟuka', 'jɑn',
]

const cap = (s: string) => s.replace(/(^|[ '-])(\p{L})/gu, (_, a: string, b: string) => a + b.toLocaleUpperCase())
const MARKS: Record<string, string> = { a: 'á', e: 'é', i: 'í', o: 'ö', u: 'ü', c: 'č', s: 'š', z: 'ž' }
/** [s] with its first letter that has one given a mark: "kurba" → "kürba". */
const marked = (s: string) => s.replace(/[aeioucsz]/, c => MARKS[c])
/** Up to [n] of [xs], spread evenly. */
function spread<T>(xs: T[], n: number): T[] {
  return xs.length <= n ? xs : Array.from({ length: n }, (_, i) => xs[Math.floor((i * xs.length) / n)])
}

const probes = new Set<string>(CURATED)
// each list: some of its entries, and the ways round them a learner might try (a capital, a mark, a second word, a hyphen,
// run into another word)
for (const l of data.lists) {
  for (const e of spread(l.entries.filter(e => e.trim()), 10)) {
    for (const p of [e, cap(e), marked(e), `${cap(e)} Novak`, `Ana ${cap(e)}`, `${cap(e)}-Novak`, `${e.replace(/ /g, '')}boy`]) probes.add(p)
  }
}
// the given names the lists touch, all of them, and some of the others
for (const g of touched) probes.add(g)
for (const g of spread(given, 1500)) probes.add(g)
// the keep list, whole, as a word of a name, beside a list's word
for (const k of readKeep(keepText)) for (const p of [k, cap(k), `${cap(k)} Novak`, `${cap(k)} Kurba`]) probes.add(p)

const check = await (async () => {
  const m = (await import(join(glas, 'src/name-check.ts'))) as {
    nameLists: () => Promise<unknown>
    NameCheck: new (o: { db: unknown; lists: unknown }) => { classify(raw: string): { verdict: string; name?: string; list?: string; words?: number; hides?: boolean } }
  }
  // classify reads the shape and the lists only: no database
  return new m.NameCheck({ db: null, lists: await m.nameLists() })
})()

type Row = [string, 'invalid'] | [string, 'blocked', string] | [string, 'known'] | [string, 'unknown', number, boolean]
const rows: Row[] = [...probes].map(p => {
  const c = check.classify(p)
  if (c.verdict === 'invalid') return [p, 'invalid']
  if (c.verdict === 'blocked') return [p, 'blocked', c.list!]
  if (c.verdict === 'known') return [p, 'known']
  if (c.verdict === 'unknown') return [p, 'unknown', c.words!, !!c.hides]
  throw new Error(`glas's classify gave "${c.verdict}" for a probe: names-sync knows invalid, blocked, known and unknown`)
})
const count = (v: string) => rows.filter(r => r[1] === v).length
const fixture = `{
  "_note": "glas's verdicts (its NameCheck.classify, the lists it was built with) over a probe set, made by companion/bin/names-sync: the bridge's check (src/name-check.ts) must give the same for each (test/name-check.ts). invalid and blocked (with the list) are the bridge's to refuse too; known and unknown are clear on the bridge, unknown with its words and whether a list's word hides inside it. Don't edit: run names-sync against a glas checkout.",
  "glas": ${JSON.stringify({ commit, date })},
  "counts": ${JSON.stringify({ probes: rows.length, invalid: count('invalid'), blocked: count('blocked'), known: count('known'), unknown: count('unknown') })},
  "names": [
${rows.map(r => `    ${JSON.stringify(r)}`).join(',\n')}
  ]
}
`

// --- written, or compared -------------------------------------------------------------------------------------------------

const files: [string, string][] = [
  [join(OUT, 'blocklist.json'), blocklist],
  [join(OUT, 'given-listed.txt'), givenListed],
  [join(OUT, 'keep.txt'), keep],
  [join(OUT, 'sources.json'), sourcesOut],
  [join(OUT, 'NOTICE'), noticeOut],
  [FIXTURE, fixture],
]
// the commit and the date say where a copy came from, not what it holds: a checkout at another commit with the same lists is no change
const content = (s: string) => s.replace(/"commit": ?("[0-9a-f]*"|null)/g, '"commit"').replace(/"date": ?("[0-9-]*"|null)/g, '"date"')
const stale = files.filter(([p, s]) => !existsSync(p) || content(readFileSync(p, 'utf8')) !== content(s))
const entries = data.lists.reduce((n, l) => n + l.entries.length, 0)
const summary = `${data.lists.length} lists (${entries.toLocaleString('en-US')} entries), ${touched.length} of ${given.length.toLocaleString('en-US')} given names, ${readKeep(keepText).length} kept; ${rows.length.toLocaleString('en-US')} probes: ${count('invalid')} invalid, ${count('blocked')} blocked, ${count('known')} known, ${count('unknown')} unknown`
// NOTICE.md names the pinned sources by their commits: a pin moved on is a row to change by hand
const noticeMd = readFileSync(resolve(bridge, '../../NOTICE.md'), 'utf8')
const pins = (['ldnoobw', 'profane-words'] as const).map(k => (sources[k] as { commit?: string } | undefined)?.commit?.slice(0, 7)).filter((c): c is string => !!c)
const unnamed = pins.filter(c => !noticeMd.includes(`\`${c}\``))
if (unnamed.length) console.error(`NOTICE.md doesn't name the pinned commit${unnamed.length > 1 ? 's' : ''} ${unnamed.join(', ')}: change its rows for the name check's lists`)
if (values.check) {
  if (stale.length || unnamed.length) {
    if (stale.length) console.error(`names-sync --check: the bridge's copy is not glas's at ${commit?.slice(0, 7) ?? 'its checkout'}: ${stale.map(([p]) => p.slice(bridge.length + 1)).join(', ')}. Run companion/bin/names-sync ${positionals[0]}`)
    process.exit(1)
  }
  console.log(`The bridge's copy is glas's at ${commit?.slice(0, 7) ?? 'its checkout'}: ${summary}.`)
  process.exit(0)
}
mkdirSync(OUT, { recursive: true })
for (const [p, s] of files) writeFileSync(p, s)
console.log(`${stale.length ? `Written: ${stale.map(([p]) => p.slice(bridge.length + 1)).join(', ')}` : 'Nothing changed'} (glas ${commit?.slice(0, 7) ?? 'checkout'}): ${summary}.`)
console.log('Then: bun test/name-check.ts in companion/bridge.')
