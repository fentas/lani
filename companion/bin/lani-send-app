#!/usr/bin/env bash
# Send the app to a phone over Tailscale (Taildrop), no cable needed: the newest APK of the release directory (where
# release-app and release-app --github put it), or the one given with --file.
#   lani-send-app [--file <apk>] [<device>]
#   <device>  the phone's name in Tailscale (as `tailscale file cp --targets` lists it). Without it: the only device
#             Taildrop can send to, else the list to choose from.
# On the phone: open the APK from Files → Downloads (or from Tailscale's notification) and allow installing from that
# app once. Then pair it (companion/bin/lani-pair); after that the app updates itself from the bridge.
# See docs/setup.md, "Get the app".
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
# LANI_* (or their FLUENT_* names) and lani.env's settings: bin/lani-env.sh
. "$root/companion/bin/lani-env.sh"

file="" device=""
while [ $# -gt 0 ]; do
  case "$1" in
    --file) file="${2:?--file needs an APK}"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "lani-send-app: unknown option $1 (--help)" >&2; exit 2 ;;
    *) device="$1"; shift ;;
  esac
done

if ! command -v tailscale >/dev/null 2>&1; then
  echo "lani-send-app needs Tailscale on this machine and the phone (https://tailscale.com/download)." >&2
  echo "Or install over USB: adb install -r <apk>" >&2
  exit 1
fi

if [ -z "$file" ]; then
  # the APKs: $LANI_RELEASE_DIR (lani.env; ~/.local/share/lani/releases after lani-setup), else <data>/app/release
  if [ -n "${LANI_RELEASE_DIR:-}" ]; then rel="$LANI_RELEASE_DIR"; else rel="$(python3 "$root/.claude/hooks/ensure_data_dir.py")/app/release"; fi
  file="$(ls -t "$rel"/lani-*.apk 2>/dev/null | head -n 1 || true)"
  if [ -z "$file" ]; then
    echo "lani-send-app: no APK in $rel yet. Get one first:" >&2
    echo "  companion/bin/release-app --github     the latest release from GitHub" >&2
    echo "  companion/bin/release-app \"notes\"      a build of this checkout" >&2
    exit 1
  fi
fi
[ -f "$file" ] || { echo "lani-send-app: no such file: $file" >&2; exit 1; }

# the devices Taildrop can send to: "<address><TAB><name>[<TAB>…]", this tailnet's own devices only
mapfile -t targets < <(tailscale file cp --targets 2>/dev/null | awk -F'\t' 'NF >= 2 { print $2 }')
if [ -z "$device" ]; then
  if [ "${#targets[@]}" -eq 1 ]; then
    device="${targets[0]}"
  else
    echo "lani-send-app: which device? companion/bin/lani-send-app <device>" >&2
    if [ "${#targets[@]}" -eq 0 ]; then
      echo "  Taildrop sees none: is the phone in this tailnet, online, with the Tailscale app running?" >&2
    else
      printf '  %s\n' "${targets[@]}" >&2
    fi
    exit 2
  fi
fi

# the phone keeps the file's name: lani-<versionName>.apk when latest.json names this build, else as it is
name="$(basename "$file")"
code="${name#lani-}"; code="${code%.apk}"
version="$(python3 - "$(dirname "$file")/latest.json" "$code" <<'PY' 2>/dev/null || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    if str(d.get("versionCode")) == sys.argv[2]:
        print(d.get("versionName", ""))
except (OSError, ValueError):
    pass
PY
)"
send="$file"
if [ -n "$version" ]; then
  tmp="$(mktemp -d)"
  trap 'rm -f "$tmp/lani-$version.apk"; rmdir "$tmp"' EXIT
  cp "$file" "$tmp/lani-$version.apk"
  send="$tmp/lani-$version.apk"
fi

tailscale file cp "$send" "$device:"
echo "Sent $(basename "$send") to $device."
echo "On the phone: open it from Files → Downloads (or Tailscale's notification) and allow installing from that app"
echo "once. Then pair it: companion/bin/lani-pair. After that the app updates itself from your bridge."
