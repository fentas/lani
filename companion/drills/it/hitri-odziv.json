    {
      "id": "che-ore",
      "level": "A1",
      "rule": "ore-giorni",
      "title": {"it": "Che ore sono?", "en": "What time is it?", "de": "Wie spät ist es?"},
      "items": [
        {"it": "È l'una.", "en": "It's one o'clock.", "de": "Es ist ein Uhr."},
        {"it": "Sono le due.", "en": "It's two o'clock.", "de": "Es ist zwei Uhr."},
        {"it": "Sono le tre.", "en": "It's three o'clock.", "de": "Es ist drei Uhr."},
        {"it": "Sono le quattro.", "en": "It's four o'clock.", "de": "Es ist vier Uhr."},
        {"it": "Sono le cinque.", "en": "It's five o'clock.", "de": "Es ist fünf Uhr."},
        {"it": "Sono le sei.", "en": "It's six o'clock.", "de": "Es ist sechs Uhr."},
        {"it": "Sono le sette.", "en": "It's seven o'clock.", "de": "Es ist sieben Uhr."},
        {"it": "Sono le otto.", "en": "It's eight o'clock.", "de": "Es ist acht Uhr."},
        {"it": "Sono le nove.", "en": "It's nine o'clock.", "de": "Es ist neun Uhr."},
        {"it": "Sono le dieci.", "en": "It's ten o'clock.", "de": "Es ist zehn Uhr."},
        {"it": "Sono le undici.", "en": "It's eleven o'clock.", "de": "Es ist elf Uhr."},
        {"it": "Sono le dodici.", "en": "It's twelve o'clock.", "de": "Es ist zwölf Uhr."},
        {"it": "È mezzogiorno.", "en": "It's midday.", "de": "Es ist Mittag."},
        {"it": "È mezzanotte.", "en": "It's midnight.", "de": "Es ist Mitternacht."},
        {"it": "È l'una e mezza.", "en": "It's half past one.", "de": "Es ist halb zwei."},
        {"it": "Sono le tre e mezza.", "en": "It's half past three.", "de": "Es ist halb vier."},
        {"it": "Sono le sette e mezza.", "en": "It's half past seven.", "de": "Es ist halb acht."},
        {"it": "Sono le undici e mezza.", "en": "It's half past eleven.", "de": "Es ist halb zwölf."},
        {"it": "Sono le due e un quarto.", "en": "It's a quarter past two.", "de": "Es ist Viertel nach zwei."},
        {"it": "Sono le otto e un quarto.", "en": "It's a quarter past eight.", "de": "Es ist Viertel nach acht."},
        {"it": "Sono le dieci e un quarto.", "en": "It's a quarter past ten.", "de": "Es ist Viertel nach zehn."},
        {"it": "È l'una meno un quarto.", "en": "It's a quarter to one.", "de": "Es ist Viertel vor eins."},
        {"it": "Sono le cinque meno un quarto.", "en": "It's a quarter to five.", "de": "Es ist Viertel vor fünf."},
        {"it": "Sono le nove meno un quarto.", "en": "It's a quarter to nine.", "de": "Es ist Viertel vor neun."}
      ]
    },
