    {
      "id": "futuro",
      "level": "A2",
      "rule": "futuro",
      "title": {"it": "Al futuro", "en": "The future", "de": "Die Zukunft"},
      "items": [
        {"it": "Andrò.", "en": "I'll go.", "de": "Ich werde gehen."},
        {"it": "Verrò.", "en": "I'll come.", "de": "Ich werde kommen."},
        {"it": "Sarò.", "en": "I'll be.", "de": "Ich werde sein."},
        {"it": "Avrò.", "en": "I'll have.", "de": "Ich werde haben."},
        {"it": "Lo farò.", "en": "I'll do it.", "de": "Ich werde es machen."},
        {"it": "Vedrò.", "en": "I'll see.", "de": "Ich werde sehen."},
        {"it": "Mangeremo.", "en": "We'll eat.", "de": "Wir werden essen."},
        {"it": "Giocherai.", "en": "You'll play.", "de": "Du wirst spielen."},
        {"it": "Dormirà.", "en": "She'll sleep.", "de": "Sie wird schlafen."},
        {"it": "Resteremo.", "en": "We'll stay.", "de": "Wir werden bleiben."},
        {"it": "Arriveranno.", "en": "They'll arrive.", "de": "Sie werden ankommen."},
        {"it": "Potrò.", "en": "I'll be able to.", "de": "Ich werde können."},
        {"it": "Dovrò.", "en": "I'll have to.", "de": "Ich werde müssen."},
        {"it": "Saprai.", "en": "You'll know.", "de": "Du wirst es wissen."},
        {"it": "Pioverà.", "en": "It'll rain.", "de": "Es wird regnen."},
        {"it": "Vorrà.", "en": "He'll want to.", "de": "Er wird wollen."}
      ]
    },
    {
      "id": "participi",
      "level": "A2",
      "rule": "participi-irregolari",
      "title": {"it": "Che cosa hai fatto?", "en": "What have you done?", "de": "Was hast du gemacht?"},
      "items": [
        {"it": "Ho fatto i compiti.", "en": "I did my homework.", "de": "Ich habe die Hausaufgaben gemacht."},
        {"it": "Ho visto il gatto.", "en": "I saw the cat.", "de": "Ich habe die Katze gesehen."},
        {"it": "Ho detto di sì.", "en": "I said yes.", "de": "Ich habe Ja gesagt."},
        {"it": "Ho scritto una lettera.", "en": "I wrote a letter.", "de": "Ich habe einen Brief geschrieben."},
        {"it": "Ho letto il libro.", "en": "I read the book.", "de": "Ich habe das Buch gelesen."},
        {"it": "Ho preso la palla.", "en": "I took the ball.", "de": "Ich habe den Ball genommen."},
        {"it": "Ho messo il cappello.", "en": "I put my hat on.", "de": "Ich habe den Hut aufgesetzt."},
        {"it": "Ho aperto la porta.", "en": "I opened the door.", "de": "Ich habe die Tür aufgemacht."},
        {"it": "Ho chiuso la finestra.", "en": "I closed the window.", "de": "Ich habe das Fenster zugemacht."},
        {"it": "Ho chiesto perché.", "en": "I asked why.", "de": "Ich habe gefragt, warum."},
        {"it": "Ho risposto.", "en": "I answered.", "de": "Ich habe geantwortet."},
        {"it": "Ho bevuto il latte.", "en": "I drank the milk.", "de": "Ich habe die Milch getrunken."},
        {"it": "Ho vinto!", "en": "I won!", "de": "Ich habe gewonnen!"},
        {"it": "Ho perso la chiave.", "en": "I lost the key.", "de": "Ich habe den Schlüssel verloren."},
        {"it": "Ho scelto quello rosso.", "en": "I chose the red one.", "de": "Ich habe den roten genommen."},
        {"it": "Ho spento la luce.", "en": "I turned off the light.", "de": "Ich habe das Licht ausgemacht."}
      ]
    },
    {
      "id": "condizionale",
      "level": "B1",
      "rule": "condizionale",
      "title": {"it": "Al condizionale", "en": "Would, could, should", "de": "Würde, könnte, sollte"},
      "items": [
        {"it": "Andrei.", "en": "I'd go.", "de": "Ich würde gehen."},
        {"it": "Vorrei.", "en": "I'd like.", "de": "Ich möchte."},
        {"it": "Potresti?", "en": "Could you?", "de": "Könntest du?"},
        {"it": "Dovresti.", "en": "You should.", "de": "Du solltest."},
        {"it": "Mangerei.", "en": "I'd eat.", "de": "Ich würde essen."},
        {"it": "Verremmo.", "en": "We'd come.", "de": "Wir würden kommen."},
        {"it": "Direbbe.", "en": "She'd say.", "de": "Sie würde sagen."},
        {"it": "Sarebbe bello.", "en": "It would be nice.", "de": "Das wäre schön."},
        {"it": "Lo farei.", "en": "I'd do it.", "de": "Ich würde es machen."},
        {"it": "Mi aiuteresti?", "en": "Would you help me?", "de": "Würdest du mir helfen?"},
        {"it": "Resterei.", "en": "I'd stay.", "de": "Ich würde bleiben."},
        {"it": "Saprebbero.", "en": "They'd know.", "de": "Sie würden es wissen."},
        {"it": "Dormiremmo.", "en": "We'd sleep.", "de": "Wir würden schlafen."},
        {"it": "Preferirei.", "en": "I'd prefer.", "de": "Ich hätte lieber."},
        {"it": "Potrei?", "en": "Could I?", "de": "Könnte ich?"},
        {"it": "Giocherei.", "en": "I'd play.", "de": "Ich würde spielen."}
      ]
    },
    {
      "id": "penso-che",
      "level": "B1",
      "rule": "congiuntivo",
      "title": {"it": "Penso che, voglio che", "en": "I think that, I want you to", "de": "Ich glaube, dass; ich will, dass"},
      "items": [
        {"it": "Penso che sia lì.", "en": "I think he's there.", "de": "Ich glaube, dass er dort ist."},
        {"it": "Penso che abbia fame.", "en": "I think she's hungry.", "de": "Ich glaube, dass sie Hunger hat."},
        {"it": "Voglio che tu venga.", "en": "I want you to come.", "de": "Ich will, dass du kommst."},
        {"it": "Spero che faccia bello.", "en": "I hope the weather's nice.", "de": "Ich hoffe, dass schönes Wetter ist."},
        {"it": "Penso che sappia.", "en": "I think he knows.", "de": "Ich glaube, dass er es weiß."},
        {"it": "Voglio che tu resti.", "en": "I want you to stay.", "de": "Ich will, dass du bleibst."},
        {"it": "Spero che tu dorma bene.", "en": "I hope you sleep well.", "de": "Ich hoffe, dass du gut schläfst."},
        {"it": "Penso che vengano.", "en": "I think they're coming.", "de": "Ich glaube, dass sie kommen."},
        {"it": "Voglio che tu mangi.", "en": "I want you to eat.", "de": "Ich will, dass du isst."},
        {"it": "Spero che possa.", "en": "I hope she can.", "de": "Ich hoffe, dass sie kann."},
        {"it": "Penso che piova.", "en": "I think it's raining.", "de": "Ich glaube, dass es regnet."},
        {"it": "Voglio che tu ascolti.", "en": "I want you to listen.", "de": "Ich will, dass du zuhörst."},
        {"it": "Prima che faccia buio.", "en": "Before it gets dark.", "de": "Bevor es dunkel wird."},
        {"it": "Spero che vincano.", "en": "I hope they win.", "de": "Ich hoffe, dass sie gewinnen."},
        {"it": "Penso che voglia.", "en": "I think he wants to.", "de": "Ich glaube, dass er will."}
      ]
    },
    {
      "id": "se-fossi",
      "level": "B2",
      "rule": "congiuntivo-imperfetto",
      "title": {"it": "Se fossi, se avessi", "en": "If I were, if I had", "de": "Wenn ich wäre, wenn ich hätte"},
      "items": [
        {"it": "Se fossi in te.", "en": "If I were you.", "de": "Wenn ich du wäre."},
        {"it": "Se avessi tempo.", "en": "If I had time.", "de": "Wenn ich Zeit hätte."},
        {"it": "Se potessi.", "en": "If I could.", "de": "Wenn ich könnte."},
        {"it": "Se tu venissi.", "en": "If you came.", "de": "Wenn du kommen würdest."},
        {"it": "Se sapessimo.", "en": "If we knew.", "de": "Wenn wir es wüssten."},
        {"it": "Se piovesse.", "en": "If it rained.", "de": "Wenn es regnen würde."},
        {"it": "Se volessero.", "en": "If they wanted.", "de": "Wenn sie wollten."},
