        {"from": {"sl": "Imam čas.", "en": "I have time.", "de": "Ich habe Zeit."}, "to": {"sl": "Nimam časa.", "en": "I don't have time.", "de": "Ich habe keine Zeit."}},
        {"from": {"sl": "Pijem kavo.", "en": "I drink coffee.", "de": "Ich trinke Kaffee."}, "to": {"sl": "Ne pijem kave.", "en": "I don't drink coffee.", "de": "Ich trinke keinen Kaffee."}},
        {"from": {"sl": "Jem meso.", "en": "I eat meat.", "de": "Ich esse Fleisch."}, "to": {"sl": "Ne jem mesa.", "en": "I don't eat meat.", "de": "Ich esse kein Fleisch."}},
        {"from": {"sl": "Vidim ovco.", "en": "I see the sheep.", "de": "Ich sehe das Schaf."}, "to": {"sl": "Ne vidim ovce.", "en": "I don't see the sheep.", "de": "Ich sehe das Schaf nicht."}},
        {"from": {"sl": "Babica ima mleko.", "en": "Grandma has milk.", "de": "Oma hat Milch."}, "to": {"sl": "Babica nima mleka.", "en": "Grandma has no milk.", "de": "Oma hat keine Milch."}},
        {"from": {"sl": "V trgovini je kruh.", "en": "There's bread in the shop.", "de": "Im Laden gibt es Brot."}, "to": {"sl": "V trgovini ni kruha.", "en": "There's no bread in the shop.", "de": "Im Laden gibt es kein Brot."}},
        {"from": {"sl": "Danes je veter.", "en": "It's windy today.", "de": "Heute ist es windig."}, "to": {"sl": "Danes ni vetra.", "en": "There's no wind today.", "de": "Heute weht kein Wind."}},
        {"from": {"sl": "Luka pije vino.", "en": "Luka drinks wine.", "de": "Luka trinkt Wein."}, "to": {"sl": "Luka ne pije vina.", "en": "Luka doesn't drink wine.", "de": "Luka trinkt keinen Wein."}},
        {"from": {"sl": "Imam brata.", "en": "I have a brother.", "de": "Ich habe einen Bruder."}, "to": {"sl": "Nimam brata.", "en": "I don't have a brother.", "de": "Ich habe keinen Bruder."}},
        {"from": {"sl": "Imamo vodo.", "en": "We have water.", "de": "Wir haben Wasser."}, "to": {"sl": "Nimamo vode.", "en": "We have no water.", "de": "Wir haben kein Wasser."}},
        {"from": {"sl": "Na nebu je luna.", "en": "The moon is in the sky.", "de": "Der Mond ist am Himmel."}, "to": {"sl": "Na nebu ni lune.", "en": "There's no moon in the sky.", "de": "Am Himmel ist kein Mond."}},
        {"from": {"sl": "V vasi je gostilna.", "en": "There's an inn in the village.", "de": "Im Dorf gibt es ein Gasthaus."}, "to": {"sl": "V vasi ni gostilne.", "en": "There's no inn in the village.", "de": "Im Dorf gibt es kein Gasthaus."}},
