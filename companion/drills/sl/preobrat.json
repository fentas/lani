        {"from": {"sl": "Imam sestro.", "en": "I have a sister.", "de": "Ich habe eine Schwester."}, "to": {"sl": "Imam dve sestri.", "en": "I have two sisters.", "de": "Ich habe zwei Schwestern."}},
        {"from": {"sl": "Vidim psa.", "en": "I see a dog.", "de": "Ich sehe einen Hund."}, "to": {"sl": "Vidim dva psa.", "en": "I see two dogs.", "de": "Ich sehe zwei Hunde."}},
        {"from": {"sl": "Na mizi je jabolko.", "en": "There's an apple on the table.", "de": "Auf dem Tisch ist ein Apfel."}, "to": {"sl": "Na mizi sta dve jabolki.", "en": "There are two apples on the table.", "de": "Auf dem Tisch sind zwei Äpfel."}},
        {"from": {"sl": "Kavo, prosim.", "en": "A coffee, please.", "de": "Einen Kaffee, bitte."}, "to": {"sl": "Dve kavi, prosim.", "en": "Two coffees, please.", "de": "Zwei Kaffee, bitte."}},
        {"from": {"sl": "V hlevu je konj.", "en": "There's a horse in the stable.", "de": "Im Stall ist ein Pferd."}, "to": {"sl": "V hlevu sta dva konja.", "en": "There are two horses in the stable.", "de": "Im Stall sind zwei Pferde."}},
        {"from": {"sl": "Na nebu je zvezda.", "en": "There's a star in the sky.", "de": "Am Himmel ist ein Stern."}, "to": {"sl": "Na nebu sta dve zvezdi.", "en": "There are two stars in the sky.", "de": "Am Himmel sind zwei Sterne."}},
        {"from": {"sl": "Kupim kruh.", "en": "I'm buying a loaf of bread.", "de": "Ich kaufe ein Brot."}, "to": {"sl": "Kupim dva kruha.", "en": "I'm buying two loaves of bread.", "de": "Ich kaufe zwei Brote."}},
        {"from": {"sl": "Na mizi je knjiga.", "en": "There's a book on the table.", "de": "Auf dem Tisch ist ein Buch."}, "to": {"sl": "Na mizi sta dve knjigi.", "en": "There are two books on the table.", "de": "Auf dem Tisch sind zwei Bücher."}},
        {"from": {"sl": "Pri ognju sedi otrok.", "en": "A child is sitting by the fire.", "de": "Am Feuer sitzt ein Kind."}, "to": {"sl": "Pri ognju sedita dva otroka.", "en": "Two children are sitting by the fire.", "de": "Am Feuer sitzen zwei Kinder."}},
        {"from": {"sl": "V gozdu je medved.", "en": "There's a bear in the forest.", "de": "Im Wald ist ein Bär."}, "to": {"sl": "V gozdu sta dva medveda.", "en": "There are two bears in the forest.", "de": "Im Wald sind zwei Bären."}},
        {"from": {"sl": "Na njivi je strašilo.", "en": "There's a scarecrow in the field.", "de": "Auf dem Feld ist eine Vogelscheuche."}, "to": {"sl": "Na njivi sta dve strašili.", "en": "There are two scarecrows in the field.", "de": "Auf dem Feld sind zwei Vogelscheuchen."}},
        {"from": {"sl": "Eno jajce, prosim.", "en": "One egg, please.", "de": "Ein Ei, bitte."}, "to": {"sl": "Dve jajci, prosim.", "en": "Two eggs, please.", "de": "Zwei Eier, bitte."}},
        {"from": {"sl": "V vasi je gostilna.", "en": "There's an inn in the village.", "de": "Im Dorf ist ein Gasthaus."}, "to": {"sl": "V vasi sta dve gostilni.", "en": "There are two inns in the village.", "de": "Im Dorf sind zwei Gasthäuser."}},
