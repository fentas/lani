      "items": [
        {"from": {"sl": "Grem na tržnico.", "en": "I'm going to the market.", "de": "Ich gehe auf den Markt."}, "to": {"sl": "Greva na tržnico.", "en": "The two of us are going to the market.", "de": "Wir zwei gehen auf den Markt."}},
        {"from": {"sl": "Doma sem.", "en": "I'm at home.", "de": "Ich bin zu Hause."}, "to": {"sl": "Doma sva.", "en": "The two of us are at home.", "de": "Wir zwei sind zu Hause."}},
        {"from": {"sl": "Imam čas.", "en": "I have time.", "de": "Ich habe Zeit."}, "to": {"sl": "Imava čas.", "en": "The two of us have time.", "de": "Wir zwei haben Zeit."}},
