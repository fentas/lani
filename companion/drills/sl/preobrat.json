      "level": "A1",
      "do": {"sl": "Dva", "en": "Make it two.", "de": "Mach zwei daraus."},
      "items": [
        {"from": {"sl": "Na travniku je krava.", "en": "There's a cow in the meadow.", "de": "Auf der Wiese ist eine Kuh."}, "to": {"sl": "Na travniku sta dve kravi.", "en": "There are two cows in the meadow.", "de": "Auf der Wiese sind zwei Kühe."}},
