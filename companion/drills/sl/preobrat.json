        {"from": {"sl": "Iščem psa.", "en": "I'm looking for the dog.", "de": "Ich suche den Hund."}, "to": {"sl": "Iščeva psa.", "en": "The two of us are looking for the dog.", "de": "Wir zwei suchen den Hund."}},
