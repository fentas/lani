        {"from": {"sl": "Pijem kavo.", "en": "I'm drinking coffee.", "de": "Ich trinke Kaffee."}, "to": {"sl": "Pijeva kavo.", "en": "The two of us are drinking coffee.", "de": "Wir zwei trinken Kaffee."}},
        {"from": {"sl": "Jem kruh.", "en": "I'm eating bread.", "de": "Ich esse Brot."}, "to": {"sl": "Jeva kruh.", "en": "The two of us are eating bread.", "de": "Wir zwei essen Brot."}},
