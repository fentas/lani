        {"from": {"sl": "Nabiram gobe.", "en": "I'm picking mushrooms.", "de": "Ich sammle Pilze."}, "to": {"sl": "Nabirava gobe.", "en": "The two of us are picking mushrooms.", "de": "Wir zwei sammeln Pilze."}},
        {"from": {"sl": "Igram se.", "en": "I'm playing.", "de": "Ich spiele."}, "to": {"sl": "Igrava se.", "en": "The two of us are playing.", "de": "Wir zwei spielen."}},
        {"from": {"sl": "Kurim ogenj.", "en": "I'm keeping the fire going.", "de": "Ich schüre das Feuer."}, "to": {"sl": "Kuriva ogenj.", "en": "The two of us are keeping the fire going.", "de": "Wir zwei schüren das Feuer."}},
        {"from": {"sl": "Pojem pesem.", "en": "I'm singing a song.", "de": "Ich singe ein Lied."}, "to": {"sl": "Pojeva pesem.", "en": "The two of us are singing a song.", "de": "Wir zwei singen ein Lied."}},
        {"from": {"sl": "Delam na njivi.", "en": "I'm working in the field.", "de": "Ich arbeite auf dem Feld."}, "to": {"sl": "Delava na njivi.", "en": "The two of us are working in the field.", "de": "Wir zwei arbeiten auf dem Feld."}},
        {"from": {"sl": "Spim v šotoru.", "en": "I'm sleeping in the tent.", "de": "Ich schlafe im Zelt."}, "to": {"sl": "Spiva v šotoru.", "en": "The two of us are sleeping in the tent.", "de": "Wir zwei schlafen im Zelt."}}
