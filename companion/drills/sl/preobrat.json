        {"from": {"sl": "Kuham juho.", "en": "I'm cooking soup.", "de": "Ich koche Suppe."}, "to": {"sl": "Ne kuham juhe.", "en": "I'm not cooking soup.", "de": "Ich koche keine Suppe."}},
        {"from": {"sl": "To je krava.", "en": "That's a cow.", "de": "Das ist eine Kuh."}, "to": {"sl": "To ni krava.", "en": "That's not a cow.", "de": "Das ist keine Kuh."}},
