{
  "schema": "lani.drill/v0",
  "id": "preobrat",
  "kind": "transform",
  "language": "sl",
  "emoji": "🔄",
  "title": {"sl": "Preobrat", "en": "Transformations", "de": "Umformen"},
  "about": {"en": "Hear a sentence and what to do with it (into the past, the two of us, say no …), say the new sentence aloud, then hear it. One set per rule of the grammar book; a set of a rule not introduced to the learner yet isn't played.", "de": "Hör einen Satz und was du mit ihm tun sollst (in die Vergangenheit, wir zwei, verneinen …), sag den neuen Satz laut und hör ihn dann. Eine Übungsreihe je Regel des Grammatikbuchs; eine Regel, die dem Lernenden noch nicht vorgestellt wurde, wird nicht gespielt."},
  "sets": [
    {
      "id": "preteklik",
      "rule": "pretekli-cas",
      "level": "A1",
      "do": {"sl": "V preteklik", "en": "Into the past.", "de": "In die Vergangenheit."},
      "items": [
        {"from": {"sl": "Micka kuha kosilo.", "en": "Micka is cooking lunch.", "de": "Micka kocht das Mittagessen."}, "to": {"sl": "Micka je kuhala kosilo.", "en": "Micka cooked lunch.", "de": "Micka hat das Mittagessen gekocht."}},
        {"from": {"sl": "Luka pase ovce.", "en": "Luka is herding the sheep.", "de": "Luka hütet die Schafe."}, "to": {"sl": "Luka je pasel ovce.", "en": "Luka herded the sheep.", "de": "Luka hat die Schafe gehütet."}},
        {"from": {"sl": "Tone kuje podkev.", "en": "Tone is forging a horseshoe.", "de": "Tone schmiedet ein Hufeisen."}, "to": {"sl": "Tone je koval podkev.", "en": "Tone forged a horseshoe.", "de": "Tone hat ein Hufeisen geschmiedet."}},
        {"from": {"sl": "Janez pripoveduje zgodbo.", "en": "Janez is telling a story.", "de": "Janez erzählt eine Geschichte."}, "to": {"sl": "Janez je pripovedoval zgodbo.", "en": "Janez told a story.", "de": "Janez hat eine Geschichte erzählt."}},
        {"from": {"sl": "Zala se igra na trgu.", "en": "Zala is playing on the square.", "de": "Zala spielt auf dem Platz."}, "to": {"sl": "Zala se je igrala na trgu.", "en": "Zala played on the square.", "de": "Zala hat auf dem Platz gespielt."}},
        {"from": {"sl": "Nejc hitro teče.", "en": "Nejc runs fast.", "de": "Nejc läuft schnell."}, "to": {"sl": "Nejc je hitro tekel.", "en": "Nejc ran fast.", "de": "Nejc ist schnell gelaufen."}},
        {"from": {"sl": "Mojca piše na tablo.", "en": "Mojca is writing on the blackboard.", "de": "Mojca schreibt an die Tafel."}, "to": {"sl": "Mojca je pisala na tablo.", "en": "Mojca wrote on the blackboard.", "de": "Mojca hat an die Tafel geschrieben."}},
        {"from": {"sl": "Vida odpre gostilno.", "en": "Vida opens the inn.", "de": "Vida öffnet das Gasthaus."}, "to": {"sl": "Vida je odprla gostilno.", "en": "Vida opened the inn.", "de": "Vida hat das Gasthaus geöffnet."}},
        {"from": {"sl": "Anton ima čebele.", "en": "Anton has bees.", "de": "Anton hat Bienen."}, "to": {"sl": "Anton je imel čebele.", "en": "Anton had bees.", "de": "Anton hatte Bienen."}},
        {"from": {"sl": "France melje moko.", "en": "France is grinding flour.", "de": "France mahlt Mehl."}, "to": {"sl": "France je mlel moko.", "en": "France ground flour.", "de": "France hat Mehl gemahlen."}},
        {"from": {"sl": "Marko pije vino.", "en": "Marko is drinking wine.", "de": "Marko trinkt Wein."}, "to": {"sl": "Marko je pil vino.", "en": "Marko drank wine.", "de": "Marko hat Wein getrunken."}},
        {"from": {"sl": "Babica peče potico.", "en": "Grandma is baking a potica.", "de": "Oma bäckt eine Potica."}, "to": {"sl": "Babica je pekla potico.", "en": "Grandma baked a potica.", "de": "Oma hat eine Potica gebacken."}},
        {"from": {"sl": "Dežuje.", "en": "It's raining.", "de": "Es regnet."}, "to": {"sl": "Deževalo je.", "en": "It rained.", "de": "Es hat geregnet."}},
        {"from": {"sl": "Ogenj gori.", "en": "The fire is burning.", "de": "Das Feuer brennt."}, "to": {"sl": "Ogenj je gorel.", "en": "The fire burned.", "de": "Das Feuer hat gebrannt."}},
        {"from": {"sl": "Jože je v gozdu.", "en": "Jože is in the forest.", "de": "Jože ist im Wald."}, "to": {"sl": "Jože je bil v gozdu.", "en": "Jože was in the forest.", "de": "Jože war im Wald."}},
        {"from": {"sl": "Ančka gre na tržnico.", "en": "Ančka is going to the market.", "de": "Ančka geht auf den Markt."}, "to": {"sl": "Ančka je šla na tržnico.", "en": "Ančka went to the market.", "de": "Ančka ist auf den Markt gegangen."}},
        {"from": {"sl": "Luka in Nejc sta doma.", "en": "Luka and Nejc are at home.", "de": "Luka und Nejc sind zu Hause."}, "to": {"sl": "Luka in Nejc sta bila doma.", "en": "Luka and Nejc were at home.", "de": "Luka und Nejc waren zu Hause."}},
        {"from": {"sl": "Micka in Zala pečeta kruh.", "en": "Micka and Zala are baking bread.", "de": "Micka und Zala backen Brot."}, "to": {"sl": "Micka in Zala sta pekli kruh.", "en": "Micka and Zala baked bread.", "de": "Micka und Zala haben Brot gebacken."}},
        {"from": {"sl": "Otroci se učijo.", "en": "The children are learning.", "de": "Die Kinder lernen."}, "to": {"sl": "Otroci so se učili.", "en": "The children were learning.", "de": "Die Kinder haben gelernt."}},
        {"from": {"sl": "Krave so na planini.", "en": "The cows are on the mountain pasture.", "de": "Die Kühe sind auf der Alm."}, "to": {"sl": "Krave so bile na planini.", "en": "The cows were on the mountain pasture.", "de": "Die Kühe waren auf der Alm."}},
        {"from": {"sl": "Sonce sije.", "en": "The sun is shining.", "de": "Die Sonne scheint."}, "to": {"sl": "Sonce je sijalo.", "en": "The sun was shining.", "de": "Die Sonne hat geschienen."}},
        {"from": {"sl": "Mačka spi na klopi.", "en": "The cat is sleeping on the bench.", "de": "Die Katze schläft auf der Bank."}, "to": {"sl": "Mačka je spala na klopi.", "en": "The cat slept on the bench.", "de": "Die Katze hat auf der Bank geschlafen."}},
        {"from": {"sl": "Pes laja.", "en": "The dog is barking.", "de": "Der Hund bellt."}, "to": {"sl": "Pes je lajal.", "en": "The dog barked.", "de": "Der Hund hat gebellt."}},
        {"from": {"sl": "Zvon zvoni.", "en": "The bell is ringing.", "de": "Die Glocke läutet."}, "to": {"sl": "Zvon je zvonil.", "en": "The bell rang.", "de": "Die Glocke hat geläutet."}}
      ]
    },
    {
      "id": "prihodnjik",
      "rule": "prihodnjik",
      "level": "A1",
      "do": {"sl": "V prihodnjik", "en": "Into the future.", "de": "In die Zukunft."},
      "items": [
        {"from": {"sl": "Micka kuha kosilo.", "en": "Micka is cooking lunch.", "de": "Micka kocht das Mittagessen."}, "to": {"sl": "Micka bo kuhala kosilo.", "en": "Micka will cook lunch.", "de": "Micka wird das Mittagessen kochen."}},
        {"from": {"sl": "Doma sem.", "en": "I'm at home.", "de": "Ich bin zu Hause."}, "to": {"sl": "Doma bom.", "en": "I'll be at home.", "de": "Ich werde zu Hause sein."}},
        {"from": {"sl": "Janez je pri ognju.", "en": "Janez is by the fire.", "de": "Janez ist am Feuer."}, "to": {"sl": "Janez bo pri ognju.", "en": "Janez will be by the fire.", "de": "Janez wird am Feuer sein."}},
        {"from": {"sl": "Dežuje.", "en": "It's raining.", "de": "Es regnet."}, "to": {"sl": "Deževalo bo.", "en": "It will rain.", "de": "Es wird regnen."}},
        {"from": {"sl": "Luka pase ovce.", "en": "Luka is herding the sheep.", "de": "Luka hütet die Schafe."}, "to": {"sl": "Luka bo pasel ovce.", "en": "Luka will herd the sheep.", "de": "Luka wird die Schafe hüten."}},
        {"from": {"sl": "Tone popravi voz.", "en": "Tone fixes the cart.", "de": "Tone repariert den Wagen."}, "to": {"sl": "Tone bo popravil voz.", "en": "Tone will fix the cart.", "de": "Tone wird den Wagen reparieren."}},
        {"from": {"sl": "Zala in Nejc se igrata.", "en": "Zala and Nejc are playing.", "de": "Zala und Nejc spielen."}, "to": {"sl": "Zala in Nejc se bosta igrala.", "en": "Zala and Nejc will play.", "de": "Zala und Nejc werden spielen."}},
        {"from": {"sl": "Imamo čas.", "en": "We have time.", "de": "Wir haben Zeit."}, "to": {"sl": "Imeli bomo čas.", "en": "We will have time.", "de": "Wir werden Zeit haben."}},
        {"from": {"sl": "Otroci so v šoli.", "en": "The children are at school.", "de": "Die Kinder sind in der Schule."}, "to": {"sl": "Otroci bodo v šoli.", "en": "The children will be at school.", "de": "Die Kinder werden in der Schule sein."}},
        {"from": {"sl": "Vreme je lepo.", "en": "The weather is nice.", "de": "Das Wetter ist schön."}, "to": {"sl": "Vreme bo lepo.", "en": "The weather will be nice.", "de": "Das Wetter wird schön sein."}},
        {"from": {"sl": "Vida odpre gostilno.", "en": "Vida opens the inn.", "de": "Vida öffnet das Gasthaus."}, "to": {"sl": "Vida bo odprla gostilno.", "en": "Vida will open the inn.", "de": "Vida wird das Gasthaus öffnen."}},
        {"from": {"sl": "Babica peče potico.", "en": "Grandma is baking a potica.", "de": "Oma bäckt eine Potica."}, "to": {"sl": "Babica bo pekla potico.", "en": "Grandma will bake a potica.", "de": "Oma wird eine Potica backen."}},
        {"from": {"sl": "Marko nabira grozdje.", "en": "Marko is picking grapes.", "de": "Marko pflückt Trauben."}, "to": {"sl": "Marko bo nabiral grozdje.", "en": "Marko will pick grapes.", "de": "Marko wird Trauben pflücken."}},
        {"from": {"sl": "Mojca uči otroke.", "en": "Mojca teaches the children.", "de": "Mojca unterrichtet die Kinder."}, "to": {"sl": "Mojca bo učila otroke.", "en": "Mojca will teach the children.", "de": "Mojca wird die Kinder unterrichten."}},
        {"from": {"sl": "Sneži.", "en": "It's snowing.", "de": "Es schneit."}, "to": {"sl": "Snežilo bo.", "en": "It will snow.", "de": "Es wird schneien."}},
        {"from": {"sl": "Tržnica je odprta.", "en": "The market is open.", "de": "Der Markt ist offen."}, "to": {"sl": "Tržnica bo odprta.", "en": "The market will be open.", "de": "Der Markt wird offen sein."}},
        {"from": {"sl": "Gremo v gozd.", "en": "We're going to the forest.", "de": "Wir gehen in den Wald."}, "to": {"sl": "Šli bomo v gozd.", "en": "We will go to the forest.", "de": "Wir werden in den Wald gehen."}},
        {"from": {"sl": "Krave so na planini.", "en": "The cows are on the mountain pasture.", "de": "Die Kühe sind auf der Alm."}, "to": {"sl": "Krave bodo na planini.", "en": "The cows will be on the mountain pasture.", "de": "Die Kühe werden auf der Alm sein."}},
        {"from": {"sl": "Jože išče medveda.", "en": "Jože is looking for the bear.", "de": "Jože sucht den Bären."}, "to": {"sl": "Jože bo iskal medveda.", "en": "Jože will look for the bear.", "de": "Jože wird den Bären suchen."}},
        {"from": {"sl": "Nejc ima žogo.", "en": "Nejc has a ball.", "de": "Nejc hat einen Ball."}, "to": {"sl": "Nejc bo imel žogo.", "en": "Nejc will have a ball.", "de": "Nejc wird einen Ball haben."}},
        {"from": {"sl": "Ogenj gori.", "en": "The fire is burning.", "de": "Das Feuer brennt."}, "to": {"sl": "Ogenj bo gorel.", "en": "The fire will burn.", "de": "Das Feuer wird brennen."}},
        {"from": {"sl": "Zvon zvoni.", "en": "The bell is ringing.", "de": "Die Glocke läutet."}, "to": {"sl": "Zvon bo zvonil.", "en": "The bell will ring.", "de": "Die Glocke wird läuten."}}
      ]
    },
    {
      "id": "midva",
